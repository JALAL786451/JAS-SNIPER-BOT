//@version=5
// ============================================================================
//  AUTO CHART PATTERNS — JAS v1
//
//  Khud ba khud chart patterns dhoondta aur draw karta hai:
//    - Double Top / Double Bottom
//    - Head & Shoulders / Inverse Head & Shoulders
//    - Triangle (ascending / descending / symmetrical)
//    - Wedge (rising / falling), Channel (rising / falling), Rectangle
//
//  Har reversal pattern ke liye:
//    - Neckline khinchti hai (H&S mein tirchi bhi ho sakti hai)
//    - Breakout hone par "CONFIRMED" label + alert
//    - Measured target (pattern ki oonchai neckline se aage naapi hui)
//
//  ZAROORI: pivot (swing) pivRight bars baad confirm hota hai, is liye
//  pattern hamesha thora sa BAAD mein nazar aata hai. Ye repaint se bachne
//  ki qeemat hai — jo indicator turant pattern dikhate hain wo aksar baad
//  mein apna faisla badal dete hain.
// ============================================================================
indicator("Auto Chart Patterns — JAS v1", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ============================================================================
//  INPUTS
// ============================================================================
gP = "1 · Pivots (swing points)"
pivLeft  = input.int(5,  "Pivot left bars",  minval = 1, group = gP)
pivRight = input.int(5,  "Pivot right bars", minval = 1, group = gP)
keepPiv  = input.int(20, "Kitne pivots yaad rakhein", minval = 6, maxval = 50, group = gP)
showZig  = input.bool(true, "ZigZag line dikhayen", group = gP)

gT = "2 · Tolerance (kitni dheel di jaye)"
atrLen      = input.int(14,  "ATR length", minval = 2, group = gT)
eqTolATR    = input.float(0.35, "Do top/bottom barabar mane jayen (x ATR)", step = 0.05, minval = 0.05, group = gT)
headMinATR  = input.float(0.50, "Head, shoulders se itna ooncha ho (x ATR)", step = 0.05, minval = 0.10, group = gT)
depthMinATR = input.float(0.80, "Pattern ki kam se kam gehrai (x ATR)",     step = 0.10, minval = 0.10, group = gT)
flatTolATR  = input.float(0.30, "Line ko 'flat' mana jaye (x ATR)",         step = 0.05, minval = 0.05, group = gT)

gS = "3 · Kaun se patterns dhoondein"
useDT  = input.bool(true, "Double Top / Double Bottom", group = gS)
useHS  = input.bool(true, "Head & Shoulders (+ ulta)",  group = gS)
useTri = input.bool(true, "Triangle / Wedge / Channel", group = gS)

gC = "4 · Confirmation"
expireBars = input.int(60, "Itne bars mein confirm na ho to pattern cancel", minval = 5, group = gC)
useClose   = input.bool(true, "Neckline break sirf CLOSE se gina jaye", group = gC)

gD = "5 · Display"
showTarget = input.bool(true,  "Measured target line dikhayen", group = gD)
showPoints = input.bool(true,  "Pattern ke points par labels", group = gD)
showPanel  = input.bool(true,  "Info panel dikhayen", group = gD)
panelPos   = input.string("Bottom Left", "Panel ki jagah", options = ["Top Right","Top Left","Bottom Right","Bottom Left"], group = gD)
colBull = input.color(color.new(color.teal,   0), "Bullish rang", group = gD)
colBear = input.color(color.new(color.red,    0), "Bearish rang", group = gD)
colNeut = input.color(color.new(color.gray,  30), "Neutral rang", group = gD)

// ============================================================================
//  HELPERS
// ============================================================================
atr = ta.atr(atrLen)

f_pos(s) => s == "Top Left" ? position.top_left : s == "Top Right" ? position.top_right : s == "Bottom Left" ? position.bottom_left : position.bottom_right

f_px(x) => str.tostring(x, format.mintick)

// ============================================================================
//  PIVOT STORE (zigzag: high aur low bari bari aate hain)
// ============================================================================
var float[] pvP = array.new_float()   // pivot ki price
var int[]   pvB = array.new_int()     // pivot ka bar_index
var bool[]  pvH = array.new_bool()    // true = high pivot, false = low pivot
var line[]  zzL = array.new_line()    // zigzag lines

f_cnt() => array.size(pvP)

// i = 0 ka matlab sab se naya pivot, 1 us se pehla, waghera.
// Pine mein `and` dono taraf chalata hai, is liye har array read pehle
// bounds check ke andar hota hai — warna index -1 par error aata hai.
f_price(i) =>
    float r = na
    if i >= 0
        if array.size(pvP) > i
            r := array.get(pvP, array.size(pvP) - 1 - i)
    r

f_bar(i) =>
    int r = na
    if i >= 0
        if array.size(pvB) > i
            r := array.get(pvB, array.size(pvB) - 1 - i)
    r

f_isHigh(i) =>
    bool r = false
    if i >= 0
        if array.size(pvH) > i
            r := array.get(pvH, array.size(pvH) - 1 - i)
    r

// Naya pivot daalna. Agar pichla pivot bhi isi type ka tha (high ke baad
// high) to nayi jagah purani ko replace karti hai jab wo zyada extreme ho —
// is se high/low hamesha bari bari rehte hain.
f_push(_p, _b, _isH) =>
    bool added    = false
    int  n        = array.size(pvP)
    bool sameType = false
    if n > 0
        sameType := array.get(pvH, n - 1) == _isH
    if sameType
        float prev   = array.get(pvP, n - 1)
        bool  better = _isH ? (_p > prev) : (_p < prev)
        if better
            array.set(pvP, n - 1, _p)
            array.set(pvB, n - 1, _b)
    else
        array.push(pvP, _p)
        array.push(pvB, _b)
        array.push(pvH, _isH)
        added := true
    if array.size(pvP) > keepPiv
        array.shift(pvP)
        array.shift(pvB)
        array.shift(pvH)
    added

ph = ta.pivothigh(high, pivLeft, pivRight)
pl = ta.pivotlow (low,  pivLeft, pivRight)

bool newPivot = false
if not na(ph)
    newPivot := f_push(ph, bar_index - pivRight, true)
if not na(pl)
    bool addedLow = f_push(pl, bar_index - pivRight, false)
    newPivot := newPivot or addedLow

// --- zigzag redraw
if showZig and newPivot
    while array.size(zzL) > 0
        line.delete(array.shift(zzL))
    if array.size(pvP) > 1
        for i = 1 to array.size(pvP) - 1
            line ln = line.new(array.get(pvB, i - 1), array.get(pvP, i - 1), array.get(pvB, i),     array.get(pvP, i), xloc = xloc.bar_index, color = colNeut, width = 1)
            array.push(zzL, ln)

// ============================================================================
//  REVERSAL PATTERN STATE (ek waqt mein ek pattern track hota hai)
// ============================================================================
var string  patName   = ""
var int     patDir    = 0        // 1 = bullish, -1 = bearish
var float   patNeckP  = na       // neckline ka anchor price
var int     patNeckB  = na       // neckline ka anchor bar
var float   patNeckS  = na       // neckline ka slope (price per bar)
var float   patHeight = na       // pattern ki oonchai (target ke liye)
var int     patBar    = na       // kab mila
var bool    patDone   = false    // breakout ho chuka?
var float   patTgt    = na
var line[]  patLines  = array.new_line()
var label[] patLbls   = array.new_label()
var line    tgtLine   = na
var label   tgtLbl    = na

// Ek-bar wale flags — alertcondition ko sirf usi bar par chalana hai jis bar
// waqia hua, warna patDone/triBrk hamesha true rehne se alert har bar bajta.
bool justFound     = false
bool justConfirmed = false
bool justBrkUp     = false
bool justBrkDn     = false

// neckline ki value kisi bhi bar par
f_neckAt(_bar) =>
    float r = na
    if not na(patNeckP)
        r := patNeckP + patNeckS * (_bar - patNeckB)
    r

// ============================================================================
//  PATTERN DETECTION (sirf jab naya pivot bane)
// ============================================================================
string dName   = ""
int    dDir    = 0
float  dNeckP  = na
int    dNeckB  = na
float  dNeckS  = na
float  dHeight = na

if newPivot
    // ---------------- Double Top ----------------
    // pivots: [2] = high A, [1] = low (neckline), [0] = high B
    if useDT and f_cnt() >= 3 and dName == ""
        if f_isHigh(0) and f_isHigh(2) and not f_isHigh(1)
            float a = f_price(2)
            float m = f_price(1)
            float b = f_price(0)
            bool eq   = math.abs(a - b) <= eqTolATR * atr
            bool deep = (math.min(a, b) - m) >= depthMinATR * atr
            if eq and deep
                dName   := "Double Top"
                dDir    := -1
                dNeckP  := m
                dNeckB  := f_bar(1)
                dNeckS  := 0.0
                dHeight := math.avg(a, b) - m

    // ---------------- Double Bottom ----------------
    if useDT and f_cnt() >= 3 and dName == ""
        if (not f_isHigh(0)) and (not f_isHigh(2)) and f_isHigh(1)
            float a = f_price(2)
            float m = f_price(1)
            float b = f_price(0)
            bool eq   = math.abs(a - b) <= eqTolATR * atr
            bool deep = (m - math.max(a, b)) >= depthMinATR * atr
            if eq and deep
                dName   := "Double Bottom"
                dDir    := 1
                dNeckP  := m
                dNeckB  := f_bar(1)
                dNeckS  := 0.0
                dHeight := m - math.avg(a, b)

    // ---------------- Head & Shoulders ----------------
    // pivots: [4] LS(high) [3] low [2] head(high) [1] low [0] RS(high)
    if useHS and f_cnt() >= 5 and dName == ""
        if f_isHigh(4) and (not f_isHigh(3)) and f_isHigh(2) and (not f_isHigh(1)) and f_isHigh(0)
            float ls = f_price(4)
            float n1 = f_price(3)
            float hd = f_price(2)
            float n2 = f_price(1)
            float rs = f_price(0)
            int   b1 = f_bar(3)
            int   b2 = f_bar(1)
            bool headOK = (hd - math.max(ls, rs)) >= headMinATR * atr
            bool shOK   = math.abs(ls - rs) <= eqTolATR * atr
            bool depthOK = (math.min(ls, rs) - math.min(n1, n2)) >= 0.0
            if headOK and shOK and depthOK and b2 > b1
                float slope = (n2 - n1) / (b2 - b1)
                dName   := "Head & Shoulders"
                dDir    := -1
                dNeckP  := n2
                dNeckB  := b2
                dNeckS  := slope
                dHeight := hd - (n1 + slope * (f_bar(2) - b1))

    // ---------------- Inverse Head & Shoulders ----------------
    if useHS and f_cnt() >= 5 and dName == ""
        if (not f_isHigh(4)) and f_isHigh(3) and (not f_isHigh(2)) and f_isHigh(1) and (not f_isHigh(0))
            float ls = f_price(4)
            float n1 = f_price(3)
            float hd = f_price(2)
            float n2 = f_price(1)
            float rs = f_price(0)
            int   b1 = f_bar(3)
            int   b2 = f_bar(1)
            bool headOK  = (math.min(ls, rs) - hd) >= headMinATR * atr
            bool shOK    = math.abs(ls - rs) <= eqTolATR * atr
            bool depthOK = (math.max(n1, n2) - math.max(ls, rs)) >= 0.0
            if headOK and shOK and depthOK and b2 > b1
                float slope = (n2 - n1) / (b2 - b1)
                dName   := "Inverse Head & Shoulders"
                dDir    := 1
                dNeckP  := n2
                dNeckB  := b2
                dNeckS  := slope
                dHeight := (n1 + slope * (f_bar(2) - b1)) - hd

// ============================================================================
//  NAYA PATTERN MILA -> purana mita kar naya draw karo
// ============================================================================
if dName != ""
    while array.size(patLines) > 0
        line.delete(array.shift(patLines))
    while array.size(patLbls) > 0
        label.delete(array.shift(patLbls))
    if not na(tgtLine)
        line.delete(tgtLine)
        tgtLine := na
    if not na(tgtLbl)
        label.delete(tgtLbl)
        tgtLbl := na

    patName   := dName
    patDir    := dDir
    patNeckP  := dNeckP
    patNeckB  := dNeckB
    patNeckS  := dNeckS
    patHeight := dHeight
    patBar    := bar_index
    patDone   := false
    patTgt    := na
    justFound := true

    color pc = patDir > 0 ? colBull : colBear

    // pattern ke points ko jorne wali lines
    int pts = (patName == "Head & Shoulders" or patName == "Inverse Head & Shoulders") ? 5 : 3
    for i = 1 to pts - 1
        line ln = line.new(f_bar(i), f_price(i), f_bar(i - 1), f_price(i - 1), xloc = xloc.bar_index, color = pc, width = 2)
        array.push(patLines, ln)

    // neckline (dono taraf thori si barhi hui)
    int   nb1 = f_bar(pts - 1)
    int   nb2 = bar_index + 20
    line nl = line.new(nb1, f_neckAt(nb1), nb2, f_neckAt(nb2), xloc = xloc.bar_index, color = pc, width = 1, style = line.style_dashed)
    array.push(patLines, nl)

    // points par chhote labels
    if showPoints
        if pts == 5
            array.push(patLbls, label.new(f_bar(4), f_price(4), "LS", xloc = xloc.bar_index, yloc = patDir > 0 ? yloc.belowbar : yloc.abovebar, style = patDir > 0 ? label.style_label_up : label.style_label_down, color = pc, textcolor = color.white, size = size.tiny))
            array.push(patLbls, label.new(f_bar(2), f_price(2), "H",  xloc = xloc.bar_index, yloc = patDir > 0 ? yloc.belowbar : yloc.abovebar, style = patDir > 0 ? label.style_label_up : label.style_label_down, color = pc, textcolor = color.white, size = size.tiny))
            array.push(patLbls, label.new(f_bar(0), f_price(0), "RS", xloc = xloc.bar_index, yloc = patDir > 0 ? yloc.belowbar : yloc.abovebar, style = patDir > 0 ? label.style_label_up : label.style_label_down, color = pc, textcolor = color.white, size = size.tiny))
        else
            array.push(patLbls, label.new(f_bar(2), f_price(2), "1", xloc = xloc.bar_index, yloc = patDir > 0 ? yloc.belowbar : yloc.abovebar, style = patDir > 0 ? label.style_label_up : label.style_label_down, color = pc, textcolor = color.white, size = size.tiny))
            array.push(patLbls, label.new(f_bar(0), f_price(0), "2", xloc = xloc.bar_index, yloc = patDir > 0 ? yloc.belowbar : yloc.abovebar, style = patDir > 0 ? label.style_label_up : label.style_label_down, color = pc, textcolor = color.white, size = size.tiny))

    // naam ka label
    array.push(patLbls, label.new(f_bar(0), f_price(0), patName + "  (" + (patDir > 0 ? "bullish" : "bearish") + ")", xloc = xloc.bar_index, yloc = patDir > 0 ? yloc.belowbar : yloc.abovebar, style = patDir > 0 ? label.style_label_up : label.style_label_down, color = color.new(pc, 20), textcolor = color.white, size = size.small))

    alert(patName + " bana — " + syminfo.ticker + " " + timeframe.period + " | neckline " + f_px(f_neckAt(bar_index)), alert.freq_once_per_bar_close)

// ============================================================================
//  CONFIRMATION: neckline break
// ============================================================================
float neckNow = f_neckAt(bar_index)
float testPx  = useClose ? close : (patDir > 0 ? high : low)

if patName != "" and not patDone and not na(neckNow)
    bool broke = patDir > 0 ? (testPx > neckNow) : (testPx < neckNow)
    if broke
        patDone       := true
        justConfirmed := true
        patTgt  := patDir > 0 ? (neckNow + patHeight) : (neckNow - patHeight)
        color pc = patDir > 0 ? colBull : colBear

        array.push(patLbls, label.new(bar_index, close, "CONFIRMED\n" + patName + "\nTarget " + f_px(patTgt), xloc = xloc.bar_index, yloc = patDir > 0 ? yloc.belowbar : yloc.abovebar, style = patDir > 0 ? label.style_label_up : label.style_label_down, color = pc, textcolor = color.white, size = size.small))

        if showTarget
            tgtLine := line.new(bar_index, patTgt, bar_index + 40, patTgt, xloc = xloc.bar_index, color = pc, width = 1, style = line.style_dotted)
            tgtLbl  := label.new(bar_index + 40, patTgt, "Target " + f_px(patTgt), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(pc, 30), textcolor = color.white, size = size.tiny)

        alert(patName + " CONFIRMED — " + syminfo.ticker + " " + timeframe.period + " | break " + f_px(neckNow) + " | target " + f_px(patTgt), alert.freq_once_per_bar_close)

// miyaad khatam — confirm nahi hua to pattern hata do
if patName != "" and not patDone and not na(patBar)
    if (bar_index - patBar) > expireBars
        while array.size(patLines) > 0
            line.delete(array.shift(patLines))
        while array.size(patLbls) > 0
            label.delete(array.shift(patLbls))
        patName := ""
        patDir  := 0

// ============================================================================
//  TRIANGLE / WEDGE / CHANNEL
//  Aakhri do highs se ooper wali line, aakhri do lows se neeche wali line.
// ============================================================================
var string triName = ""
var int    triUB1  = na
var float  triUP1  = na
var int    triUB2  = na
var float  triUP2  = na
var int    triLB1  = na
var float  triLP1  = na
var int    triLB2  = na
var float  triLP2  = na
var line   triUL   = na
var line   triLL   = na
var label  triLbl  = na
var int    triBrk  = 0        // 0 = abhi nahi, 1 = upar tora, -1 = neeche

// aakhri do high aur do low pivots dhoondo
f_findTwo(_wantHigh, _which) =>
    // _which: 1 = sab se naya, 2 = us se pehla | return: index (0-based from end)
    int found = 0
    int res   = -1
    int n     = array.size(pvP)
    if n > 0
        for i = 0 to n - 1
            bool isH = f_isHigh(i)
            if isH == _wantHigh
                found := found + 1
                if found == _which
                    res := i
                    break
    res

if useTri and newPivot and f_cnt() >= 4
    int ih2 = f_findTwo(true,  1)   // naya high
    int ih1 = f_findTwo(true,  2)   // purana high
    int il2 = f_findTwo(false, 1)   // naya low
    int il1 = f_findTwo(false, 2)   // purana low

    if ih1 >= 0 and ih2 >= 0 and il1 >= 0 and il2 >= 0
        float h1 = f_price(ih1)
        float h2 = f_price(ih2)
        float l1 = f_price(il1)
        float l2 = f_price(il2)
        int   hb1 = f_bar(ih1)
        int   hb2 = f_bar(ih2)
        int   lb1 = f_bar(il1)
        int   lb2 = f_bar(il2)

        float eps = flatTolATR * atr

        bool hUp   = (h2 - h1) >  eps
        bool hDn   = (h1 - h2) >  eps
        bool hFlat = (not hUp) and (not hDn)
        bool lUp   = (l2 - l1) >  eps
        bool lDn   = (l1 - l2) >  eps
        bool lFlat = (not lUp) and (not lDn)

        float w1 = h1 - l1
        float w2 = h2 - l2
        bool converging = w2 < w1 * 0.85
        bool parallel   = math.abs(w2 - w1) <= eps

        string nm = ""
        if hFlat and lUp
            nm := "Ascending Triangle"
        else if hDn and lFlat
            nm := "Descending Triangle"
        else if hDn and lUp
            nm := "Symmetrical Triangle"
        else if hUp and lUp
            nm := converging ? "Rising Wedge" : parallel ? "Rising Channel" : ""
        else if hDn and lDn
            nm := converging ? "Falling Wedge" : parallel ? "Falling Channel" : ""
        else if hFlat and lFlat
            nm := "Rectangle / Range"

        if nm != ""
            triName := nm
            triUB1  := hb1
            triUP1  := h1
            triUB2  := hb2
            triUP2  := h2
            triLB1  := lb1
            triLP1  := l1
            triLB2  := lb2
            triLP2  := l2
            triBrk  := 0

            if not na(triUL)
                line.delete(triUL)
            if not na(triLL)
                line.delete(triLL)
            if not na(triLbl)
                label.delete(triLbl)

            triUL := line.new(hb1, h1, hb2, h2, xloc = xloc.bar_index, color = colBear, width = 1, extend = extend.right)
            triLL := line.new(lb1, l1, lb2, l2, xloc = xloc.bar_index, color = colBull, width = 1, extend = extend.right)
            triLbl := label.new(bar_index, high, triName, xloc = xloc.bar_index, yloc = yloc.abovebar, style = label.style_label_down, color = color.new(colNeut, 20), textcolor = color.white, size = size.small)
            alert(triName + " bana — " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar_close)

// triangle/wedge ka breakout
float triUpNow = na
float triLoNow = na
if triName != "" and not na(triUB2)
    if triUB2 != triUB1
        triUpNow := triUP2 + (triUP2 - triUP1) / (triUB2 - triUB1) * (bar_index - triUB2)
    if triLB2 != triLB1
        triLoNow := triLP2 + (triLP2 - triLP1) / (triLB2 - triLB1) * (bar_index - triLB2)

if triName != "" and triBrk == 0
    if not na(triUpNow) and close > triUpNow
        triBrk     := 1
        justBrkUp  := true
        label.new(bar_index, low, triName + "\nBREAKOUT ↑", xloc = xloc.bar_index, yloc = yloc.belowbar, style = label.style_label_up, color = colBull, textcolor = color.white, size = size.small)
        alert(triName + " BREAKOUT UP — " + syminfo.ticker + " " + timeframe.period + " | " + f_px(close), alert.freq_once_per_bar_close)
    else if not na(triLoNow) and close < triLoNow
        triBrk    := -1
        justBrkDn := true
        label.new(bar_index, high, triName + "\nBREAKDOWN ↓", xloc = xloc.bar_index, yloc = yloc.abovebar, style = label.style_label_down, color = colBear, textcolor = color.white, size = size.small)
        alert(triName + " BREAKDOWN — " + syminfo.ticker + " " + timeframe.period + " | " + f_px(close), alert.freq_once_per_bar_close)

// ============================================================================
//  INFO PANEL
// ============================================================================
var table pTbl = na
if showPanel and barstate.islast
    if na(pTbl)
        pTbl := table.new(f_pos(panelPos), 1, 4, border_width = 1)
    else
        table.clear(pTbl, 0, 0, 0, 3)

    color bgc = color.new(color.white, 92)

    table.cell(pTbl, 0, 0, "AUTO CHART PATTERNS  |  " + timeframe.period, bgcolor = color.new(color.white, 88), text_color = color.black, text_size = size.small)

    string row1 = patName == "" ? "Reversal pattern: koi nahi" : ("Reversal: " + patName + (patDone ? "  ✅ CONFIRMED" : "  ⏳ intezaar (neckline break)"))
    table.cell(pTbl, 0, 1, row1, bgcolor = bgc, text_color = patName == "" ? color.gray : (patDir > 0 ? colBull : colBear), text_size = size.small)

    string row2 = patName == "" ? "—" : ("Neckline " + f_px(f_neckAt(bar_index)) + (patDone and not na(patTgt) ? "   Target " + f_px(patTgt) : "   Target: break ke baad"))
    table.cell(pTbl, 0, 2, row2, bgcolor = bgc, text_color = color.black, text_size = size.small)

    string row3 = triName == "" ? "Triangle/Wedge: koi nahi" : ("Shape: " + triName + (triBrk == 1 ? "  ↑ break" : triBrk == -1 ? "  ↓ break" : "  (andar hai)"))
    table.cell(pTbl, 0, 3, row3, bgcolor = bgc, text_color = triName == "" ? color.gray : color.black, text_size = size.small)

// ============================================================================
//  ALERT CONDITIONS (TradingView ke alert menu ke liye)
// ============================================================================
alertcondition(justFound,                        "Naya pattern mila",    "Auto Chart Patterns: naya pattern bana")
alertcondition(justConfirmed and patDir ==  1,   "Bullish confirm",      "Auto Chart Patterns: bullish pattern confirm")
alertcondition(justConfirmed and patDir == -1,   "Bearish confirm",      "Auto Chart Patterns: bearish pattern confirm")
alertcondition(justBrkUp,                        "Triangle breakout up", "Auto Chart Patterns: shape se upar breakout")
alertcondition(justBrkDn,                        "Triangle breakdown",   "Auto Chart Patterns: shape se neeche breakdown")

