//@version=6
// ============================================================================
//  JAS VIX  (build v2, Pine v6)  -  Koshish #65 (1 Nov 2026, user 'D')
//  v2: v1 ka hisaab CHART ki candles par tha (Daily = sirf 2003 se, 4H = 2022
//  se; NDX ki tareekh VIX se na mili = 5 trade) - GHALAT. Ab baqi scripts ki
//  tarah POORA hisaab har index ke APNE daily data mein (request.security ke
//  andar), VIX usi ke andar (nested request) = chart / TF ka asar nahi.
//
//  "Darr ka paimana": Connors & Alvarez 2008, "Short Term Trading Strategies
//  That Work" - VIX Stretches. Index par girawat-khareed ka khandaan (IBS
//  jaisa), magar signal VIX (darr) se. TRADE NAHI - sirf naap.
//
//  QAWAID (har index ki DAILY candle, sirf BAND candle):
//   1) Index close > SMA200 (upar ka rukh).
//   2) CBOE:VIX 3 din lagatar apne SMA10 se >= 5% upar band.
//   3) Dono = us din index ke close par BUY. Sirf BUY, ek index ek position.
//   4) Band: index RSI(2) close > 65 (us close par). Hifazat SL 3 x ATR14
//      = 1R (candle ke andar, gap = open). Band / SL wale din nayi nahi.
//   5) Kharcha 0.01% har taraf + swap 3%/saal har raat (calendar din) -> R.
//   6) DRIFT JAANCH: VIX trade ausat % >= 2 x (aam din ausat % x din).
//
//  PEHLE SE LIKHA QAIDA (docs/purana-haal.md, grep "Koshish #65 qaida"):
//   TALAASH = entry saal < 2019 (VIX 1990 se). PASS = kul >= 100 tr AUR
//   Exp - 2SE > 0 AUR dono index Exp > 0 AUR (index x saal) musbat > 50%
//   AUR VIX % >= 2 x drift.
//   IMTIHAN (2019+) CHHUPA jab tak TALAASH PASS; phir EK dafa: kul >= 30 tr
//   AUR Exp - 2SE > 0 AUR VIX % >= 2 x drift = ASLI PASS.
//
//  CHART: koi bhi DAILY chart (hisaab chart se azad).
// ============================================================================
indicator("JAS VIX v2 (#65)", shorttitle = "JAS VIX v2", overlay = true, max_bars_back = 300)

BUILD = "v2"
TZ = "America/New_York"

grI = "1 · Index + VIX (pehle se chune - badalna mana)"
s0 = input.symbol("SP:SPX", "1 S&P 500", group = grI)
s1 = input.symbol("NASDAQ:NDX", "2 Nasdaq 100", group = grI)
sV = input.symbol("CBOE:VIX", "VIX (darr)", group = grI)

grQ = "2 · Qawaid (mat badlein)"
vixPct  = input.float(5.0, "VIX SMA10 se kitna % upar", step = 0.5, group = grQ, display = display.none)
vixDays = input.int(3, "Kitne din lagatar", minval = 1, maxval = 3, group = grQ, display = display.none)
rsiExit = input.float(65.0, "Band: RSI(2) is se upar", group = grQ, display = display.none)
slMult  = input.float(3.0, "Hifazat SL (x ATR14)", minval = 0.5, step = 0.5, group = grQ, display = display.none)
costPct = input.float(0.01, "Kharcha (% har taraf)", minval = 0, step = 0.005, group = grQ, display = display.none)
swapYr  = input.float(3.0, "Swap (% saal, har raat)", minval = 0, step = 0.5, group = grQ, display = display.none)
splitYr = input.int(2019, "IMTIHAN is saal se (TALAASH is se pehle)", group = grQ, display = display.none)
showIm  = input.bool(false, "IMTIHAN dikhao (SIRF TALAASH PASS ke baad, EK dafa)", group = grQ, display = display.none)

grV = "3 · Table"
tblPos = input.string("Top Right", "Table ki jagah", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grV, display = display.none)


k = 1.0 + vixPct / 100.0

// ============================================================================
//  ENGINE (har index ki APNI daily candles par, sirf BAND candle [1]; VIX usi index ki candles par jura)
// ============================================================================
f_vix() =>
    [_vA, _vmA] = request.security(sV, "D", [close, ta.sma(close, 10)], barmerge.gaps_off, barmerge.lookahead_off)
    _smA  = ta.sma(close, 200)
    _rsA  = ta.rsi(close, 2)
    _atA  = ta.atr(14)
    _o   = open[1]
    _h   = high[1]
    _l   = low[1]
    _c   = close[1]
    _cp  = close[2]
    _sm  = _smA[1]
    _rs  = _rsA[1]
    _at  = _atA[1]
    _t   = time[1]
    _yr  = year(time_close[1])
    _s1  = not na(_vmA[1]) and _vA[1] >= k * _vmA[1]
    _s2  = not na(_vmA[2]) and _vA[2] >= k * _vmA[2]
    _s3  = not na(_vmA[3]) and _vA[3] >= k * _vmA[3]
    _st  = vixDays == 1 ? _s1 : vixDays == 2 ? _s1 and _s2 : _s1 and _s2 and _s3
    var int   _fy  = na
    var int   _vfy = na
    var bool  _in  = false
    var float _e   = na
    var float _r   = na
    var float _sl  = na
    var int   _ey  = na
    var int   _et  = na
    var int   _age = 0
    var int   _nT = 0
    var int   _wT = 0
    var float _sT = 0.0
    var float _qT = 0.0
    var float _pT = 0.0
    var int   _dT = 0
    var int   _aN = 0
    var float _aS = 0.0
    var int   _yNT = 0
    var int   _yPT = 0
    var int   _cyT = na
    var float _csT = 0.0
    var int   _nI = 0
    var int   _wI = 0
    var float _sI = 0.0
    var float _qI = 0.0
    var float _pI = 0.0
    var int   _dI = 0
    var int   _aNI = 0
    var float _aSI = 0.0
    if not na(_c)
        if na(_fy)
            _fy := _yr
        if na(_vfy) and not na(_vA[1])
            _vfy := _yr
        if not na(_cp) and _cp > 0 and not na(_vA[1])
            if _yr < splitYr
                _aN += 1
                _aS += _c / _cp - 1
            else
                _aNI += 1
                _aSI += _c / _cp - 1
        bool  _cl = false
        float _px = na
        if _in
            _age += 1
            if _l <= _sl
                _px := _o < _sl ? _o : _sl
                _cl := true
            else if not na(_rs) and _rs > rsiExit
                _px := _c
                _cl := true
        if _cl
            _nights = math.round((_t - _et) / 86400000.0)
            _rr = ((_px - _e) - costPct / 100.0 * (_e + _px) - swapYr / 100.0 / 365.0 * _nights * _e) / _r
            _pc = _px / _e - 1
            if _ey < splitYr
                _nT += 1
                _sT += _rr
                _qT += _rr * _rr
                _pT += _pc
                _dT += _age
                _wT += _rr > 0 ? 1 : 0
                if na(_cyT) or _ey != _cyT
                    if not na(_cyT)
                        _yNT += 1
                        _yPT += _csT > 0 ? 1 : 0
                    _cyT := _ey
                    _csT := 0.0
                _csT += _rr
            else
                _nI += 1
                _sI += _rr
                _qI += _rr * _rr
                _pI += _pc
                _dI += _age
                _wI += _rr > 0 ? 1 : 0
            _in := false
        if not _in and not _cl and _st and not na(_sm) and _c > _sm and not na(_at) and _at > 0
            _in  := true
            _e   := _c
            _r   := slMult * _at
            _sl  := _c - _r
            _ey  := _yr
            _et  := _t
            _age := 0
    _yN = _yNT + (na(_cyT) ? 0 : 1)
    _yP = _yPT + (not na(_cyT) and _csT > 0 ? 1 : 0)
    [_nT, _wT, _sT, _qT, _pT, _dT, _aN, _aS, _yN, _yP, _nI, _wI, _sI, _qI, _pI, _dI, _aNI, _aSI, _fy, _vfy]

f_req(_s) => request.security(_s, "D", f_vix(), barmerge.gaps_off, barmerge.lookahead_off)

[nT0, wT0, sT0, qT0, pT0, dT0, aN0, aS0, yN0, yP0, nI0, wI0, sI0, qI0, pI0, dI0, aNI0, aSI0, fy0, vf0] = f_req(s0)
[nT1, wT1, sT1, qT1, pT1, dT1, aN1, aS1, yN1, yP1, nI1, wI1, sI1, qI1, pI1, dI1, aNI1, aSI1, fy1, vf1] = f_req(s1)

// ============================================================================
//  TABLE (safaid)
// ============================================================================
f_pos(_p) => _p == "Top Left" ? position.top_left : _p == "Bottom Right" ? position.bottom_right : _p == "Bottom Left" ? position.bottom_left : position.top_right

f_exp(_n, _s) => _n > 0 ? _s / _n : 0.0
f_se(_n, _s, _q) =>
    _m = _n > 0 ? _s / _n : 0.0
    _n > 1 ? math.sqrt(math.max((_q - _n * _m * _m) / (_n - 1), 0.0)) / math.sqrt(_n) : 0.0
f_dr(float _aS, int _aN, int _d) => _aN > 0 ? _aS / _aN * _d : 0.0

var table tb = table.new(f_pos(tblPos), 8, 11, bgcolor = color.white, border_color = color.new(#9e9e9e, 0), border_width = 1)
fg  = color.new(#111111, 0)
cUp = color.new(#0a8f5a, 0)
cDn = color.new(#d32f2f, 0)
cHd = color.new(#1a237e, 0)

f_cell(int _c, int _r, string _s, color _col) =>
    table.cell(tb, _c, _r, _s, text_color = _col, text_size = size.small)

f_p(float _x) => str.tostring(100.0 * _x, "+0.000;-0.000") + "%"

f_row(int _r, string _nm, int _n, int _w, float _s, float _q, float _ip, float _dr, string _yr) =>
    _e  = f_exp(_n, _s)
    _se = f_se(_n, _s, _q)
    f_cell(0, _r, _nm, fg)
    f_cell(1, _r, str.tostring(_n), fg)
    f_cell(2, _r, str.tostring(_n > 0 ? 100.0 * _w / _n : 0.0, "#") + "%", fg)
    f_cell(3, _r, f_p(_ip), _ip >= 2 * _dr ? cUp : cDn)
    f_cell(4, _r, f_p(_dr), fg)
    f_cell(5, _r, str.tostring(_e, "+0.000;-0.000"), _e > 0 ? cUp : cDn)
    f_cell(6, _r, str.tostring(_e - 2 * _se, "+0.000;-0.000"), _e - 2 * _se > 0 ? cUp : cDn)
    f_cell(7, _r, _yr, fg)

if barstate.islast
    dr0 = f_dr(aS0, aN0, dT0)
    dr1 = f_dr(aS1, aN1, dT1)
    f_cell(0, 0, "JAS VIX " + BUILD + "  (#65)  -  VIX 3 din SMA10 se 5% upar + index > SMA200 (SPX + NDX)", cHd)
    table.merge_cells(tb, 0, 0, 7, 0)
    f_cell(0, 1, "TALAASH (shuru - " + str.tostring(splitYr - 1) + ")", cHd)
    f_cell(1, 1, "Trade", cHd)
    f_cell(2, 1, "Jeet", cHd)
    f_cell(3, 1, "VIX trade ausat", cHd)
    f_cell(4, 1, "Aam tezi (drift)", cHd)
    f_cell(5, 1, "Har trade (R)", cHd)
    f_cell(6, 1, "Exp - 2SE", cHd)
    f_cell(7, 1, "Saal + / kul", cHd)
    f_row(2, "S&P 500  (VIX ke saath " + str.tostring(vf0) + " se)", nT0, wT0, sT0, qT0, nT0 > 0 ? pT0 / nT0 : 0.0, nT0 > 0 ? dr0 / nT0 : 0.0, str.tostring(yP0) + " / " + str.tostring(yN0))
    f_row(3, "Nasdaq 100  (VIX ke saath " + str.tostring(vf1) + " se)", nT1, wT1, sT1, qT1, nT1 > 0 ? pT1 / nT1 : 0.0, nT1 > 0 ? dr1 / nT1 : 0.0, str.tostring(yP1) + " / " + str.tostring(yN1))
    nK = nT0 + nT1
    sK = sT0 + sT1
    qK = qT0 + qT1
    ipK = nK > 0 ? (pT0 + pT1) / nK : 0.0
    drK = nK > 0 ? (dr0 + dr1) / nK : 0.0
    f_row(4, "KUL", nK, wT0 + wT1, sK, qK, ipK, drK, str.tostring(yP0 + yP1) + " / " + str.tostring(yN0 + yN1))
    eK  = f_exp(nK, sK)
    seK = f_se(nK, sK, qK)
    cells = yN0 + yN1
    okT = nK >= 100 and eK - 2 * seK > 0 and f_exp(nT0, sT0) > 0 and f_exp(nT1, sT1) > 0 and cells > 0 and (yP0 + yP1) * 2 > cells and ipK >= 2 * drK
    f_cell(0, 5, okT ? "TALAASH PASS  -> IMTIHAN khol sakte hain" : "TALAASH FAIL  -> IMTIHAN band", okT ? cUp : cDn)
    table.merge_cells(tb, 0, 5, 7, 5)
    if showIm
        f_cell(0, 6, "IMTIHAN (" + str.tostring(splitYr) + " - aaj)", cHd)
        table.merge_cells(tb, 0, 6, 7, 6)
        di0 = f_dr(aSI0, aNI0, dI0)
        di1 = f_dr(aSI1, aNI1, dI1)
        f_row(7, "S&P 500", nI0, wI0, sI0, qI0, nI0 > 0 ? pI0 / nI0 : 0.0, nI0 > 0 ? di0 / nI0 : 0.0, "-")
        f_row(8, "Nasdaq 100", nI1, wI1, sI1, qI1, nI1 > 0 ? pI1 / nI1 : 0.0, nI1 > 0 ? di1 / nI1 : 0.0, "-")
        nIK = nI0 + nI1
        sIK = sI0 + sI1
        qIK = qI0 + qI1
        ipI = nIK > 0 ? (pI0 + pI1) / nIK : 0.0
        drI = nIK > 0 ? (di0 + di1) / nIK : 0.0
        f_row(9, "KUL", nIK, wI0 + wI1, sIK, qIK, ipI, drI, "-")
        eI  = f_exp(nIK, sIK)
        seI = f_se(nIK, sIK, qIK)
        okI = nIK >= 30 and eI - 2 * seI > 0 and ipI >= 2 * drI
        f_cell(0, 10, okI ? "IMTIHAN PASS = ASLI PASS" : "IMTIHAN FAIL = idea band", okI ? cUp : cDn)
        table.merge_cells(tb, 0, 10, 7, 10)
    else
        f_cell(0, 6, "IMTIHAN " + str.tostring(splitYr) + "+ CHHUPA (TALAASH PASS ke baad, EK dafa)", fg)
        table.merge_cells(tb, 0, 6, 7, 6)
