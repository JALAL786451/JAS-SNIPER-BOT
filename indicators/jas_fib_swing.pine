//@version=6
//=====================================================================
//  Jas Fib Swing  |  JAS      BUILD f4   (18 Oct 2026)
//  Aakhri 1H swing (high -> low ya low -> high) par Fib levels.
//  f2: (1) repaint band - sirf band (confirmed) 1H candle ka pivot,
//      (2) choti swing badi swing ko nahi kaatti (sirf naya extreme),
//      (3) Swing High / Swing Low lakeer, (4) OTE box par BUY/SELL zone
//      likha, swing toot jaye to box grey "TOOT GAYA".
//  f3: TradingView Long/Short jaisa trade box - price entry level chhoye to
//      BUY/SELL, SL swing ke bahar, TP extension par; TP HIT / SL HIT likhta hai.
//      Har leg par sirf 1 trade, ek waqt 1 trade. Ginti table (setting, BAND).
//  f4: SL / TP ki doori (points) dabbe par, sirf aakhri 3 trade box, ginti
//      table chalu: TP / SL kitni dafa aur kitne points, Net, Kul R, khuli trade.
//=====================================================================
indicator("Jas Fib Swing f4", overlay = true, max_lines_count = 100, max_labels_count = 300, max_boxes_count = 300)

// ================= INPUTS =================
srcTF       = input.timeframe("60", "Swing timeframe (1H)")
pivotLen    = input.int(5, "Pivot length (dono taraf ki bars)", minval = 2)
extendRight = input.bool(false, "Lines ko right tak extend karein")
showOTE     = input.bool(true, "OTE zone dikhayein (0.618 - 0.786)")
showSwing   = input.bool(true, "Swing High / Swing Low lakeer dikhayein")

grpR    = "Retracement levels (pullback)"
show382 = input.bool(true,  "0.382", group = grpR, inline = "r1")
col382  = input.color(color.gray,   "", group = grpR, inline = "r1")
show500 = input.bool(true,  "0.5",   group = grpR, inline = "r2")
col500  = input.color(color.yellow, "", group = grpR, inline = "r2")
show618 = input.bool(true,  "0.618", group = grpR, inline = "r3")
col618  = input.color(color.orange, "", group = grpR, inline = "r3")
show786 = input.bool(true,  "0.786", group = grpR, inline = "r4")
col786  = input.color(color.orange, "", group = grpR, inline = "r4")

grpE     = "Extension levels (target)"
show1272 = input.bool(true,  "1.272", group = grpE, inline = "e1")
col1272  = input.color(color.green, "", group = grpE, inline = "e1")
show1618 = input.bool(true,  "1.618", group = grpE, inline = "e2")
col1618  = input.color(color.lime,  "", group = grpE, inline = "e2")
show2618 = input.bool(false, "2.618", group = grpE, inline = "e3")
col2618  = input.color(color.teal,  "", group = grpE, inline = "e3")

grpT      = "Trade box (SL / TP)"
showTrade = input.bool(true, "Trade box dikhayein (Long/Short tool jaisa)", group = grpT)
entryLvl  = input.string("0.618", "Entry level", options = ["0.5", "0.618", "0.705", "0.786"], group = grpT)
tpMode    = input.string("1.272", "TP (target)", options = ["Swing (0)", "1.272", "1.618"], group = grpT)
slBufPct  = input.float(5.0, "SL swing se kitna bahar (% swing)", minval = 0.0, step = 1.0, group = grpT)
maxTrades = input.int(3, "Kitne aakhri trade box dikhayein", minval = 1, maxval = 50, group = grpT)
showStats = input.bool(true, "Ginti table (TP / SL kitne, kitne points)", group = grpT)

// ================= 1H PIVOTS (repaint nahi) =================
// [1] + lookahead_on = pichhli BAND 1H candle ki value; chalti candle ka pivot nahi.
pivotPack() =>
    ph = ta.pivothigh(high, pivotLen, pivotLen)
    pl = ta.pivotlow(low, pivotLen, pivotLen)
    [ph[1], na(ph[1]) ? na : time[pivotLen + 1], pl[1], na(pl[1]) ? na : time[pivotLen + 1]]

[hPiv, hPivT, lPiv, lPivT] = request.security(syminfo.tickerid, srcTF, pivotPack(), lookahead = barmerge.lookahead_on)

// ================= LEG TRACKING =================
var int   lastHighT  = na
var int   lastLowT   = na
var float legStartP  = na
var int   legStartT  = na
var float legEndP    = na
var int   legEndT    = na
var int   legEndType = 0   // 1 = aakhri pivot high (BUY leg, upar gaya), -1 = aakhri pivot low (SELL leg, neeche gaya)

newHigh = not na(hPivT) and (na(lastHighT) or hPivT != lastHighT)
newLow  = not na(lPivT) and (na(lastLowT) or lPivT != lastLowT)
if newHigh
    lastHighT := hPivT
if newLow
    lastLowT := lPivT

bool legChanged = false
if newHigh or newLow
    // dono ek saath aayein to pehle purana pivot, phir naya
    bool highFirst = newHigh and (not newLow or hPivT <= lPivT)
    for k = 0 to 1
        bool doHigh = k == 0 ? highFirst : not highFirst
        bool active = doHigh ? newHigh : newLow
        if active
            int   nType = doHigh ? 1 : -1
            float nP    = doHigh ? hPiv : lPiv
            int   nT    = doHigh ? hPivT : lPivT
            if nType == legEndType
                // wahi taraf ka doosra pivot: sirf naya extreme leg ko barhata hai
                if (nType == 1 and nP > legEndP) or (nType == -1 and nP < legEndP)
                    legEndP    := nP
                    legEndT    := nT
                    legChanged := true
            else
                if not na(legEndP)
                    legStartP := legEndP
                    legStartT := legEndT
                legEndP    := nP
                legEndT    := nT
                legEndType := nType
                legChanged := true

// ================= DRAWING =================
var line[]  fibLines  = array.new<line>()
var label[] fibLabels = array.new<label>()
var box     oteBox    = na
var float   oteTop    = na
var float   oteBot    = na
var float   swingHi   = na
var float   swingLo   = na
var int     curDir    = 0

clearAll() =>
    if array.size(fibLines) > 0
        for i = 0 to array.size(fibLines) - 1
            line.delete(array.get(fibLines, i))
        array.clear(fibLines)
    if array.size(fibLabels) > 0
        for i = 0 to array.size(fibLabels) - 1
            label.delete(array.get(fibLabels, i))
        array.clear(fibLabels)

drawLevel(float p, color c, string txt, int leftT, string st) =>
    array.push(fibLines, line.new(x1 = leftT, y1 = p, x2 = time, y2 = p, xloc = xloc.bar_time, extend = extendRight ? extend.right : extend.none, color = c, width = 1, style = st))
    array.push(fibLabels, label.new(x = time, y = p, text = txt + "  " + str.tostring(p, format.mintick), xloc = xloc.bar_time, style = label.style_label_left, textcolor = c, color = color.new(color.black, 100), size = size.small))

if legChanged and not na(legStartP) and not na(legEndP)
    clearAll()
    box.delete(oteBox)
    oteBox := na
    float hiP    = math.max(legStartP, legEndP)
    float loP    = math.min(legStartP, legEndP)
    float R      = hiP - loP
    int   legDir = legEndType
    int   leftT  = math.min(legStartT, legEndT)
    float rA     = legDir == 1 ? hiP : loP   // retracement isi point se naapa jata hai
    float eA     = legDir == 1 ? loP : hiP   // extension (target) isi point se naapa jata hai
    swingHi := hiP
    swingLo := loP
    curDir  := legDir

    if showSwing
        drawLevel(hiP, color.red,   "Swing High", leftT, line.style_solid)
        drawLevel(loP, color.green, "Swing Low",  leftT, line.style_solid)
    if show382
        drawLevel(rA - legDir * 0.382 * R, col382, "0.382", leftT, line.style_dashed)
    if show500
        drawLevel(rA - legDir * 0.5 * R, col500, "0.5", leftT, line.style_dashed)
    if show618
        drawLevel(rA - legDir * 0.618 * R, col618, "0.618", leftT, line.style_dashed)
    if show786
        drawLevel(rA - legDir * 0.786 * R, col786, "0.786", leftT, line.style_dashed)
    if show1272
        drawLevel(eA + legDir * 1.272 * R, col1272, "1.272 target", leftT, line.style_dashed)
    if show1618
        drawLevel(eA + legDir * 1.618 * R, col1618, "1.618 target", leftT, line.style_dashed)
    if show2618
        drawLevel(eA + legDir * 2.618 * R, col2618, "2.618 target", leftT, line.style_dashed)

    float p618 = rA - legDir * 0.618 * R
    float p786 = rA - legDir * 0.786 * R
    oteTop := math.max(p618, p786)
    oteBot := math.min(p618, p786)
    if showOTE
        string zt = legDir == 1 ? "BUY zone (OTE)" : "SELL zone (OTE)"
        oteBox := box.new(left = leftT, top = oteTop, right = time, bottom = oteBot, xloc = xloc.bar_time, border_color = color.new(color.orange, 50), bgcolor = color.new(color.orange, 88), text = zt, text_size = size.small, text_color = color.orange, text_halign = text.align_right)

// Swing toot gayi? BUY leg mein close Swing Low se neeche, SELL leg mein Swing High se upar
broken = (curDir == 1 and close < swingLo) or (curDir == -1 and close > swingHi)
var bool wasBroken = false
if legChanged
    wasBroken := false
if broken and not wasBroken
    wasBroken := true
    if not na(oteBox)
        box.set_bgcolor(oteBox, color.new(color.gray, 85))
        box.set_border_color(oteBox, color.new(color.gray, 50))
        box.set_text_color(oteBox, color.gray)
        box.set_text(oteBox, "TOOT GAYA - naya swing ka intezar")

// Lines, labels aur OTE box ko har bar par current candle tak le jayein
if array.size(fibLines) > 0
    for i = 0 to array.size(fibLines) - 1
        line.set_x2(array.get(fibLines, i), time)
if array.size(fibLabels) > 0
    for i = 0 to array.size(fibLabels) - 1
        label.set_x(array.get(fibLabels, i), time)
if not na(oteBox)
    box.set_right(oteBox, time)

// ================= TRADE BOX (Long/Short tool jaisa) =================
var bool  armed      = false   // is leg par abhi trade nahi hui
var int   tState     = 0       // 0 = koi trade nahi, 1 = trade khuli
var int   tDir       = 0
var float tEntry     = na
var float tSL        = na
var float tTP        = na
var int   tEntryBar  = na
var box   tpBox      = na
var box   slBox      = na
var int   nTP        = 0
var int   nSL        = 0
var float sumR       = 0.0
var float ptsTP      = 0.0     // TP se kul kitne points kamaye
var float ptsSL      = 0.0     // SL se kul kitne points gaye
var box[]   tBoxes   = array.new<box>()
var label[] tLabels  = array.new<label>()

if legChanged
    armed := true

float legR   = swingHi - swingLo
float eK     = str.tonumber(entryLvl)
float tpK    = tpMode == "1.618" ? 1.618 : tpMode == "1.272" ? 1.272 : 1.0
float entryP = curDir == 1 ? swingHi - eK * legR : swingLo + eK * legR
float slP    = curDir == 1 ? swingLo - slBufPct / 100 * legR : swingHi + slBufPct / 100 * legR
float tpP    = curDir == 1 ? swingLo + tpK * legR : swingHi - tpK * legR

bool entryNow = false
bool tpNow    = false
bool slNow    = false

fmt(float v) => str.tostring(v, format.mintick)

// Entry: price entry level ko chhoye (limit order jaisa), leg toota na ho, koi trade khuli na ho
if showTrade and armed and tState == 0 and curDir != 0 and not wasBroken and legR > 0
    bool touch = curDir == 1 ? low <= entryP : high >= entryP
    if touch
        float fill = curDir == 1 ? math.min(open, entryP) : math.max(open, entryP)
        armed := false
        if (curDir == 1 and fill > slP) or (curDir == -1 and fill < slP)
            tState    := 1
            tDir      := curDir
            tEntry    := fill
            tSL       := slP
            tTP       := tpP
            tEntryBar := bar_index
            entryNow  := true
            float tpD = math.abs(tTP - tEntry)
            float slD = math.abs(tEntry - tSL)
            tpBox := box.new(left = time, top = math.max(tEntry, tTP), right = time, bottom = math.min(tEntry, tTP), xloc = xloc.bar_time, border_color = color.new(color.green, 40), bgcolor = color.new(color.green, 80), text = "TP " + fmt(tTP) + "  (+" + fmt(tpD) + ")", text_size = size.small, text_color = color.green)
            slBox := box.new(left = time, top = math.max(tEntry, tSL), right = time, bottom = math.min(tEntry, tSL), xloc = xloc.bar_time, border_color = color.new(color.red, 40), bgcolor = color.new(color.red, 80), text = "SL " + fmt(tSL) + "  (-" + fmt(slD) + ")", text_size = size.small, text_color = color.red)
            array.push(tBoxes, tpBox)
            array.push(tBoxes, slBox)
            array.push(tLabels, label.new(x = time, y = tEntry, text = (tDir == 1 ? "BUY " : "SELL ") + fmt(tEntry) + "  R:R " + str.tostring(tpD / slD, "#.0"), xloc = xloc.bar_time, style = label.style_label_right, textcolor = color.white, color = tDir == 1 ? color.new(color.green, 20) : color.new(color.red, 20), size = size.small))
            // sirf aakhri maxTrades trade chart par; purane mita do (ginti mein rehte hain)
            while array.size(tLabels) > maxTrades
                label.delete(array.shift(tLabels))
                box.delete(array.shift(tBoxes))
                box.delete(array.shift(tBoxes))

// Khuli trade: SL pehle check (ek hi candle mein dono = SL, ehtiyat). Entry wali candle par TP nahi ginte.
if tState == 1
    bool hitSL = tDir == 1 ? low <= tSL : high >= tSL
    bool hitTP = bar_index > tEntryBar and (tDir == 1 ? high >= tTP : low <= tTP)
    box.set_right(tpBox, time)
    box.set_right(slBox, time)
    float slD = math.abs(tEntry - tSL)
    float tpD = math.abs(tTP - tEntry)
    if hitSL
        slNow  := true
        tState := 0
        nSL    += 1
        sumR   -= 1.0
        ptsSL  += slD
        box.set_text(slBox, "SL HIT  -" + fmt(slD) + "  (-1R)")
        box.set_bgcolor(slBox, color.new(color.red, 60))
    else if hitTP
        tpNow  := true
        tState := 0
        nTP    += 1
        sumR   += tpD / slD
        ptsTP  += tpD
        box.set_text(tpBox, "TP HIT  +" + fmt(tpD) + "  (+" + str.tostring(tpD / slD, "#.0") + "R)")
        box.set_bgcolor(tpBox, color.new(color.green, 60))

var table stats = na
if showStats and barstate.islast
    if na(stats)
        stats := table.new(position.top_right, 2, 7, bgcolor = color.new(color.black, 20), border_width = 1)
    int   nAll = nTP + nSL
    float net  = ptsTP - ptsSL
    color w    = color.white
    table.cell(stats, 0, 0, "Band trades", text_color = w, text_size = size.small)
    table.cell(stats, 1, 0, str.tostring(nAll), text_color = w, text_size = size.small)
    table.cell(stats, 0, 1, "TP hit", text_color = color.lime, text_size = size.small)
    table.cell(stats, 1, 1, str.tostring(nTP) + " dafa  +" + fmt(ptsTP), text_color = color.lime, text_size = size.small)
    table.cell(stats, 0, 2, "SL hit", text_color = color.red, text_size = size.small)
    table.cell(stats, 1, 2, str.tostring(nSL) + " dafa  -" + fmt(ptsSL), text_color = color.red, text_size = size.small)
    table.cell(stats, 0, 3, "Jeet %", text_color = w, text_size = size.small)
    table.cell(stats, 1, 3, nAll > 0 ? str.tostring(100.0 * nTP / nAll, "#") + "%" : "-", text_color = w, text_size = size.small)
    table.cell(stats, 0, 4, "Net points", text_color = w, text_size = size.small)
    table.cell(stats, 1, 4, (net >= 0 ? "+" : "") + fmt(net), text_color = net >= 0 ? color.lime : color.red, text_size = size.small)
    table.cell(stats, 0, 5, "Kul R", text_color = w, text_size = size.small)
    table.cell(stats, 1, 5, str.tostring(sumR, "#.0"), text_color = sumR >= 0 ? color.lime : color.red, text_size = size.small)
    table.cell(stats, 0, 6, "Khuli trade", text_color = w, text_size = size.small)
    table.cell(stats, 1, 6, tState == 1 ? (tDir == 1 ? "BUY " : "SELL ") + fmt(tEntry) + "  SL " + fmt(tSL) + "  TP " + fmt(tTP) : "koi nahi", text_color = w, text_size = size.small)

// ================= ALERT =================
inOTE = not na(oteTop) and not wasBroken and close <= oteTop and close >= oteBot
alertcondition(inOTE and not inOTE[1], title = "Price OTE zone mein", message = "Price OTE zone (0.618 - 0.786) mein aa gayi")
alertcondition(entryNow, title = "Trade entry", message = "Fib trade entry - SL/TP box dekhein")
alertcondition(tpNow, title = "TP hit", message = "Fib trade TP hit")
alertcondition(slNow, title = "SL hit", message = "Fib trade SL hit")
