//@version=6
// ============================================================================
//  JAS ICHIMOKU RADAR  (build i1, Pine v6)  —  Ichimoku 9 market, sirf naap
//
//  13 Oct 2026 - naye test qaide ki KOSHISH #7 (user 'D'). TRADE NAHI.
//  Kitaab: Goichi Hosoda, Ichimoku Kinko Hyo (Japan, 1969). Number kitaab
//  ke: 9 / 26 / 52 (tune NAHI kiye).
//  Tokri: Tide Radar r3 wale wahi 9 market (chunna MANA).
//
//  QAIDE (1D, sirf band candle, ek waqt mein ek trade har market):
//   BUY  = close badal (Span A/B, 26 aage) ke UPAR + Tenkan > Kijun +
//          Chikou: close > 26 candle pehle ka close.   SELL = ulta.
//   Bahar = close Kijun ke paar (us din ke close par), ya SL chhua.
//   SL = 2 ATR(14) entry se, fixed = 1R. Kharcha 0.005% har taraf. Swap nahi.
//   Kijun wale exit ke din nayi entry nahi (Kachhua jaisa).
//
//  PEHLE SE LIKHA QAIDA (naap se PEHLE, badalna mana):
//   TALAASH = entry saal < 2019. PASS = (a) 9 ka ausat Exp > 0, (b) >= 6/9
//   musbat, (c) MILA (sab trades) Exp - 2SE > 0.
//   IMTIHAN (2019+) CHHUPA jab tak TALAASH PASS; phir ausat > 0 AUR >= 5/9
//   musbat AUR kul >= 30 = ASLI PASS.
//   KACHHUA SAATH % = TALAASH ki Ichimoku entries mein se kitni us din hui
//   jab Kachhua (Tide 1) usi rukh mein khula tha. Sirf maloomat: zyada
//   (> ~70%) = naya kam, Kachhue ki copy.
// ============================================================================
indicator("JAS Ichimoku Radar — 9 market naap", shorttitle = "JAS Ichimoku Radar", overlay = true, max_bars_back = 300)

BUILD = "i1"

grM = "1 · Tokri (Tide Radar wali - badalna mana)"
s0 = input.symbol("OANDA:XAUUSD", "1", group = grM)
s1 = input.symbol("OANDA:XAGUSD", "2", group = grM)
s2 = input.symbol("OANDA:EURUSD", "3", group = grM)
s3 = input.symbol("OANDA:GBPUSD", "4", group = grM)
s4 = input.symbol("OANDA:AUDUSD", "5", group = grM)
s5 = input.symbol("OANDA:USDJPY", "6", group = grM)
s6 = input.symbol("OANDA:USDCHF", "7", group = grM)
s7 = input.symbol("OANDA:SPX500USD", "8", group = grM)
s8 = input.symbol("COINBASE:BTCUSD", "9", group = grM)

grI = "2 · Ichimoku (kitaab ke number - mat badlein)"
tenLen  = input.int(9, "Tenkan", minval = 2, group = grI, display = display.none)
kijLen  = input.int(26, "Kijun (aur badal/Chikou ka faasla)", minval = 2, group = grI, display = display.none)
sbLen   = input.int(52, "Span B", minval = 2, group = grI, display = display.none)
slMult  = input.float(2.0, "SL (x ATR) = 1R", minval = 0.5, step = 0.1, group = grI, display = display.none)

grQ = "3 · Kachhua (moqable ke liye - Tide 1 ke qaide, mat badlein)"
entryLen  = input.int(10, "Naali", minval = 3, maxval = 200, group = grQ, display = display.none)
exitLen   = input.int(5, "SL sarakna", minval = 2, maxval = 100, group = grQ, display = display.none)
atrLen    = input.int(14, "ATR length", minval = 2, group = grQ, display = display.none)
atrMult   = input.float(2.0, "Kachhua SL (x ATR)", minval = 0.5, step = 0.1, group = grQ, display = display.none)
emaFLen   = input.int(50, "Rukh EMA fast", minval = 2, group = grQ, display = display.none)
emaSLen   = input.int(200, "Rukh EMA slow", minval = 3, group = grQ, display = display.none)
minAtrPct = input.float(0.25, "Kam az kam ATR %", minval = 0, step = 0.05, group = grQ, display = display.none)
costPct   = input.float(0.005, "Kharcha (% har taraf)", minval = 0, step = 0.001, group = grQ, display = display.none)
splitYr   = input.int(2019, "IMTIHAN is saal se", group = grQ, display = display.none)

grV = "4 · Table"
tblPos = input.string("Top Right", "Table ki jagah", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grV, display = display.none)

f_mid(_n) => (ta.highest(high, _n) + ta.lowest(low, _n)) / 2.0

// ============================================================================
//  ENGINE - Ichimoku + Kachhua (sirf us ka rukh, moqable ke liye)
// ============================================================================
f_ichi() =>
    _atrA = ta.atr(atrLen)
    _tkA  = f_mid(tenLen)
    _kjA  = f_mid(kijLen)
    _saA  = (_tkA + _kjA) / 2.0
    _sbA  = f_mid(sbLen)
    _hbA  = ta.highest(high, entryLen)
    _lbA  = ta.lowest(low, entryLen)
    _hxA  = ta.highest(high, exitLen)
    _lxA  = ta.lowest(low, exitLen)
    _efA  = ta.ema(close, emaFLen)
    _esA  = ta.ema(close, emaSLen)
    // band candle = [1]
    _o  = open[1]
    _h  = high[1]
    _l  = low[1]
    _c  = close[1]
    _a  = _atrA[1]
    _tk = _tkA[1]
    _kj = _kjA[1]
    _ct = math.max(_saA[1 + kijLen], _sbA[1 + kijLen])
    _cb = math.min(_saA[1 + kijLen], _sbA[1 + kijLen])
    _cp = close[1 + kijLen]
    _hb = _hbA[2]
    _lb = _lbA[2]
    _hx = _hxA[2]
    _lx = _lxA[2]
    _ef = _efA[2]
    _es = _esA[2]
    _yr = year(time_close[1])
    var int   _fy  = na
    // --- Kachhua (Tide 1, radar r3 jaisa) - sirf _td rukh chahiye ---
    var int   _td  = 0
    var float _tsl = na
    bool _tAt = false
    if na(_fy) and not na(_c)
        _fy := _yr
    if _td != 0 and not na(_c)
        bool _tcl = false
        if _td == 1 and _l <= _tsl
            _tcl := true
        else if _td == -1 and _h >= _tsl
            _tcl := true
        if not _tcl and not na(_ef) and not na(_es) and (_td == 1 ? _ef < _es : _ef > _es)
            _tcl := true
            _tAt := true
        if not _tcl
            _tsl := _td == 1 ? math.max(_tsl, nz(_lx, _tsl)) : math.min(_tsl, nz(_hx, _tsl))
            if (_td == 1 and _c <= _tsl) or (_td == -1 and _c >= _tsl)
                _tcl := true
                _tAt := true
        if _tcl
            _td := 0
    if _td == 0 and not _tAt and not na(_c) and not na(_a) and _a > 0 and not na(_hb) and not na(_lb)
        _bull = not na(_ef) and not na(_es) and _ef > _es
        _bear = not na(_ef) and not na(_es) and _ef < _es
        _live = _a / _c * 100.0 >= minAtrPct
        if _c > _hb and _bull and _live
            _td  := 1
            _tsl := _c - atrMult * _a
        else if _c < _lb and _bear and _live
            _td  := -1
            _tsl := _c + atrMult * _a
    // --- Ichimoku ---
    var int   _d   = 0
    var float _e   = na
    var float _r   = na
    var float _sl  = na
    var int   _ey  = na
    var int   _nT  = 0
    var int   _wT  = 0
    var float _sT  = 0.0
    var float _qT  = 0.0
    var int   _oT  = 0
    var int   _nI  = 0
    var int   _wI  = 0
    var float _sI  = 0.0
    var float _qI  = 0.0
    bool  _cl  = false
    bool  _atC = false
    float _px  = na
    if _d != 0 and not na(_c)
        if _d == 1 and _l <= _sl
            _px := _o < _sl ? _o : _sl
            _cl := true
        else if _d == -1 and _h >= _sl
            _px := _o > _sl ? _o : _sl
            _cl := true
        if not _cl and not na(_kj) and (_d == 1 ? _c < _kj : _c > _kj)
            _px  := _c
            _cl  := true
            _atC := true
    if _cl
        _rr = _d * (_px - _e) / _r - 2.0 * costPct / 100.0 * _e / _r
        if _ey < splitYr
            _nT += 1
            _sT += _rr
            _qT += _rr * _rr
            _wT += _rr > 0 ? 1 : 0
        else
            _nI += 1
            _sI += _rr
            _qI += _rr * _rr
            _wI += _rr > 0 ? 1 : 0
        _d := 0
    if _d == 0 and not _atC and not na(_c) and not na(_a) and _a > 0 and not na(_tk) and not na(_kj) and not na(_ct) and not na(_cp)
        _buy  = _c > _ct and _tk > _kj and _c > _cp
        _sell = _c < _cb and _tk < _kj and _c < _cp
        if _buy or _sell
            _d  := _buy ? 1 : -1
            _e  := _c
            _r  := slMult * _a
            _sl := _c - _d * _r
            _ey := _yr
            if _yr < splitYr and _td == _d
                _oT += 1
    // 11 cheezein x 9 request = 99 (hadd 127)
    [_nT, _wT, _sT, _qT, _nI, _wI, _sI, _qI, _fy, _d, _oT]

f_req(_s) => request.security(_s, "D", f_ichi(), barmerge.gaps_off, barmerge.lookahead_off)

[nT0, wT0, sT0, qT0, nI0, wI0, sI0, qI0, fy0, d0, oT0] = f_req(s0)
[nT1, wT1, sT1, qT1, nI1, wI1, sI1, qI1, fy1, d1, oT1] = f_req(s1)
[nT2, wT2, sT2, qT2, nI2, wI2, sI2, qI2, fy2, d2, oT2] = f_req(s2)
[nT3, wT3, sT3, qT3, nI3, wI3, sI3, qI3, fy3, d3, oT3] = f_req(s3)
[nT4, wT4, sT4, qT4, nI4, wI4, sI4, qI4, fy4, d4, oT4] = f_req(s4)
[nT5, wT5, sT5, qT5, nI5, wI5, sI5, qI5, fy5, d5, oT5] = f_req(s5)
[nT6, wT6, sT6, qT6, nI6, wI6, sI6, qI6, fy6, d6, oT6] = f_req(s6)
[nT7, wT7, sT7, qT7, nI7, wI7, sI7, qI7, fy7, d7, oT7] = f_req(s7)
[nT8, wT8, sT8, qT8, nI8, wI8, sI8, qI8, fy8, d8, oT8] = f_req(s8)
// ============================================================================
//  HELPERS + TABLE
// ============================================================================
f_pos(_s) => _s == "Top Left" ? position.top_left : _s == "Top Right" ? position.top_right : _s == "Bottom Left" ? position.bottom_left : position.bottom_right
f_r3(_x) => na(_x) ? "-" : (_x > 0 ? "+" : "") + str.tostring(_x, "0.000")
f_se2(_n, _s, _q) => _n > 1 ? 2.0 * math.sqrt(math.max(_q - _s * _s / _n, 0.0) / (_n - 1)) / math.sqrt(_n) : na
f_nm(_s) =>
    _p = str.split(_s, ":")
    array.size(_p) > 1 ? array.get(_p, 1) : _s

var table rt = table.new(f_pos(tblPos), 7, 18, border_width = 1, border_color = color.new(color.gray, 70))
cOK = color.new(#1B5E20, 0)
cNO = color.new(#B71C1C, 0)
cBK = color.black
cGY = color.new(#78909C, 0)
cHD = color.new(color.silver, 40)
cBG = color.new(color.white, 10)

f_c(_col, _row, _t, _tc) =>
    table.cell(rt, _col, _row, _t, bgcolor = cBG, text_color = _tc, text_size = size.small, text_halign = text.align_left)

f_hd(_col, _t) =>
    table.cell(rt, _col, 1, _t, bgcolor = cHD, text_color = cBK, text_size = size.small, text_halign = text.align_left)

// TALAASH row; IMTIHAN column sirf _show par (TALAASH PASS). Wapas: Exp T
f_row(_row, _sym, _nT, _wT, _sT, _qT, _nI, _wI, _sI, _qI, _fy, _d, _oT, _show) =>
    _okT = not na(_nT) and _nT > 0
    _exT = _okT ? _sT / _nT : na
    _seT = _okT ? f_se2(_nT, _sT, _qT) : na
    _okI = not na(_nI) and _nI > 0
    _exI = _okI ? _sI / _nI : na
    f_c(0, _row, f_nm(_sym) + (_d == 1 ? " ▲" : _d == -1 ? " ▼" : ""), cBK)
    f_c(1, _row, na(_fy) ? "data nahi" : str.tostring(_fy), na(_fy) ? cNO : cBK)
    f_c(2, _row, _okT ? str.tostring(_nT) + " · " + str.tostring(100.0 * _wT / _nT, "0") + "%" : "-", cBK)
    f_c(3, _row, _okT ? f_r3(_exT) + " (± " + (na(_seT) ? "-" : str.tostring(_seT, "0.000")) + ")" : "-", na(_exT) ? cBK : _exT > 0 ? cOK : cNO)
    f_c(4, _row, na(_exT) or na(_seT) ? "-" : f_r3(_exT - _seT), na(_exT) or na(_seT) ? cBK : _exT - _seT > 0 ? cOK : cNO)
    f_c(5, _row, _okT ? str.tostring(100.0 * nz(_oT) / _nT, "0") + "%" : "-", cBK)
    if _show
        f_c(6, _row, _okI ? str.tostring(_nI) + " · " + f_r3(_exI) : "-", na(_exI) ? cBK : _exI > 0 ? cOK : cNO)
    else
        f_c(6, _row, "chhupa", cGY)
    _exT

if barstate.islast
    table.clear(rt, 0, 0, 6, 17)
    table.cell(rt, 0, 0, "JAS ICHIMOKU RADAR " + BUILD + " · Hosoda 9/26/52 · 1D · 9 market · sirf naap · KOSHISH #7", bgcolor = cHD, text_color = cBK, text_size = size.small)
    table.merge_cells(rt, 0, 0, 6, 0)
    if not (timeframe.isdaily and timeframe.multiplier == 1)
        f_c(0, 1, "TF ghalat: sirf 1D chart par", cNO)
    else
        // pehle TALAASH ka faisla (sab trades mila kar bhi)
        _nA = array.from(nT0, nT1, nT2, nT3, nT4, nT5, nT6, nT7, nT8)
        _sA = array.from(sT0, sT1, sT2, sT3, sT4, sT5, sT6, sT7, sT8)
        _qA = array.from(qT0, qT1, qT2, qT3, qT4, qT5, qT6, qT7, qT8)
        _oA = array.from(oT0, oT1, oT2, oT3, oT4, oT5, oT6, oT7, oT8)
        _nB = array.from(nI0, nI1, nI2, nI3, nI4, nI5, nI6, nI7, nI8)
        _sB = array.from(sI0, sI1, sI2, sI3, sI4, sI5, sI6, sI7, sI8)
        int   _k    = 0
        int   _pos  = 0
        float _sum  = 0.0
        int   _N    = 0
        float _S    = 0.0
        float _Q    = 0.0
        int   _O    = 0
        int   _kI   = 0
        int   _posI = 0
        float _sumI = 0.0
        int   _NI   = 0
        for _i = 0 to 8
            _n = array.get(_nA, _i)
            if not na(_n) and _n > 0
                _e = array.get(_sA, _i) / _n
                _k   += 1
                _sum += _e
                _pos += _e > 0 ? 1 : 0
                _N   += _n
                _S   += array.get(_sA, _i)
                _Q   += array.get(_qA, _i)
                _O   += nz(array.get(_oA, _i))
            _ni = array.get(_nB, _i)
            if not na(_ni) and _ni > 0
                _ei = array.get(_sB, _i) / _ni
                _kI   += 1
                _sumI += _ei
                _posI += _ei > 0 ? 1 : 0
                _NI   += _ni
        _avg  = _k > 0 ? _sum / _k : na
        _exM  = _N > 0 ? _S / _N : na
        _seM  = f_se2(_N, _S, _Q)
        _need = math.ceil(6.0 * _k / 9.0)
        _ca   = not na(_avg) and _avg > 0
        _cb   = _k > 0 and _pos >= _need
        _cc   = not na(_exM) and not na(_seM) and _exM - _seM > 0
        _pass = _ca and _cb and _cc
        _avgI  = _kI > 0 ? _sumI / _kI : na
        _needI = math.ceil(5.0 * _kI / 9.0)
        _passI = _pass and not na(_avgI) and _avgI > 0 and _posI >= _needI and _NI >= 30
        f_hd(0, "Market")
        f_hd(1, "Data se")
        f_hd(2, "TALAASH (<" + str.tostring(splitYr) + ") trades · jeet")
        f_hd(3, "TALAASH Exp R (± 2SE)")
        f_hd(4, "Exp - 2SE")
        f_hd(5, "Kachhua saath")
        f_hd(6, "IMTIHAN (" + str.tostring(splitYr) + "+) trades · Exp")
        f_row(2, s0, nT0, wT0, sT0, qT0, nI0, wI0, sI0, qI0, fy0, d0, oT0, _pass)
        f_row(3, s1, nT1, wT1, sT1, qT1, nI1, wI1, sI1, qI1, fy1, d1, oT1, _pass)
        f_row(4, s2, nT2, wT2, sT2, qT2, nI2, wI2, sI2, qI2, fy2, d2, oT2, _pass)
        f_row(5, s3, nT3, wT3, sT3, qT3, nI3, wI3, sI3, qI3, fy3, d3, oT3, _pass)
        f_row(6, s4, nT4, wT4, sT4, qT4, nI4, wI4, sI4, qI4, fy4, d4, oT4, _pass)
        f_row(7, s5, nT5, wT5, sT5, qT5, nI5, wI5, sI5, qI5, fy5, d5, oT5, _pass)
        f_row(8, s6, nT6, wT6, sT6, qT6, nI6, wI6, sI6, qI6, fy6, d6, oT6, _pass)
        f_row(9, s7, nT7, wT7, sT7, qT7, nI7, wI7, sI7, qI7, fy7, d7, oT7, _pass)
        f_row(10, s8, nT8, wT8, sT8, qT8, nI8, wI8, sI8, qI8, fy8, d8, oT8, _pass)
        f_c(0, 11, "TALAASH TOKRI (" + str.tostring(_k) + ")", cBK)
        table.merge_cells(rt, 0, 11, 1, 11)
        f_c(2, 11, "ausat Exp " + f_r3(_avg) + "R · musbat " + str.tostring(_pos) + "/" + str.tostring(_k) + " · MILA " + str.tostring(_N) + " trades Exp " + f_r3(_exM) + " (± " + (na(_seM) ? "-" : str.tostring(_seM, "0.000")) + ") · Exp - 2SE " + f_r3(na(_exM) or na(_seM) ? na : _exM - _seM) + " · Kachhua saath " + (_N > 0 ? str.tostring(100.0 * _O / _N, "0") + "%" : "-"), _pass ? cOK : cNO)
        table.merge_cells(rt, 2, 11, 6, 11)
        f_c(0, 12, "QAIDA TALAASH", _pass ? cOK : cNO)
        table.merge_cells(rt, 0, 12, 1, 12)
        f_c(2, 12, (_pass ? "PASS -> IMTIHAN khul gaya" : "FAIL - Ichimoku band, settings NAHI badalni") + " · ausat > 0 " + (_ca ? "✓" : "✗") + " · musbat >= " + str.tostring(_need) + " " + (_cb ? "✓" : "✗") + " · mila Exp - 2SE > 0 " + (_cc ? "✓" : "✗"), _pass ? cOK : cNO)
        table.merge_cells(rt, 2, 12, 6, 12)
        f_c(0, 13, "QAIDA IMTIHAN", _passI ? cOK : _pass ? cNO : cGY)
        table.merge_cells(rt, 0, 13, 1, 13)
        f_c(2, 13, not _pass ? "chhupa (TALAASH PASS ho to khulega)" : "ausat " + f_r3(_avgI) + "R · musbat " + str.tostring(_posI) + "/" + str.tostring(_kI) + " · kul " + str.tostring(_NI) + " · " + (_passI ? "ASLI PASS -> Kachhua saath % dekh kar demo ka qaida" : "FAIL - naye data par nahi tika"), _passI ? cOK : _pass ? cNO : cGY)
        table.merge_cells(rt, 2, 13, 6, 13)
        f_c(0, 14, "Note", cNO)
        table.merge_cells(rt, 0, 14, 1, 14)
        f_c(2, 14, "Sirf naap, trade nahi. Band candle par. Swap nahi. ▲/▼ = abhi khuli Ichimoku trade. Kachhua saath = TALAASH entries jab Kachhua usi rukh mein khula. Market chunna MANA.", cNO)
        table.merge_cells(rt, 2, 15, 6, 14)
