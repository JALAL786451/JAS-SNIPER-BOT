//@version=5
// ============================================================================
//  TREND RIBBON + LEVELS  —  v1.1
//
//  v1.0 sirf khoobsoorat drawing thi: rukh aur lakeerein, magar koi faisla
//  nahi. v1.1 mein teen cheezein add hui hain jo isay padhne laayak banati
//  hain:
//
//   1. ROLE — har level ab red (resistance, price ke UPAR) ya green (support,
//      price ke NEECHE) hai, aur break hone par rang palat jaata hai. Tuti hui
//      resistance khud-ba-khud support ban jaati hai, jaisa chart par hota hai.
//
//   2. KAHAN SE KAHAN TAK — engine sabse qareebi R aur S dhoondta hai aur
//      screen par ek box khinchta hai: entry se target tak, SL alag lakeer.
//      RR bhi likha hota hai. Yani "sell 4360 se 4336 tak" saaf nazar aata hai.
//
//   3. KYUN / KYUN NAHI — panel Roman Urdu mein wajah likhta hai. Agar trade
//      nahi ban rahi to wajah likhta hai (price kisi level se door hai, ya RR
//      chhota hai, ya ribbon flat hai). Yehi cheez v1.0 mein bilkul nahi thi.
//
//  Ribbon ka kaam sirf ek hai: BIAS. Level ka kaam: ENTRY aur TARGET. Dono
//  milte hain to hi idea banta hai.
//
//  Note: ye SMC Coach Pro v2 ki jagah nahi hai. Wo zones, BOS/CHOCH, score aur
//  virtual tracking karta hai. Ye halka, nazar wala tool hai.
// ============================================================================
indicator("Trend Ribbon + Levels", overlay = true, max_lines_count = 500, max_boxes_count = 100, max_labels_count = 100, dynamic_requests = true)

// ---------------------------------------------------------------- inputs
gRib = "1 · Trend lines (bias)"
showRibbon = input.bool(true,  "Trend dikhao", group = gRib)
dispMode   = input.string("MA lines (2)", "Shakl", options = ["MA lines (2)","MA lines (sab)","Ribbon (shaded)"], group = gRib)
fastLen    = input.int(20, "2-line: fast MA", minval = 1, group = gRib)
slowLen    = input.int(50, "2-line: slow MA", minval = 2, group = gRib)
colFast    = input.color(color.new(#00bcd4, 0), "Fast", inline = "mc", group = gRib)
colSlow    = input.color(color.new(#e040fb, 0), "Slow", inline = "mc", group = gRib)
maWidth    = input.int(2, "MA line width", minval = 1, maxval = 4, group = gRib)
maType     = input.string("EMA", "MA type", options = ["EMA","SMA","WMA","RMA","HMA"], group = gRib)
ribSrc     = input.source(close, "Source", group = gRib)
lenMode    = input.string("Bars (tay shuda)", "Length kaise tay ho", options = ["Bars (tay shuda)","Waqt (timeframe se khud badle)"], group = gRib)
baseLen    = input.int(20, "BARS mode: first length", minval = 1, group = gRib)
lenStep    = input.int(10, "BARS mode: length step",  minval = 1, group = gRib)
fastMins   = input.int(20,  "WAQT mode: sabse tez MA (minute)", minval = 1, group = gRib)
slowMins   = input.int(110, "WAQT mode: sabse sust MA (minute)", minval = 2, group = gRib)
ribCount   = input.int(10, "How many MAs", minval = 2, maxval = 10, group = gRib)
colUp      = input.color(color.new(#00c853, 0), "Up",   inline = "rc", group = gRib)
colDn      = input.color(color.new(#d50000, 0), "Down", inline = "rc", group = gRib)
transpIn   = input.int(55, "Fill transparency: inner", minval = 0, maxval = 100, group = gRib)
transpOut  = input.int(88, "Fill transparency: outer", minval = 0, maxval = 100, group = gRib)
showLines  = input.bool(false, "Draw the MA lines themselves", group = gRib)
bandOwnCol = input.bool(true,  "Colour each band by its own pair", group = gRib)

gLvl = "2 · Levels (entry / target)"
showLevels = input.bool(true, "Show levels", group = gLvl)
pvLen      = input.int(15, "Pivot L/R", minval = 1, group = gLvl)
maxLevels  = input.int(16, "Keep last N levels", minval = 2, maxval = 60, group = gLvl)
breakATR   = input.float(0.10, "Break needs close beyond by (x ATR)", minval = 0, step = 0.05, group = gLvl)
showTouch  = input.bool(true, "Label nearest R / S with touch count", group = gLvl)
hideFarATR = input.float(15, "Itne ATR se door wale levels chhupao (0 = sab dikhao)", minval = 0, step = 1, group = gLvl)
colRes     = input.color(color.new(#d50000, 0), "Resistance (upar)", group = gLvl)
colSup     = input.color(color.new(#00c853, 0), "Support (neeche)",  group = gLvl)
lvlWidth   = input.int(2, "Line width", minval = 1, maxval = 5, group = gLvl)

gFvg = "3 · FVG (khaali jagah)"
showFVG    = input.bool(true, "Show fair value gaps", group = gFvg)
fvgMinATR  = input.float(0.25, "Ignore gaps smaller than (x ATR)", minval = 0, step = 0.05, group = gFvg)
fvgKeep    = input.int(6, "Keep last N gaps", minval = 1, maxval = 20, group = gFvg)
// FVG ka apna rang. Pehle ye levels aur idea box jaisa hi green/red tha, is
// liye teen alag cheezein ek jaisi dikhti thin. Ab neela/narangi, aur box par
// naam bhi likha hota hai.
colFvgUp   = input.color(color.new(#00b0ff, 0), "FVG upar wala", inline = "fc", group = gFvg)
colFvgDn   = input.color(color.new(#ff9100, 0), "FVG neeche wala", inline = "fc", group = gFvg)
fvgLabel   = input.bool(true, "Box par \"FVG\" likho", group = gFvg)

gLeg = "5 · Legend (sab timeframes)"
showLegend = input.bool(true, "Legend dikhao", group = gLeg)
legendPos  = input.string("Top Left", "Legend jagah", options = ["Top Right","Top Left","Bottom Right","Bottom Left"], group = gLeg)
legMinSep  = input.float(0.05, "Trend maana jaye jab MA faasla (x ATR) se zyada ho", minval = 0, step = 0.01, group = gLeg)
legMomoLive = input.bool(true, "FVG/LGB live candle se (chart jaisa)", group = gLeg)
legClosed  = input.bool(true, "Trend closed candle se (repaint nahi)", group = gLeg)

gIdea = "4 · Trade idea"
showIdea   = input.bool(true, "Show the idea box + panel", group = gIdea)
nearATR    = input.float(0.80, "Level ke qareeb = (x ATR) ke andar", minval = 0.1, step = 0.1, group = gIdea)
stopATR    = input.float(0.60, "SL level se aage (x ATR)", minval = 0.1, step = 0.1, group = gIdea)
minRR      = input.float(1.5,  "Minimum RR", minval = 0.2, step = 0.1, group = gIdea)
useAtrTgt  = input.bool(true, "Target ke liye level na ho to ATR se target banao", group = gIdea)
atrTgtMult = input.float(2.0, "ATR target (x ATR)", minval = 0.5, step = 0.5, group = gIdea)
ideaBars   = input.int(40, "Idea box kitne bars aage", minval = 5, group = gIdea)
markHist   = input.bool(false, "Purane setups par bhi nishaan lagao (sirf seekhne ke liye)", group = gIdea)
panelPos   = input.string("Bottom Right", "Panel", options = ["Top Right","Top Left","Bottom Right","Bottom Left"], group = gIdea)
panelFont  = input.string("Normal", "Panel font", options = ["Small","Normal","Large","Huge"], group = gIdea)

// ---------------------------------------------------------------- helpers
f_pos(s) => s == "Top Left" ? position.top_left : s == "Top Right" ? position.top_right : s == "Bottom Left" ? position.bottom_left : position.bottom_right
f_px(x)  => str.tostring(x, format.mintick)
f_fs(s)  => s == "Small" ? size.small : s == "Normal" ? size.normal : s == "Large" ? size.large : size.huge
f_dur(_mins) => _mins < 60 ? str.tostring(math.round(_mins)) + "m" : _mins < 1440 ? str.tostring(math.floor(_mins / 60)) + "h " + str.tostring(math.round(_mins % 60)) + "m" : str.tostring(math.floor(_mins / 1440)) + "d " + str.tostring(math.floor((_mins % 1440) / 60)) + "h"
f_fsLbl(s) => s == "Small" ? size.tiny : s == "Normal" ? size.small : s == "Large" ? size.normal : size.large
PF  = f_fs(panelFont)
PFL = f_fsLbl(panelFont)
atr = ta.atr(14)

// ---------------------------------------------------------------- ribbon
f_ma(_t, _src, _len) => _t == "SMA" ? ta.sma(_src, _len) : _t == "WMA" ? ta.wma(_src, _len) : _t == "RMA" ? ta.rma(_src, _len) : _t == "HMA" ? ta.hma(_src, _len) : ta.ema(_src, _len)

// MA ki length "bars" mein hoti hai, aur ek bar ka waqt timeframe se badalta
// hai. Isi liye EMA 20 — 1m par 20 minute, magar 1h par 20 GHANTE naapti hai.
// Do tareeqe, dono yahan mojood hain:
//   BARS  — number wahi rehta hai, naapa gaya waqt TF ke sath badalta hai
//   WAQT  — naapa gaya waqt wahi rehta hai, number TF ke sath khud badalta hai
// WAQT mode mein 1m par 20/110 minute ka matlab 20/110 bars, jabke 5m par
// wahi 4/22 bars ban jaate hain — yani ribbon har chart par ek hi cheez naapti
// hai. (Yehi wo baat hai jo "1m par MA100/200" wale sawal ke peeche hai.)
tfMin = timeframe.in_seconds() / 60.0
f_barsFromMins(_m) => math.max(2, int(math.round(_m / math.max(tfMin, 0.0001))))
useTimeLen = lenMode == "Waqt (timeframe se khud badle)"
useTwo     = dispMode == "MA lines (2)"
// Do-line shakl mein ribbon ki lengths se koi wasta nahi — sirf fast aur slow.
eff2Fast = useTimeLen ? f_barsFromMins(fastMins) : fastLen
eff2Slow = useTimeLen ? math.max(f_barsFromMins(slowMins), eff2Fast + 1) : slowLen
effBase = useTimeLen ? f_barsFromMins(fastMins) : baseLen
effLast = useTimeLen ? math.max(f_barsFromMins(slowMins), effBase + 1) : baseLen + (ribCount - 1) * lenStep
effStep = useTimeLen ? math.max(1, int(math.round((effLast - effBase) / math.max(ribCount - 1, 1)))) : lenStep

// A plot count cannot be a variable in Pine, so all ten exist and the ones
// past ribCount are fed na, which draws nothing and fills nothing.
f_lvlLen(_i) => effBase + _i * effStep
f_on(_i)     => showRibbon and not useTwo and _i < ribCount

m1  = f_on(0) ? f_ma(maType, ribSrc, f_lvlLen(0)) : na
m2  = f_on(1) ? f_ma(maType, ribSrc, f_lvlLen(1)) : na
m3  = f_on(2) ? f_ma(maType, ribSrc, f_lvlLen(2)) : na
m4  = f_on(3) ? f_ma(maType, ribSrc, f_lvlLen(3)) : na
m5  = f_on(4) ? f_ma(maType, ribSrc, f_lvlLen(4)) : na
m6  = f_on(5) ? f_ma(maType, ribSrc, f_lvlLen(5)) : na
m7  = f_on(6) ? f_ma(maType, ribSrc, f_lvlLen(6)) : na
m8  = f_on(7) ? f_ma(maType, ribSrc, f_lvlLen(7)) : na
m9  = f_on(8) ? f_ma(maType, ribSrc, f_lvlLen(8)) : na
m10 = f_on(9) ? f_ma(maType, ribSrc, f_lvlLen(9)) : na

// Do saaf lines — yehi default shakl hai. Rang SMC Coach jaisa hi rakha gaya
// hai (fast aqua, slow fuchsia) taake dono script ek tarah parhi jayein.
maF2 = showRibbon and useTwo ? f_ma(maType, ribSrc, eff2Fast) : na
maS2 = showRibbon and useTwo ? f_ma(maType, ribSrc, eff2Slow) : na
plot(maF2, "MA fast", color = color.new(colFast, 0), linewidth = maWidth)
plot(maS2, "MA slow", color = color.new(colSlow, 0), linewidth = maWidth)

// Slowest MA that is actually switched on — the ribbon's own trend reference.
mSlow = not na(m10) ? m10 : not na(m9) ? m9 : not na(m8) ? m8 : not na(m7) ? m7 : not na(m6) ? m6 : not na(m5) ? m5 : not na(m4) ? m4 : not na(m3) ? m3 : m2

// Bias wahin se aata hai jo shakl chuni gayi hai: do lines, ya ribbon ke
// sabse tez aur sabse sust kinare.
biasFast = useTwo ? maF2 : m1
biasSlow = useTwo ? maS2 : mSlow
ribUp = not na(biasFast) and not na(biasSlow) and biasFast > biasSlow
ribDn = not na(biasFast) and not na(biasSlow) and biasFast < biasSlow
// Faasla patla ho to bias "flat" — is waqt level bounce bharosemand nahi.
ribThin = not na(biasFast) and not na(biasSlow) and math.abs(biasFast - biasSlow) < atr * 0.25
biasTxt = ribThin ? "FLAT" : ribUp ? "UPAR" : ribDn ? "NEECHE" : "-"

f_bandCol(_a, _b, _i) => color.new(bandOwnCol ? (_a > _b ? colUp : colDn) : (ribUp ? colUp : colDn), int(math.round(transpIn + (transpOut - transpIn) * _i / 8.0)))

// Legend chart wali hi MA jodi parhta hai, is liye bar-counts yahan se aate hain.
legFastBars = useTwo ? eff2Fast : effBase
legSlowBars = useTwo ? eff2Slow : effBase + (ribCount - 1) * effStep

showFill = dispMode == "Ribbon (shaded)"
showAll  = dispMode == "MA lines (sab)"
lineCol = (showAll or (showFill and showLines)) ? color.new(ribUp ? colUp : colDn, 25) : color.new(color.gray, 100)
f_fillCol(_a, _b, _i) => showFill ? f_bandCol(_a, _b, _i) : color.new(color.gray, 100)
p1  = plot(m1,  "MA 1",  color = lineCol, linewidth = 1)
p2  = plot(m2,  "MA 2",  color = lineCol, linewidth = 1)
p3  = plot(m3,  "MA 3",  color = lineCol, linewidth = 1)
p4  = plot(m4,  "MA 4",  color = lineCol, linewidth = 1)
p5  = plot(m5,  "MA 5",  color = lineCol, linewidth = 1)
p6  = plot(m6,  "MA 6",  color = lineCol, linewidth = 1)
p7  = plot(m7,  "MA 7",  color = lineCol, linewidth = 1)
p8  = plot(m8,  "MA 8",  color = lineCol, linewidth = 1)
p9  = plot(m9,  "MA 9",  color = lineCol, linewidth = 1)
p10 = plot(m10, "MA 10", color = lineCol, linewidth = 1)

fill(p1, p2,  color = f_fillCol(m1, m2,  0), title = "Band 1")
fill(p2, p3,  color = f_fillCol(m2, m3,  1), title = "Band 2")
fill(p3, p4,  color = f_fillCol(m3, m4,  2), title = "Band 3")
fill(p4, p5,  color = f_fillCol(m4, m5,  3), title = "Band 4")
fill(p5, p6,  color = f_fillCol(m5, m6,  4), title = "Band 5")
fill(p6, p7,  color = f_fillCol(m6, m7,  5), title = "Band 6")
fill(p7, p8,  color = f_fillCol(m7, m8,  6), title = "Band 7")
fill(p8, p9,  color = f_fillCol(m8, m9,  7), title = "Band 8")
fill(p9, p10, color = f_fillCol(m9, m10, 8), title = "Band 9")

// ---------------------------------------------------------------- levels
var line[]  lvLine  = array.new_line()
var float[] lvPrice = array.new_float()
var bool[]  lvIsRes = array.new_bool()
var int[]   lvTouch = array.new_int()

f_lvKill(_i) =>
    line.delete(array.get(lvLine, _i))
    array.remove(lvLine,  _i)
    array.remove(lvPrice, _i)
    array.remove(lvIsRes, _i)
    array.remove(lvTouch, _i)

f_lvAdd(_price) =>
    _x1  = bar_index - pvLen
    _res = _price > close
    _l   = line.new(_x1, _price, bar_index + 1, _price, xloc = xloc.bar_index, color = _res ? colRes : colSup, width = lvlWidth)
    array.push(lvLine,  _l)
    array.push(lvPrice, _price)
    array.push(lvIsRes, _res)
    // Jo swing is level ko banata hai wo khud pehla test hai. Counter 0 se
    // shuru karne par har naya level "x0" dikhata tha, jo ghalat tha.
    array.push(lvTouch, 1)

ph = ta.pivothigh(high, pvLen, pvLen)
pl = ta.pivotlow (low,  pvLen, pvLen)

if showLevels and not na(ph)
    f_lvAdd(ph)
if showLevels and not na(pl)
    f_lvAdd(pl)

// Har bar: lakeer aage barhao, touch ginno, aur role (R/S) price ki position se
// tay karo. Break hone par lakeer marti nahi — uska rang palat jaata hai, kyunke
// tooti hui resistance agli baar support ka kaam karti hai.
if array.size(lvLine) > 0
    for i = array.size(lvLine) - 1 to 0
        _ln  = array.get(lvLine, i)
        _px  = array.get(lvPrice, i)
        _was = array.get(lvIsRes, i)
        line.set_x2(_ln, bar_index + 1)
        _touching     = high >= _px and low <= _px
        _touchingPrev = high[1] >= _px and low[1] <= _px
        if _touching and not _touchingPrev
            array.set(lvTouch, i, array.get(lvTouch, i) + 1)
        _now = _was
        if _was and close > _px + atr * breakATR
            _now := false
        if not _was and close < _px - atr * breakATR
            _now := true
        if _now != _was
            array.set(lvIsRes, i, _now)
        _far = hideFarATR > 0 and math.abs(_px - close) > atr * hideFarATR
        line.set_color(_ln, _far ? color.new(color.gray, 100) : (_now ? colRes : colSup))

while array.size(lvLine) > maxLevels
    f_lvKill(0)

// ---------------------------------------------------------------- FVG
var box[] fvgBox = array.new_box()
gapUp = bar_index > 2 and low > high[2] and (low - high[2]) >= atr * fvgMinATR
gapDn = bar_index > 2 and high < low[2] and (low[2] - high) >= atr * fvgMinATR

if showFVG and gapUp
    array.push(fvgBox, box.new(bar_index - 2, low, bar_index + 1, high[2], xloc = xloc.bar_index, bgcolor = color.new(colFvgUp, 88), border_color = color.new(colFvgUp, 55), text = fvgLabel ? "FVG ↑" : "", text_color = color.new(colFvgUp, 0), text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_center))
if showFVG and gapDn
    array.push(fvgBox, box.new(bar_index - 2, low[2], bar_index + 1, high, xloc = xloc.bar_index, bgcolor = color.new(colFvgDn, 88), border_color = color.new(colFvgDn, 55), text = fvgLabel ? "FVG ↓" : "", text_color = color.new(colFvgDn, 0), text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_center))

// gap bharne par mit jaata hai — khaali gap hi magnet hai, bhara hua nahi
if array.size(fvgBox) > 0
    for i = array.size(fvgBox) - 1 to 0
        _b = array.get(fvgBox, i)
        box.set_right(_b, bar_index + 1)
        _age = bar_index - box.get_left(_b)
        if _age > 2 and low <= box.get_top(_b) and high >= box.get_bottom(_b)
            box.delete(_b)
            array.remove(fvgBox, i)

while array.size(fvgBox) > fvgKeep
    box.delete(array.get(fvgBox, 0))
    array.remove(fvgBox, 0)

// ---------------------------------------------------------------- nearest R / S
var float nearR = na
var float nearS = na
var int   nearRt = 0
var int   nearSt = 0
nearR  := na
nearS  := na
nearRt := 0
nearSt := 0
if array.size(lvPrice) > 0
    for i = 0 to array.size(lvPrice) - 1
        _px = array.get(lvPrice, i)
        _tc = array.get(lvTouch, i)
        if _px > close
            if na(nearR) or _px < nearR
                nearR  := _px
                nearRt := _tc
        if _px < close
            if na(nearS) or _px > nearS
                nearS  := _px
                nearSt := _tc

// Doosra level, nearest ke bhi aage — "agar ye toot gaya to aage kya" ke liye.
var float farR = na
var float farS = na
farR := na
farS := na
if array.size(lvPrice) > 0
    for i = 0 to array.size(lvPrice) - 1
        _px = array.get(lvPrice, i)
        if not na(nearR) and _px > nearR
            if na(farR) or _px < farR
                farR := _px
        if not na(nearS) and _px < nearS
            if na(farS) or _px > farS
                farS := _px

distR = na(nearR) ? na : nearR - close
distS = na(nearS) ? na : close - nearS
atR   = not na(distR) and distR <= atr * nearATR
atS   = not na(distS) and distS <= atr * nearATR
// "Qareeb" aur "level PAR" ek cheez nahi. Qareeb hone par order LIMIT hai —
// us qeemat par abhi sauda nahi ho sakta. Sirf level par khare hone par hi
// market order ka matlab banta hai, warna panel ghalat-fehmi paida karta hai.
onR   = not na(distR) and distR <= atr * 0.15
onS   = not na(distS) and distS <= atr * 0.15

// ---------------------------------------------------------------- the idea
// Do halatein, dono numbers ke sath:
//   ABHI     — price level par hai, trade ab ban rahi hai
//   INTEZAAR — plan tayyar hai magar price abhi level tak nahi pohcha
// Pehle plan banta hai (bias + do level), phir dekha jaata hai ke price level
// par hai ya nahi. Isi liye ab panel khaali nahi rehta: jab trade nahi hai,
// tab bhi likha hota hai ke kis qeemat ka intezaar hai.
// Jab price record ke sabse nichle (ya sabse uoonche) kinare par ho, to target
// ke liye koi level bacha hi nahi hota — aur yehi wo waqt hota hai jab move
// sabse tez hoti hai. Pehle engine yahan chup ho jata tha. Ab target ATR se
// bana leta hai aur panel saaf likhta hai ke ye level nahi, ATR ka andaza hai.
sTgtAtr = useAtrTgt and na(nearS)
bTgtAtr = useAtrTgt and na(nearR)
sTgtPx  = not na(nearS) ? nearS : (sTgtAtr ? close - atr * atrTgtMult : na)
bTgtPx  = not na(nearR) ? nearR : (bTgtAtr ? close + atr * atrTgtMult : na)

planSell = ribDn and not ribThin and not na(nearR) and not na(sTgtPx)
planBuy  = ribUp and not ribThin and not na(nearS) and not na(bTgtPx)

sEntry = planSell ? nearR : na
sStop  = planSell ? nearR + atr * stopATR : na
sTgt   = planSell ? sTgtPx : na
sRR    = planSell and (sStop - sEntry) > 0 ? (sEntry - sTgt) / (sStop - sEntry) : na

bEntry = planBuy ? nearS : na
bStop  = planBuy ? nearS - atr * stopATR : na
bTgt   = planBuy ? bTgtPx : na
bRR    = planBuy and (bEntry - bStop) > 0 ? (bTgt - bEntry) / (bEntry - bStop) : na

sRROK = planSell and not na(sRR) and sRR >= minRR
bRROK = planBuy  and not na(bRR) and bRR >= minRR

sellOK   = sRROK and atR
buyOK    = bRROK and atS
sellWait = sRROK and not atR
buyWait  = bRROK and not atS

plotshape(markHist and sellOK and not sellOK[1] ? high : na, title = "Sell setup", style = shape.triangledown, location = location.absolute, color = colRes, size = size.tiny, text = "S")
plotshape(markHist and buyOK  and not buyOK[1]  ? low  : na, title = "Buy setup",  style = shape.triangleup,   location = location.absolute, color = colSup, size = size.tiny, text = "B")

alertcondition(sellOK and not sellOK[1], "Sell idea", "Trend Ribbon: SELL idea ban gaya")
alertcondition(buyOK  and not buyOK[1],  "Buy idea",  "Trend Ribbon: BUY idea ban gaya")

var box   ideaBox = na
var line  ideaSL  = na
var label ideaLbl = na

if showIdea and barstate.islast
    box.delete(ideaBox)
    line.delete(ideaSL)
    label.delete(ideaLbl)
    ideaBox := na
    ideaSL  := na
    ideaLbl := na
    _live = sellOK or buyOK
    _plan = sellWait or buyWait
    if _live or _plan
        _sell = sellOK or sellWait
        _e    = _sell ? sEntry : bEntry
        _t    = _sell ? sTgt   : bTgt
        _sl   = _sell ? sStop  : bStop
        _rr   = _sell ? sRR    : bRR
        _c    = _sell ? colRes : colSup
        ideaBox := box.new(bar_index, _e, bar_index + ideaBars, _t, xloc = xloc.bar_index, bgcolor = color.new(_c, _live ? 82 : 92), border_color = color.new(_c, _live ? 30 : 55), border_style = _live ? line.style_solid : line.style_dotted)
        ideaSL  := line.new(bar_index, _sl, bar_index + ideaBars, _sl, xloc = xloc.bar_index, color = color.new(_c, _live ? 0 : 40), width = 1, style = line.style_dashed)
        _onLvl = _sell ? onR : onS
        _dist  = _sell ? distR : distS
        _side  = _sell ? "SELL" : "BUY"
        _head  = _live and _onLvl ? _side + " ABHI (market)" : _live ? _side + " LIMIT " + f_px(_e) + "  —  abhi " + f_px(_dist) + " door" : "INTEZAAR — " + _side + " jab price " + f_px(_e) + " par aaye"
        _tgtKind = (_sell ? sTgtAtr : bTgtAtr) ? "  (ATR target — level nahi)" : ""
        _txt  = _head + "\n" + f_px(_e) + "  se  " + f_px(_t) + "  tak" + _tgtKind + "\nSL " + f_px(_sl) + "     RR 1:" + str.tostring(_rr, "#.#")
        ideaLbl := label.new(bar_index + ideaBars, _e, _txt, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(_c, _live ? 10 : 35), textcolor = color.white, size = PFL)

// ---------------------------------------------------------------- panel
var table pTbl = na
if showIdea and barstate.islast
    if na(pTbl)
        pTbl := table.new(f_pos(panelPos), 1, 6, border_width = 1)
    else
        table.clear(pTbl, 0, 0, 0, 5)
    _bg  = color.new(color.white, 90)
    _bg2 = color.new(color.white, 80)
    // Header khud bata deta hai ke ribbon kitna WAQT naap rahi hai — yehi cheez
    // har chart par badal jaati hai aur aksar nazar nahi aati.
    _fastBars = useTwo ? eff2Fast : effBase
    _slowBars = useTwo ? eff2Slow : effBase + (ribCount - 1) * effStep
    _sep = useTwo ? "  /  " : " → "
    _hdr = "TREND + LEVELS  |  " + timeframe.period + "      BIAS: " + biasTxt
    _hdr := _hdr + "\n" + maType + " " + str.tostring(_fastBars) + _sep + str.tostring(_slowBars) + " bars   =   " + f_dur(_fastBars * tfMin) + _sep + f_dur(_slowBars * tfMin)
    // WAQT mode is chart par itna chhota par gaya ke MA be-maani ho gayi — ye
    // chup-chaap nahi hona chahiye, warna ribbon shor dikhane lagti hai.
    if useTimeLen and _fastBars <= 2
        _hdr := _hdr + "\n! Ye waqt is chart ke liye bohot chhota hai — minute barhayein ya BARS mode par jayein"
    table.cell(pTbl, 0, 0, _hdr, bgcolor = _bg2, text_color = color.black, text_size = PF)
    _rTxt = na(nearR) ? "R  —  upar koi pivot nahi (record ka sabse ooncha ilaqa)" : "R  " + f_px(nearR) + "    " + str.tostring(nearRt) + " touch    " + f_px(distR) + " door"
    _sTxt = na(nearS) ? "S  —  neeche koi pivot nahi (record ka sabse nichla ilaqa)" : "S  " + f_px(nearS) + "    " + str.tostring(nearSt) + " touch    " + f_px(distS) + " door"
    table.cell(pTbl, 0, 1, _rTxt, bgcolor = _bg, text_color = colRes, text_size = PF)
    table.cell(pTbl, 0, 2, _sTxt, bgcolor = _bg, text_color = colSup, text_size = PF)

    _idea = "PLAN: abhi koi nahi"
    if sellOK
        _idea := (onR ? "ABHI SELL (market):  " : "SELL LIMIT " + f_px(sEntry) + " par (abhi " + f_px(distR) + " door):  ") + f_px(sEntry) + "  →  " + f_px(sTgt) + "     SL " + f_px(sStop) + "     RR 1:" + str.tostring(sRR, "#.#")
    else if buyOK
        _idea := (onS ? "ABHI BUY (market):  " : "BUY LIMIT " + f_px(bEntry) + " par (abhi " + f_px(distS) + " door):  ") + f_px(bEntry) + "  →  " + f_px(bTgt) + "     SL " + f_px(bStop) + "     RR 1:" + str.tostring(bRR, "#.#")
    else if sellWait
        _idea := "INTEZAAR:  price " + f_px(sEntry) + " tak upar aaye → SELL → " + f_px(sTgt) + "     SL " + f_px(sStop) + "     RR 1:" + str.tostring(sRR, "#.#")
    else if buyWait
        _idea := "INTEZAAR:  price " + f_px(bEntry) + " tak neeche aaye → BUY → " + f_px(bTgt) + "     SL " + f_px(bStop) + "     RR 1:" + str.tostring(bRR, "#.#")
    table.cell(pTbl, 0, 3, _idea, bgcolor = _bg2, text_color = sellOK or sellWait ? colRes : buyOK or buyWait ? colSup : color.black, text_size = PF)

    // agar level toot gaya to agla padaav — dono taraf ke numbers
    // Khaali taraf ka matlab samjhana zaroori hai: level "ghayab" nahi hua, wahan
    // chart ke record mein pivot bana hi nahi. Aise mein ATR ka andaza dete hain.
    _atrDn = f_px(close - atr * atrTgtMult)
    _atrUp = f_px(close + atr * atrTgtMult)
    _brk = ""
    if not na(nearS)
        _brk := _brk + "Agar S " + f_px(nearS) + " toota → " + (na(farS) ? "record mein neeche pivot nahi, ATR andaza " + _atrDn : "agla " + f_px(farS))
    if not na(nearR)
        _brk := (_brk == "" ? "" : _brk + "     |     ") + "Agar R " + f_px(nearR) + " toota → " + (na(farR) ? "record mein upar pivot nahi, ATR andaza " + _atrUp : "agla " + f_px(farR))
    _brk := _brk + "     |     Levels: " + str.tostring(array.size(lvPrice)) + "/" + str.tostring(maxLevels)
    table.cell(pTbl, 0, 4, _brk == "" ? "Koi level nahi bana abhi" : _brk, bgcolor = _bg, text_color = color.black, text_size = PF)

    // wajah — kyun ban rahi hai, ya kyun nahi ban rahi
    _why = ""
    if sellOK
        _why := "Wajah: ribbon NEECHE + price resistance par + neeche support khaali hai."
    else if buyOK
        _why := "Wajah: ribbon UPAR + price support par + upar resistance tak jagah hai."
    else if sellWait
        _why := "Wajah: ribbon NEECHE hai, plan tayyar hai — bas price abhi R se " + f_px(distR) + " door hai. Wahan pohche to sell." + (sTgtAtr ? "  (target level se nahi, ATR se bana hai)" : "")
    else if buyWait
        _why := "Wajah: ribbon UPAR hai, plan tayyar hai — bas price abhi S se " + f_px(distS) + " door hai. Wahan pohche to buy." + (bTgtAtr ? "  (target level se nahi, ATR se bana hai)" : "")
    else
        if ribThin
            _why := _why + "• Ribbon patla hai (bias flat) — abhi kisi taraf bharosa nahi\n"
        if na(nearR) and ribDn
            _why := _why + "• Sell ke liye entry chahiye (R), magar upar koi pivot nahi\n"
        if na(nearS) and ribUp
            _why := _why + "• Buy ke liye entry chahiye (S), magar neeche koi pivot nahi\n"
        if planSell and not sRROK
            _why := _why + "• Sell ka plan tha magar RR 1:" + str.tostring(sRR, "#.#") + " chhota hai (minimum 1:" + str.tostring(minRR, "#.#") + ") — target bohot qareeb hai\n"
        if planBuy and not bRROK
            _why := _why + "• Buy ka plan tha magar RR 1:" + str.tostring(bRR, "#.#") + " chhota hai (minimum 1:" + str.tostring(minRR, "#.#") + ")\n"
        if _why == ""
            _why := "• Bias, level aur RR ek sath align nahi hue\n"
    table.cell(pTbl, 0, 5, _why, bgcolor = _bg, text_color = color.black, text_size = PF, text_halign = text.align_left)

// ---------------------------------------------------------------- nearest R/S labels
var label labR = na
var label labS = na
if showTouch and barstate.islast
    label.delete(labR)
    label.delete(labS)
    labR := na
    labS := na
    if not na(nearR)
        labR := label.new(bar_index + 2, nearR, "R " + f_px(nearR) + "   x" + str.tostring(nearRt), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(colRes, 20), textcolor = color.white, size = PFL)
    if not na(nearS)
        labS := label.new(bar_index + 2, nearS, "S " + f_px(nearS) + "   x" + str.tostring(nearSt), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(colSup, 20), textcolor = color.white, size = PFL)

// ============================================================================
//  LEGEND — har timeframe ek nazar mein
//
//  Har TF ke liye alag alag request.security bhejna mehanga aur dohrav hai, is
//  liye SMC Coach wala hi tareeqa: saara jawab ek hi number mein pack karke
//  aata hai (trend + pressure + 8 bits), aur yahan khol liya jaata hai.
//
//  Ahem: yahan wahi tareef istemal hoti hai jo chart par lagi hai — wahi MA
//  jodi, wahi Pivot L/R, wahi FVG size filter. Is liye legend ki row aur chart
//  ka nishaan kabhi ek doosre ko jhutla nahi sakte.
// ============================================================================
var int SCALE_TREND = 1000000
var int SCALE_PRESS = 1000

f_labTF(_tf) => _tf == "W" ? "1W" : _tf == "D" ? "1D" : _tf == "240" ? "4H" : _tf == "180" ? "3H" : _tf == "120" ? "2H" : _tf == "60" ? "1H" : _tf == "30" ? "30m" : _tf == "15" ? "15m" : _tf == "5" ? "5m" : _tf == "1" ? "1m" : _tf
f_lbl(_st)  => _st == 1 ? "UT" : _st == -1 ? "DT" : "NT"
f_hasBit(_n, _k) => int(math.floor(_n / math.pow(2, _k))) % 2 == 1

f_decode(_v) =>
    _x     = nz(_v, 2 * SCALE_TREND + 50 * SCALE_PRESS)
    _stVal = int(math.floor(_x / SCALE_TREND))
    _rem   = _x - _stVal * SCALE_TREND
    _press = int(math.floor(_rem / SCALE_PRESS))
    _bits  = _rem - _press * SCALE_PRESS
    _st    = _stVal == 3 ? 1 : _stVal == 1 ? -1 : 0
    // bits: 0 up-gate, 1 down-gate, 2 FVG UP, 3 FVG DN, 4 LGB UP, 5 LGB DN, 6 DZ, 7 SZ
    [_st, f_hasBit(_bits, 0), f_hasBit(_bits, 1), f_hasBit(_bits, 2), f_hasBit(_bits, 3), f_hasBit(_bits, 4), f_hasBit(_bits, 5), f_hasBit(_bits, 6), f_hasBit(_bits, 7), _press]

// Ye poora hisab us TF ke apne context mein chalta hai, is liye [1] ka matlab
// "us TF ki pichhli candle" hota hai — chart ki nahi.
f_pack(_useClosed, _momoLive) =>
    _tfm  = timeframe.in_seconds() / 60.0
    _lf   = useTimeLen ? math.max(2, int(math.round(fastMins / math.max(_tfm, 0.0001)))) : legFastBars
    _ls   = useTimeLen ? math.max(_lf + 1, int(math.round(slowMins / math.max(_tfm, 0.0001)))) : legSlowBars
    _f    = f_ma(maType, close, _lf)
    _s    = f_ma(maType, close, _ls)
    _a    = ta.atr(14)
    _phv  = ta.pivothigh(high, pvLen, pvLen)
    _plv  = ta.pivotlow (low,  pvLen, pvLen)
    _swHi = ta.valuewhen(not na(_phv), _phv, 0)
    _swLo = ta.valuewhen(not na(_plv), _plv, 0)
    _fx   = _useClosed ? _f[1] : _f
    _sx   = _useClosed ? _s[1] : _s
    _ax   = _useClosed ? _a[1] : _a
    _f1   = _useClosed ? nz(_f[2], _fx) : nz(_f[1], _fx)
    _s1   = _useClosed ? nz(_s[2], _sx) : nz(_s[1], _sx)
    _mc   = _momoLive ? false : _useClosed
    _hm   = _mc ? high[1]  : high
    _lm   = _mc ? low[1]   : low
    _cm   = _mc ? close[1] : close
    _h2   = _mc ? high[3]  : high[2]
    _l2   = _mc ? low[3]   : low[2]
    _swHiM = _mc ? _swHi[1] : _swHi
    _swLoM = _mc ? _swLo[1] : _swLo
    _den   = math.max(nz(_ax, 1.0), math.max(syminfo.mintick, 1e-10))
    _sepOK = math.abs(_fx - _sx) >= _den * legMinSep
    _up    = nz(_fx > _sx) and _sepOK
    _dn    = nz(_fx < _sx) and _sepOK
    _st    = _up ? 1 : _dn ? -1 : 0
    _has2  = not na(_h2) and not na(_l2)
    _fvgUp = _has2 and (_lm > _h2) and (_lm - _h2) >= _den * fvgMinATR
    _fvgDn = _has2 and (_hm < _l2) and (_l2 - _hm) >= _den * fvgMinATR
    // LGB = pichhla confirmed swing toot kar wapas andar band hona
    _lgbUp = not na(_swHiM) and _hm > _swHiM and _cm < _swHiM
    _lgbDn = not na(_swLoM) and _lm < _swLoM and _cm > _swLoM
    _dzT   = not na(_swLoM) and _lm <= _swLoM
    _szT   = not na(_swHiM) and _hm >= _swHiM
    _dist  = (_fx - _sx) / _den
    _slope = ((_fx - _f1) - (_sx - _s1)) / _den
    _pBuy  = int(math.round(100 * (1.0 / (1.0 + math.exp(-(0.75 * _dist + 0.25 * _slope))))))
    _bits  = (_up ? 1 : 0) + (_dn ? 2 : 0) + (_fvgUp ? 4 : 0) + (_fvgDn ? 8 : 0) +
              (_lgbUp ? 16 : 0) + (_lgbDn ? 32 : 0) + (_dzT ? 64 : 0) + (_szT ? 128 : 0)
    (_st + 2) * SCALE_TREND + _pBuy * SCALE_PRESS + _bits

var table legTbl = na
if showLegend and barstate.islast
    string[] tfs = array.from("1","5","15","30","60","120","180","240","D","W")
    if na(legTbl)
        legTbl := table.new(f_pos(legendPos), 1, 1 + array.size(tfs), border_width = 1)
    else
        table.clear(legTbl, 0, 0, 0, array.size(tfs))
    _bgh = color.new(color.white, 80)
    _bgr = color.new(color.white, 90)
    // WAQT mode mein har TF apne bars khud nikalta hai, is liye header bars ke
    // bajaye minute likhta hai — warna ye sirf chart wale TF ka sach hota.
    _hd  = useTimeLen ? "LEGEND  |  " + maType + " " + str.tostring(fastMins) + "/" + str.tostring(slowMins) + " min" : "LEGEND  |  " + maType + " " + str.tostring(legFastBars) + "/" + str.tostring(legSlowBars) + " bars"
    _hd := _hd + "   |   FVG/LGB " + (legMomoLive ? "live" : "closed") + "   |   trend " + (legClosed ? "closed" : "live")
    table.cell(legTbl, 0, 0, _hd, bgcolor = _bgh, text_color = color.black, text_size = PF)
    for i = 0 to array.size(tfs) - 1
        _tf  = array.get(tfs, i)
        _pk  = request.security(syminfo.tickerid, _tf, f_pack(legClosed, legMomoLive), barmerge.gaps_off, barmerge.lookahead_off)
        [lst, lup, ldn, lfu, lfd, llu, lld, ldz, lsz, lpb] = f_decode(_pk)
        _row = f_labTF(_tf) + "  " + f_lbl(lst)
        _row := _row + "   B " + str.tostring(lpb) + "% / S " + str.tostring(100 - lpb) + "%"
        _row := _row + "   " + (ldz ? "DZ" : lsz ? "SZ" : "--")
        _row := _row + "   FVG " + (lfu ? "UP" : lfd ? "DN" : "-")
        _row := _row + "   LGB " + (llu ? "UP" : lld ? "DN" : "-")
        _col = lup ? color.new(colSup, 0) : ldn ? color.new(colRes, 0) : color.new(color.gray, 0)
        table.cell(legTbl, 0, 1 + i, _row, bgcolor = _bgr, text_color = _col, text_size = PF)
