[nT7, wT7, sT7, qT7, pT7, dT7, aN7, aS7, yN7, yP7, n27, nI7, wI7, sI7, qI7, pI7, dI7, aNI7, aSI7, fy7] = f_req(s7)
[nT8, wT8, sT8, qT8, pT8, dT8, aN8, aS8, yN8, yP8, n28, nI8, wI8, sI8, qI8, pI8, dI8, aNI8, aSI8, fy8] = f_req(s8)
[nT9, wT9, sT9, qT9, pT9, dT9, aN9, aS9, yN9, yP9, n29, nI9, wI9, sI9, qI9, pI9, dI9, aNI9, aSI9, fy9] = f_req(s9)
[nT10, wT10, sT10, qT10, pT10, dT10, aN10, aS10, yN10, yP10, n210, nI10, wI10, sI10, qI10, pI10, dI10, aNI10, aSI10, fy10] = f_req(s10)
