//@version=6
// ============================================================================
//  JAS IBS SHARES  (build s1, Pine v6)  -  Koshish #61 (1 Nov 2026, user 'D')
//
//  User: "mahine mein 50+ trade, imaandari aur sakht test". Hamara sab se
//  mazboot qaida (IBS #15, US index par ASLI PASS) bilkul wahi, magar 30 bare
//  Amreeki SHARES par (Dow Jones 30, Nov 2024 wali list - pehle se chuni,
//  nateeja dekh kar NAHI). Saboot: Connors-Alvarez 2008, Jegadeesh 1990,
//  Lehmann 1990 (chhoti girawat ke baad wapsi). TRADE NAHI - sirf naap.
//
//  QAWAID (har share ki apni DAILY candles, sirf BAND candle [1]):
//   1) IBS = (close - low) / (high - low). BUY: IBS < 0.2 AUR close > SMA200,
//      din ke close par. Band: IBS > 0.8 ya 5 din (close), SL 3 x ATR14 = 1R
//      (gap = open). Band / SL wale din nayi nahi. Har share ek position.
//   2) Kharcha 0.03% har taraf + swap 5%/saal har raat (calendar din) -> R.
//   3) DRIFT JAANCH (survivorship): ye shares AAJ bare hain = barhte rahe.
//      IBS trade ka ausat % >= 2 x "aam tezi" (us share ka aam din ka ausat %
//      x trade ke din) - warna faida sirf achhe share chunne ka.
//
//  PEHLE SE LIKHA QAIDA (docs/purana-haal.md, grep "Koshish #61 qaida"):
//   TALAASH = entry saal < 2019. PASS = kul >= 100 tr AUR Exp - 2SE > 0 AUR
//   (>= 10 tr wale) shares mein >= 70% Exp > 0 AUR (share x saal) musbat > 50%
//   AUR IBS ausat % >= 2 x drift.
//   IMTIHAN (2019+) CHHUPA jab tak TALAASH PASS; phir EK dafa: kul >= 30 tr
//   AUR Exp - 2SE > 0 AUR IBS ausat % >= 2 x drift = ASLI PASS.
//
//  CHART: koi bhi DAILY chart (misaal SP:SPX). 30 share request.security se.
// ============================================================================
indicator("JAS IBS Shares s1 (#61)", shorttitle = "JAS IBS SHARES s1", overlay = true, max_bars_back = 300)

BUILD = "s1"

grI = "1 · 30 share (Dow 30, pehle se chune - badalna mana)"
