grQ = "2 · Qawaid (mat badlein)"
ibsLo    = input.float(0.2, "BUY: IBS is se kam", step = 0.05, group = grQ, display = display.none)
ibsHi    = input.float(0.8, "Band: IBS is se zyada", step = 0.05, group = grQ, display = display.none)
maxDays  = input.int(5, "Zyada se zyada din", minval = 1, group = grQ, display = display.none)
trendLen = input.int(200, "Rukh SMA", minval = 10, group = grQ, display = display.none)
atrLen   = input.int(14, "ATR length", minval = 2, group = grQ, display = display.none)
slMult   = input.float(3.0, "SL (x ATR)", minval = 0.5, step = 0.5, group = grQ, display = display.none)
costPct  = input.float(0.03, "Kharcha (% har taraf)", minval = 0, step = 0.005, group = grQ, display = display.none)
swapYr   = input.float(5.0, "Swap (% saal, har raat)", minval = 0, step = 0.5, group = grQ, display = display.none)
splitYr  = input.int(2019, "IMTIHAN is saal se (TALAASH is se pehle)", group = grQ, display = display.none)
showIm   = input.bool(false, "IMTIHAN dikhao (SIRF TALAASH PASS ke baad, EK dafa)", group = grQ, display = display.none)

grV = "3 · Table"
tblPos  = input.string("Top Right", "Table ki jagah", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grV, display = display.none)
showAll = input.bool(false, "Har share ki line (TALAASH)", group = grV, display = display.none)

// ============================================================================
//  ENGINE (har share ki apni daily candles par, sirf BAND candle)
// ============================================================================
f_ibs() =>
    _atrA = ta.atr(atrLen)
    _smA  = ta.sma(close, trendLen)
    _o   = open[1]
    _h   = high[1]
    _l   = low[1]
    _c   = close[1]
    _cp  = close[2]
    _a   = _atrA[1]
    _sm  = _smA[1]
    _t   = time[1]
    _yr  = year(time_close[1])
    _ibs = not na(_h) and _h > _l ? (_c - _l) / (_h - _l) : na
    var int   _fy  = na
    var bool  _in  = false
    var float _e   = na
    var float _r   = na
    var float _sl  = na
    var int   _ey  = na
    var int   _et  = na
    var int   _age = 0
    var int   _nT = 0
    var int   _wT = 0
    var float _sT = 0.0
    var float _qT = 0.0
    var float _pT = 0.0
    var int   _dT = 0
    var int   _aN = 0
    var float _aS = 0.0
    var int   _yNT = 0
    var int   _yPT = 0
    var int   _cyT = na
    var float _csT = 0.0
    var int   _n2 = 0
    var int   _nI = 0
    var int   _wI = 0
    var float _sI = 0.0
    var float _qI = 0.0
    var float _pI = 0.0
    var int   _dI = 0
    var int   _aNI = 0
    var float _aSI = 0.0
    if not na(_c)
        if na(_fy)
            _fy := _yr
        if not na(_cp) and _cp > 0
            if _yr < splitYr
                _aN += 1
                _aS += _c / _cp - 1
            else
                _aNI += 1
                _aSI += _c / _cp - 1
        bool  _cl = false
        float _px = na
        if _in
            _age += 1
            if _l <= _sl
                _px := _o < _sl ? _o : _sl
                _cl := true
            else if (not na(_ibs) and _ibs > ibsHi) or _age >= maxDays
                _px := _c
                _cl := true
        if _cl
            _nights = math.round((_t - _et) / 86400000.0)
            _rr = ((_px - _e) - costPct / 100.0 * (_e + _px) - swapYr / 100.0 / 365.0 * _nights * _e) / _r
            _pc = _px / _e - 1
            if _ey < splitYr
                _nT += 1
                _sT += _rr
                _qT += _rr * _rr
                _pT += _pc
                _dT += _age
                _wT += _rr > 0 ? 1 : 0
                _n2 += _ey >= 2000 ? 1 : 0
                if na(_cyT) or _ey != _cyT
                    if not na(_cyT)
                        _yNT += 1
                        _yPT += _csT > 0 ? 1 : 0
                    _cyT := _ey
                    _csT := 0.0
                _csT += _rr
            else
                _nI += 1
                _sI += _rr
                _qI += _rr * _rr
                _pI += _pc
                _dI += _age
                _wI += _rr > 0 ? 1 : 0
            _in := false
        if not _in and not _cl and not na(_ibs) and not na(_sm) and not na(_a) and _a > 0 and _ibs < ibsLo and _c > _sm
            _in  := true
            _e   := _c
            _r   := slMult * _a
            _sl  := _c - _r
            _ey  := _yr
            _et  := _t
            _age := 0
    _yN = _yNT + (na(_cyT) ? 0 : 1)
    _yP = _yPT + (not na(_cyT) and _csT > 0 ? 1 : 0)
    [_nT, _wT, _sT, _qT, _pT, _dT, _aN, _aS, _yN, _yP, _n2, _nI, _wI, _sI, _qI, _pI, _dI, _aNI, _aSI, _fy]

f_req(_s) => request.security(_s, "D", f_ibs(), barmerge.gaps_off, barmerge.lookahead_off)

[nT0, wT0, sT0, qT0, pT0, dT0, aN0, aS0, yN0, yP0, n20, nI0, wI0, sI0, qI0, pI0, dI0, aNI0, aSI0, fy0] = f_req(s0)
[nT1, wT1, sT1, qT1, pT1, dT1, aN1, aS1, yN1, yP1, n21, nI1, wI1, sI1, qI1, pI1, dI1, aNI1, aSI1, fy1] = f_req(s1)
[nT2, wT2, sT2, qT2, pT2, dT2, aN2, aS2, yN2, yP2, n22, nI2, wI2, sI2, qI2, pI2, dI2, aNI2, aSI2, fy2] = f_req(s2)
