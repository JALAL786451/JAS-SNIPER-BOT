//@version=6
// ============================================================================
//  JAS IBS RADAR  (build b1, Pine v6)  —  Internal Bar Strength, 10 stock index
//
//  13 Oct 2026 - naye test qaide ki KOSHISH #14 (user 'D'). TRADE NAHI - naap.
//  Saboot: IBS effect - Pagonidis (2013, NAAIM 'The IBS Effect'); index din
//  ke NEECHE ke hisse mein band ho to agle din aksar wapsi (RSI2 jaisa
//  khandan - chhoti wapsi, sirf stock index par chali hai).
//
//  QAWAID (har index, us ki apni DAILY candles, sirf BAND candle [1]):
//   1) IBS = (close - low) / (high - low).
//   2) BUY: IBS < 0.2 AUR close > SMA200, din ke close par. Sirf BUY.
//   3) Band: kisi din IBS > 0.8 to us din ke close par, ya 5 din baad close.
//   4) SL hifazat 3 x ATR(14) = 1R (RSI2 jaisa), candle ke andar (gap = open).
//   5) Kharcha 0.01% har taraf (R mein). Swap nahi. Bahar wale din nayi nahi.
//
//  PEHLE SE LIKHA QAIDA (ABHI-KAHAN-HAIN, naap se PEHLE, badalna mana):
//   TALAASH = data shuru se 2018 (entry saal). PASS = (a) 10 ka ausat Exp > 0,
//   (b) >= 7/10 musbat, (c) SAKHT ausat - (2SE ka seedha ausat) > 0 (index
//   aapas mein jure - TOM wala sakht qaida).
//   IMTIHAN (2019+) table mein CHHUPA jab tak TALAASH PASS; phir ausat > 0
//   AUR >= 6/10 musbat AUR kul >= 30 = ASLI PASS -> demo.
//   'RSI2 saath' = TALAASH entries jin din RSI(2) < 10 bhi tha (maloomat):
//   zyada = RSI2 ki copy. Index chunna MANA. Settings badal kar dobara MANA.
//
//  b2 = KOSHISH #15 (13 Oct, user 'D'): #14 tokri FAIL (sakht -0.011) magar
//  9/10 musbat. Kachhue (pehle sirf gold) ki tarah SIRF S&P 500 (pehla
//  symbol) - is idea ka asal ghar. Ye nateeja DEKH KAR chuna gaya, is liye
//  IMTIHAN SAKHT: TALAASH S&P Exp - 2SE > 0 (trades >= 100) -> IMTIHAN
//  (2019+, kabhi nahi dekha) EK DAFA khulta hai: PASS = trades >= 50 AUR
//  Exp - 2SE > 0 (sirf Exp > 0 NAHI - woh sikka uchhalna hai).
//  ASLI PASS -> demo (JasRsi2EA ke saath US500). FAIL = IBS POORI band.
//  Baqi 9 index ka IMTIHAN chhupa hi rahega.
// ============================================================================
indicator("JAS IBS Radar — 10 index", shorttitle = "JAS IBS Radar", overlay = true, max_bars_back = 300)

BUILD = "b2"

grI = "1 · 10 index (pehle se chune - badalna mana)"
s0 = input.symbol("OANDA:SPX500USD", "1 S&P 500", group = grI)
s1 = input.symbol("OANDA:NAS100USD", "2 Nasdaq 100", group = grI)
s2 = input.symbol("OANDA:US30USD", "3 Dow 30", group = grI)
s3 = input.symbol("OANDA:US2000USD", "4 Russell 2000", group = grI)
s4 = input.symbol("OANDA:DE30EUR", "5 DAX", group = grI)
s5 = input.symbol("OANDA:UK100GBP", "6 FTSE 100", group = grI)
s6 = input.symbol("OANDA:EU50EUR", "7 Euro Stoxx 50", group = grI)
s7 = input.symbol("OANDA:JP225USD", "8 Nikkei 225", group = grI)
s8 = input.symbol("OANDA:AU200AUD", "9 Australia 200", group = grI)
s9 = input.symbol("OANDA:HK33HKD", "10 Hang Seng", group = grI)

grQ = "2 · Qawaid (mat badlein)"
ibsLo   = input.float(0.2, "BUY: IBS is se kam", step = 0.05, group = grQ, display = display.none)
ibsHi   = input.float(0.8, "Band: IBS is se zyada", step = 0.05, group = grQ, display = display.none)
maxDays = input.int(5, "Zyada se zyada din", minval = 1, group = grQ, display = display.none)
trendLen = input.int(200, "Rukh SMA", minval = 10, group = grQ, display = display.none)
atrLen  = input.int(14, "ATR length", minval = 2, group = grQ, display = display.none)
slMult  = input.float(3.0, "SL (x ATR) - hifazat", minval = 0.5, step = 0.5, group = grQ, display = display.none)
costPct = input.float(0.01, "Kharcha (% har taraf)", minval = 0, step = 0.005, group = grQ, display = display.none)
splitYr = input.int(2019, "IMTIHAN is saal se (TALAASH is se pehle)", group = grQ, display = display.none)

mode15  = input.bool(true, "KOSHISH #15: sirf S&P (pehla symbol), IMTIHAN sakht", group = grQ, display = display.none)

grV = "3 · Table"
tblPos = input.string("Top Right", "Table ki jagah", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grV, display = display.none)

// ============================================================================
//  ENGINE (har index ki apni daily candles par, sirf BAND candle)
// ============================================================================
f_ibs() =>
    _atrA = ta.atr(atrLen)
    _smA  = ta.sma(close, trendLen)
    _rsA  = ta.rsi(close, 2)
    _o   = open[1]
    _h   = high[1]
    _l   = low[1]
    _c   = close[1]
    _a   = _atrA[1]
    _sm  = _smA[1]
    _rs  = _rsA[1]
    _yr  = year(time_close[1])
    _ibs = not na(_h) and _h > _l ? (_c - _l) / (_h - _l) : na
    var int   _fy  = na
    var bool  _in  = false
    var float _e   = na
    var float _r   = na
    var float _sl  = na
    var int   _ey  = na
    var int   _age = 0
    var int   _nT = 0
    var int   _wT = 0
    var float _sT = 0.0
    var float _qT = 0.0
    var int   _nI = 0
    var int   _wI = 0
    var float _sI = 0.0
    var float _qI = 0.0
    var int   _oT = 0
    if not na(_c)
        if na(_fy)
            _fy := _yr
        bool  _cl = false
        float _px = na
        if _in
            _age += 1
            if _l <= _sl
                _px := _o < _sl ? _o : _sl
                _cl := true
            else if (not na(_ibs) and _ibs > ibsHi) or _age >= maxDays
                _px := _c
                _cl := true
        if _cl
            _rr = (_px - _e) / _r - costPct / 100.0 * (_e + _px) / _r
            if _ey < splitYr
                _nT += 1
                _sT += _rr
                _qT += _rr * _rr
                _wT += _rr > 0 ? 1 : 0
            else
                _nI += 1
                _sI += _rr
                _qI += _rr * _rr
                _wI += _rr > 0 ? 1 : 0
            _in := false
        if not _in and not _cl and not na(_ibs) and not na(_sm) and not na(_a) and _a > 0 and _ibs < ibsLo and _c > _sm
            _in  := true
            _e   := _c
            _r   := slMult * _a
            _sl  := _c - _r
            _ey  := _yr
            _age := 0
            if _yr < splitYr and not na(_rs) and _rs < 10
                _oT += 1
    // 11 cheezein x 10 request = 110 (hadd 127)
    [_nT, _wT, _sT, _qT, _nI, _wI, _sI, _qI, _fy, _in ? 1 : 0, _oT]

f_req(_s) => request.security(_s, "D", f_ibs(), barmerge.gaps_off, barmerge.lookahead_off)

[nT0, wT0, sT0, qT0, nI0, wI0, sI0, qI0, fy0, d0, oT0] = f_req(s0)
[nT1, wT1, sT1, qT1, nI1, wI1, sI1, qI1, fy1, d1, oT1] = f_req(s1)
[nT2, wT2, sT2, qT2, nI2, wI2, sI2, qI2, fy2, d2, oT2] = f_req(s2)
[nT3, wT3, sT3, qT3, nI3, wI3, sI3, qI3, fy3, d3, oT3] = f_req(s3)
[nT4, wT4, sT4, qT4, nI4, wI4, sI4, qI4, fy4, d4, oT4] = f_req(s4)
[nT5, wT5, sT5, qT5, nI5, wI5, sI5, qI5, fy5, d5, oT5] = f_req(s5)
[nT6, wT6, sT6, qT6, nI6, wI6, sI6, qI6, fy6, d6, oT6] = f_req(s6)
[nT7, wT7, sT7, qT7, nI7, wI7, sI7, qI7, fy7, d7, oT7] = f_req(s7)
[nT8, wT8, sT8, qT8, nI8, wI8, sI8, qI8, fy8, d8, oT8] = f_req(s8)
[nT9, wT9, sT9, qT9, nI9, wI9, sI9, qI9, fy9, d9, oT9] = f_req(s9)

// ============================================================================
//  HELPERS + TABLE
// ============================================================================
f_pos(_s) => _s == "Top Left" ? position.top_left : _s == "Top Right" ? position.top_right : _s == "Bottom Left" ? position.bottom_left : position.bottom_right
f_r3(_x) => na(_x) ? "-" : (_x > 0 ? "+" : "") + str.tostring(_x, "0.000")
f_se2(_n, _s, _q) => _n > 1 ? 2.0 * math.sqrt(math.max(_q - _s * _s / _n, 0.0) / (_n - 1)) / math.sqrt(_n) : na
f_nm(_s) =>
    _p = str.split(_s, ":")
    array.size(_p) > 1 ? array.get(_p, 1) : _s

var table rt = table.new(f_pos(tblPos), 7, 18, border_width = 1, border_color = color.new(color.gray, 70))
cOK = color.new(#1B5E20, 0)
cNO = color.new(#B71C1C, 0)
cBK = color.black
cHD = color.new(color.silver, 40)
cBG = color.new(color.white, 10)
cGY = color.new(#78909C, 0)

f_c(_col, _row, _t, _tc) =>
    table.cell(rt, _col, _row, _t, bgcolor = cBG, text_color = _tc, text_size = size.small, text_halign = text.align_left)

f_hd(_col, _t) =>
    table.cell(rt, _col, 1, _t, bgcolor = cHD, text_color = cBK, text_size = size.small, text_halign = text.align_left)

// ek index ki row; IMTIHAN sirf _show (TALAASH PASS) par
f_row(_row, _sym, _nT, _wT, _sT, _qT, _nI, _wI, _sI, _qI, _fy, _d, _oT, _show) =>
    _okT = not na(_nT) and _nT > 0
    _exT = _okT ? _sT / _nT : na
    _seT = _okT ? f_se2(_nT, _sT, _qT) : na
    _okI = not na(_nI) and _nI > 0
    _exI = _okI ? _sI / _nI : na
    f_c(0, _row, f_nm(_sym) + (_d == 1 ? " ▲" : ""), cBK)
    f_c(1, _row, na(_fy) ? "data nahi" : str.tostring(_fy), na(_fy) ? cNO : cBK)
    f_c(2, _row, _okT ? str.tostring(_nT) + " · " + str.tostring(100.0 * _wT / _nT, "0") + "%" : "-", cBK)
    f_c(3, _row, _okT ? f_r3(_exT) + " (± " + (na(_seT) ? "-" : str.tostring(_seT, "0.000")) + ")" : "-", na(_exT) ? cBK : _exT > 0 ? cOK : cNO)
    f_c(4, _row, na(_exT) or na(_seT) ? "-" : f_r3(_exT - _seT), na(_exT) or na(_seT) ? cBK : _exT - _seT > 0 ? cOK : cNO)
    f_c(5, _row, _okT ? str.tostring(100.0 * nz(_oT) / _nT, "0") + "%" : "-", cBK)
    if _show
        f_c(6, _row, _okI ? str.tostring(_nI) + " · " + f_r3(_exI) : "-", na(_exI) ? cBK : _exI > 0 ? cOK : cNO)
    else
        f_c(6, _row, "chhupa", cGY)

if barstate.islast
    table.clear(rt, 0, 0, 6, 17)
    table.cell(rt, 0, 0, "JAS IBS RADAR " + BUILD + " · IBS < 0.2 / > 0.8 · 1D · 10 index · sirf naap · KOSHISH #14 + #15", bgcolor = cHD, text_color = cBK, text_size = size.small)
    table.merge_cells(rt, 0, 0, 6, 0)
    if not (timeframe.isdaily and timeframe.multiplier == 1)
        f_c(0, 1, "TF ghalat: sirf 1D chart par", cNO)
    else
        // pehle TALAASH ka faisla (IMTIHAN dikhane se pehle)
        _nTa = array.from(nT0, nT1, nT2, nT3, nT4, nT5, nT6, nT7, nT8, nT9)
        _sTa = array.from(sT0, sT1, sT2, sT3, sT4, sT5, sT6, sT7, sT8, sT9)
        _qTa = array.from(qT0, qT1, qT2, qT3, qT4, qT5, qT6, qT7, qT8, qT9)
        _nIa = array.from(nI0, nI1, nI2, nI3, nI4, nI5, nI6, nI7, nI8, nI9)
        _sIa = array.from(sI0, sI1, sI2, sI3, sI4, sI5, sI6, sI7, sI8, sI9)
        _oTa = array.from(oT0, oT1, oT2, oT3, oT4, oT5, oT6, oT7, oT8, oT9)
        int   _k    = 0
        int   _pos  = 0
        float _sum  = 0.0
        float _sz   = 0.0
        int   _kI   = 0
        int   _posI = 0
        int   _nIall = 0
        float _sumI = 0.0
        int   _NT   = 0
        int   _OT   = 0
        for _i = 0 to 9
            _n = array.get(_nTa, _i)
            if not na(_n) and _n > 0
                _e = array.get(_sTa, _i) / _n
                _z = f_se2(_n, array.get(_sTa, _i), array.get(_qTa, _i))
                if not na(_z)
                    _k   += 1
                    _sum += _e
                    _sz  += _z
                    _pos += _e > 0 ? 1 : 0
                _NT += _n
                _OT += nz(array.get(_oTa, _i))
            _ni = array.get(_nIa, _i)
            if not na(_ni) and _ni > 0
                _ei = array.get(_sIa, _i) / _ni
                _kI   += 1
                _sumI += _ei
                _posI += _ei > 0 ? 1 : 0
                _nIall += _ni
        _avg  = _k > 0 ? _sum / _k : na
        _seC  = _k > 0 ? _sz / _k : na
        _need = math.ceil(7.0 * _k / 10.0)
        _ca   = not na(_avg) and _avg > 0
        _cb   = _k > 0 and _pos >= _need
        _cc   = not na(_avg) and not na(_seC) and _avg - _seC > 0
        _pass = _ca and _cb and _cc
        _avgI  = _kI > 0 ? _sumI / _kI : na
        _needI = math.ceil(6.0 * _kI / 10.0)
        _passI = _pass and not na(_avgI) and _avgI > 0 and _posI >= _needI and _nIall >= 30
        f_hd(0, "Index")
        f_hd(1, "Data se")
        f_hd(2, "TALAASH (<" + str.tostring(splitYr) + ") trades · jeet")
        f_hd(3, "TALAASH Exp R (± 2SE)")
        f_hd(4, "Exp - 2SE")
        f_hd(5, "RSI2 saath")
        f_hd(6, "IMTIHAN (" + str.tostring(splitYr) + "+) trades · Exp")
        f_row(2, s0, nT0, wT0, sT0, qT0, nI0, wI0, sI0, qI0, fy0, d0, oT0, _pass)
        f_row(3, s1, nT1, wT1, sT1, qT1, nI1, wI1, sI1, qI1, fy1, d1, oT1, _pass)
        f_row(4, s2, nT2, wT2, sT2, qT2, nI2, wI2, sI2, qI2, fy2, d2, oT2, _pass)
        f_row(5, s3, nT3, wT3, sT3, qT3, nI3, wI3, sI3, qI3, fy3, d3, oT3, _pass)
        f_row(6, s4, nT4, wT4, sT4, qT4, nI4, wI4, sI4, qI4, fy4, d4, oT4, _pass)
        f_row(7, s5, nT5, wT5, sT5, qT5, nI5, wI5, sI5, qI5, fy5, d5, oT5, _pass)
        f_row(8, s6, nT6, wT6, sT6, qT6, nI6, wI6, sI6, qI6, fy6, d6, oT6, _pass)
        f_row(9, s7, nT7, wT7, sT7, qT7, nI7, wI7, sI7, qI7, fy7, d7, oT7, _pass)
        f_row(10, s8, nT8, wT8, sT8, qT8, nI8, wI8, sI8, qI8, fy8, d8, oT8, _pass)
        f_row(11, s9, nT9, wT9, sT9, qT9, nI9, wI9, sI9, qI9, fy9, d9, oT9, _pass)
        f_c(0, 12, "TALAASH TOKRI (" + str.tostring(_k) + ")", cBK)
        table.merge_cells(rt, 0, 12, 1, 12)
        f_c(2, 12, "ausat Exp " + f_r3(_avg) + "R · musbat " + str.tostring(_pos) + "/" + str.tostring(_k) + " · sakht 2SE ± " + (na(_seC) ? "-" : str.tostring(_seC, "0.000")) + " · ausat - 2SE " + f_r3(na(_avg) or na(_seC) ? na : _avg - _seC) + " · kul " + str.tostring(_NT) + " trades · RSI2 saath " + (_NT > 0 ? str.tostring(100.0 * _OT / _NT, "0") + "%" : "-"), _pass ? cOK : cNO)
        table.merge_cells(rt, 2, 12, 6, 12)
        f_c(0, 13, "QAIDA TALAASH", _pass ? cOK : cNO)
        table.merge_cells(rt, 0, 13, 1, 13)
        f_c(2, 13, (_pass ? "PASS -> IMTIHAN khul gaya" : "FAIL - IBS band, settings NAHI badalni") + " · ausat > 0 " + (_ca ? "✓" : "✗") + " · musbat >= " + str.tostring(_need) + " " + (_cb ? "✓" : "✗") + " · ausat - 2SE > 0 " + (_cc ? "✓" : "✗"), _pass ? cOK : cNO)
        table.merge_cells(rt, 2, 13, 6, 13)
        f_c(0, 14, "QAIDA IMTIHAN", _passI ? cOK : _pass ? cNO : cGY)
        table.merge_cells(rt, 0, 14, 1, 14)
        f_c(2, 14, not _pass ? "chhupa (TALAASH PASS ho to khulega)" : "ausat " + f_r3(_avgI) + "R · musbat " + str.tostring(_posI) + "/" + str.tostring(_kI) + " · kul " + str.tostring(_nIall) + " · " + (_passI ? "ASLI PASS -> demo ka qaida likhna" : "FAIL - naye data par nahi tika"), _passI ? cOK : _pass ? cNO : cGY)
        table.merge_cells(rt, 2, 14, 6, 14)
        f_c(0, 15, "Note", cNO)
        table.merge_cells(rt, 0, 15, 1, 15)
        f_c(2, 15, "Sirf naap, trade nahi. Sirf BUY. Band candle par. Swap nahi. ▲ = abhi khuli. RSI2 saath = entry din RSI(2) < 10 bhi. Index chunna MANA.", cNO)
        table.merge_cells(rt, 2, 15, 6, 15)
        // KOSHISH #15: sirf S&P (pehla symbol), IMTIHAN sakht
        if mode15
            _exT0 = nT0 > 0 ? sT0 / nT0 : na
            _seT0 = f_se2(nT0, sT0, qT0)
            _pT0  = nT0 >= 100 and not na(_exT0) and not na(_seT0) and _exT0 - _seT0 > 0
            _exI0 = nI0 > 0 ? sI0 / nI0 : na
            _seI0 = f_se2(nI0, sI0, qI0)
            _pI0  = _pT0 and nI0 >= 50 and not na(_exI0) and not na(_seI0) and _exI0 - _seI0 > 0
            f_c(0, 16, "#15 " + f_nm(s0) + " TALAASH", _pT0 ? cOK : cNO)
            table.merge_cells(rt, 0, 16, 1, 16)
            f_c(2, 16, str.tostring(nT0) + " trades · Exp " + f_r3(_exT0) + " (± " + (na(_seT0) ? "-" : str.tostring(_seT0, "0.000")) + ") · Exp - 2SE " + f_r3(na(_exT0) or na(_seT0) ? na : _exT0 - _seT0) + (_pT0 ? " ✓ -> IMTIHAN khula (ek dafa)" : " ✗ -> IMTIHAN band"), _pT0 ? cOK : cNO)
            table.merge_cells(rt, 2, 16, 6, 16)
            f_c(0, 17, "#15 IMTIHAN (sakht)", _pI0 ? cOK : _pT0 ? cNO : cGY)
            table.merge_cells(rt, 0, 17, 1, 17)
            f_c(2, 17, not _pT0 ? "chhupa" : str.tostring(nI0) + " trades · Exp " + f_r3(_exI0) + " (± " + (na(_seI0) ? "-" : str.tostring(_seI0, "0.000")) + ") · Exp - 2SE " + f_r3(na(_exI0) or na(_seI0) ? na : _exI0 - _seI0) + " · " + (_pI0 ? "ASLI PASS -> demo ka qaida" : "FAIL - IBS poori band"), _pI0 ? cOK : _pT0 ? cNO : cGY)
            table.merge_cells(rt, 2, 17, 6, 17)
