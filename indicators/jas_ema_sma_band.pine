//@version=6
//=====================================================================
//  Jas EMA SMA Band  |  JAS      BUILD m4   (18 Oct 2026)
//  Har TF (1m se 1D) par saaf naap - kitabon ke mashhoor qaide, trade nahi:
//    EMA 13 / EMA 26 = "Value Zone" (Alexander Elder, Come Into My
//      Trading Room) - chart ki apni TF par, dono lakeeron ke beech
//      ki jagah = support (rukh upar) / resistance (rukh neeche).
//    SMA 30 hafte = bara rukh (Stan Weinstein, Secrets for Profiting in
//      Bull and Bear Markets) - pichhle BAND hafte se.
//    SMA 10 mahine = sab se bara rukh (Meb Faber, Tactical Asset
//      Allocation) - pichhle BAND mahine se.
//    OB / OS = Elder ka AutoEnvelope: EMA 26 ke gird channel jis mein
//      pichhli 100 candles ka 95% raha - kinara chhua = OB / OS.
//      Channel har TF ki apni candles se, is liye 1m aur 1D dono par theek.
//  Ishare (sirf BAND candle par - history = live, repaint nahi):
//    S  = rukh upar, price value zone tak wapas aayi, close zone ke upar
//    R  = rukh neeche, price value zone tak upar aayi, close zone ke neeche
//    OB = channel ka upar kinara (ek leg mein ek dafa; zone chhoo kar dobara)
//    OS = channel ka neeche kinara (ek leg mein ek dafa)
//  OB rukh upar mein = "mehnga, naya BUY nahi", SELL ka hukm nahi.
//  m2-m3 ke masle: EMA ab chart TF par (1D ki seerhi nahi), OB/OS ab
//  chart ki apni candles ke channel se (1H par OS ki bharmar khatam).
//  Har lakeer / ishara settings mein ON/OFF. Rang / table BAND.
//=====================================================================
indicator("Jas EMA SMA Band m4", shorttitle = "JAS EMA/SMA m4", overlay = true)

grpE = "EMA - Value Zone (Elder, har TF)"
fastLen = input.int(13, "Tez EMA", minval = 1, group = grpE)
slowLen = input.int(26, "Dheemi EMA", minval = 2, group = grpE)
showEma = input.bool(true, "EMA lakeerein", group = grpE)
showZn  = input.bool(false, "Value zone ka halka rang", group = grpE)

grpS = "SMA - bara rukh (band hafta / mahina)"
showW = input.bool(true, "SMA hafte (Weinstein)", group = grpS)
wLen  = input.int(30, "Kitne hafte", minval = 1, group = grpS)
showM = input.bool(true, "SMA mahine (Faber)", group = grpS)
mLen  = input.int(10, "Kitne mahine", minval = 1, group = grpS)

grpC = "OB / OS - AutoEnvelope (Elder)"
chLook = input.int(100, "Pichhli candles", minval = 20, group = grpC)
chPct  = input.float(95.0, "Kitni % candles channel ke andar", minval = 50.0, maxval = 99.9, step = 0.5, group = grpC)
showCh = input.bool(false, "Channel lakeerein", group = grpC)

grpI = "Ishare"
showSR   = input.bool(true, "S / R (value zone se wapsi)", group = grpI)
showOBOS = input.bool(true, "OB / OS (channel ka kinara)", group = grpI)
useTide  = input.bool(true, "S / R sirf hafte wali SMA ke rukh mein", group = grpI)

// ---- EMA value zone (chart TF)
emaF = ta.ema(close, fastLen)
emaS = ta.ema(close, slowLen)
zTop = math.max(emaF, emaS)
zBot = math.min(emaF, emaS)

// ---- bari TF: sirf pichhli BAND candle ([1] + lookahead_on) = repaint nahi
smaW  = request.security(syminfo.tickerid, "1W", ta.sma(close, wLen)[1], lookahead = barmerge.lookahead_on)
smaW2 = request.security(syminfo.tickerid, "1W", ta.sma(close, wLen)[2], lookahead = barmerge.lookahead_on)
wCl   = request.security(syminfo.tickerid, "1W", close[1], lookahead = barmerge.lookahead_on)
smaM  = request.security(syminfo.tickerid, "1M", ta.sma(close, mLen)[1], lookahead = barmerge.lookahead_on)

// Weinstein: hafta SMA ke upar + SMA upar ja rahi = rukh upar
tideUp = wCl > smaW and smaW >= smaW2
tideDn = wCl < smaW and smaW <= smaW2

// ---- AutoEnvelope: pichhli candles (aaj ki nahi) ka chLook / chPct kinara
dev  = math.max(high - emaS, emaS - low)
chW  = ta.percentile_nearest_rank(dev, chLook, chPct)[1]
chUp = emaS + chW
chDn = emaS - chW

upT = emaF > emaS and (not useTide or tideUp)
dnT = emaF < emaS and (not useTide or tideDn)

var bool armUp  = false
var bool pullUp = false
var bool armDn  = false
var bool pullDn = false
var bool obArm  = true
var bool osArm  = true

sigS  = false
sigR  = false
sigOB = false
sigOS = false

// sab faisle sirf band candle par - live candle par kuch nahi badalta
if barstate.isconfirmed
    // S: rukh upar, pehle zone ke saaf upar, phir zone tak wapsi, close zone ke upar
    if not upT
        armUp  := false
        pullUp := false
    else
        if low > zTop
            armUp := true
        if armUp and low <= zTop
            pullUp := true
        if pullUp and close < zBot
            armUp  := false
            pullUp := false
        else if pullUp and close > zTop
            sigS   := true
            armUp  := false
            pullUp := false
    // R: rukh neeche, pehle zone ke saaf neeche, phir zone tak upar, close zone ke neeche
    if not dnT
        armDn  := false
        pullDn := false
    else
        if high < zBot
            armDn := true
        if armDn and high >= zBot
            pullDn := true
        if pullDn and close > zTop
            armDn  := false
            pullDn := false
        else if pullDn and close < zBot
            sigR   := true
            armDn  := false
            pullDn := false
    // OB / OS: ek leg mein ek dafa; price value zone chhoo le to dobara tayyar
    if obArm and high >= chUp
        sigOB := true
        obArm := false
    else if not obArm and low <= zTop and high < chUp
        obArm := true
    if osArm and low <= chDn
        sigOS := true
        osArm := false
    else if not osArm and high >= zBot and low > chDn
        osArm := true

noSt = display.all - display.status_line

pF = plot(showEma ? emaF : na, "EMA tez",    color = color.new(color.teal, 0), linewidth = 1)
pS = plot(showEma ? emaS : na, "EMA dheemi", color = color.new(color.blue, 0), linewidth = 2)
fill(pF, pS, color = showZn ? color.new(color.blue, 88) : na, title = "Value zone")
plot(showW ? smaW : na, "SMA hafte",  color = color.new(color.orange, 0), linewidth = 2, style = plot.style_stepline)
plot(showM ? smaM : na, "SMA mahine", color = color.new(color.purple, 0), linewidth = 2, style = plot.style_stepline)
plot(showCh ? chUp : na, "Channel upar",  color = color.new(color.gray, 30), linewidth = 1)
plot(showCh ? chDn : na, "Channel neeche", color = color.new(color.gray, 30), linewidth = 1)

plotshape(showSR and sigS, "Support", shape.triangleup, location.belowbar, color.new(color.green, 0), text = "S", textcolor = color.green, size = size.tiny, display = noSt)
plotshape(showSR and sigR, "Resistance", shape.triangledown, location.abovebar, color.new(color.red, 0), text = "R", textcolor = color.red, size = size.tiny, display = noSt)
plotshape(showOBOS and sigOB, "Overbought", shape.circle, location.abovebar, color.new(color.maroon, 0), text = "OB", textcolor = color.maroon, size = size.tiny, display = noSt)
plotshape(showOBOS and sigOS, "Oversold", shape.circle, location.belowbar, color.new(color.navy, 0), text = "OS", textcolor = color.navy, size = size.tiny, display = noSt)

alertcondition(sigS, "Support", "JAS: S - value zone se support")
alertcondition(sigR, "Resistance", "JAS: R - value zone se resistance")
alertcondition(sigOB, "Overbought", "JAS: OB - channel ka upar kinara")
alertcondition(sigOS, "Oversold", "JAS: OS - channel ka neeche kinara")
