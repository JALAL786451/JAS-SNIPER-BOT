//@version=5
// ============================================================================
//  CANDLE X-RAY — ek candle ke andar ka sab kuch
//
//  MASLA:
//   1D ki ek candle sirf 4 number batati hai — open, high, low, close.
//   Ye nahi batati ke din ke andar hua KYA. Pehle buy chala phir sell?
//   Sara kaam pehle ghante mein hua ya aakhri mein? High kis waqt bana?
//
//  HAL:
//   Ye indicator us EK candle ko kholta hai. Uske andar ki chhoti candles
//   (1m / 5m / 15m — aap chunein) nikal kar, candle ke SAATH khali jagah
//   mein ek mini-chart bana deta hai. Wahi din, magar andar se.
//
//  SAATH MEIN:
//   - MA lines strip par: chart ka apna MA in mini-candles par nahi aata,
//     kyunke ye asli bars nahi, banai hui shaklein hain. Is liye MA yahan
//     UNHI chhoti candles se bana hai. Pichhle dino ka data seed ke taur par
//     mila diya gaya hai, warna pehli 20 mini-candles par MA khali rehta.
//   - Rang ka gehrapan = us waqt kitna kaam (volume) hua. Gehra = asli zor.
//   - Price profile: qeemat ne sabse zyada waqt KAHAN guzara.
//   - MTF patti: 1m se 1W tak har timeframe abhi kis taraf hai.
//   - Panel: kitni candle green kitni red, high/low kis waqt bana.
//
//  YE SIGNAL NAHI DETA. Ye dekhne ka aala hai — microscope.
//  Live candle par ye barabar badalta rahega, kyunke din abhi chal raha hai.
//  Yehi is ka kaam hai.
// ============================================================================
indicator("Candle X-Ray", "X-RAY", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_polylines_count = 100)

// ---------------------------------------------------------------- 1. X-RAY --
gX      = "1. X-Ray"
xrayOn  = input.bool(true,   "X-Ray chalu", group = gX)
ltfSel  = input.string("Auto", "Andar ki timeframe", options = ["Auto", "1", "3", "5", "15", "30", "60", "240"], group = gX)
srcOff  = input.int(0,       "Kaunsi candle kholni hai (0 = abhi wali)", minval = 0, maxval = 20, group = gX)
maxDraw = input.int(180,     "Zyada se zyada kitni mini-candle", minval = 20, maxval = 400, group = gX)
slotW   = input.int(2,       "Har mini-candle ki jagah (bars)", minval = 1, maxval = 6, group = gX)
gapBar  = input.int(4,       "Candle se faasla (bars)", minval = 1, maxval = 40, group = gX)
volFade = input.bool(true,   "Rang ka gehrapan volume se (gehra = zyada kaam)", group = gX)
fadeMin = input.int(15,      "Sabse gehra (kam = zyada gehra)", minval = 0, maxval = 60, group = gX)
fadeMax = input.int(78,      "Sabse halka", minval = 40, maxval = 95, group = gX)

// ------------------------------------------------------------------ 2. MA --
gA      = "2. MA lines (mini-candles par)"
maOn    = input.bool(true,    "MA lines chalu", group = gA)
maType  = input.string("EMA", "Kis tarah ka", options = ["EMA", "SMA"], group = gA)
maLen1  = input.int(20,       "Tez MA",  minval = 2, maxval = 400, group = gA)
maLen2  = input.int(50,       "Susat MA", minval = 2, maxval = 400, group = gA)
maWarm  = input.int(3,        "Pichhli kitni bari candles ka data seed", minval = 0, maxval = 10, group = gA)
maWid   = input.int(2,        "Motai", minval = 1, maxval = 4, group = gA)
cMA1    = input.color(#FF9800, "Tez MA ka rang",  group = gA)
cMA2    = input.color(#7E57C2, "Susat MA ka rang", group = gA)

// ------------------------------------------------------------------ 3. WAQT --
gW      = "3. Waqt kis ghari se"
tzMode  = input.string("Apna waqt", "Ghari", options = ["Apna waqt", "Broker ka waqt", "UTC"], group = gW)
tzOff   = input.int(5, "Apna waqt: UTC se kitne ghante aagey", minval = -12, maxval = 14, group = gW)

// -------------------------------------------------------------- 4. PROFILE --
gP      = "4. Price profile (waqt kahan guzra)"
profOn  = input.bool(true, "Profile chalu", group = gP)
profBin = input.int(24,    "Kitni pattiyan", minval = 8, maxval = 60, group = gP)
profW   = input.int(26,    "Sabse lambi patti (bars)", minval = 5, maxval = 40, group = gP)

// ------------------------------------------------------------------ 5. MTF --
gM      = "5. MTF patti"
mtfOn   = input.bool(true, "MTF patti chalu", group = gM)
panelOn = input.bool(true, "Hisaab ka panel chalu", group = gM)

// ---------------------------------------------------------------- 6. RANG --
gR      = "6. Rang"
cUp     = input.color(#089981, "Buy",  group = gR, inline = "r1")
cDn     = input.color(#F23645, "Sell", group = gR, inline = "r1")
cFlat   = input.color(#787B86, "Barabar", group = gR, inline = "r1")
cMark   = input.color(#2962FF, "Nishan", group = gR, inline = "r2")
cText   = input.color(#111111, "Likhai", group = gR, inline = "r2")
cPanel  = input.color(#FFFFFFAA, "Panel", group = gR, inline = "r2")

// ============================================================================
//  LTF khud chunna
// ============================================================================
chartSec = timeframe.in_seconds(timeframe.period)
ltfAuto  = chartSec <= 900 ? "1" : chartSec <= 3600 ? "1" : chartSec <= 14400 ? "5" : chartSec <= 86400 ? "15" : "60"
ltfRes   = ltfSel == "Auto" ? ltfAuto : ltfSel
ltfSec   = timeframe.in_seconds(ltfRes)

tzSign = tzOff >= 0 ? "+" : "-"
tzStr  = tzMode == "Broker ka waqt" ? syminfo.timezone : tzMode == "UTC" ? "UTC" : "UTC" + tzSign + str.tostring(math.abs(tzOff))

aO = request.security_lower_tf(syminfo.tickerid, ltfRes, open)
aH = request.security_lower_tf(syminfo.tickerid, ltfRes, high)
aL = request.security_lower_tf(syminfo.tickerid, ltfRes, low)
aC = request.security_lower_tf(syminfo.tickerid, ltfRes, close)
aV = request.security_lower_tf(syminfo.tickerid, ltfRes, volume)

// ============================================================================
//  SCALE ANCHOR — ye lakeer dikhai nahi deti, magar hataiye mat
//
//  Is script mein ek bhi asli plot nahi, sab kuch drawings hain (box, line,
//  label, polyline). Aise overlay ko TradingView kabhi kabhi chart wale price
//  scale se alag, apna scale de deta hai. Us soorat mein strip andar se to
//  theek rehti hai magar chart ke candles se alag jagah chali jaati hai, aur
//  right side se price kheenchte hi sab bikhar jaata hai.
//
//  Ye bilkul shaffaf plot close ke barabar hai. Iska ek hi kaam hai:
//  TradingView ko yaad dilana ke ye indicator chart wale hi scale par hai.
// ============================================================================
plot(close, "scale anchor", color = color.new(color.white, 100), display = display.pane, editable = false)

// ============================================================================
//  MTF patti — har timeframe abhi kis taraf
// ============================================================================
f_bias(_tf) => request.security(syminfo.tickerid, _tf, close > open ? 1 : close < open ? -1 : 0, lookahead = barmerge.lookahead_off)

b1   = f_bias("1")
b5   = f_bias("5")
b15  = f_bias("15")
b60  = f_bias("60")
b240 = f_bias("240")
bD   = f_bias("D")
bW   = f_bias("W")

// MA poori list par ek hi baar -- har mini-candle par dobara ginna nahi
f_maArr(_src, _len, _isEma) =>
    _n   = array.size(_src)
    _out = array.new_float(_n, na)
    if _isEma
        _k = 2.0 / (_len + 1)
        _e = 0.0
        for i = 0 to _n - 1
            _v = array.get(_src, i)
            _e := i == 0 ? _v : _e + _k * (_v - _e)
            if i >= _len - 1
                array.set(_out, i, _e)
    else
        _s = 0.0
        for i = 0 to _n - 1
            _s := _s + array.get(_src, i)
            if i >= _len
                _s := _s - array.get(_src, i - _len)
            if i >= _len - 1
                array.set(_out, i, _s / _len)
    _out

f_bcol(_b) => _b > 0 ? cUp : _b < 0 ? cDn : cFlat
f_btxt(_b) => _b > 0 ? "BUY" : _b < 0 ? "SELL" : "—"

// ============================================================================
//  Drawing ka saman
// ============================================================================
var array<box>   BX = array.new<box>()
var array<line>  LN = array.new<line>()
var array<label> LB = array.new<label>()
var array<polyline> PL = array.new<polyline>()

f_wipe() =>
    while array.size(BX) > 0
        box.delete(array.pop(BX))
    while array.size(LN) > 0
        line.delete(array.pop(LN))
    while array.size(LB) > 0
        label.delete(array.pop(LB))
    while array.size(PL) > 0
        polyline.delete(array.pop(PL))

// ============================================================================
//  Panel
// ============================================================================
var table TB = table.new(position.top_right, 3, 16, border_width = 1)

f_row(_r, _a, _b, _bg, _tc) =>
    table.cell(TB, 0, _r, _a, text_color = cText, text_size = size.small, text_halign = text.align_left, bgcolor = cPanel)
    table.cell(TB, 1, _r, _b, text_color = _tc,   text_size = size.small, text_halign = text.align_right, bgcolor = _bg)

// ============================================================================
//  ASAL KAAM
// ============================================================================
if barstate.islast
    f_wipe()

    table.clear(TB, 0, 0, 2, 15)

    float maX1 = na
    float maX2 = na

    sO = aO[srcOff]
    sH = aH[srcOff]
    sL = aL[srcOff]
    sC = aC[srcOff]
    sV = aV[srcOff]
    n  = na(sO) ? 0 : array.size(sO)

    if xrayOn and n < 1
        array.push(LB, label.new(bar_index + gapBar, close, "X-RAY: is candle ka " + ltfRes + "m data nahi mila.\nChhoti timeframe chunein ya chart thora scroll karein.", style = label.style_label_left, color = color.new(cFlat, 20), textcolor = color.white, size = size.small))

    if xrayOn and n > 0
        // --- parent candle ko nishan lagao ---
        pTop = high[srcOff]
        pBot = low[srcOff]
        array.push(BX, box.new(bar_index - srcOff - 1, pTop, bar_index - srcOff + 1, pBot, border_color = cMark, border_width = 2, bgcolor = color.new(cMark, 92)))

        // --- kitni mini-candle bane, kitni jorni parein ---
        budget = 470 - gapBar - (profOn ? profW + 18 : 0)
        cap    = math.max(20, math.min(maxDraw, int(budget / slotW)))
        step   = math.max(1, int(math.ceil(n * 1.0 / cap)))
        grp    = math.max(1, int(math.ceil(n * 1.0 / step)))

        // --- pehle volume ka average taake gehrapan nap sakein ---
        vSum = 0.0
        for i = 0 to n - 1
            vSum := vSum + array.get(sV, i)
        vAvg = vSum / n

        x0 = bar_index + gapBar

        gUp   = 0
        gDn   = 0
        volUp = 0.0
        volDn = 0.0
        hiVal = array.get(sH, 0)
        loVal = array.get(sL, 0)
        hiIdx = 0
        loIdx = 0

        for g = 0 to grp - 1
            i0 = g * step
            i1 = math.min(n - 1, i0 + step - 1)

            go = array.get(sO, i0)
            gc = array.get(sC, i1)
            gh = go
            gl = go
            gv = 0.0

            for i = i0 to i1
                _h = array.get(sH, i)
                _l = array.get(sL, i)
                _v = array.get(sV, i)
                gh := math.max(gh, _h)
                gl := math.min(gl, _l)
                gv := gv + _v
                if _h > hiVal
                    hiVal := _h
                    hiIdx := i
                if _l < loVal
                    loVal := _l
                    loIdx := i

            up = gc >= go
            if up
                gUp   := gUp + 1
                volUp := volUp + gv
            else
                gDn   := gDn + 1
                volDn := volDn + gv

            // gehrapan: is tukre ka volume average se jitna bara, utna gehra
            rel  = vAvg > 0 ? gv / (vAvg * step) : 1.0
            fade = volFade ? int(math.max(fadeMin, math.min(fadeMax, fadeMax - (fadeMax - fadeMin) * math.min(2.0, rel) / 2.0))) : 25
            col  = color.new(up ? cUp : cDn, fade)

            xa = x0 + g * slotW
            xb = xa + math.max(1, slotW - 1)
            xc = int((xa + xb) / 2)

            bTop = math.max(go, gc)
            bBot = math.min(go, gc)
            if bTop - bBot < syminfo.mintick
                bTop := bTop + syminfo.mintick / 2
                bBot := bBot - syminfo.mintick / 2

            array.push(LN, line.new(xc, gl, xc, gh, color = col, width = 1))
            array.push(BX, box.new(xa, bTop, xb, bBot, border_color = col, bgcolor = col))

        xEnd = x0 + grp * slotW

        // --- MA lines: pichhle dino ka data pehle jorho, warna line adhoori ---
        if maOn
            cbuf = array.new_float()
            if maWarm > 0
                for k = maWarm to 1
                    pArr = aC[srcOff + k]
                    if not na(pArr)
                        for i = 0 to array.size(pArr) - 1
                            array.push(cbuf, array.get(pArr, i))
            warmN = array.size(cbuf)
            for i = 0 to n - 1
                array.push(cbuf, array.get(sC, i))

            isEma = maType == "EMA"
            m1 = f_maArr(cbuf, maLen1, isEma)
            m2 = f_maArr(cbuf, maLen2, isEma)

            pt1 = array.new<chart.point>()
            pt2 = array.new<chart.point>()
            float e1 = na
            float e2 = na

            for g = 0 to grp - 1
                iE = math.min(n - 1, g * step + step - 1)
                xa = x0 + g * slotW
                xc = int((xa + xa + math.max(1, slotW - 1)) / 2)
                v1 = array.get(m1, warmN + iE)
                v2 = array.get(m2, warmN + iE)
                if not na(v1)
                    array.push(pt1, chart.point.from_index(xc, v1))
                    e1 := v1
                if not na(v2)
                    array.push(pt2, chart.point.from_index(xc, v2))
                    e2 := v2

            if array.size(pt1) > 1
                array.push(PL, polyline.new(pt1, line_color = cMA1, line_width = maWid, xloc = xloc.bar_index))
                array.push(LB, label.new(xEnd, e1, maType + str.tostring(maLen1), style = label.style_label_left, color = color.new(cMA1, 20), textcolor = color.white, size = size.tiny))
            if array.size(pt2) > 1
                array.push(PL, polyline.new(pt2, line_color = cMA2, line_width = maWid, xloc = xloc.bar_index))
                array.push(LB, label.new(xEnd, e2, maType + str.tostring(maLen2), style = label.style_label_left, color = color.new(cMA2, 20), textcolor = color.white, size = size.tiny))

            maX1 := e1
            maX2 := e2

        // --- parent candle ke open aur close ki lakeerein strip ke aar paar ---
        array.push(LN, line.new(x0 - 1, open[srcOff],  xEnd, open[srcOff],  color = color.new(cFlat, 40), style = line.style_dotted))
        array.push(LN, line.new(x0 - 1, close[srcOff], xEnd, close[srcOff], color = color.new(cMark, 20), style = line.style_dashed))

        // --- high aur low kis waqt bana (taqreeban) ---
        t0 = time[srcOff]
        tH = t0 + hiIdx * ltfSec * 1000
        tL = t0 + loIdx * ltfSec * 1000
        array.push(LB, label.new(xEnd + 1, hiVal, "HIGH  " + str.format_time(tH, "dd HH:mm", tzStr), style = label.style_label_left, color = color.new(cUp, 15), textcolor = color.white, size = size.small))
        array.push(LB, label.new(xEnd + 1, loVal, "LOW  " + str.format_time(tL, "dd HH:mm", tzStr), style = label.style_label_left, color = color.new(cDn, 15), textcolor = color.white, size = size.small))

        // --- price profile: qeemat ne waqt kahan guzara ---
        if profOn and hiVal > loVal
            binH  = (hiVal - loVal) / profBin
            cnt   = array.new_int(profBin, 0)
            for i = 0 to n - 1
                _c = array.get(sC, i)
                bi = int(math.floor((_c - loVal) / binH))
                bi := math.max(0, math.min(profBin - 1, bi))
                array.set(cnt, bi, array.get(cnt, bi) + 1)
            cMaxV = 1
            for i = 0 to profBin - 1
                cMaxV := math.max(cMaxV, array.get(cnt, i))
            px = xEnd + 12
            for i = 0 to profBin - 1
                q = array.get(cnt, i)
                if q > 0
                    w  = math.max(1, int(profW * q / float(cMaxV)))
                    hot = q == cMaxV
                    pc = hot ? color.new(cMark, 20) : color.new(cFlat, 60)
                    array.push(BX, box.new(px, loVal + (i + 1) * binH, px + w, loVal + i * binH, border_color = pc, bgcolor = pc))
            array.push(LB, label.new(px + profW + 2, loVal + (hiVal - loVal) / 2, "waqt\nkahan", style = label.style_none, textcolor = color.new(cText, 30), size = size.tiny))

        // ------------------------------------------------------------ panel --
        if panelOn
            rng  = hiVal - loVal
            body = close[srcOff] - open[srcOff]
            eff  = rng > 0 ? math.abs(body) / rng * 100 : 0.0
            vTot = volUp + volDn
            upPc = vTot > 0 ? volUp / vTot * 100 : 50.0

            table.cell(TB, 0, 0, "CANDLE X-RAY", text_color = color.white, text_size = size.normal, bgcolor = cMark)
            table.cell(TB, 1, 0, timeframe.period + " ← " + ltfRes + "m", text_color = color.white, text_size = size.normal, bgcolor = cMark)

            f_row(1, "Andar ki candles", str.tostring(n), cPanel, cText)
            f_row(2, "Green / Red", str.tostring(gUp) + " / " + str.tostring(gDn), cPanel, gUp > gDn ? cUp : gDn > gUp ? cDn : cText)
            f_row(3, "Buy volume %", str.tostring(upPc, "#.0") + " %", color.new(upPc >= 50 ? cUp : cDn, 80), upPc >= 50 ? cUp : cDn)
            f_row(4, "Range", str.tostring(rng, format.mintick), cPanel, cText)
            f_row(5, "Body / Range", str.tostring(eff, "#.0") + " %", cPanel, eff >= 50 ? cUp : cFlat)
            f_row(6, "High bana", str.format_time(tH, "dd HH:mm", tzStr), cPanel, cUp)
            f_row(7, "Low bana", str.format_time(tL, "dd HH:mm", tzStr), cPanel, cDn)

            maTxt = na(maX1) or na(maX2) ? "data kam hai" : maX1 > maX2 ? "TEZ  UPAR" : maX1 < maX2 ? "TEZ  NEECHEY" : "barabar"
            maCol = na(maX1) or na(maX2) ? cFlat : maX1 > maX2 ? cUp : cDn
            f_row(8, maType + str.tostring(maLen1) + " vs " + str.tostring(maLen2), maOn ? maTxt : "band", maOn ? color.new(maCol, 80) : cPanel, maCol)

            if mtfOn
                table.cell(TB, 0, 9, "TIMEFRAME", text_color = color.white, text_size = size.small, bgcolor = cFlat)
                table.cell(TB, 1, 9, "ABHI", text_color = color.white, text_size = size.small, bgcolor = cFlat)
                f_row(10, "1m  /  5m",  f_btxt(b1)  + "  /  " + f_btxt(b5),  cPanel, f_bcol(b1 + b5))
                f_row(11, "15m /  1H",  f_btxt(b15) + "  /  " + f_btxt(b60), cPanel, f_bcol(b15 + b60))
                f_row(12, "4H  /  1D",  f_btxt(b240)+ "  /  " + f_btxt(bD),  cPanel, f_bcol(b240 + bD))
                f_row(13, "1W",         f_btxt(bW),                          cPanel, f_bcol(bW))
                sumB = b1 + b5 + b15 + b60 + b240 + bD + bW
                f_row(14, "Sab mila kar", sumB > 0 ? "BUY  " + str.tostring(sumB) : sumB < 0 ? "SELL  " + str.tostring(sumB) : "BARABAR", color.new(sumB > 0 ? cUp : sumB < 0 ? cDn : cFlat, 78), f_bcol(sumB))
