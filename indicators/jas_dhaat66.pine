//@version=6
// ============================================================================
//  JAS DHAAT 66  (build d2, Pine v6)  -  Koshish #66 (1 Nov 2026)
//  d2 (judge): pehle SIRF DATA jaanch (nateeja chhupa) - 1D aur 1W chart; saal UTC
//  (#34 / Python jaisa); drift ke din theek; har dhaat ki 4H candles ka waqt jaancha.
//
//  Trend 4H (#34, #53 mein chal raha) ke "rishtedar" market: PLATINUM,
//  PALLADIUM, COPPER. Engine = jas_ftmo49_tokri.pine t4 ka simT bilkul wahi
//  (har market apne 4H data par, request.security "240"). TRADE NAHI.
//
//  QAWAID (#34): Supertrend 10/3 4H, SIRF BUY. Flip upar = AGLI 4H open BUY,
//   flip neeche = AGLI open band, SL 6 x ATR10 (4H) = 1R (candle ke andar,
//   gap = open). Ek market ek position.
//   Kharcha = har market ka apna (JasSpreadNaap "poora din" spread % x 0.75
//   har taraf; naap 1 Nov: XPT 0.249% -> 0.187, XPD 0.551% -> 0.414, XCU
//   0.056% -> 0.042) + swap 3%/saal har raat (calendar din) -> R.
//
//  PEHLE SE LIKHA QAIDA (docs/purana-haal.md, grep "Koshish #66 qaida"):
//   TALAASH = entry < 2019 (TV 4H data jitna). PASS = kul >= 100 tr AUR
//   Exp - 2SE > 0 AUR >= 2/3 market Exp > 0 AUR (market x saal) musbat > 50%.
//   Aam tezi (drift) sirf maloomat. IMTIHAN 2019+ CHHUPA jab tak TALAASH PASS;
//   phir EK dafa: kul >= 30 tr AUR Exp - 2SE > 0 = ASLI PASS.
//
//  CHART: koi bhi DAILY chart (misaal OANDA:XAUUSD 1D). "data se" saal dekhein.
// ============================================================================
indicator("JAS Dhaat 66 d2 (#66)", shorttitle = "JAS DHAAT66 d2", overlay = true, max_bars_back = 300)

BUILD = "d2"
TZ = "America/New_York"

grI = "1 · 3 dhaat (pehle se chuni - badalna mana)"
m1 = input.symbol("OANDA:XPTUSD", "1 Platinum", group = grI)
m2 = input.symbol("OANDA:XPDUSD", "2 Palladium", group = grI)
m3 = input.symbol("OANDA:XCUUSD", "3 Copper", group = grI)

grQ = "2 · Kharcha (JasSpreadNaap x 0.75, % har taraf) + muddat"
c1 = input.float(0.187, "Platinum kharcha % har taraf", step = 0.001, group = grQ, display = display.none)
c2 = input.float(0.414, "Palladium kharcha % har taraf", step = 0.001, group = grQ, display = display.none)
c3 = input.float(0.042, "Copper kharcha % har taraf", step = 0.001, group = grQ, display = display.none)
swapYr  = input.float(3.0, "Swap (% saal, har raat)", minval = 0, step = 0.5, group = grQ, display = display.none)
splitYr = input.int(2019, "IMTIHAN is saal se (TALAASH is se pehle)", group = grQ, display = display.none)
showIm  = input.bool(false, "IMTIHAN dikhao (SIRF TALAASH PASS ke baad, EK dafa)", group = grQ, display = display.none)
hideRes = input.bool(true, "PEHLE SIRF DATA jaanch (nateeja chhupa) - chart chun kar ye tick hatayein", group = grQ, display = display.none)

grV = "3 · Table"
tblPos = input.string("Top Right", "Table ki jagah", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grV, display = display.none)

// ============================================================================
//  ENGINE - jas_ftmo49_tokri.pine simT (#34) jyon ka tyon + kharcha / swap / drift / saal
// ============================================================================
simT(float costPct) =>
    var int   pos  = 0
    var bool  pEnt = false
    var bool  pEx  = false
    var float sdP  = na
    var float eP   = na
    var float sd   = na
    var float sl   = na
    var int   eT   = na
    var int   ey   = na
    var int   age  = 0
    var int   fy   = na
    var int   nT = 0
    var int   wT = 0
    var float sT = 0.0
    var float qT = 0.0
    var float pT = 0.0
    var int   dT = 0
    var int   aN = 0
    var float aS = 0.0
    var int   yN = 0
    var int   yP = 0
    var int   cy = na
    var float cs = 0.0
    var int   nI = 0
    var int   wI = 0
    var float sI = 0.0
    var float qI = 0.0
    var int   bad = 0
    a = ta.atr(10)
    [st, d] = ta.supertrend(3.0, 10)
    up = d < 0
    yr = year(time, "UTC")
    hNy = hour(time, TZ)
    if not (hNy == 17 or hNy == 21 or hNy == 1 or hNy == 5 or hNy == 9 or hNy == 13)
        bad += 1
    if na(fy)
        fy := yr
    if not na(close[1]) and close[1] > 0 and yr < splitYr
        aN += 1
        aS += close / close[1] - 1
    float xP = na
    bool  xFl = false
    if pEx and pos == 1
        xP := open
        xFl := true
    pEx := false
    if pEnt and pos == 0 and na(xP)
        pos := 1
        eP := open
        sd := sdP
        sl := open - sdP
        eT := time
        ey := yr
        age := 0
    pEnt := false
    if pos == 1
        age += 1
    if pos == 1 and na(xP) and low <= sl
        xP := math.min(open, sl)
    if pos == 1 and not na(xP)
        nights = math.round((time - eT) / 86400000.0)
        r = (xP - eP - costPct / 100.0 * (eP + xP) - swapYr / 100.0 / 365.0 * nights * eP) / sd
        if ey < splitYr
            nT += 1
            sT += r
            qT += r * r
            pT += xP / eP - 1
            dT += xFl ? age - 1 : age
            wT += r > 0 ? 1 : 0
            if na(cy) or ey != cy
                if not na(cy)
                    yN += 1
                    yP += cs > 0 ? 1 : 0
                cy := ey
                cs := 0.0
            cs += r
        else
            nI += 1
            sI += r
            qI += r * r
            wI += r > 0 ? 1 : 0
        pos := 0
    if bar_index > 30 and up and not up[1] and pos == 0
        pEnt := true
        sdP := 6.0 * a
    if pos == 1 and not up and up[1]
        pEx := true
    yNo = yN + (na(cy) ? 0 : 1)
    yPo = yP + (not na(cy) and cs > 0 ? 1 : 0)
    [nT, wT, sT, qT, pT, dT, aN, aS, yNo, yPo, nI, wI, sI, qI, fy, bad]

[nT1, wT1, sT1, qT1, pT1, dT1, aN1, aS1, yN1, yP1, nI1, wI1, sI1, qI1, fy1, bd1] = request.security(m1, "240", simT(c1), lookahead = barmerge.lookahead_off)
[nT2, wT2, sT2, qT2, pT2, dT2, aN2, aS2, yN2, yP2, nI2, wI2, sI2, qI2, fy2, bd2] = request.security(m2, "240", simT(c2), lookahead = barmerge.lookahead_off)
[nT3, wT3, sT3, qT3, pT3, dT3, aN3, aS3, yN3, yP3, nI3, wI3, sI3, qI3, fy3, bd3] = request.security(m3, "240", simT(c3), lookahead = barmerge.lookahead_off)

// ============================================================================
//  TABLE (safaid)
// ============================================================================
f_pos(_p) => _p == "Top Left" ? position.top_left : _p == "Bottom Right" ? position.bottom_right : _p == "Bottom Left" ? position.bottom_left : position.top_right

f_exp(_n, _s) => _n > 0 ? _s / _n : 0.0
f_se(_n, _s, _q) =>
    _m = _n > 0 ? _s / _n : 0.0
    _n > 1 ? math.sqrt(math.max((_q - _n * _m * _m) / (_n - 1), 0.0)) / math.sqrt(_n) : 0.0
f_dr(float _aS, int _aN, int _d) => _aN > 0 ? _aS / _aN * _d : 0.0

var table tb = table.new(f_pos(tblPos), 8, 13, bgcolor = color.white, border_color = color.new(#9e9e9e, 0), border_width = 1)
fg  = color.new(#111111, 0)
cUp = color.new(#0a8f5a, 0)
cDn = color.new(#d32f2f, 0)
cHd = color.new(#1a237e, 0)

f_cell(int _c, int _r, string _s, color _col) =>
    table.cell(tb, _c, _r, _s, text_color = _col, text_size = size.small)

f_p(float _x) => str.tostring(100.0 * _x, "+0.00;-0.00") + "%"

f_row(int _r, string _nm, int _n, int _w, float _s, float _q, string _pct, string _dr, string _yr) =>
    _e  = f_exp(_n, _s)
    _se = f_se(_n, _s, _q)
    f_cell(0, _r, _nm, fg)
    f_cell(1, _r, str.tostring(_n), fg)
    f_cell(2, _r, str.tostring(_n > 0 ? 100.0 * _w / _n : 0.0, "#") + "%", fg)
    f_cell(3, _r, _pct, fg)
    f_cell(4, _r, _dr, fg)
    f_cell(5, _r, str.tostring(_e, "+0.000;-0.000"), _e > 0 ? cUp : cDn)
    f_cell(6, _r, str.tostring(_e - 2 * _se, "+0.000;-0.000"), _e - 2 * _se > 0 ? cUp : cDn)
    f_cell(7, _r, _yr, fg)

f_data(int _r, string _nm, int _fy, int _aN, int _bd) =>
    _yrs = splitYr - _fy
    f_cell(0, _r, _nm, fg)
    f_cell(1, _r, str.tostring(_fy) + " se", fg)
    f_cell(2, _r, str.tostring(_aN) + " candle (2019 se pehle)", fg)
    f_cell(3, _r, _yrs > 0 ? "~" + str.tostring(_aN / _yrs, "#") + " / saal" : "-", fg)
    f_cell(4, _r, "galat waqt: " + str.tostring(_bd), _bd == 0 ? cUp : cDn)

if barstate.islast and hideRes
    f_cell(0, 0, "JAS DHAAT 66 " + BUILD + "  (#66)  -  SIRF DATA JAANCH (nateeja chhupa)", cHd)
    table.merge_cells(tb, 0, 0, 7, 0)
    f_cell(0, 1, "Dhaat", cHd)
    f_cell(1, 1, "4H data", cHd)
    f_cell(2, 1, "TALAASH candles", cHd)
    f_cell(3, 1, "Har saal (~1500 theek)", cHd)
    f_cell(4, 1, "4H waqt (17/21/1/5/9/13 NY)", cHd)
    f_data(2, "Platinum", fy1, aN1, bd1)
    f_data(3, "Palladium", fy2, aN2, bd2)
    f_data(4, "Copper", fy3, aN3, bd3)
    f_cell(0, 5, "Chart: " + syminfo.tickerid + " " + timeframe.period + "  |  sab se purana saal wala chart chunein (barabar = 1D), phir Settings mein 'PEHLE SIRF DATA' ka tick hatayein", fg)
    table.merge_cells(tb, 0, 5, 7, 5)

if barstate.islast and not hideRes
    f_cell(0, 0, "JAS DHAAT 66 " + BUILD + "  (#66)  -  Trend 4H (#34) x Platinum / Palladium / Copper", cHd)
    table.merge_cells(tb, 0, 0, 7, 0)
    f_cell(0, 1, "TALAASH (shuru - " + str.tostring(splitYr - 1) + ")", cHd)
    f_cell(1, 1, "Trade", cHd)
    f_cell(2, 1, "Jeet", cHd)
    f_cell(3, 1, "Trend ausat", cHd)
    f_cell(4, 1, "Aam tezi (maloomat)", cHd)
    f_cell(5, 1, "Har trade (R)", cHd)
    f_cell(6, 1, "Exp - 2SE", cHd)
    f_cell(7, 1, "Saal + / kul", cHd)
    d1 = f_dr(aS1, aN1, dT1)
    d2 = f_dr(aS2, aN2, dT2)
    d3 = f_dr(aS3, aN3, dT3)
    f_row(2, "Platinum  (" + str.tostring(fy1) + " se, kharcha " + str.tostring(c1) + "%)", nT1, wT1, sT1, qT1, f_p(nT1 > 0 ? pT1 / nT1 : 0.0), f_p(nT1 > 0 ? d1 / nT1 : 0.0), str.tostring(yP1) + " / " + str.tostring(yN1))
    f_row(3, "Palladium  (" + str.tostring(fy2) + " se, kharcha " + str.tostring(c2) + "%)", nT2, wT2, sT2, qT2, f_p(nT2 > 0 ? pT2 / nT2 : 0.0), f_p(nT2 > 0 ? d2 / nT2 : 0.0), str.tostring(yP2) + " / " + str.tostring(yN2))
    f_row(4, "Copper  (" + str.tostring(fy3) + " se, kharcha " + str.tostring(c3) + "%)", nT3, wT3, sT3, qT3, f_p(nT3 > 0 ? pT3 / nT3 : 0.0), f_p(nT3 > 0 ? d3 / nT3 : 0.0), str.tostring(yP3) + " / " + str.tostring(yN3))
    nK = nT1 + nT2 + nT3
    sK = sT1 + sT2 + sT3
    qK = qT1 + qT2 + qT3
    f_row(5, "KUL", nK, wT1 + wT2 + wT3, sK, qK, f_p(nK > 0 ? (pT1 + pT2 + pT3) / nK : 0.0), f_p(nK > 0 ? (d1 + d2 + d3) / nK : 0.0), str.tostring(yP1 + yP2 + yP3) + " / " + str.tostring(yN1 + yN2 + yN3))
    eK  = f_exp(nK, sK)
    seK = f_se(nK, sK, qK)
    mPos = (f_exp(nT1, sT1) > 0 ? 1 : 0) + (f_exp(nT2, sT2) > 0 ? 1 : 0) + (f_exp(nT3, sT3) > 0 ? 1 : 0)
    cells = yN1 + yN2 + yN3
    okT = nK >= 100 and eK - 2 * seK > 0 and mPos >= 2 and cells > 0 and (yP1 + yP2 + yP3) * 2 > cells
    f_cell(0, 6, okT ? "TALAASH PASS  -> IMTIHAN khol sakte hain" : "TALAASH FAIL  -> IMTIHAN band", okT ? cUp : cDn)
    table.merge_cells(tb, 0, 6, 7, 6)
    if showIm and okT
        f_cell(0, 7, "IMTIHAN (" + str.tostring(splitYr) + " - aaj)", cHd)
        table.merge_cells(tb, 0, 7, 7, 7)
        f_row(8, "Platinum", nI1, wI1, sI1, qI1, "-", "-", "-")
        f_row(9, "Palladium", nI2, wI2, sI2, qI2, "-", "-", "-")
        f_row(10, "Copper", nI3, wI3, sI3, qI3, "-", "-", "-")
        nIK = nI1 + nI2 + nI3
        sIK = sI1 + sI2 + sI3
        qIK = qI1 + qI2 + qI3
        eI  = f_exp(nIK, sIK)
        seI = f_se(nIK, sIK, qIK)
        okI = nIK >= 30 and eI - 2 * seI > 0
        f_cell(0, 11, "IMTIHAN KUL: " + str.tostring(nIK) + " tr, Exp " + str.tostring(eI, "+0.000;-0.000") + "R, Exp-2SE " + str.tostring(eI - 2 * seI, "+0.000;-0.000") + (okI ? "  = ASLI PASS" : "  = FAIL, idea band"), okI ? cUp : cDn)
        table.merge_cells(tb, 0, 11, 7, 11)
    else
        f_cell(0, 7, "IMTIHAN " + str.tostring(splitYr) + "+ CHHUPA (TALAASH PASS ke baad, EK dafa)", fg)
        table.merge_cells(tb, 0, 7, 7, 7)
