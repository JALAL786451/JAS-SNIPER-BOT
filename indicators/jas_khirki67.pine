//@version=6
// ============================================================================
//  JAS KHIRKI 67  (build k1, Pine v6)  -  Koshish #67 (1 Nov 2026, user 'D')
//
//  US (NYSE) CHUTTI KI KHIRKI - 7 NON-US index par (Casado-Muga-Santamaria
//  2013, Ariel 1990). Calendar #59 (jas_chutti.pine h1) wala. TRADE NAHI.
//
//  QAWAID (har index ki APNI daily candle, band candle [1], tareekh =
//  time_tradingday UTC): H = NYSE chutti, P = H se pehle aakhri NYSE din.
//   BUY: jis session ka AGLA weekday = P, us ke close par (P khud NYSE din ho
//   aur P ke baad wala weekday = H). Band: pehli session jis ki tareekh >= H,
//   us ke close par. SL 3 x ATR20 = 1R (daily low, gap = open). Sirf BUY.
//   Kharcha 0.02% har taraf + swap 3%/saal har raat (calendar din).
//   JURE HUE: ek waqia par 7 trade - SE x 2.14 (rho 0.6, pehle se tay).
//
//  PEHLE SE LIKHA QAIDA (docs/purana-haal.md, grep "Koshish #67 qaida"):
//   TALAASH entry < 2019: kul >= 100 tr, Exp - 2 x (2.14 SE) > 0, >= 5/7
//   index Exp > 0, (index x saal) musbat > 50%, khirki ausat % >= 2 x drift.
//   IMTIHAN 2019+ CHHUPA (sirf TALAASH PASS par, EK dafa) - research agent ne
//   2019+ dekh liya tha = aadha dekha; aakhri faisla demo se bhi.
//
//  CHART: koi bhi DAILY chart (misaal SP:SPX). 7 index request.security se.
// ============================================================================
indicator("JAS Khirki 67 k1 (#67)", shorttitle = "JAS KHIRKI67 k1", overlay = true, max_bars_back = 300)

BUILD = "k1"
TZ = "America/New_York"
DAY = 86400000
ADJ = 2.14

grI = "1 · 7 index (pehle se chune - badalna mana)"
s0 = input.symbol("XETR:DAX", "1 DAX (Germany)", group = grI)
s1 = input.symbol("TVC:UKX", "2 FTSE 100 (UK)", group = grI)
s2 = input.symbol("EURONEXT:PX1", "3 CAC 40 (France)", group = grI)
s3 = input.symbol("TVC:SX5E", "4 Euro Stoxx 50", group = grI)
s4 = input.symbol("TVC:NI225", "5 Nikkei 225 (Japan)", group = grI)
s5 = input.symbol("ASX:XJO", "6 ASX 200 (Australia)", group = grI)
s6 = input.symbol("TVC:HSI", "7 Hang Seng (HK)", group = grI)

grQ = "2 · Qawaid (mat badlein)"
atrLen  = input.int(20, "ATR length", minval = 2, group = grQ, display = display.none)
slMult  = input.float(3.0, "SL (x ATR) = 1R", minval = 0.5, step = 0.5, group = grQ, display = display.none)
costPct = input.float(0.02, "Kharcha (% har taraf)", minval = 0, step = 0.005, group = grQ, display = display.none)
swapYr  = input.float(3.0, "Swap (% saal, har raat)", minval = 0, step = 0.5, group = grQ, display = display.none)
fromYr  = input.int(1971, "TALAASH is saal se (calendar 1971+)", group = grQ, display = display.none)
splitYr = input.int(2019, "IMTIHAN is saal se (TALAASH is se pehle)", group = grQ, display = display.none)
showIm  = input.bool(false, "IMTIHAN dikhao (SIRF TALAASH PASS ke baad, EK dafa)", group = grQ, display = display.none)

grV = "3 · Table"
tblPos = input.string("Top Right", "Table ki jagah", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grV, display = display.none)

// ============================================================================
//  NYSE CALENDAR (#59 jas_chutti.pine h1 se, Python mein jaancha hua)
// ============================================================================
f_easter(int y) =>
    a = y % 19
    b = math.floor(y / 100)
    c = y % 100
    d = math.floor(b / 4)
    e = b % 4
    f = math.floor((b + 8) / 25)
    g = math.floor((b - f + 1) / 3)
    h = (19 * a + b - d - g + 15) % 30
    i = math.floor(c / 4)
    k = c % 4
    l = (32 + 2 * e + 2 * i - h - k) % 7
    m = math.floor((a + 11 * h + 22 * l) / 451)
    n = h + l - 7 * m + 114
    [math.floor(n / 31), n % 31 + 1]

f_isWk(int ts) =>
    w = dayofweek(ts, TZ)
    w != dayofweek.saturday and w != dayofweek.sunday

f_isHol(int ts) =>
    y = year(ts, TZ)
    m = month(ts, TZ)
    d = dayofmonth(ts, TZ)
    w = dayofweek(ts, TZ)
    wk = w != dayofweek.saturday and w != dayofweek.sunday
    mon = w == dayofweek.monday
    fri = w == dayofweek.friday
    bool h = false
    if m == 1
        h := (d == 1 and wk) or (d == 2 and mon) or (y >= 1998 and mon and d >= 15 and d <= 21)
    else if m == 2
        h := mon and d >= 15 and d <= 21
    else if m == 5
        h := mon and d >= 25
    else if m == 6
        h := y >= 2022 and ((d == 19 and wk) or (d == 18 and fri) or (d == 20 and mon))
    else if m == 7
        h := (d == 4 and wk) or (d == 3 and fri) or (d == 5 and mon)
    else if m == 9
        h := mon and d <= 7
    else if m == 11
        h := (w == dayofweek.thursday and d >= 22 and d <= 28) or ((y == 1972 or y == 1976 or y == 1980) and w == dayofweek.tuesday and d >= 2 and d <= 8)
    else if m == 12
        h := (d == 25 and wk) or (d == 24 and fri) or (d == 26 and mon)
    if not h and fri and (m == 3 or m == 4)
        [em, ed] = f_easter(y)
        gf = timestamp(TZ, y, em, ed, 12, 0) - 2 * DAY
        h := month(gf, TZ) == m and dayofmonth(gf, TZ) == d
    h

// index ki session (y-m-d) ka AGLA weekday P: P NYSE din ho aur P ke baad wala weekday NYSE chutti H = H ki tareekh (yyyymmdd), warna 0
f_win(int y, int m, int d) =>
    noon = timestamp(TZ, y, m, d, 12, 0)
    int p = noon
    for k = 1 to 4
        p := noon + k * DAY
        if f_isWk(p)
            break
    int hy = 0
    if not f_isHol(p)
        int q = p
        for k = 1 to 4
            q := p + k * DAY
            if f_isWk(q)
                break
        if f_isHol(q)
            hy := year(q, TZ) * 10000 + month(q, TZ) * 100 + dayofmonth(q, TZ)
    hy

// ============================================================================
//  ENGINE (har index ki apni daily candles, sirf BAND candle [1])
// ============================================================================
f_kh() =>
    _atrA = ta.atr(atrLen)
    _o  = open[1]
    _l  = low[1]
    _c  = close[1]
    _cp = close[2]
    _a  = _atrA[1]
    _td = time_tradingday[1]
    var int   _fy  = na
    var bool  _in  = false
    var float _e   = na
    var float _r   = na
    var float _sl  = na
    var int   _xd  = 0
    var int   _ey  = na
    var int   _et  = na
    var int   _age = 0
    var int   _nT = 0
    var int   _wT = 0
    var float _sT = 0.0
    var float _qT = 0.0
    var float _pT = 0.0
    var int   _dT = 0
    var int   _aN = 0
    var float _aS = 0.0
    var int   _yNT = 0
    var int   _yPT = 0
    var int   _cyT = na
    var float _csT = 0.0
    var int   _nI = 0
    var int   _wI = 0
    var float _sI = 0.0
    var float _qI = 0.0
    var float _pI = 0.0
    var int   _dI = 0
    var int   _aNI = 0
    var float _aSI = 0.0
    if not na(_c) and not na(_td)
        _y   = year(_td, "UTC")
        _m   = month(_td, "UTC")
        _d   = dayofmonth(_td, "UTC")
        _ymd = _y * 10000 + _m * 100 + _d
        if na(_fy) and _y >= fromYr
            _fy := _y
        if not na(_cp) and _cp > 0 and _y >= fromYr
            if _y < splitYr
                _aN += 1
                _aS += _c / _cp - 1
            else
                _aNI += 1
                _aSI += _c / _cp - 1
        bool  _cl = false
        float _px = na
        if _in
            _age += 1
            if _l <= _sl
                _px := _o < _sl ? _o : _sl
                _cl := true
            else if _ymd >= _xd
                _px := _c
                _cl := true
        if _cl
            _nights = math.round((_td - _et) / 86400000.0)
            _rr = ((_px - _e) - costPct / 100.0 * (_e + _px) - swapYr / 100.0 / 365.0 * _nights * _e) / _r
            _pc = _px / _e - 1
            if _ey < splitYr
                _nT += 1
                _sT += _rr
                _qT += _rr * _rr
                _pT += _pc
                _dT += _age
                _wT += _rr > 0 ? 1 : 0
                if na(_cyT) or _ey != _cyT
                    if not na(_cyT)
                        _yNT += 1
                        _yPT += _csT > 0 ? 1 : 0
                    _cyT := _ey
                    _csT := 0.0
                _csT += _rr
            else
                _nI += 1
                _sI += _rr
                _qI += _rr * _rr
                _pI += _pc
                _dI += _age
                _wI += _rr > 0 ? 1 : 0
            _in := false
        if not _in and not _cl and _y >= fromYr and not na(_a) and _a > 0
            _hy = f_win(_y, _m, _d)
            if _hy > 0
                _in  := true
                _e   := _c
                _r   := slMult * _a
                _sl  := _c - _r
                _xd  := _hy
                _ey  := _y
                _et  := _td
                _age := 0
    _yN = _yNT + (na(_cyT) ? 0 : 1)
    _yP = _yPT + (not na(_cyT) and _csT > 0 ? 1 : 0)
    [_nT, _wT, _sT, _qT, _pT, _dT, _aN, _aS, _yN, _yP, _nI, _wI, _sI, _qI, _pI, _dI, _aNI, _aSI, _fy]

f_req(_s) => request.security(_s, "D", f_kh(), barmerge.gaps_off, barmerge.lookahead_off)

[nT0, wT0, sT0, qT0, pT0, dT0, aN0, aS0, yN0, yP0, nI0, wI0, sI0, qI0, pI0, dI0, aNI0, aSI0, fy0] = f_req(s0)
[nT1, wT1, sT1, qT1, pT1, dT1, aN1, aS1, yN1, yP1, nI1, wI1, sI1, qI1, pI1, dI1, aNI1, aSI1, fy1] = f_req(s1)
[nT2, wT2, sT2, qT2, pT2, dT2, aN2, aS2, yN2, yP2, nI2, wI2, sI2, qI2, pI2, dI2, aNI2, aSI2, fy2] = f_req(s2)
[nT3, wT3, sT3, qT3, pT3, dT3, aN3, aS3, yN3, yP3, nI3, wI3, sI3, qI3, pI3, dI3, aNI3, aSI3, fy3] = f_req(s3)
[nT4, wT4, sT4, qT4, pT4, dT4, aN4, aS4, yN4, yP4, nI4, wI4, sI4, qI4, pI4, dI4, aNI4, aSI4, fy4] = f_req(s4)
[nT5, wT5, sT5, qT5, pT5, dT5, aN5, aS5, yN5, yP5, nI5, wI5, sI5, qI5, pI5, dI5, aNI5, aSI5, fy5] = f_req(s5)
[nT6, wT6, sT6, qT6, pT6, dT6, aN6, aS6, yN6, yP6, nI6, wI6, sI6, qI6, pI6, dI6, aNI6, aSI6, fy6] = f_req(s6)

// ============================================================================
//  TABLE (safaid)
// ============================================================================
f_pos(_p) => _p == "Top Left" ? position.top_left : _p == "Bottom Right" ? position.bottom_right : _p == "Bottom Left" ? position.bottom_left : position.top_right

f_exp(_n, _s) => _n > 0 ? _s / _n : 0.0
f_se(_n, _s, _q) =>
    _m = _n > 0 ? _s / _n : 0.0
    _n > 1 ? math.sqrt(math.max((_q - _n * _m * _m) / (_n - 1), 0.0)) / math.sqrt(_n) : 0.0
f_dr(float _aS, int _aN, int _d) => _aN > 0 ? _aS / _aN * _d : 0.0

var table tb = table.new(f_pos(tblPos), 8, 22, bgcolor = color.white, border_color = color.new(#9e9e9e, 0), border_width = 1)
fg  = color.new(#111111, 0)
cUp = color.new(#0a8f5a, 0)
cDn = color.new(#d32f2f, 0)
cHd = color.new(#1a237e, 0)

f_cell(int _c, int _r, string _s, color _col) =>
    table.cell(tb, _c, _r, _s, text_color = _col, text_size = size.small)

f_p(float _x) => str.tostring(100.0 * _x, "+0.000;-0.000") + "%"

// [_e, _seAdj] - adj = 2.14 sirf KUL par (jure hue waqiat)
f_row(int _r, string _nm, int _n, int _w, float _s, float _q, float _ip, float _dr, string _yr, float _adj) =>
    _e  = f_exp(_n, _s)
    _se = f_se(_n, _s, _q) * _adj
    f_cell(0, _r, _nm, fg)
    f_cell(1, _r, str.tostring(_n), fg)
    f_cell(2, _r, str.tostring(_n > 0 ? 100.0 * _w / _n : 0.0, "#") + "%", fg)
    f_cell(3, _r, f_p(_ip), _ip >= 2 * _dr ? cUp : cDn)
    f_cell(4, _r, f_p(_dr), fg)
    f_cell(5, _r, str.tostring(_e, "+0.000;-0.000"), _e > 0 ? cUp : cDn)
    f_cell(6, _r, str.tostring(_e - 2 * _se, "+0.000;-0.000"), _e - 2 * _se > 0 ? cUp : cDn)
    f_cell(7, _r, _yr, fg)
    [_e, _se]

if barstate.islast
    anT = array.from(nT0, nT1, nT2, nT3, nT4, nT5, nT6)
    awT = array.from(wT0, wT1, wT2, wT3, wT4, wT5, wT6)
    asT = array.from(sT0, sT1, sT2, sT3, sT4, sT5, sT6)
    aqT = array.from(qT0, qT1, qT2, qT3, qT4, qT5, qT6)
    apT = array.from(pT0, pT1, pT2, pT3, pT4, pT5, pT6)
    adT = array.from(dT0, dT1, dT2, dT3, dT4, dT5, dT6)
    aaN = array.from(aN0, aN1, aN2, aN3, aN4, aN5, aN6)
    aaS = array.from(aS0, aS1, aS2, aS3, aS4, aS5, aS6)
    ayN = array.from(yN0, yN1, yN2, yN3, yN4, yN5, yN6)
    ayP = array.from(yP0, yP1, yP2, yP3, yP4, yP5, yP6)
    anI = array.from(nI0, nI1, nI2, nI3, nI4, nI5, nI6)
    awI = array.from(wI0, wI1, wI2, wI3, wI4, wI5, wI6)
    asI = array.from(sI0, sI1, sI2, sI3, sI4, sI5, sI6)
    aqI = array.from(qI0, qI1, qI2, qI3, qI4, qI5, qI6)
    apI = array.from(pI0, pI1, pI2, pI3, pI4, pI5, pI6)
    adI = array.from(dI0, dI1, dI2, dI3, dI4, dI5, dI6)
    aaNI = array.from(aNI0, aNI1, aNI2, aNI3, aNI4, aNI5, aNI6)
    aaSI = array.from(aSI0, aSI1, aSI2, aSI3, aSI4, aSI5, aSI6)
    afy = array.from(fy0, fy1, fy2, fy3, fy4, fy5, fy6)
    aNm = array.from("DAX (Germany)", "FTSE 100 (UK)", "CAC 40 (France)", "Euro Stoxx 50", "Nikkei 225 (Japan)", "ASX 200 (Australia)", "Hang Seng (HK)")
    f_cell(0, 0, "JAS KHIRKI 67 " + BUILD + "  (#67)  -  US chutti ki khirki x 7 non-US index", cHd)
    table.merge_cells(tb, 0, 0, 7, 0)
    f_cell(0, 1, "TALAASH (shuru - " + str.tostring(splitYr - 1) + ")", cHd)
    f_cell(1, 1, "Trade", cHd)
    f_cell(2, 1, "Jeet", cHd)
    f_cell(3, 1, "Khirki ausat", cHd)
    f_cell(4, 1, "Aam tezi (drift)", cHd)
    f_cell(5, 1, "Har trade (R)", cHd)
    f_cell(6, 1, "Exp - 2SE", cHd)
    f_cell(7, 1, "Saal + / kul", cHd)
    int nK = 0
    int wK = 0
    float sK = 0.0
    float qK = 0.0
    float pK = 0.0
    float dK = 0.0
    int yNK = 0
    int yPK = 0
    int ps = 0
    for i = 0 to 6
        n = array.get(anT, i)
        dr = f_dr(array.get(aaS, i), array.get(aaN, i), array.get(adT, i))
        [e_, se_] = f_row(2 + i, array.get(aNm, i) + "  (" + str.tostring(array.get(afy, i)) + " se)", n, array.get(awT, i), array.get(asT, i), array.get(aqT, i), n > 0 ? array.get(apT, i) / n : 0.0, n > 0 ? dr / n : 0.0, str.tostring(array.get(ayP, i)) + " / " + str.tostring(array.get(ayN, i)), 1.0)
        nK += n
        wK += array.get(awT, i)
        sK += array.get(asT, i)
        qK += array.get(aqT, i)
        pK += array.get(apT, i)
        dK += dr
        yNK += array.get(ayN, i)
        yPK += array.get(ayP, i)
        ps += e_ > 0 ? 1 : 0
    ipK = nK > 0 ? pK / nK : 0.0
    drK = nK > 0 ? dK / nK : 0.0
    [eK, seK] = f_row(9, "KUL (SE x 2.14)", nK, wK, sK, qK, ipK, drK, str.tostring(yPK) + " / " + str.tostring(yNK), ADJ)
    okT = nK >= 100 and eK - 2 * seK > 0 and ps >= 5 and yNK > 0 and yPK * 2 > yNK and ipK >= 2 * drK
    f_cell(0, 10, (okT ? "TALAASH PASS  -> IMTIHAN khol sakte hain" : "TALAASH FAIL  -> IMTIHAN band") + "  |  index faide mein " + str.tostring(ps) + " / 7", okT ? cUp : cDn)
    table.merge_cells(tb, 0, 10, 7, 10)
    if showIm and okT
        f_cell(0, 11, "IMTIHAN (" + str.tostring(splitYr) + " - aaj)  - aadha dekha (research agent)", cHd)
        table.merge_cells(tb, 0, 11, 7, 11)
        int nI = 0
        int wI = 0
        float sI = 0.0
        float qI = 0.0
        float pI = 0.0
        float dI = 0.0
        for i = 0 to 6
            n = array.get(anI, i)
            dr = f_dr(array.get(aaSI, i), array.get(aaNI, i), array.get(adI, i))
            [e2_, se2_] = f_row(12 + i, array.get(aNm, i), n, array.get(awI, i), array.get(asI, i), array.get(aqI, i), n > 0 ? array.get(apI, i) / n : 0.0, n > 0 ? dr / n : 0.0, "-", 1.0)
            nI += n
            wI += array.get(awI, i)
            sI += array.get(asI, i)
            qI += array.get(aqI, i)
            pI += array.get(apI, i)
            dI += dr
        ipI = nI > 0 ? pI / nI : 0.0
        drI = nI > 0 ? dI / nI : 0.0
        [eI, seI] = f_row(19, "KUL (SE x 2.14)", nI, wI, sI, qI, ipI, drI, "-", ADJ)
        okI = nI >= 30 and eI - 2 * seI > 0 and ipI >= 2 * drI
        f_cell(0, 20, okI ? "IMTIHAN PASS (demo se tasdeeq baqi)" : "IMTIHAN FAIL = idea band", okI ? cUp : cDn)
        table.merge_cells(tb, 0, 20, 7, 20)
    else
        f_cell(0, 11, "IMTIHAN " + str.tostring(splitYr) + "+ CHHUPA (TALAASH PASS ke baad, EK dafa)", fg)
        table.merge_cells(tb, 0, 11, 7, 11)
