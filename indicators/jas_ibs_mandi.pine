//@version=6
// ============================================================================
//  JAS IBS MANDI  (build m1, Pine v6)  -  Koshish #58 (1 Nov 2026, user 'D')
//
//  Sawal: #15 / #53 ka IBS sirf UPAR ke rukh (close > SMA200) mein khareedta
//  hai. MANDI (close < SMA200, misaal 2008, 2020, 2022) mein bhi gehri
//  girawat ke baad index uchhalta hai? (Connors: neeche ke rukh mein bhi
//  mean reversion - magar zyada jhatke). TRADE NAHI - sirf naap.
//
//  QAWAID (har index ki apni DAILY candles, sirf BAND candle [1]):
//   1) IBS = (close - low) / (high - low).
//   2) BUY: IBS < 0.2 AUR close < SMA200 (MANDI), din ke close par. Sirf BUY.
//   3) Band: kisi din IBS > 0.8 to us din ke close par, ya 5 din baad close.
//   4) SL 3 x ATR(14) = 1R, candle ke andar (gap = open). Band / SL wale din
//      nayi nahi. Ek market ek position.
//   5) Kharcha 0.01% har taraf + swap 3%/saal har raat (calendar din) -> R.
//
//  PEHLE SE LIKHA QAIDA (docs/purana-haal.md, grep "Koshish #58 qaida"):
//   TALAASH = data shuru se 2018 (entry saal). PASS = kul >= 100 trade AUR
//   kul Exp - 2SE > 0 AUR dono index Exp > 0 AUR (index x saal, sirf trade
//   wale saal) musbat > 50%.
//   IMTIHAN (2019+) CHHUPA jab tak TALAASH PASS; phir EK dafa: kul >= 30
//   trade AUR Exp - 2SE > 0 = ASLI PASS. Settings badal kar dobara MANA.
//
//  CHART: SP:SPX, Daily (lamba data). NDX request.security se.
// ============================================================================
indicator("JAS IBS Mandi m1 (#58)", shorttitle = "JAS IBS MANDI m1", overlay = true, max_bars_back = 300)

BUILD = "m1"

grI = "1 · 2 index (pehle se chune - badalna mana)"
s0 = input.symbol("SP:SPX", "1 S&P 500", group = grI)
s1 = input.symbol("NASDAQ:NDX", "2 Nasdaq 100", group = grI)

grQ = "2 · Qawaid (mat badlein)"
ibsLo    = input.float(0.2, "BUY: IBS is se kam", step = 0.05, group = grQ, display = display.none)
ibsHi    = input.float(0.8, "Band: IBS is se zyada", step = 0.05, group = grQ, display = display.none)
maxDays  = input.int(5, "Zyada se zyada din", minval = 1, group = grQ, display = display.none)
trendLen = input.int(200, "Rukh SMA", minval = 10, group = grQ, display = display.none)
atrLen   = input.int(14, "ATR length", minval = 2, group = grQ, display = display.none)
slMult   = input.float(3.0, "SL (x ATR)", minval = 0.5, step = 0.5, group = grQ, display = display.none)
costPct  = input.float(0.01, "Kharcha (% har taraf)", minval = 0, step = 0.005, group = grQ, display = display.none)
swapYr   = input.float(3.0, "Swap (% saal, har raat)", minval = 0, step = 0.5, group = grQ, display = display.none)
splitYr  = input.int(2019, "IMTIHAN is saal se (TALAASH is se pehle)", group = grQ, display = display.none)
showIm   = input.bool(false, "IMTIHAN dikhao (SIRF TALAASH PASS ke baad, EK dafa)", group = grQ, display = display.none)

grV = "3 · Table"
tblPos = input.string("Top Right", "Table ki jagah", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grV, display = display.none)

// ============================================================================
//  ENGINE (har index ki apni daily candles par, sirf BAND candle)
// ============================================================================
f_ibs() =>
    _atrA = ta.atr(atrLen)
    _smA  = ta.sma(close, trendLen)
    _o   = open[1]
    _h   = high[1]
    _l   = low[1]
    _c   = close[1]
    _a   = _atrA[1]
    _sm  = _smA[1]
    _t   = time[1]
    _yr  = year(time_close[1])
    _ibs = not na(_h) and _h > _l ? (_c - _l) / (_h - _l) : na
    var int   _fy  = na
    var bool  _in  = false
    var float _e   = na
    var float _r   = na
    var float _sl  = na
    var int   _ey  = na
    var int   _et  = na
    var int   _age = 0
    var int   _nT = 0
    var int   _wT = 0
    var float _sT = 0.0
    var float _qT = 0.0
    var int   _yNT = 0
    var int   _yPT = 0
    var int   _cyT = na
    var float _csT = 0.0
    var int   _nI = 0
    var int   _wI = 0
    var float _sI = 0.0
    var float _qI = 0.0
    if not na(_c)
        if na(_fy)
            _fy := _yr
        bool  _cl = false
        float _px = na
        if _in
            _age += 1
            if _l <= _sl
                _px := _o < _sl ? _o : _sl
                _cl := true
            else if (not na(_ibs) and _ibs > ibsHi) or _age >= maxDays
                _px := _c
                _cl := true
        if _cl
            _nights = math.round((_t - _et) / 86400000.0)
            _rr = ((_px - _e) - costPct / 100.0 * (_e + _px) - swapYr / 100.0 / 365.0 * _nights * _e) / _r
            if _ey < splitYr
                _nT += 1
                _sT += _rr
                _qT += _rr * _rr
                _wT += _rr > 0 ? 1 : 0
                if na(_cyT) or _ey != _cyT
                    if not na(_cyT)
                        _yNT += 1
                        _yPT += _csT > 0 ? 1 : 0
                    _cyT := _ey
                    _csT := 0.0
                _csT += _rr
            else
                _nI += 1
                _sI += _rr
                _qI += _rr * _rr
                _wI += _rr > 0 ? 1 : 0
            _in := false
        if not _in and not _cl and not na(_ibs) and not na(_sm) and not na(_a) and _a > 0 and _ibs < ibsLo and _c < _sm
            _in  := true
            _e   := _c
            _r   := slMult * _a
            _sl  := _c - _r
            _ey  := _yr
            _et  := _t
            _age := 0
    _yN = _yNT + (na(_cyT) ? 0 : 1)
    _yP = _yPT + (not na(_cyT) and _csT > 0 ? 1 : 0)
    [_nT, _wT, _sT, _qT, _yN, _yP, _nI, _wI, _sI, _qI, _fy, _in ? 1 : 0]

f_req(_s) => request.security(_s, "D", f_ibs(), barmerge.gaps_off, barmerge.lookahead_off)

[nT0, wT0, sT0, qT0, yN0, yP0, nI0, wI0, sI0, qI0, fy0, d0] = f_req(s0)
[nT1, wT1, sT1, qT1, yN1, yP1, nI1, wI1, sI1, qI1, fy1, d1] = f_req(s1)

// ============================================================================
//  TABLE (safaid)
// ============================================================================
f_pos(_p) => _p == "Top Left" ? position.top_left : _p == "Bottom Right" ? position.bottom_right : _p == "Bottom Left" ? position.bottom_left : position.top_right

f_exp(_n, _s) => _n > 0 ? _s / _n : 0.0
f_se(_n, _s, _q) =>
    _m = _n > 0 ? _s / _n : 0.0
    _n > 1 ? math.sqrt(math.max((_q - _n * _m * _m) / (_n - 1), 0.0)) / math.sqrt(_n) : 0.0

var table tb = table.new(f_pos(tblPos), 6, 11, bgcolor = color.white, border_color = color.new(#9e9e9e, 0), border_width = 1)
fg  = color.new(#111111, 0)
cUp = color.new(#0a8f5a, 0)
cDn = color.new(#d32f2f, 0)
cHd = color.new(#1a237e, 0)

f_row(int _r, string _nm, int _n, int _w, float _s, float _q, string _yr) =>
    _e  = f_exp(_n, _s)
    _se = f_se(_n, _s, _q)
    table.cell(tb, 0, _r, _nm, text_color = fg, text_size = size.small)
    table.cell(tb, 1, _r, str.tostring(_n), text_color = fg, text_size = size.small)
    table.cell(tb, 2, _r, str.tostring(_n > 0 ? 100.0 * _w / _n : 0.0, "#") + "%", text_color = fg, text_size = size.small)
    table.cell(tb, 3, _r, str.tostring(_e, "+0.000;-0.000"), text_color = _e > 0 ? cUp : cDn, text_size = size.small)
    table.cell(tb, 4, _r, str.tostring(_e - 2 * _se, "+0.000;-0.000"), text_color = _e - 2 * _se > 0 ? cUp : cDn, text_size = size.small)
    table.cell(tb, 5, _r, _yr, text_color = fg, text_size = size.small)

if barstate.islast
    table.cell(tb, 0, 0, "JAS IBS MANDI " + BUILD + "  (#58)  -  IBS jab close < SMA200", text_color = cHd, text_size = size.small)
    table.merge_cells(tb, 0, 0, 5, 0)
    table.cell(tb, 0, 1, "TALAASH (shuru - " + str.tostring(splitYr - 1) + ")", text_color = cHd, text_size = size.small)
    table.cell(tb, 1, 1, "Trade", text_color = cHd, text_size = size.small)
    table.cell(tb, 2, 1, "Jeet", text_color = cHd, text_size = size.small)
    table.cell(tb, 3, 1, "Har trade (R)", text_color = cHd, text_size = size.small)
    table.cell(tb, 4, 1, "Exp - 2SE", text_color = cHd, text_size = size.small)
    table.cell(tb, 5, 1, "Saal + / kul", text_color = cHd, text_size = size.small)
    f_row(2, "S&P 500  (" + str.tostring(fy0) + " se)", nT0, wT0, sT0, qT0, str.tostring(yP0) + " / " + str.tostring(yN0))
    f_row(3, "Nasdaq 100  (" + str.tostring(fy1) + " se)", nT1, wT1, sT1, qT1, str.tostring(yP1) + " / " + str.tostring(yN1))
    nK = nT0 + nT1
    sK = sT0 + sT1
    qK = qT0 + qT1
    f_row(4, "KUL", nK, wT0 + wT1, sK, qK, str.tostring(yP0 + yP1) + " / " + str.tostring(yN0 + yN1))
    eK  = f_exp(nK, sK)
    seK = f_se(nK, sK, qK)
    cells = yN0 + yN1
    okT = nK >= 100 and eK - 2 * seK > 0 and f_exp(nT0, sT0) > 0 and f_exp(nT1, sT1) > 0 and cells > 0 and (yP0 + yP1) * 2 > cells
    table.cell(tb, 0, 5, okT ? "TALAASH PASS  -> IMTIHAN khol sakte hain" : "TALAASH FAIL  -> IMTIHAN band", text_color = okT ? cUp : cDn, text_size = size.small)
    table.merge_cells(tb, 0, 5, 5, 5)
    if showIm
        table.cell(tb, 0, 6, "IMTIHAN (" + str.tostring(splitYr) + " - aaj)", text_color = cHd, text_size = size.small)
        table.merge_cells(tb, 0, 6, 5, 6)
        f_row(7, "S&P 500", nI0, wI0, sI0, qI0, "-")
        f_row(8, "Nasdaq 100", nI1, wI1, sI1, qI1, "-")
        nIK = nI0 + nI1
        sIK = sI0 + sI1
        qIK = qI0 + qI1
        f_row(9, "KUL", nIK, wI0 + wI1, sIK, qIK, "-")
        eI  = f_exp(nIK, sIK)
        seI = f_se(nIK, sIK, qIK)
        okI = nIK >= 30 and eI - 2 * seI > 0
        table.cell(tb, 0, 10, okI ? "IMTIHAN PASS = ASLI PASS" : "IMTIHAN FAIL = idea band", text_color = okI ? cUp : cDn, text_size = size.small)
        table.merge_cells(tb, 0, 10, 5, 10)
    else
        table.cell(tb, 0, 6, "IMTIHAN " + str.tostring(splitYr) + "+ CHHUPA (TALAASH PASS ke baad, EK dafa)", text_color = fg, text_size = size.small)
        table.merge_cells(tb, 0, 6, 5, 6)
