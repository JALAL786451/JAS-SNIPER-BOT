//@version=6
// ============================================================================
//  JAS GOLD REHNUMA  (build r2, Pine v6, 16 Nov 2026)   - NAYI file; r1 (11 Nov) branch fish-demo-trend-1h par waisi hi.
//  User (16 Nov): "design chart ke hisab se mazeed professional; SELL ka idea; chhoti TF par BUY ka bhi idea."
//
//  r2 = r1 ka ASAL qaida HUBAHU (4H Supertrend 10/3, sirf BUY, SL 6 ATR, TP nahi = JasTrendEA t5) + 3 nayi cheezein:
//   (1) DESIGN: rukh ka halka badal (fill), sarnama wala dabba, rukh ki patti (1D / 4H / 1H), khuli trade ka
//       risk / faida dabba (drawing - paimana nahi bigarta).
//   (2) CHHOTA BUY idea (1H): 1H Supertrend upar palte JAB 4H rukh upar ho -> BUY idea, SL 3 x ATR(1H),
//       1H neeche palte par band. Python (tools/rehnuma_r2_test.py, gold H1, kharcha + swap, EK hi variant):
//       2003-18: 409 tr +0.199R (kul +81.5R, girawat 20.3R) | 2019-26: 207 tr +0.329R (kul +68.2R, girawat 13.4R).
//       R chhota hai (SL 3 ATR 1H) - 4H wale R se seedha muqabla NAHI. Abhi sirf IDEA: EA nahi, pehle demo.
//   (3) SELL idea: sirf ITTILA (4H neeche palta / kis qeemat par paltega). NAAP FAIL:
//       4H SELL 2003-18 -6.1R, 2019-26 -15.6R ; 1H SELL (4H neeche) 2019-26 -32.7R. Is liye SELL ka lot / SL NAHI likha.
//
//  REPAINT NAHI: faisla sirf BAND candle par; engine ka data block ki aakhri chart candle par (lookahead_off, sirf
//  jab waqt engine candle se mile) warna pichhli BAND engine candle ([1] + lookahead_on). 1H engine bhi isi tarha.
//  Chart 1m..1H par sab kuch; 4H par chhota idea nahi (1H ya chhota chart lagayein). Aage ki guarantee NAHI.
// ============================================================================
indicator("JAS Gold Rehnuma r2", shorttitle = "JAS REHNUMA r2", overlay = true, max_lines_count = 60, max_boxes_count = 30, max_labels_count = 60)

grQ = "1 · Qaida (EA / Python jaisa - mat badlein)"
atrLen  = input.int(10, "Supertrend ATR length", minval = 2, group = grQ, display = display.none)
atrMult = input.float(3.0, "Supertrend multiplier", minval = 0.5, step = 0.1, group = grQ, display = display.none)
slMult  = input.float(6.0, "SL = kitne x ATR", minval = 0.5, step = 0.5, group = grQ, display = display.none)
useD    = input.bool(false, "Filter: 1D Supertrend UPAR ho tab hi BUY (band = EA t5 jaisa)", group = grQ, display = display.none)

grA = "2 · Aap ka account (lot ke liye)"
myBal   = input.float(38900, "Mera balance (cent account = USC, dollar account = $)", minval = 1, group = grA, display = display.none)
myRisk  = input.float(0.75, "Meri hadd: ek trade par zyada se zyada kitna % balance", minval = 0.05, step = 0.05, group = grA, display = display.none)
lateMin = input.int(15, "Ishare ke baad kitne minute tak 'ABHI'", minval = 1, maxval = 240, group = grA, display = display.none)
myTZ    = input.string("Asia/Karachi", "Waqt kis jagah ka (PKT = Asia/Karachi)", group = grA, display = display.none)

grI = "3 · Idea (r2): chhota BUY + SELL ittila"
showMini = input.bool(true, "CHHOTA BUY idea (1H palta + 4H upar) - chart 1H ya chhota", group = grI, display = display.none)
miniSl   = input.float(3.0, "Chhota BUY: SL = kitne x ATR(1H) (naap 3.0)", minval = 0.5, step = 0.5, group = grI, display = display.none)
miniRisk = input.float(0.25, "Chhote idea ka risk % (4H BUY ke ILAWA lagta hai - chhota rakhein)", minval = 0.05, step = 0.05, group = grI, display = display.none)
showSell = input.bool(true, "SELL idea ki qatar + lakeer (sirf ittila - naap FAIL)", group = grI, display = display.none)

grV = "4 · Dikhawa"
showLn   = input.bool(true, "Supertrend lakeer", group = grV, display = display.none)
showFill = input.bool(true, "Rukh ka halka badal (lakeer aur qeemat ke beech)", group = grV, display = display.none)
showBar  = input.bool(false, "Candles ko rukh ka rang (default band)", group = grV, display = display.none)
showNext = input.bool(true, "Chart par AGLI / KHULI trade (entry, SL)", group = grV, display = display.none)
showOld  = input.bool(false, "Purani trades ke chhote nishan (default band)", group = grV, display = display.none)
showWhy  = input.bool(true, "Dabbe mein 'Kyun' ki qatar (seekhne ke liye)", group = grV, display = display.none)
tPos     = input.string("Top Right", "Dabbe ki jagah", options = ["Middle Left", "Top Left", "Bottom Left", "Top Right", "Middle Right", "Bottom Right"], group = grV, display = display.none)
tSize    = input.string("Small", "Dabbe ki likhai", options = ["Tiny", "Small", "Normal"], group = grV, display = display.none)
alertOn  = input.bool(true, "Alert bhejo (BUY / BAND) - TV mein 'Any alert() function call' chunein", group = grV, display = display.none)

// ============================================================================
//  ENGINE (u3 jaisa): chart 1m..4H -> 4H ; 4H se bara..1D -> 1D
// ============================================================================
chSec  = timeframe.in_seconds()
engTF  = chSec <= 14400 ? "240" : "D"
engSec = timeframe.in_seconds(engTF)
engNm  = engTF == "D" ? "1D" : "4H"
okTF   = chSec <= 86400
okCh   = chart.is_standard
stdTk  = ticker.standard(syminfo.tickerid)
useDf  = useD and engTF == "240"

f_cur() =>
    [s, d] = ta.supertrend(atrMult, atrLen)
    a = ta.atr(atrLen)
    [s, d, a, time]

f_prv() =>
    [s, d] = ta.supertrend(atrMult, atrLen)
    a = ta.atr(atrLen)
    [s[1], d[1], a[1], time[1]]

f_dcur() =>
    [s, d] = ta.supertrend(atrMult, atrLen)
    [d, time]

f_dprv() =>
    [s, d] = ta.supertrend(atrMult, atrLen)
    [d[1], time[1]]

[stC, drC, atC, tC] = request.security(stdTk, engTF, f_cur(), lookahead = barmerge.lookahead_off)
[stP, drP, atP, tP] = request.security(stdTk, engTF, f_prv(), lookahead = barmerge.lookahead_on)
[ddC, tdC] = request.security(stdTk, "D", f_dcur(), lookahead = barmerge.lookahead_off)
[ddP, tdP] = request.security(stdTk, "D", f_dprv(), lookahead = barmerge.lookahead_on)

// r2: chhota engine 1H (chart 1H ya chhota). Bare chart par engTF hi maango (istemal nahi hota).
bool   okMini = chSec <= 3600
string miniTF = okMini ? "60" : engTF
[msC, mdC, maC, mtC] = request.security(stdTk, miniTF, f_cur(), lookahead = barmerge.lookahead_off)
[msP, mdP, maP, mtP] = request.security(stdTk, miniTF, f_prv(), lookahead = barmerge.lookahead_on)
int  miniOpen = time(miniTF)
bool lastMini = time_close == time_close(miniTF)

int  engOpen  = time(engTF)
int  dayOpen  = time("D")
int  engClose = time_close(engTF)
bool lastEng  = time_close == engClose
bool lastDay  = time_close == time_close("D")
bool dPrevUp  = not na(ddP) and ddP < 0

// ============================================================================
//  HAAL: faisla band candle par, bhar agli candle ki open par (strategy u3 jaisi tarteeb)
// ============================================================================
var int   eDir     = 0       // aakhri dekhi hui band engine candle ka rukh
var int   procT    = na
var bool  inPos    = false
var bool  pendBuy  = false
var bool  pendExit = false
var float pendRd   = na
var float enPx     = na
var float slPx     = na
var float rdPx     = na
var float buyRef   = na
var int   buyT     = na      // BUY ka ishara kis lamhe
var int   entT     = na      // trade kab khuli
var int   exitT    = na      // BAND ka ishara / band kab hui
var int   slT      = na      // SL kab laga

// r2: chhota BUY idea (1H) ka haal + SELL ittila
var int   mDir      = 0
var int   mProcT    = na
var bool  mIn       = false
var bool  mPendBuy  = false
var bool  mPendExit = false
var float mPendRd   = na
var float mEn       = na
var float mSl       = na
var float mRd       = na
var float mRef      = na
var int   mBuyT     = na
var int   mEntT     = na
var int   mExitT    = na
var int   mSlT      = na
var int   dnT       = na      // 4H kab neeche palta (SELL ittila)
var float dnPx      = na

// (1) pichhli candle ka faisla -> is candle ki open par
bool opened  = false
bool closedX = false
if pendExit and inPos
    inPos   := false
    exitT   := time
    closedX := true
pendExit := false
if pendBuy and not inPos
    enPx   := open
    rdPx   := pendRd
    slPx   := open - pendRd
    inPos  := true
    entT   := time
    opened := true
pendBuy := false

// r2 (1b) chhota idea: agli candle ki open par
bool mOpened = false
bool mClosed = false
if mPendExit and mIn
    mIn     := false
    mExitT  := time
    mClosed := true
mPendExit := false
if mPendBuy and not mIn
    mEn     := open
    mRd     := mPendRd
    mSl     := open - mPendRd
    mIn     := true
    mEntT   := time
    mOpened := true
mPendBuy := false

// (2) candle ke andar SL
if inPos and low <= slPx
    inPos   := false
    slT     := time
    closedX := true
if mIn and low <= mSl
    mIn     := false
    mSlT    := time
    mClosed := true

// (3) candle band = agla faisla
bool  sigBuy  = false
bool  sigExit = false
float sigAtr  = na
bool  sigD    = true
if barstate.isconfirmed and okTF and okCh
    for stp = 0 to 1
        bool  has  = false
        int   nDir = 0
        float nAtr = na
        int   nT   = na
        bool  nD   = true
        if stp == 0
            if not na(tP) and not na(drP) and not na(atP) and (na(procT) or tP > procT)
                has  := true
                nDir := drP < 0 ? 1 : -1
                nAtr := atP
                nT   := tP
                nD   := dPrevUp
        else
            if lastEng and not na(tC) and tC == engOpen and not na(drC) and not na(atC) and (na(procT) or tC > procT)
                has  := true
                nDir := drC < 0 ? 1 : -1
                nAtr := atC
                nT   := tC
                nD   := (lastDay and not na(tdC) and tdC == dayOpen and not na(ddC)) ? ddC < 0 : dPrevUp
        if has
            if eDir != 0
                if nDir > 0 and eDir < 0
                    sigBuy  := true
                    sigExit := false
                    sigAtr  := nAtr
                    sigD    := nD
                if nDir < 0 and eDir > 0
                    sigExit := true
                    sigBuy  := false
                    dnT     := time_close
                    dnPx    := close
            eDir  := nDir
            procT := nT
    if sigBuy and not inPos and (not useDf or sigD) and not na(sigAtr) and sigAtr > 0
        pendBuy := true
        pendRd  := slMult * sigAtr
        buyT    := time_close
        buyRef  := close
        if alertOn
            alert("JAS Gold Rehnuma r2 " + syminfo.ticker + ": ABHI BUY (Supertrend " + engNm + " UPAR palta) | qeemat ~" + str.tostring(close, format.mintick) + " | SL ~" + str.tostring(close - pendRd, format.mintick) + " | TP nahi", alert.freq_once_per_bar_close)
    if sigExit and inPos
        pendExit := true
        exitT    := time_close
        if alertOn
            alert("JAS Gold Rehnuma r2 " + syminfo.ticker + ": ABHI BAND (Supertrend " + engNm + " NEECHE palta) | qeemat ~" + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

// ============================================================================
//  r2: CHHOTA BUY idea - 1H Supertrend upar palta JAB aakhri band 4H candle ka rukh upar (eDir upar wali loop se taza)
// ============================================================================
bool mSigBuy  = false
bool mSigExit = false
float mSigAtr = na
if barstate.isconfirmed and okTF and okCh and okMini
    for stp = 0 to 1
        bool  mHas = false
        int   qDir = 0
        float qAtr = na
        int   qT   = na
        if stp == 0
            if not na(mtP) and not na(mdP) and not na(maP) and (na(mProcT) or mtP > mProcT)
                mHas := true
                qDir := mdP < 0 ? 1 : -1
                qAtr := maP
                qT   := mtP
        else
            if lastMini and not na(mtC) and mtC == miniOpen and not na(mdC) and not na(maC) and (na(mProcT) or mtC > mProcT)
                mHas := true
                qDir := mdC < 0 ? 1 : -1
                qAtr := maC
                qT   := mtC
        if mHas
            if mDir != 0
                if qDir > 0 and mDir < 0
                    mSigBuy  := true
                    mSigExit := false
                    mSigAtr  := qAtr
                if qDir < 0 and mDir > 0
                    mSigExit := true
                    mSigBuy  := false
            mDir   := qDir
            mProcT := qT
    if mSigBuy and not mIn and eDir > 0 and not na(mSigAtr) and mSigAtr > 0
        mPendBuy := true
        mPendRd  := miniSl * mSigAtr
        mBuyT    := time_close
        mRef     := close
        if alertOn and showMini
            alert("JAS Gold Rehnuma r2 " + syminfo.ticker + ": CHHOTA BUY idea (1H upar palta, 4H upar) | qeemat ~" + str.tostring(close, format.mintick) + " | SL ~" + str.tostring(close - mPendRd, format.mintick) + " | band: 1H neeche palte par", alert.freq_once_per_bar_close)
    if mSigExit and mIn
        mPendExit := true
        mExitT    := time_close
        if alertOn and showMini
            alert("JAS Gold Rehnuma r2 " + syminfo.ticker + ": CHHOTA BUY idea BAND (1H neeche palta) | qeemat ~" + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

// ============================================================================
//  DIKHAWA: lakeer + (ikhtiyari) purane nishan
// ============================================================================
cUp = color.new(#26a69a, 0)
cDn = color.new(#ef5350, 0)
cOr = color.new(#ff9800, 0)
cMu = color.new(#787b86, 0)
cBl = color.new(#2962ff, 0)
bool engUp = not na(drP) and drP < 0

bool miniUp = not na(mdP) and mdP < 0
pSt  = plot(showLn and okTF ? stP : na, "Supertrend (band engine candle)", color = engUp ? cUp : cDn, linewidth = 2, style = plot.style_stepline)
pMid = plot(showFill and showLn and okTF ? hl2 : na, "Qeemat (badal ke liye, nazar nahi aati)", color = color.new(#787b86, 100), editable = false, display = display.pane)
fill(pSt, pMid, color = engUp ? color.new(#26a69a, 88) : color.new(#ef5350, 88), title = "Rukh ka badal")
plot(showMini and showLn and okTF and okMini ? msP : na, "Supertrend 1H (chhota idea)", color = miniUp ? color.new(#26a69a, 45) : color.new(#ef5350, 45), linewidth = 1, style = plot.style_stepline)
barcolor(showBar and okTF ? (engUp ? color.new(#26a69a, 0) : color.new(#ef5350, 0)) : na, title = "Candle ka rang (rukh)")
plotshape(showOld and showMini and mOpened, "Chhota BUY idea (purana)", style = shape.circle, location = location.belowbar, color = color.new(#42a5f5, 0), size = size.tiny, display = display.pane)
plotshape(showOld and opened, "BUY (purani)", style = shape.triangleup, location = location.belowbar, color = cUp, size = size.tiny, display = display.pane)
plotshape(showOld and closedX, "BAND (purani)", style = shape.xcross, location = location.abovebar, color = cMu, size = size.tiny, display = display.pane)

// ============================================================================
//  AAKHRI CANDLE: chhota dabba + sirf agli / khuli trade
// ============================================================================
f_pos(string p) => p == "Top Left" ? position.top_left : p == "Bottom Left" ? position.bottom_left : p == "Top Right" ? position.top_right : p == "Middle Right" ? position.middle_right : p == "Bottom Right" ? position.bottom_right : position.middle_left
f_sz(string z) => z == "Tiny" ? size.tiny : z == "Normal" ? size.normal : size.small

// lot: 1.00 lot = 100 oz -> $1 hile to 100 ikai (cent account USC, dollar account $)
f_lot(float rd, float rk) =>
    float raw  = myBal * rk / 100.0 / (rd * 100.0)
    float lots = math.floor(raw / 0.01 + 1e-9) * 0.01
    float use  = math.max(lots, 0.01)
    float pct  = use * 100.0 * rd / myBal * 100.0
    string t = str.tostring(use, "0.00") + " lot (SL = -" + str.tostring(use * 100.0 * rd, "0") + ", " + str.tostring(pct, "0.0#") + "%" + (lots >= 0.01 ? ")" : pct <= 2.0 * rk ? ", hadd se upar)" : ", BOHOT zyada - sirf demo)")
    t

var table tb = table.new(f_pos(tPos), 2, 8, bgcolor = color.new(chart.bg_color, 6), frame_color = color.new(#2a3b52, 0), frame_width = 2, border_color = color.new(#787b86, 82), border_width = 1)
var array<line>  lns = array.new<line>()
var array<box>   bxs = array.new<box>()
var array<label> lbs = array.new<label>()

if barstate.islast
    for oneL in lns
        oneL.delete()
    lns.clear()
    for oneB in bxs
        oneB.delete()
    bxs.clear()
    for oneT in lbs
        oneT.delete()
    lbs.clear()

    color  fg   = chart.fg_color
    string sz   = f_sz(tSize)
    int    nowT = timenow
    string lvTx = str.tostring(stP, format.mintick)
    float  rdEst = not na(atP) ? slMult * atP : na
    bool stBuy  = pendBuy or (inPos and not na(entT) and nowT - entT <= lateMin * 60000)
    bool stExit = pendExit or (not inPos and not na(exitT) and nowT - exitT <= lateMin * 60000 and (na(slT) or exitT >= slT))
    bool stSl   = not inPos and not pendBuy and not na(slT) and nowT - slT <= engSec * 1000 and (na(exitT) or slT > exitT)
    // khuli / abhi banti trade ke number
    float e0 = inPos ? enPx : buyRef
    float r0 = inPos ? rdPx : pendRd
    float s0 = e0 - r0
    // agla dekhne ka waqt
    int nx = engClose
    if nowT >= nx
        nx += engSec * 1000
    int leftMs = math.max(0, nx - nowT)
    string nxTx = str.format_time(nx, "EEE HH:mm", myTZ) + "  (" + str.tostring(math.floor(leftMs / 3600000.0)) + "h " + str.tostring(math.floor((leftMs % 3600000) / 60000.0)) + "m)"
    // chart ki jaanch
    string tu = str.upper(syminfo.ticker)
    bool isGold = str.contains(tu, "XAU") or str.contains(tu, "GOLD")
    bool nyOk   = engTF != "240" or hour(engOpen, "America/New_York") % 4 == 1

    string wd = "RUKEIN"
    color  wC = cMu
    string l1 = "-"
    string l2 = "-"
    string l3 = "-"
    if not okTF or not okCh
        wd := "CHART"
        wC := cOr
        l1 := not okTF ? "1D ya chhota chart lagayein" : "aam candle chart lagayein"
        l2 := "is chart par qaida nahi chalta"
        l3 := "Heikin Ashi / Renko / haftawar chart par naap nahi hua."
    else if stBuy and not na(r0) and r0 > 0
        wd := "ABHI BUY"
        wC := cUp
        l1 := "Market par BUY - " + str.format_time(pendBuy ? buyT : entT, "HH:mm", myTZ) + " se " + str.tostring(lateMin) + " min tak"
        l2 := f_lot(r0, myRisk) + "\nSL " + str.tostring(s0, format.mintick) + " ($" + str.tostring(r0, "0") + " neeche) | TP nahi"
        l3 := engNm + " candle lakeer ke upar band = rukh palta.\nDer ho jaye to chhor dein, peechha nahi."
    else if pendExit
        wd := "ABHI BAND"
        wC := cDn
        l1 := "BUY ko market par band karein - abhi"
        l2 := "nateeja jo bhi ho"
        l3 := engNm + " candle lakeer ke neeche band = rukh palat gaya."
    else if inPos and not na(r0) and r0 > 0
        wd := "CHALNE DEIN"
        wC := cUp
        l1 := "BUY " + str.tostring(e0, format.mintick) + " | abhi " + str.tostring((close - e0) / r0, "+0.00;-0.00") + "R"
        l2 := "SL " + str.tostring(s0, format.mintick) + " (na chherein) | TP nahi\nband: " + engNm + " close < " + lvTx
        l3 := "Kamai chand bari trades se aati hai -\njaldi band na karein. Aam haar -0.4R."
    else if stExit
        wd := "ABHI BAND"
        wC := cDn
        l1 := "BUY khuli hai to market par band karein"
        l2 := "ishara " + str.format_time(exitT, "EEE HH:mm", myTZ)
        l3 := engNm + " candle lakeer ke neeche band = rukh palat gaya."
    else if stSl
        wd := "SL LAGA"
        wC := cOr
        l1 := "Trade khatam - kuch na karein"
        l2 := "nayi BUY sirf agle palte par"
        l3 := "Tay shuda nuqsan. Badle ki trade nahi."
    else if eDir < 0
        l1 := "BUY tab: " + engNm + " close > " + lvTx + (useDf and not dPrevUp ? " + 1D upar" : "")
        l2 := na(rdEst) or rdEst <= 0 ? "-" : "bane to: " + f_lot(rdEst, myRisk) + "\nSL ~$" + str.tostring(rdEst, "0") + " neeche | TP nahi"
        l3 := "Rukh neeche. SELL nahi (test fail)."
    else if eDir > 0
        l1 := "Rukh upar, palta ho chuka"
        l2 := "der se BUY nahi - agle palte ka intezar"
        l3 := "Entry sirf palte par (test wahi)."
    else
        wd := "INTEZAR"
        l1 := "data load ho raha hai"
    if okTF and okCh and (not isGold or not nyOk)
        l3 := not isGold ? "DHYAN: ye gold nahi - naap sirf gold ka hai." : "DHYAN: 4H candle NY 17:00 se nahi - OANDA:XAUUSD behtar."

    // ---- r2: rukh ki patti + chhota BUY idea + SELL ittila
    string aU = "▲"
    string aD = "▼"
    bool   d1Up = not na(ddP) and ddP < 0
    string rukh = "1D " + (na(ddP) ? "-" : d1Up ? aU : aD) + "   ·   " + engNm + " " + (eDir > 0 ? aU : eDir < 0 ? aD : "-") + (okMini ? "   ·   1H " + (mDir > 0 ? aU : mDir < 0 ? aD : "-") : "")
    color  rkC  = eDir > 0 ? cUp : eDir < 0 ? cDn : cMu
    string mLv  = str.tostring(msP, format.mintick)
    float  mEst = not na(maP) ? miniSl * maP : na
    bool   mNow = mPendBuy or (mIn and not na(mEntT) and nowT - mEntT <= lateMin * 60000)
    float  me0  = mIn ? mEn : mRef
    float  mr0  = mIn ? mRd : mPendRd
    float  ms0  = me0 - mr0
    string m1 = "-"
    color  mC = fg
    if not okMini
        m1 := "1H ya chhota chart lagayein"
        mC := cMu
    else if mNow and not na(mr0) and mr0 > 0
        m1 := "ABHI: BUY idea " + str.format_time(mPendBuy ? mBuyT : mEntT, "HH:mm", myTZ) + "\n" + f_lot(mr0, miniRisk) + "\nSL " + str.tostring(ms0, format.mintick) + " | band: 1H close < lakeer"
        mC := cUp
    else if mPendExit
        m1 := "ABHI BAND (1H neeche palta)"
        mC := cDn
    else if mIn and not na(mr0) and mr0 > 0
        m1 := "khuli " + str.tostring(me0, format.mintick) + " | abhi " + str.tostring((close - me0) / mr0, "+0.00;-0.00") + "R\nSL " + str.tostring(ms0, format.mintick) + " | band: 1H close < " + mLv
        mC := cBl
    else if eDir < 0
        m1 := "band - " + engNm + " rukh neeche"
        mC := cMu
    else if mDir < 0
        m1 := "tab: 1H close > " + mLv + (na(mEst) or mEst <= 0 ? "" : "\nbane to: " + f_lot(mEst, miniRisk))
    else if mDir > 0
        m1 := "1H upar, palta ho chuka - agle ka intezar"
        mC := cMu
    else
        m1 := "data load ho raha hai"
        mC := cMu
    string s1 = "-"
    color  sC = cMu
    if eDir < 0
        s1 := "rukh NEECHE" + (na(dnT) ? "" : " - palta " + str.format_time(dnT, "EEE HH:mm", myTZ) + " @ " + str.tostring(dnPx, format.mintick)) + "\nkhatam: " + engNm + " close > " + lvTx + "\nnaap FAIL (2019-26 -15.6R) - lot / SL nahi"
        sC := cDn
    else if eDir > 0
        s1 := "tab: " + engNm + " close < " + lvTx + "\nsirf ittila - naap FAIL (2019-26 -15.6R)"

    string tip = "JAS Gold Rehnuma r2 | engine " + engNm + (useDf ? " + 1D filter" : "") + " | asal qaida sirf BUY (= EA t5) | repaint nahi\nPython 2010-26 (gold M1, kharcha + swap): 331 trades, jeet 41%, +0.095R har trade, kul +31.6R, girawat 8.5R.\nTP nahi: TP 0.5R-2R se kamai kam hui. Aam haar -0.4R.\nCHHOTA BUY (1H + 4H upar, SL 3 ATR): 2003-18 409 tr +0.199R | 2019-26 207 tr +0.329R, girawat 13.4R - abhi sirf idea, demo pehle.\nSELL: 4H SELL 2019-26 -15.6R, 1H SELL -32.7R = FAIL, sirf ittila."
    color hdB = color.new(#14233a, 0)
    table.clear(tb, 0, 0, 1, 7)
    table.cell(tb, 0, 0, "JAS REHNUMA", text_color = color.new(#ffd54f, 0), bgcolor = hdB, text_size = sz, text_halign = text.align_left, tooltip = tip)
    table.cell(tb, 1, 0, "r2  ·  " + syminfo.ticker + "  ·  engine " + engNm + (useDf ? " + 1D" : ""), text_color = color.new(#b0bec5, 0), bgcolor = hdB, text_size = sz, text_halign = text.align_right, tooltip = tip)
    table.cell(tb, 0, 1, "Rukh", text_color = cMu, text_size = sz, text_halign = text.align_left)
    table.cell(tb, 1, 1, rukh, text_color = rkC, text_size = sz, text_halign = text.align_left)
    table.cell(tb, 0, 2, wd, text_color = color.white, bgcolor = wC, text_size = sz, text_halign = text.align_center, tooltip = tip)
    table.cell(tb, 1, 2, l1, text_color = fg, bgcolor = color.new(wC, 85), text_size = sz, text_halign = text.align_left, tooltip = tip)
    table.cell(tb, 0, 3, "Trade", text_color = cMu, text_size = sz, text_halign = text.align_left)
    table.cell(tb, 1, 3, l2, text_color = wd == "ABHI BUY" or wd == "CHALNE DEIN" ? cOr : fg, text_size = sz, text_halign = text.align_left)
    int rw = 4
    if showMini
        table.cell(tb, 0, rw, "Chhota\nBUY idea", text_color = color.new(#42a5f5, 0), text_size = sz, text_halign = text.align_left)
        table.cell(tb, 1, rw, m1, text_color = mC, text_size = sz, text_halign = text.align_left)
        rw += 1
    if showSell
        table.cell(tb, 0, rw, "SELL\nidea", text_color = color.new(#ef9a9a, 0), text_size = sz, text_halign = text.align_left)
        table.cell(tb, 1, rw, s1, text_color = sC, text_size = sz, text_halign = text.align_left)
        rw += 1
    table.cell(tb, 0, rw, "Agla", text_color = cMu, text_size = sz, text_halign = text.align_left)
    table.cell(tb, 1, rw, nxTx, text_color = fg, text_size = sz, text_halign = text.align_left)
    rw += 1
    if showWhy
        table.cell(tb, 0, rw, "Kyun", text_color = cMu, text_size = sz, text_halign = text.align_left)
        table.cell(tb, 1, rw, l3, text_color = cMu, text_size = sz, text_halign = text.align_left)

    // ---- chart par sirf agli / khuli trade (drawing = paimana nahi bigarta)
    if showNext and okTF and okCh
        int xL = time + 2 * chSec * 1000
        int xR = time + 14 * chSec * 1000
        if (inPos or pendBuy) and not na(e0) and not na(r0) and r0 > 0
            int x0 = inPos and not na(entT) ? entT : time
            bxs.push(box.new(x0, e0, xR, s0, xloc = xloc.bar_time, border_color = na, bgcolor = color.new(#ef5350, 92)))
            if inPos and close > e0
                bxs.push(box.new(x0, close, xR, e0, xloc = xloc.bar_time, border_color = na, bgcolor = color.new(#26a69a, 90)))
            lns.push(line.new(x0, e0, xR, e0, xloc = xloc.bar_time, color = cBl, width = 2))
            lns.push(line.new(x0, s0, xR, s0, xloc = xloc.bar_time, color = cOr, width = 1, style = line.style_dashed))
            lbs.push(label.new(xR, e0, (stBuy ? "ABHI BUY " : "BUY khuli ") + str.tostring(e0, format.mintick) + "\nSL " + str.tostring(s0, format.mintick) + " | abhi " + str.tostring((close - e0) / r0, "+0.00;-0.00") + "R", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(#1b2a3a, 10), textcolor = stBuy ? cUp : color.new(#90caf9, 0), size = size.small))
            if inPos and not na(entT)
                lbs.push(label.new(entT, e0, "", xloc = xloc.bar_time, yloc = yloc.belowbar, style = label.style_triangleup, color = cUp, size = size.tiny))
        else if pendExit or stExit
            lbs.push(label.new(time, high, "ABHI BAND", xloc = xloc.bar_time, yloc = yloc.abovebar, style = label.style_label_down, color = cDn, textcolor = color.white, size = size.small))
        else if eDir < 0 and not na(stP) and not na(rdEst) and rdEst > 0 and not stSl
            bxs.push(box.new(xL, stP, xR, stP - rdEst, xloc = xloc.bar_time, border_color = color.new(#c62828, 40), border_style = line.style_dotted, bgcolor = color.new(#c62828, 90)))
            lns.push(line.new(xL, stP, xR, stP, xloc = xloc.bar_time, color = cUp, width = 2, style = line.style_dotted))
            lbs.push(label.new(xR, stP, "AGLI BUY (andaza) - intezar\n" + engNm + " close > " + lvTx + "\nSL ~" + str.tostring(stP - rdEst, format.mintick) + " | TP nahi", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(#1b2a3a, 10), textcolor = color.new(#ffb300, 0), size = size.small))
        // r2: SELL ittila - rukh upar ho to palatne ki qeemat (chhoti surkh lakeer)
        if showSell and eDir > 0 and not na(stP) and not pendExit and not stExit
            lns.push(line.new(xL, stP, xR, stP, xloc = xloc.bar_time, color = color.new(#ef5350, 30), width = 1, style = line.style_dotted))
            lbs.push(label.new(xR, stP, engNm + " close < " + lvTx + " = rukh palta\n(BUY band · SELL idea, naap fail)", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(#1b2a3a, 10), textcolor = color.new(#ef9a9a, 0), size = size.small))
        // r2: chhota BUY idea - khula / abhi / agla
        if showMini and okMini
            int xM = time + 8 * chSec * 1000
            if (mIn or mPendBuy) and not na(me0) and not na(mr0) and mr0 > 0
                int m0 = mIn and not na(mEntT) ? mEntT : time
                lns.push(line.new(m0, me0, xM, me0, xloc = xloc.bar_time, color = color.new(#42a5f5, 0), width = 1))
                lns.push(line.new(m0, ms0, xM, ms0, xloc = xloc.bar_time, color = color.new(#ff9800, 20), width = 1, style = line.style_dotted))
                lbs.push(label.new(xM, ms0, "chhota BUY idea " + str.tostring(me0, format.mintick) + " | SL " + str.tostring(ms0, format.mintick) + " | " + str.tostring((close - me0) / mr0, "+0.00;-0.00") + "R", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(#1b2a3a, 10), textcolor = color.new(#90caf9, 0), size = size.small))
            else if eDir > 0 and mDir < 0 and not na(msP)
                lns.push(line.new(xL, msP, xM, msP, xloc = xloc.bar_time, color = color.new(#42a5f5, 20), width = 1, style = line.style_dotted))
                lbs.push(label.new(xM, msP, "chhota BUY tab: 1H close > " + mLv, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(#1b2a3a, 10), textcolor = color.new(#90caf9, 0), size = size.small))
