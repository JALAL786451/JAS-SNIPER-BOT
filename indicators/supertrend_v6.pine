//@version=6
// ============================================================================
//  SUPERTREND — asli Pine v6, aur repaint ke baghair
//
//  Ye wohi mashhoor Supertrend hai jo aapne bheja. Do kaam kiye gaye hain:
//
//  1) ZABAAN THEEK KI
//     Bheji hui file par //@version=6 likha tha magar andar ka code v2/v3 ka
//     tha - study(), input(type=...), sma(tr,...), atr(), max(), transp=.
//     Ye sab v6 mein khatam ho chuke hain, is liye woh chalta hi nahi tha.
//     Hisaab bilkul wohi rakha gaya hai, ek number nahi badla.
//
//  2) REPAINT BAND KIYA  <- ASAL KAAM
//     Asli script chalti candle ke close par trend palat deta tha. Chalta
//     close har second badalta hai, to signal aata tha, phir gayab ho jata
//     tha, phir aata tha. Peeche ke chart par ye nazar nahi aata - wahan har
//     signal "sahi waqt par" lagta hai. Isi liye Supertrend peeche dekhne
//     mein itna acha lagta hai aur live itna bura.
//     Ab signal SIRF candle band hone par pakka hota hai.
//
//  IMANDARI KI BAAT:
//  Supertrend ek TRAILING STOP hai, peshangoi karne wala aala nahi. Ye
//  hamesha der se palatta hai - yehi uski banawat hai, kharabi nahi. Koi
//  coding isko "aainda" batane wala nahi bana sakti.
//  Ye kitna kaam ka hai, ye sirf Strategy Tester bata sakta hai. Kahein to
//  ise strategy bana dein aur asli number dekh lein - jaise humne Tony wale
//  EMA scalper ke saath kiya tha.
// ============================================================================
indicator("Supertrend", overlay = true, format = format.price, precision = 2, timeframe = "", timeframe_gaps = false)

// ------------------------------------------------------- 1. ASLI SETTINGS --
g1          = "1. Supertrend (asli settings)"
Periods     = input.int(10,    "ATR Period", minval = 1, group = g1)
src         = input.source(hl2, "Source", group = g1)
Multiplier  = input.float(3.0, "ATR Multiplier", step = 0.1, minval = 0.1, group = g1)
changeATR   = input.bool(true, "ATR ka tareeqa badlein? (ON = RMA, OFF = SMA)", group = g1)

// ------------------------------------------------------------ 2. ACCURACY --
g2          = "2. Accuracy"
confirmBar  = input.bool(true,  "Signal sirf BAND candle par (repaint band)", group = g2)
useHTF      = input.bool(false, "Bare timeframe ka filter lagayein", group = g2)
htfTF       = input.timeframe("D", "Bara timeframe", group = g2)
htfFast     = input.int(50,  "HTF EMA fast", minval = 1, group = g2)
htfSlow     = input.int(200, "HTF EMA slow", minval = 1, group = g2)

// ------------------------------------------------------------- 3. DIKHAWA --
g3          = "3. Dikhawa"
showsignals = input.bool(true, "Buy/Sell labels", group = g3)
highlighting= input.bool(true, "Highlighter on/off", group = g3)
fillTransp  = input.int(85, "Highlighter ka halkapan", minval = 50, maxval = 98, group = g3)
showPanel   = input.bool(true, "Hisaab ka panel", group = g3)
cUp         = input.color(#089981, "Up",   group = g3, inline = "c")
cDn         = input.color(#F23645, "Down", group = g3, inline = "c")

// ============================================================================
//  ASAL HISAAB - bheji hui file se bilkul wohi, sirf v6 ki zabaan mein
// ============================================================================
atr2 = ta.sma(ta.tr, Periods)
atr  = changeATR ? ta.atr(Periods) : atr2

up  = src - Multiplier * atr
up1 = nz(up[1], up)
up := close[1] > up1 ? math.max(up, up1) : up

dn  = src + Multiplier * atr
dn1 = nz(dn[1], dn)
dn := close[1] < dn1 ? math.min(dn, dn1) : dn

trend = 1
trend := nz(trend[1], trend)
trend := trend == -1 and close > dn1 ? 1 : trend == 1 and close < up1 ? -1 : trend

stLevel = trend == 1 ? up : dn

// ============================================================================
//  BARA TIMEFRAME KA FILTER - band candle par, is liye ye bhi repaint nahi karta
// ============================================================================
f_htf() =>
    _f = ta.ema(close, htfFast)
    _s = ta.ema(close, htfSlow)
    [_f[1], _s[1]]

[hF, hS] = request.security(syminfo.tickerid, htfTF, f_htf(), barmerge.gaps_off, barmerge.lookahead_off)

htfReady = not na(hF) and not na(hS)
htfLong  = not useHTF or (htfReady and hF > hS)
htfShort = not useHTF or (htfReady and hF < hS)

// ============================================================================
//  SIGNAL - yahan repaint marta hai
// ============================================================================
flipUp = trend == 1  and trend[1] == -1
flipDn = trend == -1 and trend[1] == 1
ready  = not confirmBar or barstate.isconfirmed

buySignal  = flipUp and ready and htfLong
sellSignal = flipDn and ready and htfShort

// bara filter ne jo signal roka - ye dekhna kaam ka hai
blockUp = flipUp and ready and not htfLong
blockDn = flipDn and ready and not htfShort

// ============================================================================
//  LAKEEREIN
// ============================================================================
upPlot = plot(trend ==  1 ? up : na, "Up Trend",   style = plot.style_linebr, linewidth = 2, color = cUp)
dnPlot = plot(trend == -1 ? dn : na, "Down Trend", style = plot.style_linebr, linewidth = 2, color = cDn)
mPlot  = plot(ohlc4, "", style = plot.style_circles, linewidth = 0, display = display.none)

fillUp = highlighting and trend ==  1 ? color.new(cUp, fillTransp) : na
fillDn = highlighting and trend == -1 ? color.new(cDn, fillTransp) : na
fill(mPlot, upPlot, title = "UpTrend Highlighter",   color = fillUp)
fill(mPlot, dnPlot, title = "DownTrend Highlighter", color = fillDn)

plotshape(buySignal  ? up : na, "UpTrend Begins",   location = location.absolute, style = shape.circle, size = size.tiny, color = cUp)
plotshape(sellSignal ? dn : na, "DownTrend Begins", location = location.absolute, style = shape.circle, size = size.tiny, color = cDn)
plotshape(buySignal  and showsignals ? up : na, "Buy",  text = "Buy",  location = location.absolute, style = shape.labelup,   size = size.tiny, color = cUp, textcolor = color.white)
plotshape(sellSignal and showsignals ? dn : na, "Sell", text = "Sell", location = location.absolute, style = shape.labeldown, size = size.tiny, color = cDn, textcolor = color.white)
plotshape(blockUp and showsignals ? up : na, "Buy roka gaya",  text = "x", location = location.absolute, style = shape.labelup,   size = size.tiny, color = color.new(cUp, 55), textcolor = color.white)
plotshape(blockDn and showsignals ? dn : na, "Sell roka gaya", text = "x", location = location.absolute, style = shape.labeldown, size = size.tiny, color = color.new(cDn, 55), textcolor = color.white)

// ============================================================================
//  PANEL - Supertrend asal mein trailing stop hai, to uska faasla dikhayein
// ============================================================================
var table TB = table.new(position.top_right, 2, 5, border_width = 1)

f_row(_r, _a, _b, _tc) =>
    table.cell(TB, 0, _r, _a, text_color = #111111, text_size = size.small, text_halign = text.align_left,  bgcolor = #FFFFFFAA)
    table.cell(TB, 1, _r, _b, text_color = _tc,     text_size = size.small, text_halign = text.align_right, bgcolor = #FFFFFFAA)

if showPanel and barstate.islast
    tCol = trend == 1 ? cUp : cDn
    dist = math.abs(close - stLevel)
    inAtr = atr > 0 ? dist / atr : 0.0
    table.cell(TB, 0, 0, "SUPERTREND", text_color = color.white, text_size = size.normal, bgcolor = tCol)
    table.cell(TB, 1, 0, str.tostring(Periods) + " / " + str.tostring(Multiplier, "#.#"), text_color = color.white, text_size = size.normal, bgcolor = tCol)
    f_row(1, "Rukh", trend == 1 ? "UP" : "DOWN", tCol)
    f_row(2, "ST (trailing stop)", str.tostring(stLevel, format.mintick), tCol)
    f_row(3, "Faasla", str.tostring(dist, format.mintick) + "  (" + str.tostring(inAtr, "#.##") + " ATR)", #111111)
    f_row(4, "Bara filter", not useHTF ? "band" : not htfReady ? "data nahi" : hF > hS ? "UP - sirf BUY" : "DOWN - sirf SELL", not useHTF ? #787B86 : hF > hS ? cUp : cDn)

// ============================================================================
//  ALERTS
// ============================================================================
alertcondition(buySignal,  title = "SuperTrend Buy",  message = "SuperTrend Buy!")
alertcondition(sellSignal, title = "SuperTrend Sell", message = "SuperTrend Sell!")
alertcondition(buySignal or sellSignal, title = "SuperTrend Direction Change", message = "SuperTrend has changed direction!")

if buySignal
    alert("SuperTrend BUY  " + syminfo.ticker + " " + timeframe.period + "  ST = " + str.tostring(stLevel, format.mintick), alert.freq_once_per_bar_close)
if sellSignal
    alert("SuperTrend SELL " + syminfo.ticker + " " + timeframe.period + "  ST = " + str.tostring(stLevel, format.mintick), alert.freq_once_per_bar_close)
