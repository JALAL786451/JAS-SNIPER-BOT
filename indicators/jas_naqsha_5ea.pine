//@version=6
// JAS NAQSHA + 5EA  (build j3.2, Pine v6, 9 Nov 2026; j3.2 = sirf 4 Pine warning saaf (shorttitle chhota, s1/s2/ln naam badle), hisaab wahi; j3.1 = label transparent + likhai candle ke rang, dotted line poore chart par; j3 = aakhri candle ke saath BOLD chalti price label (setting "7 · Price label"); j2 = j2 = 5EA band / doosra engine ho to us ka hisaab bilkul nahi chalta (halka))  -  jas_naqsha n5.9 + jas_5ea p6 EK script mein (user: 2 script saath, 5EA chart par kuch nahi dikhata tha).
//  j1: Naqsha hissa n5.9 jyon ka tyon. 5EA hissa p6 wala hisaab, magar SIRF chart ke instrument ka: request.security 11 -> 2
//   (bhaari 4 x 4H + 7 x 1D poori history = loading / timeout ki wajah). Neeche 11 instrument ki line default BAND (ab sirf chart
//   wale ka haal hota hai). 5EA ka poora hissa setting "6 · 5EA" se ON/OFF. Python ke pakke number wahi (table). TRADE NAHI, sirf dikhana.
//  HADD: request.security 7 + 2 = 9 (hadd 40). Box <= 50, line <= 50, label <= 70.
//  Purani tafseel: indicators/jas_naqsha.pine (n5.9) aur indicators/jas_5ea.pine (p6) ke upar wale comment.
// ============================================================================
// ============================================================================
//  KYA DIKHATA HAI (har TF par, khud):
//   1) ZONES S/R: 1H / 4H / 1D / 1W ke swing high/low (pivot 5/5, band candle) -> qareeb wale aapas mein jor
//      (0.25 x din ka ATR) = zone. Qeemat ke UPAR = R (laal), NEECHE = S (hara). Sirf qareeb 3 + 3. "4H x3" = 4H ka, 3 dafa chhua.
//      Chart ki TF se CHHOTI TF ke pivot nahi (wo data adhoora hota hai).
//   2) RUKH: har TF (15m, 1H, 4H, 1D, 1W): UPAR = close > EMA50 > EMA200 + Supertrend(10,3) upar; NEECHE = ulta; warna MILA.
//   3) TOOT KA KHATRA: qeemat qareeb zone se kitni door (din ke ATR mein) + Bollinger squeeze (chart TF, 120 candle).
//   4) OVERBOUGHT / OVERSOLD: RSI14 har TF + EMA50 se kitne ATR upar / neeche.
//   5) NEWS WAQT: US data aam taur par 08:30 + 10:00 NY (har kaam ka din), NFP (mahine ka pehla Jumma 08:30), FOMC 14:00
//      (2026 tareekhein). Pine mein asli news calendar NAHI - ye "dhyan ka waqt" hai; pakki news ForexFactory se.
//      Intraday chart par us waqt ke +-15 min halka narangi rang; table mein agli news ka waqt (PKT) + kitni der.
//   6) 1D EMA50 / EMA200 (pichhla band din) lakeer + rukh: qeemat dono ke upar aur EMA50 > EMA200 = UPAR (sirf BUY socho).
//      4H ENTRY WAQT = 4H Supertrend(10,3) upar mude (jas_5ea B1 / #34 ka mor) JAB 1D rukh UPAR -> chart par "4H BUY" nishan.
//      B1 akela test PASS (#34); 1D filter ke SAATH test NAHI.
//      n5.7 SELL = ulta: 4H Supertrend NEECHE mude JAB 1D rukh NEECHE (qeemat dono EMA ke neeche, EMA50 < EMA200) -> "4H SELL" nishan,
//      SL 6 x ATR10 UPAR, TP 2R NEECHE. SELL ka koi TEST NAHI hua. Settings mein "SELL bhi dikhao" band kar sakte hain.
//   7) 4H POSITION dabba (TV jaisa): entry mor wali 4H candle ka open, SL 6 x ATR10 4H (B1), TP 2R (TEST NAHI - B1 mein TP nahi,
//      0 karein to B1 jaisa sirf mor par band). Laal = SL, hara = TP. Sirf 4H ya chhota chart.
//      n5: band position chart se hat jati hai (Settings "Purani dikhao" ON = "+1.2R" label ke saath).
//      AGLI (dotted, andaza): 1D UPAR + 4H Supertrend abhi neeche -> entry ~ 4H Supertrend lakeer, SL / TP isi se. % nahi diya (B1 jeet 37-43%).
//   8) KHULASA (table ki pehli line): ek lafz - RUKO (1D rukh MILA, koi side nahi) / TAYYAR (1D rukh saaf, 4H mor ka intezar) /
//      BUY ya SELL (chart par asal entry bani, pehle 4 ghante) / CHALU (khuli position, 4 ghante baad) / INTEZAR (4H pehle se usi taraf)
//      + jumla: rukh, qareeb zone + toot, OB/OS, agli news.
//  IMAANDARI: ye sab TEST NAHI hua (zones / rukh / toot = sirf naqsha). Pakke number sirf jas_5ea ki table mein.
//  REPAINT NAHI: HTF ka data pichhli BAND candle ([1] + lookahead_on); zones / table sirf aakhri candle par banti hain.
//  HADD: request.security 7, tuple 10, box <= 12 + 2 x 10 (position), label <= 31, line <= 4, plot 2, plotshape 2.
// ============================================================================
indicator("JAS Naqsha+5EA j3.2", "JAS j3.2", overlay = true, scale = scale.right, max_boxes_count = 50, max_lines_count = 50, max_labels_count = 70, max_bars_back = 300)

grZ = "1 · Zones S/R"
showZ  = input.bool(true, "Zones dikhao", group = grZ, display = display.none)
zN     = input.int(3, "Upar / neeche kitne zone", minval = 1, maxval = 6, group = grZ, display = display.none)
zTol   = input.float(0.25, "Jorne ki doori (x din ka ATR)", minval = 0.05, step = 0.05, group = grZ, display = display.none)
zH     = input.float(0.10, "Zone ki motai (x din ka ATR, aadhi)", minval = 0.02, step = 0.02, group = grZ, display = display.none)
showPD = input.bool(false, "Kal (dotted) / pichhle hafte (dashed) ka High-Low", group = grZ, display = display.none)

grT = "2 · Table"
showT  = input.bool(true, "Table dikhao", group = grT, display = display.none)
tPos   = input.string("Middle Left", "Table ki jagah", options = ["Middle Left", "Top Left", "Bottom Left", "Middle Right", "Top Right", "Bottom Right", "Bottom Center"], group = grT, display = display.none)
tFull  = input.bool(false, "Poori table (5 TF, RSI, ATR waghaira) - band = chhoti table", group = grT, display = display.none)
tSize  = input.string("Small", "Likhai", options = ["Tiny", "Small", "Normal"], group = grT, display = display.none)

grN = "3 · News waqt"
showNB = input.bool(true, "Intraday chart par news waqt ka rang (+-15 min)", group = grN, display = display.none)

grE = "4 · 1D EMA + 4H entry"
showE  = input.bool(true, "1D EMA50 / EMA200 lakeer", group = grE, display = display.none)
showEn = input.bool(true, "4H entry nishan (1D UPAR + 4H Supertrend upar mura)", group = grE, display = display.none)
showPs = input.bool(true, "4H position dabba (TV jaisa SL / TP)", group = grE, display = display.none)
psSL   = input.float(6.0, "SL = kitne x ATR10 (4H)  [B1 / #34 wala 6]", minval = 0.5, step = 0.5, group = grE, display = display.none)
psTP   = input.float(2.0, "TP = kitne R (0 = TP nahi, sirf Supertrend mor par band = B1)", minval = 0, step = 0.5, group = grE, display = display.none)
psOld  = input.bool(false, "Purani (band) positions dikhao", group = grE, display = display.none)
psKeep = input.int(10, "Purani ON ho to kitni", minval = 1, maxval = 15, group = grE, display = display.none)
psNext = input.bool(true, "AGLI position ka dotted dabba (andaza: 1D rukh saaf + 4H abhi ulti taraf)", group = grE, display = display.none)
buy1D  = input.bool(false, "BUY par 1D shart (1D UPAR ho tab hi BUY) - band = B1 / t5 jaisa (TEST wala)", group = grE, display = display.none)
showSell = input.bool(false, "SELL bhi dikhao (1D NEECHE + 4H Supertrend neeche mura) - #73 FAIL, default band", group = grE, display = display.none)

// ============================================================================
//  HTF DATA (har TF ek tuple, pichhli band candle)
// ============================================================================
f_tf() =>
    e50 = ta.ema(close, 50)
    e200 = ta.ema(close, 200)
    [stv, dr] = ta.supertrend(3.0, 10)
    r = ta.rsi(close, 14)
    a = ta.atr(14)
    ph = ta.pivothigh(high, 5, 5)
    pl = ta.pivotlow(low, 5, 5)
    a10 = ta.atr(10)
    [close[1], e50[1], e200[1], dr[1], r[1], a[1], ph[1], pl[1], time[6], a10[1], stv[1]]

LA = barmerge.lookahead_on
[c0, m0, n0, d0, r0, a0, h0, l0, t0, k0, s0] = request.security(syminfo.tickerid, "15", f_tf(), lookahead = LA)
[c1, m1, n1, d1, r1, a1, h1, l1, t1, k1, s1] = request.security(syminfo.tickerid, "60", f_tf(), lookahead = LA)
[c2, m2, n2, d2, r2, a2, h2, l2, t2, k2, s2] = request.security(syminfo.tickerid, "240", f_tf(), lookahead = LA)
[c3, m3, n3, d3, r3, a3, h3, l3, t3, k3, s3] = request.security(syminfo.tickerid, "D", f_tf(), lookahead = LA)
[c4, m4, n4, d4, r4, a4, h4, l4, t4, k4, s4] = request.security(syminfo.tickerid, "W", f_tf(), lookahead = LA)
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = LA)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = LA)

chSec = timeframe.in_seconds()
ok0 = timeframe.in_seconds("15") >= chSec
ok1 = timeframe.in_seconds("60") >= chSec
ok2 = timeframe.in_seconds("240") >= chSec
ok3 = timeframe.in_seconds("D") >= chSec
ok4 = timeframe.in_seconds("W") >= chSec
aD = a3

// 1D EMA50/200 rukh (pichhla band din) + 4H Supertrend mor (pichhli band 4H candle)
dRukh = na(m3) or na(n3) ? 0 : (close > m3 and close > n3 and m3 > n3) ? 1 : (close < m3 and close < n3 and m3 < n3) ? -1 : 0
plot(showE ? m3 : na, "1D EMA50", color = color.new(#ffb300, 0), linewidth = 2, style = plot.style_stepline)
plot(showE ? n3 : na, "1D EMA200", color = color.new(#42a5f5, 0), linewidth = 2, style = plot.style_stepline)
ch2 = ta.change(d2)
flipUp = ok2 and not na(ch2) and ch2 < 0
flipDn = ok2 and not na(ch2) and ch2 > 0
var int lastFlipT = na
var int lastFlipDir = 0
if flipUp or flipDn
    lastFlipT := time
    lastFlipDir := flipUp ? 1 : -1
// n5.7: 1D se kaunsi side allowed: UPAR = BUY (1), NEECHE = SELL (-1, agar switch ON), warna 0 (koi side nahi)
dSide = (dRukh < 0 and showSell) ? -1 : (dRukh > 0 or not buy1D) ? 1 : 0
// entry ka faisla candle ke OPEN par (close badalta rehta = repaint nahi)
dRukhO = na(m3) or na(n3) ? 0 : (open > m3 and open > n3 and m3 > n3) ? 1 : (open < m3 and open < n3 and m3 < n3) ? -1 : 0
entryNow = flipUp and (buy1D ? dRukhO > 0 : not (showSell and dRukhO < 0))
entryShort = showSell and flipDn and dRukhO < 0
plotshape(showEn and entryNow and (psOld or not showPs), "4H BUY waqt", shape.triangleup, location.belowbar, color.new(#00e676, 0), size = size.small, text = "4H BUY", textcolor = color.new(#00e676, 0))
plotshape(showEn and entryShort and (psOld or not showPs), "4H SELL waqt", shape.triangledown, location.abovebar, color.new(#ff5252, 0), size = size.small, text = "4H SELL", textcolor = color.new(#ff5252, 0))

// ============================================================================
//  4H POSITION (TV jaisa dabba): entry = mor wali 4H candle ka open; SL = psSL x ATR10 (4H) neeche;
//  band: Supertrend 4H neeche mude (us candle ka open) / SL (gap = open) / TP (psTP R, 0 = nahi). Ek waqt ek position.
// ============================================================================
type Pos
    int t0
    float e
    float sl
    float tp
    box bT
    box bS
    label lb
    label lE
    bool live
    float r
    int dir

var array<Pos> ps = array.new<Pos>()
var Pos cur = na

f_closePos(Pos q, float xp) =>
    q.live := false
    q.r := (xp - q.e) / (q.e - q.sl)
    box.set_right(q.bS, time)
    if not na(q.bT)
        box.set_right(q.bT, time)
    if psOld
        q.lb := label.new(time, xp, (q.r >= 0 ? "+" : "") + str.tostring(q.r, "0.0") + "R", xloc = xloc.bar_time, style = q.r >= 0 ? label.style_label_down : label.style_label_up, color = q.r >= 0 ? color.new(#2e7d32, 10) : color.new(#c62828, 10), textcolor = color.white, size = size.tiny)
    else
        box.delete(q.bS)
        if not na(q.bT)
            box.delete(q.bT)
        label.delete(q.lE)
        q.lb := na
    q.r

if showPs and ok2
    if not na(cur) and cur.live
        pd = cur.dir
        bool flipOpp = pd > 0 ? flipDn : flipUp
        bool hitSL = pd > 0 ? low <= cur.sl : high >= cur.sl
        bool hitTP = psTP > 0 and (pd > 0 ? high >= cur.tp : low <= cur.tp)
        if flipOpp
            f_closePos(cur, open)
        else if hitSL
            f_closePos(cur, pd > 0 ? math.min(open, cur.sl) : math.max(open, cur.sl))
        else if hitTP
            f_closePos(cur, pd > 0 ? math.max(open, cur.tp) : math.min(open, cur.tp))
        else
            box.set_right(cur.bS, time)
            if not na(cur.bT)
                box.set_right(cur.bT, time)
    if (entryNow or entryShort) and not na(k2) and k2 > 0 and (na(cur) or not cur.live)
        int dn = entryNow ? 1 : -1
        e = open
        sl = e - dn * psSL * k2
        tp = psTP > 0 ? e + psTP * (e - sl) : na
        string vaS = dn > 0 ? text.align_bottom : text.align_top
        string vaT = dn > 0 ? text.align_top : text.align_bottom
        bS = box.new(time, dn > 0 ? e : sl, time, dn > 0 ? sl : e, xloc = xloc.bar_time, border_color = color.new(#c62828, 40), bgcolor = color.new(#c62828, 80), text = "SL " + str.tostring(sl, format.mintick), text_size = size.tiny, text_color = color.new(#ff8a80, 0), text_halign = text.align_left, text_valign = vaS)
        bT = psTP > 0 ? box.new(time, dn > 0 ? tp : e, time, dn > 0 ? e : tp, xloc = xloc.bar_time, border_color = color.new(#2e7d32, 40), bgcolor = color.new(#2e7d32, 80), text = "TP " + str.tostring(tp, format.mintick) + " (" + str.tostring(psTP, "0.0") + "R)", text_size = size.tiny, text_color = color.new(#b9f6ca, 0), text_halign = text.align_left, text_valign = vaT) : na
        lE = showEn ? label.new(time, dn > 0 ? low : high, dn > 0 ? "4H BUY" : "4H SELL", xloc = xloc.bar_time, style = dn > 0 ? label.style_label_up : label.style_label_down, color = dn > 0 ? color.new(#00e676, 0) : color.new(#ff5252, 0), textcolor = dn > 0 ? color.black : color.white, size = size.small) : na
        cur := Pos.new(time, e, sl, tp, bT, bS, na, lE, true, na, dn)
        ps.push(cur)
        if ps.size() > psKeep
            old = ps.shift()
            box.delete(old.bS)
            if not na(old.bT)
                box.delete(old.bT)
            if not na(old.lb)
                label.delete(old.lb)
            label.delete(old.lE)

// n5.6: asal entry ka waqt - table ka BUY isi se (jo position / nishan chart par bana, wahi). Position ban'ne ke BAAD set hota hai.
var int lastEntryT = na
var int lastEntryDir = 0
if (entryNow or entryShort) and (not showPs or (not na(cur) and cur.live and cur.t0 == time))
    lastEntryT := time
    lastEntryDir := entryNow ? 1 : -1

// ============================================================================
//  ZONES: pivot -> jor -> array
// ============================================================================
type Lvl
    float p
    int rk
    int t
    int n

var array<Lvl> lv = array.new<Lvl>()

// n5.6: 80 se zyada hon to sab se kamzor zone nikalo: pehle kam rank (1H), phir kam dafa chhui, phir qeemat se sab se door.
// Naya (aakhri) zone bachaya jata hai. Pehle sab se purani nikalti thi, chahe majboot ho.
f_evict() =>
    int w = -1
    for i = 0 to lv.size() - 2
        L = lv.get(i)
        if w < 0
            w := i
        else
            Lw = lv.get(w)
            bool weaker = L.rk < Lw.rk or (L.rk == Lw.rk and (L.n < Lw.n or (L.n == Lw.n and math.abs(L.p - close) > math.abs(Lw.p - close))))
            if weaker
                w := i
    if w >= 0
        lv.remove(w)
    w

f_add(float p, int rk, int t, float tol) =>
    bool merged = false
    if lv.size() > 0
        for i = 0 to lv.size() - 1
            L = lv.get(i)
            if math.abs(L.p - p) <= tol
                L.p := (L.p * L.n + p) / (L.n + 1)
                L.n := L.n + 1
                L.rk := math.max(L.rk, rk)
                L.t := math.min(L.t, t)
                merged := true
                break
    if not merged
        lv.push(Lvl.new(p, rk, t, 1))
        if lv.size() > 80
            f_evict()
    merged

nw1 = ta.change(t1) != 0
nw2 = ta.change(t2) != 0
nw3 = ta.change(t3) != 0
nw4 = ta.change(t4) != 0

if not na(aD) and aD > 0
    tol = zTol * aD
    if ok1 and nw1
        if not na(h1)
            f_add(h1, 1, t1, tol)
        if not na(l1)
            f_add(l1, 1, t1, tol)
    if ok2 and nw2
        if not na(h2)
            f_add(h2, 2, t2, tol)
        if not na(l2)
            f_add(l2, 2, t2, tol)
    if ok3 and nw3
        if not na(h3)
            f_add(h3, 3, t3, tol)
        if not na(l3)
            f_add(l3, 3, t3, tol)
    if ok4 and nw4
        if not na(h4)
            f_add(h4, 4, t4, tol)
        if not na(l4)
            f_add(l4, 4, t4, tol)

f_rkName(int rk) =>
    rk == 4 ? "1W" : rk == 3 ? "1D" : rk == 2 ? "4H" : "1H"

// ============================================================================
//  RUKH / RSI / TOOT
// ============================================================================
f_dir(float c, float m, float n, float d) =>
    na(c) or na(m) or na(n) or na(d) ? 0 : (c > m and m > n and d < 0) ? 1 : (c < m and m < n and d > 0) ? -1 : 0

f_dirTxt(int v) =>
    v > 0 ? "▲ UPAR" : v < 0 ? "▼ NEECHE" : "◆ MILA"

f_dirCol(int v) =>
    v > 0 ? color.new(#2e7d32, 0) : v < 0 ? color.new(#c62828, 0) : color.new(#9e9e9e, 0)

f_rsiTxt(float r) =>
    na(r) ? "-" : str.tostring(r, "#") + (r >= 70 ? " OB" : r <= 30 ? " OS" : "")

f_rsiCol(float r) =>
    na(r) ? color.gray : r >= 70 ? color.new(#c62828, 0) : r <= 30 ? color.new(#2e7d32, 0) : color.new(#bdbdbd, 0)

f_distTxt(float m, float a) =>
    na(m) or na(a) or a <= 0 ? "-" : str.tostring((close - m) / a, "+0.0;-0.0") + " ATR"

dv0 = ok0 ? f_dir(c0, m0, n0, d0) : 0
dv1 = ok1 ? f_dir(c1, m1, n1, d1) : 0
dv2 = ok2 ? f_dir(c2, m2, n2, d2) : 0
dv3 = ok3 ? f_dir(c3, m3, n3, d3) : 0
dv4 = ok4 ? f_dir(c4, m4, n4, d4) : 0
nTf = (ok0 ? 1 : 0) + (ok1 ? 1 : 0) + (ok2 ? 1 : 0) + (ok3 ? 1 : 0) + (ok4 ? 1 : 0)
nUp = (dv0 > 0 ? 1 : 0) + (dv1 > 0 ? 1 : 0) + (dv2 > 0 ? 1 : 0) + (dv3 > 0 ? 1 : 0) + (dv4 > 0 ? 1 : 0)
nDn = (dv0 < 0 ? 1 : 0) + (dv1 < 0 ? 1 : 0) + (dv2 < 0 ? 1 : 0) + (dv3 < 0 ? 1 : 0) + (dv4 < 0 ? 1 : 0)

[bbM, bbU, bbL] = ta.bb(close, 20, 2.0)
bbw = bbM != 0 ? (bbU - bbL) / bbM : na
bbPct = ta.percentrank(bbw, 120)
rsiC = ta.rsi(close, 14)

// ============================================================================
//  NEWS WAQT (NY)
// ============================================================================
var fomc = array.from(20260128, 20260318, 20260429, 20260617, 20260729, 20260916, 20261028, 20261209)
NY = "America/New_York"

f_ymd(int t) =>
    year(t, NY) * 10000 + month(t, NY) * 100 + dayofmonth(t, NY)

f_isFomc(int t) =>
    array.includes(fomc, f_ymd(t))

f_isWk(int t) =>
    dw = dayofweek(t, NY)
    dw >= dayofweek.monday and dw <= dayofweek.friday

// bar ke andar (ya +-15 min) koi news waqt?  0 = nahi, 1 = aam US data, 2 = NFP / FOMC
f_newsBar() =>
    int lvl = 0
    if timeframe.isintraday and f_isWk(time)
        bs = hour(time, NY) * 60 + minute(time, NY)
        be = bs + int(chSec / 60)
        nfp = dayofweek(time, NY) == dayofweek.friday and dayofmonth(time, NY) <= 7
        if bs < 510 + 15 and be > 510 - 15
            lvl := nfp ? 2 : 1
        if bs < 600 + 15 and be > 600 - 15
            lvl := math.max(lvl, 1)
        if f_isFomc(time) and bs < 840 + 15 and be > 840 - 15
            lvl := 2
    lvl

nb = showNB and chSec <= 3600 ? f_newsBar() : 0
bgcolor(nb == 2 ? color.new(#ff9800, 75) : nb == 1 ? color.new(#ff9800, 90) : na, title = "News waqt")

f_nextNews() =>
    int nt = na
    string tag = ""
    for k = 0 to 9
        b = timenow + k * 86400000
        if f_isWk(b) and na(nt)
            y = year(b, NY)
            mo = month(b, NY)
            dd = dayofmonth(b, NY)
            nfp = dayofweek(b, NY) == dayofweek.friday and dd <= 7
            ta830 = timestamp(NY, y, mo, dd, 8, 30)
            ta1000 = timestamp(NY, y, mo, dd, 10, 0)
            ta1400 = timestamp(NY, y, mo, dd, 14, 0)
            if ta830 > timenow
                nt := ta830
                tag := nfp ? "NFP (aksar) 08:30 NY" : "US data 08:30 NY"
            else if ta1000 > timenow
                nt := ta1000
                tag := "US data 10:00 NY"
            else if f_isFomc(b) and ta1400 > timenow
                nt := ta1400
                tag := "FOMC 14:00 NY"
    [nt, tag]

// ============================================================================
//  AAKHRI CANDLE: zones + lakeer + table
// ============================================================================
var array<box> bx = array.new<box>()
var array<line> ln = array.new<line>()
var array<box> bxN = array.new<box>()
var label lbN = na
var table tb = na

f_pos(string s) =>
    s == "Middle Left" ? position.middle_left : s == "Top Left" ? position.top_left : s == "Middle Right" ? position.middle_right : s == "Top Right" ? position.top_right : s == "Bottom Right" ? position.bottom_right : s == "Bottom Center" ? position.bottom_center : position.bottom_left

f_sz(string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : size.small

cR = color.new(#e53935, 0)
cS = color.new(#43a047, 0)
cTx = color.new(#e0e0e0, 0)
cBg = color.new(#121212, 15)
cHd = color.new(#263238, 0)

// nazdeek zone (toot ke liye) - aakhri candle par bharta
var float nearUp = na
var float nearDn = na
var string nearUpTx = ""
var string nearDnTx = ""

if barstate.islast
    // n5.6: CHALU / BUY ka faisla ek hi jagah (dono table ke liye). BUY = chart par asal entry bani aur 4 ghante se kam guzre.
    bool live = not na(cur) and cur.live and showPs and ok2
    float liveR = na
    int liveD = 0
    if live
        liveR := (close - cur.e) / (cur.e - cur.sl)
        liveD := cur.dir
    bool entryFresh = not na(lastEntryT) and time - lastEntryT < 4 * 3600000
    bool freshOk = ok2 and entryFresh
    bool buyNow = freshOk and lastEntryDir > 0 and (not showPs or liveD > 0)
    bool sellNow = freshOk and lastEntryDir < 0 and (not showPs or liveD < 0)
    // KHULASA ka lafz (dono table ke liye ek hi): BUY / SELL = asal entry (pehle 4 ghante), CHALU = khuli position, RUKO = 1D se koi side nahi
    string word = buyNow ? "BUY" : sellNow ? "SELL" : live ? "CHALU" : dSide == 0 ? "RUKO" : not ok2 ? "TAYYAR" : dSide > 0 ? (d2 > 0 ? "TAYYAR" : "INTEZAR") : (d2 < 0 ? "TAYYAR" : "INTEZAR")
    color wCol = word == "BUY" ? color.new(#00e676, 0) : word == "SELL" ? color.new(#ff5252, 0) : word == "CHALU" ? (liveD > 0 ? color.new(#00e676, 0) : color.new(#ff5252, 0)) : word == "RUKO" ? color.new(#9e9e9e, 0) : color.new(#ffb300, 0)
    while bx.size() > 0
        box.delete(bx.pop())
    while ln.size() > 0
        line.delete(ln.pop())
    nearUp := na
    nearDn := na
    nearUpTx := ""
    nearDnTx := ""
    if not na(aD) and aD > 0 and lv.size() > 0
        array<float> dU = array.new<float>()
        array<int> iU = array.new<int>()
        array<float> dDn = array.new<float>()
        array<int> iD = array.new<int>()
        for i = 0 to lv.size() - 1
            L = lv.get(i)
            dist = L.p - close
            if math.abs(dist) <= 6 * aD
                if dist >= 0
                    dU.push(dist)
                    iU.push(i)
                else
                    dDn.push(-dist)
                    iD.push(i)
        sU = dU.size() > 0 ? array.sort_indices(dU, order.ascending) : array.new<int>()
        sD = dDn.size() > 0 ? array.sort_indices(dDn, order.ascending) : array.new<int>()
        hz = zH * aD
        if sU.size() > 0
            for j = 0 to math.min(zN, sU.size()) - 1
                L = lv.get(iU.get(sU.get(j)))
                if j == 0
                    nearUp := L.p
                    nearUpTx := "R " + f_rkName(L.rk) + " " + str.tostring(L.p, format.mintick)
                if showZ
                    tr = 92 - L.rk * 8
                    bx.push(box.new(L.t, L.p + hz, time, L.p - hz, xloc = xloc.bar_time, extend = extend.right, border_color = color.new(#e53935, 60), bgcolor = color.new(#e53935, tr), text = "R " + f_rkName(L.rk) + " x" + str.tostring(L.n), text_size = size.tiny, text_color = color.new(#e53935, 20), text_halign = text.align_right, text_valign = text.align_center))
        if sD.size() > 0
            for j = 0 to math.min(zN, sD.size()) - 1
                L = lv.get(iD.get(sD.get(j)))
                if j == 0
                    nearDn := L.p
                    nearDnTx := "S " + f_rkName(L.rk) + " " + str.tostring(L.p, format.mintick)
                if showZ
                    tr = 92 - L.rk * 8
                    bx.push(box.new(L.t, L.p + hz, time, L.p - hz, xloc = xloc.bar_time, extend = extend.right, border_color = color.new(#43a047, 60), bgcolor = color.new(#43a047, tr), text = "S " + f_rkName(L.rk) + " x" + str.tostring(L.n), text_size = size.tiny, text_color = color.new(#43a047, 20), text_halign = text.align_right, text_valign = text.align_center))
    // AGLI position (andaza): 1D UPAR + 4H Supertrend abhi neeche + koi khuli nahi -> entry ~ 4H Supertrend lakeer
    while bxN.size() > 0
        box.delete(bxN.pop())
    label.delete(lbN)
    lbN := na
    if psNext and showPs and ok2 and dSide != 0 and d2 * dSide > 0 and not na(s2) and not na(k2) and k2 > 0 and (na(cur) or not cur.live)
        eN = s2
        slN = eN - dSide * psSL * k2
        tpN = psTP > 0 ? eN + psTP * (eN - slN) : na
        tR = time + 6 * 4 * 3600000
        bxN.push(box.new(time, dSide > 0 ? eN : slN, tR, dSide > 0 ? slN : eN, xloc = xloc.bar_time, border_color = color.new(#c62828, 30), border_style = line.style_dotted, bgcolor = color.new(#c62828, 92)))
        if psTP > 0
            bxN.push(box.new(time, dSide > 0 ? tpN : eN, tR, dSide > 0 ? eN : tpN, xloc = xloc.bar_time, border_color = color.new(#2e7d32, 30), border_style = line.style_dotted, bgcolor = color.new(#2e7d32, 92)))
        lbN := label.new(tR, eN, "AGLI " + (dSide > 0 ? "BUY" : "SELL") + " (andaza) - intezar\nentry ~" + str.tostring(eN, format.mintick) + (dSide > 0 ? " (4H close is se upar)" : " (4H close is se neeche)") + "\nSL ~" + str.tostring(slN, format.mintick) + (psTP > 0 ? " | TP ~" + str.tostring(tpN, format.mintick) : ""), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(#263238, 10), textcolor = color.new(#ffb300, 0), size = size.small)
    if showPD and not na(pdh)
        t0d = time - 20 * chSec * 1000
        ln.push(line.new(t0d, pdh, time, pdh, xloc = xloc.bar_time, extend = extend.right, color = color.new(#90a4ae, 30), style = line.style_dotted, width = 1))
        ln.push(line.new(t0d, pdl, time, pdl, xloc = xloc.bar_time, extend = extend.right, color = color.new(#90a4ae, 30), style = line.style_dotted, width = 1))
        if not na(pwh)
            ln.push(line.new(t0d, pwh, time, pwh, xloc = xloc.bar_time, extend = extend.right, color = color.new(#90a4ae, 0), style = line.style_dashed, width = 1))
            ln.push(line.new(t0d, pwl, time, pwl, xloc = xloc.bar_time, extend = extend.right, color = color.new(#90a4ae, 0), style = line.style_dashed, width = 1))

    if not na(tb)
        table.delete(tb)
    if showT and tFull
        sz = f_sz(tSize)
        tb := table.new(f_pos(tPos), 4, 15, bgcolor = cBg, border_width = 1, border_color = color.new(#37474f, 0), frame_width = 1, frame_color = color.new(#37474f, 0))
        table.cell(tb, 0, 0, "JAS NAQSHA+5EA j3.2", text_color = cTx, bgcolor = cHd, text_size = sz)
        table.cell(tb, 1, 0, "sirf naqsha - TEST NAHI", text_color = color.new(#ffb300, 0), bgcolor = cHd, text_size = sz)
        table.merge_cells(tb, 1, 0, 3, 0)
        table.cell(tb, 0, 1, "TF", text_color = cTx, bgcolor = cHd, text_size = sz)
        table.cell(tb, 1, 1, "Rukh", text_color = cTx, bgcolor = cHd, text_size = sz)
        table.cell(tb, 2, 1, "RSI", text_color = cTx, bgcolor = cHd, text_size = sz)
        table.cell(tb, 3, 1, "EMA50 se", text_color = cTx, bgcolor = cHd, text_size = sz)
        names = array.from("15m", "1H", "4H", "1D", "1W")
        oks = array.from(ok0, ok1, ok2, ok3, ok4)
        dvs = array.from(dv0, dv1, dv2, dv3, dv4)
        rs = array.from(r0, r1, r2, r3, r4)
        ms = array.from(m0, m1, m2, m3, m4)
        as_ = array.from(a0, a1, a2, a3, a4)
        for k = 0 to 4
            okk = oks.get(k)
            table.cell(tb, 0, 2 + k, names.get(k), text_color = cTx, text_size = sz)
            table.cell(tb, 1, 2 + k, okk ? f_dirTxt(dvs.get(k)) : "- (chhoti TF)", text_color = okk ? f_dirCol(dvs.get(k)) : color.gray, text_size = sz)
            table.cell(tb, 2, 2 + k, okk ? f_rsiTxt(rs.get(k)) : "-", text_color = okk ? f_rsiCol(rs.get(k)) : color.gray, text_size = sz)
            table.cell(tb, 3, 2 + k, okk ? f_distTxt(ms.get(k), as_.get(k)) : "-", text_color = cTx, text_size = sz)
        // kul rukh
        kTx = nUp > nDn and nUp * 2 > nTf ? "▲ UPAR " + str.tostring(nUp) + "/" + str.tostring(nTf) : nDn > nUp and nDn * 2 > nTf ? "▼ NEECHE " + str.tostring(nDn) + "/" + str.tostring(nTf) : "◆ MILA JULA (" + str.tostring(nUp) + " upar, " + str.tostring(nDn) + " neeche)"
        kCol = nUp > nDn and nUp * 2 > nTf ? f_dirCol(1) : nDn > nUp and nDn * 2 > nTf ? f_dirCol(-1) : f_dirCol(0)
        table.cell(tb, 0, 7, "KUL RUKH", text_color = cTx, bgcolor = cHd, text_size = sz)
        table.cell(tb, 1, 7, kTx, text_color = kCol, text_size = sz)
        table.merge_cells(tb, 1, 7, 3, 7)
        // toot
        dUpA = na(nearUp) or na(aD) ? na : (nearUp - close) / aD
        dDnA = na(nearDn) or na(aD) ? na : (close - nearDn) / aD
        dMin = na(dUpA) ? dDnA : na(dDnA) ? dUpA : math.min(dUpA, dDnA)
        sq = not na(bbPct) and bbPct <= 25
        near = not na(dMin) and dMin <= 0.15
        tLvl = near and sq ? "UNCHA" : near or sq ? "DARMIYANA" : "KAM"
        tCol = tLvl == "UNCHA" ? color.new(#ff5252, 0) : tLvl == "DARMIYANA" ? color.new(#ffb300, 0) : color.new(#9e9e9e, 0)
        side = na(dMin) ? "" : (not na(dUpA) and dMin == dUpA) ? nearUpTx : nearDnTx
        tWhy = (na(dMin) ? "zone nahi" : side + " (" + str.tostring(dMin, "0.00") + " ATR-D)") + (sq ? " | squeeze" : "")
        table.cell(tb, 0, 8, "TOOT KHATRA", text_color = cTx, bgcolor = cHd, text_size = sz)
        table.cell(tb, 1, 8, tLvl + "  " + tWhy, text_color = tCol, text_size = sz)
        table.merge_cells(tb, 1, 8, 3, 8)
        // OB / OS chart TF
        obTx = na(rsiC) ? "-" : rsiC >= 70 ? "OVERBOUGHT (RSI " + str.tostring(rsiC, "#") + ")" : rsiC <= 30 ? "OVERSOLD (RSI " + str.tostring(rsiC, "#") + ")" : "theek (RSI " + str.tostring(rsiC, "#") + ")"
        table.cell(tb, 0, 9, "OB / OS (chart)", text_color = cTx, bgcolor = cHd, text_size = sz)
        table.cell(tb, 1, 9, obTx, text_color = f_rsiCol(rsiC), text_size = sz)
        table.merge_cells(tb, 1, 9, 3, 9)
        // news
        [nt, tag] = f_nextNews()
        nTx = na(nt) ? "-" : tag + " = " + str.format_time(nt, "EEE HH:mm", "Asia/Karachi") + " PKT (" + str.tostring(math.floor((nt - timenow) / 3600000)) + "h " + str.tostring(math.floor((nt - timenow) % 3600000 / 60000)) + "m)"
        nCol = str.contains(tag, "NFP") or str.contains(tag, "FOMC") ? color.new(#ff9800, 0) : cTx
        table.cell(tb, 0, 10, "AGLI NEWS", text_color = cTx, bgcolor = cHd, text_size = sz)
        table.cell(tb, 1, 10, nTx, text_color = nCol, text_size = sz)
        table.merge_cells(tb, 1, 10, 3, 10)
        table.cell(tb, 0, 11, "ZONE", text_color = cTx, bgcolor = cHd, text_size = sz)
        table.cell(tb, 1, 11, (nearUpTx == "" ? "R -" : nearUpTx) + "   |   " + (nearDnTx == "" ? "S -" : nearDnTx), text_color = cTx, text_size = sz)
        table.merge_cells(tb, 1, 11, 3, 11)
        // 1D EMA rukh
        eTx = na(m3) ? "-" : (dRukh > 0 ? "▲ UPAR - sirf BUY socho" : dRukh < 0 ? (showSell ? "▼ NEECHE - sirf SELL socho" : buy1D ? "▼ NEECHE - BUY nahi" : "▼ NEECHE - BUY sirf B1 jaisa (dhyan)") : "◆ MILA - intezar") + "  (EMA50 " + str.tostring(m3, format.mintick) + " | EMA200 " + str.tostring(n3, format.mintick) + ")"
        table.cell(tb, 0, 12, "1D EMA50/200", text_color = cTx, bgcolor = cHd, text_size = sz)
        table.cell(tb, 1, 12, eTx, text_color = f_dirCol(dRukh), text_size = sz)
        table.merge_cells(tb, 1, 12, 3, 12)
        // 4H entry waqt (n5.6: buyNow = chart ki asal entry)
        flTx = na(lastFlipT) ? "" : " (mura " + str.format_time(lastFlipT, "dd MMM HH:mm", "Asia/Karachi") + " PKT)"
        string s2Tx = na(s2) ? "Supertrend" : str.tostring(s2, format.mintick)
        hTx = not ok2 ? "4H ya chhota chart lagayein" : buyNow ? "ABHI BUY KA WAQT - 4H Supertrend upar mura" + flTx : sellNow ? "ABHI SELL KA WAQT - 4H Supertrend neeche mura" + flTx : dSide == 0 ? "1D rukh saaf nahi - koi entry nahi" : dSide > 0 ? (d2 < 0 ? "4H UPAR chal raha" + flTx + " - nayi BUY nahi, agle mor ka intezar" : "intezar: 4H close " + s2Tx + " se upar band ho (agli position dotted)") : (d2 > 0 ? "4H NEECHE chal raha" + flTx + " - nayi SELL nahi, agle mor ka intezar" : "intezar: 4H close " + s2Tx + " se neeche band ho (agli position dotted)")
        hCol = not ok2 ? color.gray : buyNow ? color.new(#00e676, 0) : sellNow ? color.new(#ff5252, 0) : dSide == 0 ? color.gray : color.new(#ffb300, 0)
        table.cell(tb, 0, 13, "4H ENTRY", text_color = cTx, bgcolor = cHd, text_size = sz)
        table.cell(tb, 1, 13, hTx, text_color = hCol, text_size = sz)
        table.merge_cells(tb, 1, 13, 3, 13)
        // 4H position
        string pTx = not (showPs and ok2) ? "-" : "abhi tak koi nahi"
        color pCol = color.gray
        if showPs and ok2 and not na(cur)
            if cur.live
                pTx := "KHULI " + (cur.dir > 0 ? "BUY " : "SELL ") + str.tostring(cur.e, format.mintick) + " | SL " + str.tostring(cur.sl, format.mintick) + (na(cur.tp) ? "" : " | TP " + str.tostring(cur.tp, format.mintick)) + " | abhi " + str.tostring((close - cur.e) / (cur.e - cur.sl), "+0.0;-0.0") + "R"
                pCol := cur.dir > 0 ? color.new(#00e676, 0) : color.new(#ff5252, 0)
            else
                pTx := "band - aakhri " + str.tostring(cur.r, "+0.0;-0.0") + "R (" + str.format_time(cur.t0, "dd MMM", "Asia/Karachi") + ")"
                pCol := cur.r >= 0 ? color.new(#66bb6a, 0) : color.new(#ef5350, 0)
        table.cell(tb, 0, 14, "4H POSITION", text_color = cTx, bgcolor = cHd, text_size = sz)
        table.cell(tb, 1, 14, pTx, text_color = pCol, text_size = sz)
        table.merge_cells(tb, 1, 14, 3, 14)
        // KHULASA (sab ka nichor, ek line) - table ki pehli line
        // lafz (word) aur uska rang (wCol) islast ke shuru mein tay hote hain
        wWhy = word == "CHALU" ? (liveD > 0 ? "BUY" : "SELL") + " khuli, abhi " + str.tostring(liveR, "+0.0;-0.0") + "R" : word == "RUKO" ? (dRukh < 0 ? "1D NEECHE - BUY nahi (SELL switch band)" : "1D rukh saaf nahi - BUY / SELL dono nahi") : word == "BUY" ? "4H mor + 1D UPAR = BUY ka waqt" : word == "SELL" ? "4H mor + 1D NEECHE = SELL ka waqt (SELL ka test nahi)" : word == "TAYYAR" ? (ok2 ? (dSide > 0 ? "1D UPAR, 4H close " + str.tostring(s2, format.mintick) + " se upar ka intezar" : "1D NEECHE, 4H close " + str.tostring(s2, format.mintick) + " se neeche ka intezar") : (dSide > 0 ? "1D UPAR - 4H chart par entry dekhein" : "1D NEECHE - 4H chart par entry dekhein")) : (dSide > 0 ? "1D UPAR, 4H pehle se upar - agle mor ka intezar" : "1D NEECHE, 4H pehle se neeche - agle mor ka intezar")
        kW = nUp > nDn and nUp * 2 > nTf ? "UPAR" : nDn > nUp and nDn * 2 > nTf ? "NEECHE" : "MILA"
        zW = side == "" ? "" : " · " + side + (tLvl == "KAM" ? "" : " (toot " + tLvl + ")")
        oW = na(rsiC) ? "" : rsiC >= 70 ? " · OVERBOUGHT" : rsiC <= 30 ? " · OVERSOLD" : ""
        nW = na(nt) ? "" : " · news " + str.format_time(nt, "EEE HH:mm", "Asia/Karachi") + (str.contains(tag, "NFP") ? " NFP" : str.contains(tag, "FOMC") ? " FOMC" : "")
        table.cell(tb, 0, 0, word, text_color = wCol, bgcolor = cHd, text_size = sz)
        table.cell(tb, 1, 0, wWhy + " · rukh " + kW + zW + oW + nW + "  (test nahi)", text_color = wCol, bgcolor = cHd, text_size = sz, text_halign = text.align_left)

    // CHHOTI TABLE (default): 4 line
    if showT and not tFull
        sz = f_sz(tSize)
        dUpA = na(nearUp) or na(aD) ? na : (nearUp - close) / aD
        dDnA = na(nearDn) or na(aD) ? na : (close - nearDn) / aD
        dMin = na(dUpA) ? dDnA : na(dDnA) ? dUpA : math.min(dUpA, dDnA)
        sq = not na(bbPct) and bbPct <= 25
        near = not na(dMin) and dMin <= 0.15
        tLvl = near and sq ? "UNCHA" : near or sq ? "DARMIYANA" : "KAM"
        [nt, tag] = f_nextNews()
        // lafz (word) aur uska rang (wCol) islast ke shuru mein tay hote hain
        wWhy = word == "CHALU" ? (liveD > 0 ? "BUY" : "SELL") + " khuli, abhi " + str.tostring(liveR, "+0.0;-0.0") + "R" : word == "RUKO" ? (dRukh < 0 ? "BUY nahi (1D neeche, SELL band)" : "1D saaf nahi - koi side nahi") : word == "BUY" ? "BUY ka waqt" : word == "SELL" ? "SELL ka waqt (test nahi)" : word == "TAYYAR" ? (ok2 ? (dSide > 0 ? "4H close > " : "4H close < ") + str.tostring(s2, format.mintick) : "4H chart dekhein") : "agle 4H mor ka intezar"
        kW = nUp > nDn and nUp * 2 > nTf ? "UPAR" : nDn > nUp and nDn * 2 > nTf ? "NEECHE" : "MILA"
        rTx = "1D " + (dRukh > 0 ? "UPAR" : dRukh < 0 ? "NEECHE" : "MILA") + (ok2 ? " · 4H " + (dv2 > 0 ? "UPAR" : dv2 < 0 ? "NEECHE" : "MILA") : "") + " · kul " + kW
        zTx = (nearUpTx == "" ? "R -" : "R " + str.tostring(nearUp, format.mintick)) + " · " + (nearDnTx == "" ? "S -" : "S " + str.tostring(nearDn, format.mintick)) + (tLvl == "KAM" ? "" : " · toot " + tLvl)
        nTx = na(nt) ? "-" : str.format_time(nt, "EEE HH:mm", "Asia/Karachi") + " PKT" + (str.contains(tag, "NFP") ? " NFP" : str.contains(tag, "FOMC") ? " FOMC" : "")
        tb := table.new(f_pos(tPos), 2, 4, bgcolor = cBg, border_width = 1, border_color = color.new(#37474f, 0), frame_width = 1, frame_color = color.new(#37474f, 0))
        table.cell(tb, 0, 0, word, text_color = wCol, bgcolor = cHd, text_size = sz)
        table.cell(tb, 1, 0, wWhy, text_color = wCol, text_size = sz, text_halign = text.align_left)
        table.cell(tb, 0, 1, "Rukh", text_color = cTx, bgcolor = cHd, text_size = sz)
        table.cell(tb, 1, 1, rTx, text_color = f_dirCol(dRukh), text_size = sz, text_halign = text.align_left)
        table.cell(tb, 0, 2, "Zone", text_color = cTx, bgcolor = cHd, text_size = sz)
        table.cell(tb, 1, 2, zTx, text_color = tLvl == "UNCHA" ? color.new(#ff5252, 0) : tLvl == "DARMIYANA" ? color.new(#ffb300, 0) : cTx, text_size = sz, text_halign = text.align_left)
        table.cell(tb, 0, 3, "News", text_color = cTx, bgcolor = cHd, text_size = sz)
        table.cell(tb, 1, 3, nTx, text_color = str.contains(tag, "NFP") or str.contains(tag, "FOMC") ? color.new(#ff9800, 0) : cTx, text_size = sz, text_halign = text.align_left)


// ============================================================================
//  ===== 5EA HISSA (jas_5ea p6; naam badle: LA->eLA, cTx->eTx, cBg->eBg, tb->tb5, showSell->showSell5, f_pos->f_pos5, f_isWk->f_isWk5) =====
// ============================================================================

BUILD = "j3.2"
TZ    = "America/New_York"
DAY   = 86400000
SWAP  = 0.03 / 365
C_XAU = 0.75 * 0.0059 / 100
C_XAG = 0.75 * 0.0445 / 100
C_SPX = 0.75 * 0.0052 / 100
C_NAS = 0.75 * 0.0038 / 100
C_IDX = 0.02 / 100
TMIN  = timestamp("1900-01-01T00:00:00+00:00")
TMAX  = timestamp("2100-01-01T00:00:00+00:00")

grM = "6 · 5EA: Markets (#73 - mat badlein)"
mXAU = input.symbol("OANDA:XAUUSD", "XAU  (B1, S1)", group = grM, display = display.none)
mXAG = input.symbol("OANDA:XAGUSD", "XAG  (B1, S1)", group = grM, display = display.none)
