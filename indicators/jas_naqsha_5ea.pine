// 1m..4H chart: lookahead_on (HTF candle ka haal us ke OPEN tak = aage ka data nahi); bara chart: 4H andar ki aakhri candle
eLA = timeframe.in_seconds() <= 14400 ? barmerge.lookahead_on : barmerge.lookahead_off

// ============================================================================
//  EK LEG (ek EA x ek market): khuli trade + band trades ka hisaab (p2 jaisa; p3 mein sirf khuli trade bahar aati hai)
// ============================================================================
type Leg
    int   dir = 1
    float e = na
    float sl = na
    float sd = na
    int   et = na
    int   ec = 0
    int   n = 0
    int   w = 0
    float s = 0.0
    float q = 0.0
    float cum = 0.0
    float pk = 0.0
    float dd = 0.0

// band: R = (rukh x (exit - entry) - kharcha x (entry + exit) - swap x raatein x entry) / SL doori  (ftmo73.net_r)
f_close(Leg g, float px, float cst, int fromT, int toT, int xt) =>
    nights = math.max(0, math.floor(xt / 86400000.0) - math.floor(g.et / 86400000.0))
    r = (g.dir * (px - g.e) - cst * (g.e + px) - SWAP * nights * g.e) / g.sd
    if g.et >= fromT and g.et < toT
        g.n += 1
        g.w += r > 0 ? 1 : 0
        g.s += r
        g.q += r * r
        g.cum += r
        g.pk := math.max(g.pk, g.cum)
        g.dd := math.max(g.dd, g.pk - g.cum)
    g.e := na
    g.sl := na
    r

f_open(Leg g, float px, float sd, int t) =>
    g.e := px
    g.sd := sd
    g.sl := px - g.dir * sd
    g.et := t
    g.ec := 0
    px

// ============================================================================
//  B1 + S1 (+ B2 + S2) - EK market, 4H candles. Har 4H candle k par tarteeb (Python jaisi):
//   (1) candle k-1 ke andar SL  (2) k-1 ke close par Supertrend mura?  (3) naya din? -> pichhle din ka IBS / SMA200 /
//   ATR14 + IBS ki apni band  (4) k ke open par rukh wali band  (5) din ke close: B2, SELL kato, S2  (6) k ka open: B1, SELL kato, S1.
//   Wapas = haal "candle k ke OPEN par" - is mein k ka high / low / close nahi = repaint nahi.
// ============================================================================
f_core(bool act, bool ibsOn, float cst, int fromT, int toT) =>
    var Leg b1 = Leg.new(dir = 1)
    var Leg sel1 = Leg.new(dir = -1)
    var Leg b2 = Leg.new(dir = 1)
    var Leg sel2 = Leg.new(dir = -1)
    var array<float> cls = array.new<float>()
    var float cSum = 0.0
    var float dH = na
    var float dL = na
    var float pdC = na
    var float dSma = na
    var float dAtr = na
    var float trSum = 0.0
    var int   nDay = 0
    var bool  b2Hit = false
    var bool  s2Hit = false
    [stv, stDir] = ta.supertrend(3.0, 10)
    atr4 = ta.atr(10)
    up = stDir < 0
    if act and bar_index >= 1
        qo1 = open[1]
        qh1 = high[1]
        ql1 = low[1]
        qt1 = time[1]
        // (1) SL pichhli candle mein (gap = open)
        if not na(b1.e) and ql1 <= b1.sl
            f_close(b1, math.min(qo1, b1.sl), cst, fromT, toT, qt1)
        if not na(sel1.e) and qh1 >= sel1.sl
            f_close(sel1, math.max(qo1, sel1.sl), cst, fromT, toT, qt1)
        if not na(b2.e) and ql1 <= b2.sl
            f_close(b2, math.min(qo1, b2.sl), cst, fromT, toT, qt1)
            b2Hit := true
        if not na(sel2.e) and qh1 >= sel2.sl
            f_close(sel2, math.max(qo1, sel2.sl), cst, fromT, toT, qt1)
            s2Hit := true
        dH := na(dH) ? qh1 : math.max(dH, qh1)
        dL := na(dL) ? ql1 : math.min(dL, ql1)
        // (2) Supertrend k-1 ke close par mura? (signal candle # > 30, Python jaisa)
        sig = bar_index - 1 > 30
        fUp = sig and up[1] and not up[2]
        fDn = sig and not up[1] and up[2]
        xb1 = not na(b1.e) and not up[1]
        xs1 = not na(sel1.e) and up[1]
        pb1 = fUp and na(b1.e)
        ps1 = fDn and na(sel1.e)
        sdT = 6.0 * atr4[1]
        // (3) naya din (17:00 NY) shuru = pichhla din band: close, ATR14 (RMA), SMA200, IBS
        bool  dayEv = false
        float dc = close[1]
        float ibs = 0.5
        if time_tradingday != time_tradingday[1] and not na(dH)
            tr = na(pdC) ? dH - dL : math.max(dH - dL, math.abs(dH - pdC), math.abs(dL - pdC))
            nDay += 1
            if nDay <= 14
                trSum += tr
                dAtr := nDay == 14 ? trSum / 14 : na
            else
                dAtr := (dAtr * 13 + tr) / 14
            cls.push(dc)
            cSum += dc
            if cls.size() > 200
                cSum -= cls.shift()
            dSma := cls.size() >= 200 ? cSum / 200 : na
            ibs := dH > dL ? (dc - dL) / (dH - dL) : 0.5
            pdC := dc
            dH := na
            dL := na
            dayEv := true
            // IBS ki apni band: din ke close par (IBS ulta ya 5 din)
            if not na(b2.e)
                b2.ec += 1
                if ibs > 0.8 or b2.ec >= 5
                    f_close(b2, dc, cst, fromT, toT, time)
                    b2Hit := true
            if not na(sel2.e)
                sel2.ec += 1
                if ibs < 0.2 or sel2.ec >= 5
                    f_close(sel2, dc, cst, fromT, toT, time)
                    s2Hit := true
        // (4) is 4H open par rukh wali band
        if xb1
            f_close(b1, open, cst, fromT, toT, time)
        if xs1
            f_close(sel1, open, cst, fromT, toT, time)
        // (5) din ke CLOSE (dc) par: B2 BUY (band wale din nayi nahi) -> khuli SELL usi close par band -> S2 SELL
        //     (BUY khuli ho to ruki - khulti nahi, agla din phir dekha jata hai)
        okD = dayEv and not na(dSma) and not na(dAtr) and dAtr > 0
        if ibsOn and okD and na(b2.e) and not b2Hit and ibs < 0.2 and dc > dSma
            f_open(b2, dc, 3.0 * dAtr, time)
            if not na(sel1.e)
                f_close(sel1, dc, cst, fromT, toT, time)
            if not na(sel2.e)
                f_close(sel2, dc, cst, fromT, toT, time)
                s2Hit := true
        if ibsOn and okD and na(sel2.e) and not s2Hit and na(b1.e) and na(b2.e) and ibs > 0.8 and dc < dSma
            f_open(sel2, dc, 3.0 * dAtr, time)
        // (6) 4H OPEN par: B1 BUY -> khuli SELL usi open par band (judge #73: kal ke close wali S2 bhi - pehle khulti,
        //     phir yahan band; ruki NAHI) -> S1 SELL (BUY khuli ho to ruki)
        if pb1
            f_open(b1, open, sdT, time)
            if not na(sel1.e)
                f_close(sel1, open, cst, fromT, toT, time)
            if not na(sel2.e)
                f_close(sel2, open, cst, fromT, toT, time)
                s2Hit := true
        if ps1 and na(b1.e) and na(b2.e) and not na(dSma) and pdC < dSma
            f_open(sel1, open, sdT, time)
        if dayEv
            b2Hit := false
            s2Hit := false
    // p5: levels ke liye (logic se bahar, sirf wapasi): pichhli band 4H ki Supertrend lakeer + rukh, din ki SMA200,
    // aaj ka high / low abhi tak (pichhli candles + is candle), close. Sirf aakhri candle par istemal = history par asar nahi.
    tH = na(dH) ? high : math.max(dH, high)
    tL = na(dL) ? low : math.min(dL, low)
    [b1.e, b1.sl, sel1.e, sel1.sl, b2.e, b2.sl, sel2.e, sel2.sl, stv[1], up[1] ? 1.0 : -1.0, dSma, tH, tL, close]

// XAU / XAG: sirf B1 + S1 + Supertrend / SMA200 / close (8 tuple)
f_tr2(float cst, int fromT, int toT) =>
    [qa0, qa1, qc0, qc1, u0, u1, v0, v1, w0, w1, w2, w3, w4, w5] = f_core(true, false, cst, fromT, toT)
    [qa0, qa1, qc0, qc1, w0, w1, w2, w5]

// ============================================================================
//  B3 KHIRKI - NYSE CALENDAR + ENGINE (jas_khirki67.pine k2 hubahu; sirf wapasi badli)
// ============================================================================
f_easter(int y) =>
    a = y % 19
    b = math.floor(y / 100)
    c = y % 100
    d = math.floor(b / 4)
    e = b % 4
    f = math.floor((b + 8) / 25)
    g = math.floor((b - f + 1) / 3)
    h = (19 * a + b - d - g + 15) % 30
    i = math.floor(c / 4)
    k = c % 4
    l = (32 + 2 * e + 2 * i - h - k) % 7
    m = math.floor((a + 11 * h + 22 * l) / 451)
    n = h + l - 7 * m + 114
    [math.floor(n / 31), n % 31 + 1]

f_isWk5(int ts) =>
    w = dayofweek(ts, TZ)
    w != dayofweek.saturday and w != dayofweek.sunday

f_isHol(int ts) =>
    y = year(ts, TZ)
    m = month(ts, TZ)
    d = dayofmonth(ts, TZ)
    w = dayofweek(ts, TZ)
    wk = w != dayofweek.saturday and w != dayofweek.sunday
    mon = w == dayofweek.monday
    fri = w == dayofweek.friday
    bool h = false
    if m == 1
        h := (d == 1 and wk) or (d == 2 and mon) or (y >= 1998 and mon and d >= 15 and d <= 21)
    else if m == 2
        h := mon and d >= 15 and d <= 21
    else if m == 5
        h := mon and d >= 25
    else if m == 6
        h := y >= 2022 and ((d == 19 and wk) or (d == 18 and fri) or (d == 20 and mon))
    else if m == 7
        h := (d == 4 and wk) or (d == 3 and fri) or (d == 5 and mon)
    else if m == 9
        h := mon and d <= 7
    else if m == 11
        h := (w == dayofweek.thursday and d >= 22 and d <= 28) or ((y == 1972 or y == 1976 or y == 1980) and w == dayofweek.tuesday and d >= 2 and d <= 8)
    else if m == 12
        h := (d == 25 and wk) or (d == 24 and fri) or (d == 26 and mon)
    if not h and fri and (m == 3 or m == 4)
        [em, ed] = f_easter(y)
        gf = timestamp(TZ, y, em, ed, 12, 0) - 2 * DAY
        h := month(gf, TZ) == m and dayofmonth(gf, TZ) == d
    h

// index ki session (y-m-d) ka AGLA weekday P: P NYSE din ho aur P ke baad wala weekday NYSE chutti H = H (yyyymmdd), warna 0
f_win(int y, int m, int d) =>
    noon = timestamp(TZ, y, m, d, 12, 0)
    int p = noon
    for k = 1 to 4
        p := noon + k * DAY
        if f_isWk5(p)
            break
    int hy = 0
    if not f_isHol(p)
        int q = p
        for k = 1 to 4
            q := p + k * DAY
            if f_isWk5(q)
                break
        if f_isHol(q)
            hy := year(q, TZ) * 10000 + month(q, TZ) * 100 + dayofmonth(q, TZ)
    hy

// har index ki apni daily candles, sirf BAND candle [1]: BUY close par, band pehli session >= H ke close par, SL 3 x ATR20
f_kh(bool act, int fromT, int toT) =>
    _atrA = ta.atr(20)
    _o  = open[1]
    _l  = low[1]
    _c  = close[1]
    _a  = _atrA[1]
    _td = time_tradingday[1]
    var Leg g = Leg.new(dir = 1)
    if act and not na(_c) and not na(_td)
        _y   = year(_td, "UTC")
        _m   = month(_td, "UTC")
        _d   = dayofmonth(_td, "UTC")
        _ymd = _y * 10000 + _m * 100 + _d
        bool _cl = false
        if not na(g.e)
            if _l <= g.sl
                f_close(g, _o < g.sl ? _o : g.sl, C_IDX, fromT, toT, _td)
                _cl := true
            else if _ymd >= g.ec
                f_close(g, _c, C_IDX, fromT, toT, _td)
                _cl := true
        if not _cl and na(g.e) and _y >= 1971 and not na(_a) and _a > 0
            _hy = f_win(_y, _m, _d)
            if _hy > 0
                f_open(g, _c, 3.0 * _a, _td)
                g.ec := _hy
    [g.e, g.sl, close]


