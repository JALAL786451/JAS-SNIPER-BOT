//@version=6
// ============================================================================
//  JAS TREND 1H  (build h1, Pine v6) - 11 Nov 2026
//  JasTrend1hEA.mq5 h1 ka saathi (user: "1h trend wale EA ke saath Pine bhi").
//  Qaida (EA jaisa): Supertrend 10 / 3.0, SIRF BUY.
//    - Supertrend NEECHE se UPAR palta (band candle par) = agli candle ki open par BUY.
//    - Supertrend UPAR se NEECHE palta = agli candle ki open par BAND.
//    - Hifazati SL = entry - 6 x ATR(10) (signal candle ka ATR). 1R = yahi faasla.
//    - Short NAHI. Ek waqt mein ek position.
//  Chart: 1H par lagayein (koi bhi TF chalega, lekin naap 1H ka hai).
//  Kharcha: % har taraf (default 0.0045) + gold par kam az kam $0.50 aana-jana.
//  Repaint nahi: faisla sirf band candle par, bhar agli candle ki open par.
//  SIRF DEKHNA / TAJURBA: Python naap (2019-26) XAU +63R, US500 +39R, USTEC +45R,
//  lekin 2012-18 gold -20R. Pine nateeja sirf ANDAZA - sahi nateeja MT5 / Python se.
// ============================================================================
indicator("JAS Trend 1H h1", shorttitle = "JAS TREND 1H h1", overlay = true, max_labels_count = 500)

atrLen   = input.int(10, "ATR length", minval = 1, group = "Trend (EA jaisa - mat badlein)")
atrMult  = input.float(3.0, "ATR multiplier", minval = 0.1, step = 0.1, group = "Trend (EA jaisa - mat badlein)")
slMult   = input.float(6.0, "SL (x ATR)", minval = 0.5, step = 0.5, group = "Trend (EA jaisa - mat badlein)")
costPct  = input.float(0.0045, "Kharcha % har taraf", minval = 0.0, step = 0.0005, group = "Hisaab")
minCostI = input.float(-1.0, "Kam az kam kharcha aana-jana (qeemat). -1 = khud: gold 0.50, baqi 0", step = 0.05, group = "Hisaab")
fromYear = input.int(2019, "Hisaab is saal se", minval = 1970, group = "Hisaab")
showTbl  = input.bool(true, "Dabba dikhao", group = "Dikhawa")
showMark = input.bool(true, "BUY / BAND nishan dikhao", group = "Dikhawa")

[stLine, stDir] = ta.supertrend(atrMult, atrLen)
atrNow = ta.atr(atrLen)
bool up     = stDir < 0
bool flipUp = up and not up[1]
bool flipDn = (not up) and up[1]
float minCost = minCostI >= 0.0 ? minCostI : (str.contains(syminfo.ticker, "XAU") ? 0.50 : 0.0)

// ---- haal (band candle par faisla, agli open par bhar)
var bool  inPos    = false
var bool  pendBuy  = false
var bool  pendExit = false
var float entry    = na
var float slPx     = na
var float risk     = na
var int   entryYr  = 0
var int   nTr      = 0
var int   nWin     = 0
var int   nSl      = 0
var float sumR     = 0.0
var float sumR2    = 0.0
var float cumR     = 0.0
var float peakR    = 0.0
var float ddR      = 0.0
var float lastR    = na

// 1) pichhli candle ka faisla -> is candle ki open par
if pendExit and inPos
    float cost = math.max(minCost, costPct / 100.0 * (entry + open))
    float r = (open - entry - cost) / risk
    lastR := r
    if entryYr >= fromYear
        nTr += 1
        nWin += r > 0 ? 1 : 0
        sumR += r
        sumR2 += r * r
        cumR += r
        peakR := math.max(peakR, cumR)
        ddR := math.max(ddR, peakR - cumR)
    inPos := false
pendExit := false

if pendBuy and not inPos and not na(atrNow[1])
    entry := open
    risk := slMult * atrNow[1]
    slPx := entry - risk
    entryYr := year(time)
    inPos := true
pendBuy := false

// 2) candle ke andar SL
if inPos and low <= slPx
    float cost2 = math.max(minCost, costPct / 100.0 * (entry + slPx))
    float r2 = (slPx - entry - cost2) / risk
    lastR := r2
    if entryYr >= fromYear
        nTr += 1
        nSl += 1
        sumR += r2
        sumR2 += r2 * r2
        cumR += r2
        peakR := math.max(peakR, cumR)
        ddR := math.max(ddR, peakR - cumR)
    inPos := false

// 3) candle band = agla faisla
if barstate.isconfirmed
    if inPos and not up
        pendExit := true
    if not inPos and flipUp
        pendBuy := true

// ---- dikhawa
plot(stLine, "Supertrend 10/3", color = up ? color.new(color.lime, 0) : color.new(color.red, 0), linewidth = 2, style = plot.style_linebr)
plot(inPos ? slPx : na, "Hifazati SL (6 x ATR)", color = color.new(color.orange, 0), linewidth = 1, style = plot.style_linebr)
plot(inPos ? entry : na, "Entry", color = color.new(color.aqua, 30), linewidth = 1, style = plot.style_linebr)
plotshape(showMark and flipUp and barstate.isconfirmed, "BUY palta", style = shape.labelup, location = location.belowbar, color = color.new(color.lime, 0), textcolor = color.black, text = "BUY", size = size.small)
plotshape(showMark and flipDn and barstate.isconfirmed, "BAND palta", style = shape.labeldown, location = location.abovebar, color = color.new(color.red, 0), textcolor = color.white, text = "BAND", size = size.small)

alertcondition(flipUp, "JAS Trend 1H: BUY palta", "JAS Trend 1H h1: Supertrend UPAR palta - agli candle par BUY")
alertcondition(flipDn, "JAS Trend 1H: BAND palta", "JAS Trend 1H h1: Supertrend NEECHE palta - agli candle par BAND")

// ---- dabba
var table tb = table.new(position.top_right, 2, 8, border_width = 1, border_color = color.new(color.gray, 50))
if showTbl and barstate.islast
    float expR = nTr > 0 ? sumR / nTr : 0.0
    float se2  = nTr > 1 ? 2.0 * math.sqrt(math.max(sumR2 - sumR * sumR / nTr, 0.0) / (nTr - 1)) / math.sqrt(nTr) : 0.0
    float winP = nTr > 0 ? 100.0 * nWin / nTr : 0.0
    color bg = color.new(color.black, 20)
    color fg = color.white
    bool tfOk = timeframe.period == "60"
    table.cell(tb, 0, 0, "JAS TREND 1H h1", text_color = color.yellow, bgcolor = bg, text_halign = text.align_left)
    table.cell(tb, 1, 0, tfOk ? "TF 1H theek" : "TF " + timeframe.period + " (naap 1H ka hai)", text_color = tfOk ? color.lime : color.orange, bgcolor = bg)
    table.cell(tb, 0, 1, "Trades (" + str.tostring(fromYear) + " se)", text_color = fg, bgcolor = bg, text_halign = text.align_left)
    table.cell(tb, 1, 1, str.tostring(nTr) + "  (SL " + str.tostring(nSl) + ")", text_color = fg, bgcolor = bg)
    table.cell(tb, 0, 2, "Jeet", text_color = fg, bgcolor = bg, text_halign = text.align_left)
    table.cell(tb, 1, 2, str.tostring(winP, "#.0") + " %", text_color = fg, bgcolor = bg)
    table.cell(tb, 0, 3, "Har trade ausat", text_color = fg, bgcolor = bg, text_halign = text.align_left)
    table.cell(tb, 1, 3, str.tostring(expR, "#.000") + " R  (+- " + str.tostring(se2, "#.000") + ")", text_color = expR - se2 > 0 ? color.lime : color.orange, bgcolor = bg)
    table.cell(tb, 0, 4, "Kul", text_color = fg, bgcolor = bg, text_halign = text.align_left)
    table.cell(tb, 1, 4, str.tostring(sumR, "#.0") + " R", text_color = sumR >= 0 ? color.lime : color.red, bgcolor = bg)
    table.cell(tb, 0, 5, "Sab se bari girawat", text_color = fg, bgcolor = bg, text_halign = text.align_left)
    table.cell(tb, 1, 5, str.tostring(ddR, "#.0") + " R", text_color = fg, bgcolor = bg)
    table.cell(tb, 0, 6, "Abhi", text_color = fg, bgcolor = bg, text_halign = text.align_left)
    table.cell(tb, 1, 6, inPos ? "BUY khuli @ " + str.tostring(entry, format.mintick) + " | SL " + str.tostring(slPx, format.mintick) : (up ? "intezar: naya palta chahiye" : "intezar: line ke upar close = BUY"), text_color = inPos ? color.lime : fg, bgcolor = bg)
    table.cell(tb, 0, 7, "Rukh", text_color = fg, bgcolor = bg, text_halign = text.align_left)
    table.cell(tb, 1, 7, up ? "UPAR" : "NEECHE", text_color = up ? color.lime : color.red, bgcolor = bg)
