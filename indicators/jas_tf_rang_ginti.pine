//@version=6
// ============================================================================
//  JAS TF-RANG GINTI  (build r1, 12 Oct 2026)  - TRADE NAHI, SIRF GINTI
//  Ginti script #3 + user ka sawal: "1m se 1W tak kis TF ki harkat apna
//  rukh RAKHTI hai (saalon se)?"
//
//  Har TF par (1m 3m 5m 15m 30m 1H 4H 1D 1W), sirf band candles:
//   Hari %        = kitni candles hari (buniyad)
//   Hare -> hara  = hari candle ke baad agli bhi hari, kitni dafa
//   Laal -> hara  = laal candle ke baad agli hari, kitni dafa
//   RUKH RAKHE    = (Hare->hara) - (Laal->hara), ±2SE
//                   + = rukh chalta rehta hai (trend / Kachhua jaisa)
//                   - = rukh palat-ta hai (wapsi / RSI2 jaisa)
//                   ★ = shor se alag (9 TF mein ittefaq se bhi ~0-1 ★)
//   3 laal -> hara = lagatar 3 laal ke baad agli hari (RSI2 wali soch)
//   3 hare -> hara = lagatar 3 hari ke baad agli hari
//  Chart: koi bhi (1D behtar). Chhoti TF ka data kam (1m = chand hafte);
//  "Candles" column dekh kar bharosa karein.
// ============================================================================
indicator("JAS TF-Rang Ginti r1", overlay=true)

f_stats() =>
    var int nAG = 0
    var int gAG = 0
    var int nAR = 0
    var int gAR = 0
    var int n3R = 0
    var int g3R = 0
    var int n3G = 0
    var int g3G = 0
    // bar 0 abhi ban rahi ho sakti hai - sirf [1] aur peeche (band)
    bool o  = close[1] > open[1]
    bool p1 = close[2] > open[2]
    bool p2 = close[3] > open[3]
    bool p3 = close[4] > open[4]
    if not na(close[4])
        if p1
            nAG += 1
            gAG += o ? 1 : 0
        else
            nAR += 1
            gAR += o ? 1 : 0
        if not p1 and not p2 and not p3
            n3R += 1
            g3R += o ? 1 : 0
        if p1 and p2 and p3
            n3G += 1
            g3G += o ? 1 : 0
    [nAG, gAG, nAR, gAR, n3R, g3R, n3G, g3G]

[a1, b1, c1, d1, e1, f1, g1, h1] = request.security(syminfo.tickerid, "1",   f_stats())
[a2, b2, c2, d2, e2, f2, g2, h2] = request.security(syminfo.tickerid, "3",   f_stats())
[a3, b3, c3, d3, e3, f3, g3, h3] = request.security(syminfo.tickerid, "5",   f_stats())
[a4, b4, c4, d4, e4, f4, g4, h4] = request.security(syminfo.tickerid, "15",  f_stats())
[a5, b5, c5, d5, e5, f5, g5, h5] = request.security(syminfo.tickerid, "30",  f_stats())
[a6, b6, c6, d6, e6, f6, g6, h6] = request.security(syminfo.tickerid, "60",  f_stats())
[a7, b7, c7, d7, e7, f7, g7, h7] = request.security(syminfo.tickerid, "240", f_stats())
[a8, b8, c8, d8, e8, f8, g8, h8] = request.security(syminfo.tickerid, "D",   f_stats())
[a9, b9, c9, d9, e9, f9, g9, h9] = request.security(syminfo.tickerid, "W",   f_stats())

f_pct(int g, int n) => n > 0 ? str.tostring(100.0 * g / n, "#.0") + "%" : "-"

f_row(table t, int row, string tf, int nAG, int gAG, int nAR, int gAR, int n3R, int g3R, int n3G, int g3G) =>
    int n = nz(nAG) + nz(nAR)
    float pG = nz(nAG) > 0 ? 1.0 * gAG / nAG : na
    float pR = nz(nAR) > 0 ? 1.0 * gAR / nAR : na
    float base = n > 0 ? 1.0 * (nz(gAG) + nz(gAR)) / n : na
    float d = na(pG) or na(pR) ? na : (pG - pR) * 100
    float se2 = na(base) or nz(nAG) == 0 or nz(nAR) == 0 ? na : 2 * math.sqrt(base * (1 - base) * (1.0 / nAG + 1.0 / nAR)) * 100
    bool star = not na(d) and not na(se2) and math.abs(d) > se2
    color c = star ? (d > 0 ? color.green : color.red) : color.black
    table.cell(t, 0, row, tf, text_size=size.small)
    table.cell(t, 1, row, str.tostring(n), text_size=size.small)
    table.cell(t, 2, row, na(base) ? "-" : str.tostring(base * 100, "#.0") + "%", text_size=size.small)
    table.cell(t, 3, row, f_pct(nz(gAG), nz(nAG)), text_size=size.small)
    table.cell(t, 4, row, f_pct(nz(gAR), nz(nAR)), text_size=size.small)
    table.cell(t, 5, row, na(d) ? "-" : str.tostring(d, "+#.0;-#.0") + " ±" + str.tostring(se2, "#.0") + (star ? " ★" : ""), text_color=c, text_size=size.small)
    table.cell(t, 6, row, f_pct(nz(g3R), nz(n3R)) + " (" + str.tostring(nz(n3R)) + ")", text_size=size.small)
    table.cell(t, 7, row, f_pct(nz(g3G), nz(n3G)) + " (" + str.tostring(nz(n3G)) + ")", text_size=size.small)

var table t = table.new(position.top_right, 8, 11, bgcolor=color.new(color.white, 5), border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 7, 10)
    hdr = array.from("TF-RANG r1", "Candles", "Hari %", "Hare→hara", "Laal→hara", "RUKH RAKHE (±2SE)", "3 laal→hara", "3 hare→hara")
    for i = 0 to 7
        table.cell(t, i, 0, array.get(hdr, i), text_size=size.small)
    f_row(t, 1, "1m",  a1, b1, c1, d1, e1, f1, g1, h1)
    f_row(t, 2, "3m",  a2, b2, c2, d2, e2, f2, g2, h2)
    f_row(t, 3, "5m",  a3, b3, c3, d3, e3, f3, g3, h3)
    f_row(t, 4, "15m", a4, b4, c4, d4, e4, f4, g4, h4)
    f_row(t, 5, "30m", a5, b5, c5, d5, e5, f5, g5, h5)
    f_row(t, 6, "1H",  a6, b6, c6, d6, e6, f6, g6, h6)
    f_row(t, 7, "4H",  a7, b7, c7, d7, e7, f7, g7, h7)
    f_row(t, 8, "1D",  a8, b8, c8, d8, e8, f8, g8, h8)
    f_row(t, 9, "1W",  a9, b9, c9, d9, e9, f9, g9, h9)
    table.cell(t, 0, 10, "+ = rukh chalta · - = palat-ta · ★ = idea, saboot nahi", text_size=size.small)
