// ============================================================================
//  ENGINE (har index ki apni daily candles, sirf BAND candle [1])
// ============================================================================
f_c1(string _ev, float _cost) =>
    _atrA = ta.atr(atrLen)
    _o  = open[1]
    _l  = low[1]
    _c  = close[1]
    _cp = close[2]
    _a  = _atrA[1]
    _td = time_tradingday[1]
    var int   _fy  = na
    var bool  _in  = false
    var float _e   = na
    var float _r   = na
    var float _sl  = na
    var int   _xd  = 0
    var int   _ey  = na
    var int   _et  = na
    var int   _age = 0
    var int   _nT = 0
    var int   _wT = 0
    var float _sT = 0.0
    var float _qT = 0.0
    var float _pT = 0.0
    var int   _dT = 0
    var int   _aN = 0
    var float _aS = 0.0
    var int   _yNT = 0
    var int   _yPT = 0
    var int   _cyT = na
    var float _csT = 0.0
    var int   _ccT = 0
    var int   _nI = 0
    var int   _wI = 0
    var float _sI = 0.0
    var float _qI = 0.0
    var float _pI = 0.0
    var int   _dI = 0
    var int   _aNI = 0
    var float _aSI = 0.0
    if not na(_c) and not na(_td)
        _y   = year(_td, "UTC")
        _m   = month(_td, "UTC")
        _d   = dayofmonth(_td, "UTC")
        _ymd = _y * 10000 + _m * 100 + _d
        if na(_fy) and _y >= fromYr
            _fy := _y
        if not na(_cp) and _cp > 0 and _y >= fromYr
            if _y < splitYr
                _aN += 1
                _aS += _c / _cp - 1
            else
                _aNI += 1
                _aSI += _c / _cp - 1
        bool  _cl = false
        float _px = na
        if _in
            _age += 1
            if _l <= _sl
                _px := _o < _sl ? _o : _sl
                _cl := true
            else if _ymd >= _xd
                _px := _c
                _cl := true
        if _cl
            _nights = math.round((_td - _et) / 86400000.0)
            _rr = ((_px - _e) - _cost / 100.0 * (_e + _px) - swapYr / 100.0 / 365.0 * _nights * _e) / _r
            _pc = _px / _e - 1
            if _ey < splitYr
                _nT += 1
                _sT += _rr
                _qT += _rr * _rr
                _pT += _pc
                _dT += _age
                _wT += _rr > 0 ? 1 : 0
                if na(_cyT) or _ey != _cyT
                    if not na(_cyT) and _ccT >= 2
                        _yNT += 1
                        _yPT += _csT > 0 ? 1 : 0
                    _cyT := _ey
                    _csT := 0.0
                    _ccT := 0
                _csT += _rr
                _ccT += 1
            else
                _nI += 1
                _sI += _rr
                _qI += _rr * _rr
                _pI += _pc
                _dI += _age
                _wI += _rr > 0 ? 1 : 0
            _in := false
        if not _in and _y >= fromYr and not na(_a) and _a > 0
            _p = str.pos(_ev, str.tostring(_ymd) + ">")
            if not na(_p) and _p >= 0
                _x = str.tonumber(str.substring(_ev, _p + 9, _p + 17))
                if not na(_x)
                    _in  := true
                    _e   := _c
                    _r   := slMult * _a
                    _sl  := _c - _r
                    _xd  := int(_x)
                    _ey  := _y
                    _et  := _td
                    _age := 0
    _yN = _yNT + (not na(_cyT) and _ccT >= 2 ? 1 : 0)
    _yP = _yPT + (not na(_cyT) and _ccT >= 2 and _csT > 0 ? 1 : 0)
    [_nT, _wT, _sT, _qT, _pT, _dT, _aN > 0 ? _aS / _aN : 0.0, _yN, _yP, _nI, _wI, _sI, _qI, _pI, _dI, _aNI > 0 ? _aSI / _aNI : 0.0, _fy]

f_req(_s, string _ev, float _cost) => request.security(_s, "D", f_c1(_ev, _cost), barmerge.gaps_off, barmerge.lookahead_off)

[nT0, wT0, sT0, qT0, pT0, dT0, aM0, yN0, yP0, nI0, wI0, sI0, qI0, pI0, dI0, aMI0, fy0] = f_req(s0, EV_DAX, costEu)
[nT1, wT1, sT1, qT1, pT1, dT1, aM1, yN1, yP1, nI1, wI1, sI1, qI1, pI1, dI1, aMI1, fy1] = f_req(s1, EV_UKX, costEu)
[nT2, wT2, sT2, qT2, pT2, dT2, aM2, yN2, yP2, nI2, wI2, sI2, qI2, pI2, dI2, aMI2, fy2] = f_req(s2, EV_PX1, costEu)
[nT3, wT3, sT3, qT3, pT3, dT3, aM3, yN3, yP3, nI3, wI3, sI3, qI3, pI3, dI3, aMI3, fy3] = f_req(s3, EV_SX5E, costEu)
[nT4, wT4, sT4, qT4, pT4, dT4, aM4, yN4, yP4, nI4, wI4, sI4, qI4, pI4, dI4, aMI4, fy4] = f_req(s4, EV_NI225, costAs)
[nT5, wT5, sT5, qT5, pT5, dT5, aM5, yN5, yP5, nI5, wI5, sI5, qI5, pI5, dI5, aMI5, fy5] = f_req(s5, EV_XJO, costAs)
[nT6, wT6, sT6, qT6, pT6, dT6, aM6, yN6, yP6, nI6, wI6, sI6, qI6, pI6, dI6, aMI6, fy6] = f_req(s6, EV_HSI, costAs)

// ============================================================================
//  TABLE (safaid)
// ============================================================================
f_pos(_p) => _p == "Top Left" ? position.top_left : _p == "Bottom Right" ? position.bottom_right : _p == "Bottom Left" ? position.bottom_left : position.top_right

f_exp(_n, _s) => _n > 0 ? _s / _n : 0.0
f_se(_n, _s, _q) =>
    _m = _n > 0 ? _s / _n : 0.0
    _n > 1 ? math.sqrt(math.max((_q - _n * _m * _m) / (_n - 1), 0.0)) / math.sqrt(_n) : 0.0
f_dr(float _am, int _d) => _am * _d

var table tb = table.new(f_pos(tblPos), 8, 22, bgcolor = color.white, border_color = color.new(#9e9e9e, 0), border_width = 1)
fg  = color.new(#111111, 0)
cUp = color.new(#0a8f5a, 0)
cDn = color.new(#d32f2f, 0)
cHd = color.new(#1a237e, 0)

f_cell(int _c, int _r, string _s, color _col) =>
    table.cell(tb, _c, _r, _s, text_color = _col, text_size = size.small)

f_p(float _x) => str.tostring(100.0 * _x, "+0.000;-0.000") + "%"

f_row(int _r, string _nm, int _n, int _w, float _s, float _q, float _ip, float _dr, string _yr, float _adj) =>
    _e  = f_exp(_n, _s)
    _se = f_se(_n, _s, _q) * _adj
    f_cell(0, _r, _nm, fg)
    f_cell(1, _r, str.tostring(_n), fg)
    f_cell(2, _r, str.tostring(_n > 0 ? 100.0 * _w / _n : 0.0, "#") + "%", fg)
    f_cell(3, _r, f_p(_ip), _ip >= 2 * _dr ? cUp : cDn)
    f_cell(4, _r, f_p(_dr), fg)
    f_cell(5, _r, str.tostring(_e, "+0.000;-0.000"), _e > 0 ? cUp : cDn)
    f_cell(6, _r, str.tostring(_e - 2 * _se, "+0.000;-0.000"), _e - 2 * _se > 0 ? cUp : cDn)
    f_cell(7, _r, _yr, fg)
    [_e, _se]

if barstate.islast
    anT = array.from(nT0, nT1, nT2, nT3, nT4, nT5, nT6)
    awT = array.from(wT0, wT1, wT2, wT3, wT4, wT5, wT6)
    asT = array.from(sT0, sT1, sT2, sT3, sT4, sT5, sT6)
    aqT = array.from(qT0, qT1, qT2, qT3, qT4, qT5, qT6)
    apT = array.from(pT0, pT1, pT2, pT3, pT4, pT5, pT6)
    adT = array.from(dT0, dT1, dT2, dT3, dT4, dT5, dT6)
    aaM = array.from(aM0, aM1, aM2, aM3, aM4, aM5, aM6)
    ayN = array.from(yN0, yN1, yN2, yN3, yN4, yN5, yN6)
    ayP = array.from(yP0, yP1, yP2, yP3, yP4, yP5, yP6)
    anI = array.from(nI0, nI1, nI2, nI3, nI4, nI5, nI6)
    awI = array.from(wI0, wI1, wI2, wI3, wI4, wI5, wI6)
    asI = array.from(sI0, sI1, sI2, sI3, sI4, sI5, sI6)
    aqI = array.from(qI0, qI1, qI2, qI3, qI4, qI5, qI6)
    apI = array.from(pI0, pI1, pI2, pI3, pI4, pI5, pI6)
    adI = array.from(dI0, dI1, dI2, dI3, dI4, dI5, dI6)
    aaMI = array.from(aMI0, aMI1, aMI2, aMI3, aMI4, aMI5, aMI6)
    afy = array.from(fy0, fy1, fy2, fy3, fy4, fy5, fy6)
    aNm = array.from("DAX (Germany)", "FTSE 100 (UK)", "CAC 40 (France)", "Euro Stoxx 50", "Nikkei 225 (Japan)", "ASX 200 (Australia)", "Hang Seng (HK)")
    f_cell(0, 0, "JAS C1 70 " + BUILD + "  (#70)  -  local chutti se pehle wala din x 7 index", cHd)
    table.merge_cells(tb, 0, 0, 7, 0)
    f_cell(0, 1, "TALAASH (" + str.tostring(fromYr) + " - " + str.tostring(splitYr - 1) + ")", cHd)
    f_cell(1, 1, "Trade", cHd)
    f_cell(2, 1, "Jeet", cHd)
    f_cell(3, 1, "Din ausat", cHd)
    f_cell(4, 1, "Aam tezi (drift)", cHd)
    f_cell(5, 1, "Har trade (R)", cHd)
    f_cell(6, 1, "Exp - 2SE", cHd)
    f_cell(7, 1, "Saal + / kul (>=2 tr)", cHd)
    int nK = 0
    int wK = 0
    float sK = 0.0
    float qK = 0.0
    float pK = 0.0
    float dK = 0.0
    int yNK = 0
    int yPK = 0
    float eJP = 0.0
    float eHK = 0.0
    for i = 0 to 6
        n = array.get(anT, i)
        dr = f_dr(array.get(aaM, i), array.get(adT, i))
        [e_, se_] = f_row(2 + i, array.get(aNm, i) + "  (" + str.tostring(array.get(afy, i)) + " se)", n, array.get(awT, i), array.get(asT, i), array.get(aqT, i), n > 0 ? array.get(apT, i) / n : 0.0, n > 0 ? dr / n : 0.0, str.tostring(array.get(ayP, i)) + " / " + str.tostring(array.get(ayN, i)), 1.0)
        nK += n
        wK += array.get(awT, i)
        sK += array.get(asT, i)
        qK += array.get(aqT, i)
        pK += array.get(apT, i)
        dK += dr
        yNK += array.get(ayN, i)
        yPK += array.get(ayP, i)
        if i == 4
            eJP := e_
        if i == 6
            eHK := e_
    ipK = nK > 0 ? pK / nK : 0.0
    drK = nK > 0 ? dK / nK : 0.0
    [eK, seK] = f_row(9, "KUL (SE x " + str.tostring(ADJ) + ")", nK, wK, sK, qK, ipK, drK, str.tostring(yPK) + " / " + str.tostring(yNK), ADJ)
    okT = nK >= 100 and eK - 2 * seK > 0 and ipK >= 2 * drK and yNK > 0 and yPK * 2 > yNK and eJP > 0 and eHK > 0
    f_cell(0, 10, (okT ? "TALAASH PASS  -> IMTIHAN khol sakte hain" : "TALAASH FAIL  -> IMTIHAN band") + "  |  Nikkei " + str.tostring(eJP, "+0.000;-0.000") + "R, Hang Seng " + str.tostring(eHK, "+0.000;-0.000") + "R", okT ? cUp : cDn)
    table.merge_cells(tb, 0, 10, 7, 10)
    if showIm and okT
        f_cell(0, 11, "IMTIHAN (" + str.tostring(splitYr) + " - aaj)  - EK dafa", cHd)
        table.merge_cells(tb, 0, 11, 7, 11)
        int nI = 0
        int wI = 0
        float sI = 0.0
        float qI = 0.0
        float pI = 0.0
        float dI = 0.0
        for i = 0 to 6
            n = array.get(anI, i)
            dr = f_dr(array.get(aaMI, i), array.get(adI, i))
            [e2_, se2_] = f_row(12 + i, array.get(aNm, i), n, array.get(awI, i), array.get(asI, i), array.get(aqI, i), n > 0 ? array.get(apI, i) / n : 0.0, n > 0 ? dr / n : 0.0, "-", 1.0)
            nI += n
            wI += array.get(awI, i)
            sI += array.get(asI, i)
            qI += array.get(aqI, i)
            pI += array.get(apI, i)
            dI += dr
        ipI = nI > 0 ? pI / nI : 0.0
        drI = nI > 0 ? dI / nI : 0.0
        [eI, seI] = f_row(19, "KUL (SE x " + str.tostring(ADJ) + ")", nI, wI, sI, qI, ipI, drI, "-", ADJ)
        okI = nI >= 30 and eI - 2 * seI > 0 and ipI >= 2 * drI
        f_cell(0, 20, okI ? "IMTIHAN PASS -> FTMO jor test (#68 + C1)" : "IMTIHAN FAIL = idea band", okI ? cUp : cDn)
        table.merge_cells(tb, 0, 20, 7, 20)
    else
        f_cell(0, 11, "IMTIHAN " + str.tostring(splitYr) + "+ CHHUPA (TALAASH PASS ke baad, EK dafa)", fg)
        table.merge_cells(tb, 0, 11, 7, 11)
