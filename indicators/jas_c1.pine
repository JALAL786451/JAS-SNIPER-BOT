//@version=6
// ============================================================================
//  JAS C1 70  (build c1, Pine v6)  -  Koshish #70 (1 Nov 2026, user 'D')
//
//  LOCAL (NON-US) CHUTTI SE PEHLE WALA DIN - 7 index (research team daur 1,
//  judge KEEP: McGuinness 2005, Yuan-Gupta 2014, Cadsby-Ratner 1992).
//  Har index ki APNI exchange ki chutti (exchange_calendars 4.13.2, ad-hoc
//  typhoon wagaira NAHI), NYSE chutti qareeb ho to waqia chhoro (#59/#67 alag).
//  Waqiat Python `tools/c1_calendar.py --pine` se (sirf calendar, qeemat nahi).
//
//  QAWAID (har index ki apni daily candle, band candle [1], tareekh =
//  time_tradingday UTC): P = bandish se pehle aakhri session.
//   BUY P-1 ke close par, band P ke close par (pehli candle tareekh >= P).
//   SL 3 x ATR20 = 1R (daily low, gap = open). Sirf BUY. Kharcha har taraf
//   Asia 0.03%, Europe 0.02% + swap 3%/saal. SE x k = 1.093 (pehle se, calendar).
//
//  PEHLE SE LIKHA QAIDA (docs/purana-haal.md, grep "Koshish #70 qaida"):
//   TALAASH 2005-2018: N >= 100, Exp - 2kSE > 0, ausat >= 2 x drift,
//   (index x saal, >= 2 tr) musbat > 50%, NI225 aur HSI Exp > 0.
//   IMTIHAN 2019+ CHHUPA (sirf TALAASH PASS par, EK dafa).
//  CHART: koi bhi DAILY chart (misaal TVC:NI225). 7 index request.security se.
// ============================================================================
indicator("JAS C1 70 c1 (#70)", shorttitle = "JAS C1 70 c1", overlay = true, max_bars_back = 300)

BUILD = "c1"
ADJ = 1.093

grI = "1 · 7 index (pehle se chune - badalna mana)"
s0 = input.symbol("XETR:DAX", "1 DAX (Germany)", group = grI)
s1 = input.symbol("TVC:UKX", "2 FTSE 100 (UK)", group = grI)
s2 = input.symbol("EURONEXT:PX1", "3 CAC 40 (France)", group = grI)
s3 = input.symbol("TVC:SX5E", "4 Euro Stoxx 50", group = grI)
s4 = input.symbol("TVC:NI225", "5 Nikkei 225 (Japan)", group = grI)
s5 = input.symbol("ASX:XJO", "6 ASX 200 (Australia)", group = grI)
s6 = input.symbol("TVC:HSI", "7 Hang Seng (HK)", group = grI)

grQ = "2 · Qawaid (mat badlein)"
atrLen  = input.int(20, "ATR length", minval = 2, group = grQ, display = display.none)
slMult  = input.float(3.0, "SL (x ATR) = 1R", minval = 0.5, step = 0.5, group = grQ, display = display.none)
costEu  = input.float(0.02, "Kharcha Europe (% har taraf)", minval = 0, step = 0.005, group = grQ, display = display.none)
costAs  = input.float(0.03, "Kharcha Asia (% har taraf)", minval = 0, step = 0.005, group = grQ, display = display.none)
swapYr  = input.float(3.0, "Swap (% saal, har raat)", minval = 0, step = 0.5, group = grQ, display = display.none)
fromYr  = input.int(2005, "TALAASH is saal se", group = grQ, display = display.none)
splitYr = input.int(2019, "IMTIHAN is saal se (TALAASH is se pehle)", group = grQ, display = display.none)
showIm  = input.bool(false, "IMTIHAN dikhao (SIRF TALAASH PASS ke baad, EK dafa)", group = grQ, display = display.none)

grV = "3 · Table"
tblPos = input.string("Top Right", "Table ki jagah", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grV, display = display.none)

