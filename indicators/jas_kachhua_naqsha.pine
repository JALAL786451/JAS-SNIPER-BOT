//@version=6
// JAS KACHHUA NAQSHA  (build k1, Pine v6, 17 Nov 2026)  -  user (64vi): "Kachhua ka Pine bilkul JAS Naqsha+5EA j3 jaisa".
//  NAYI file: jas_naqsha_5ea.pine (j3.2) ko CHHUA NAHI. Zones / rukh / news ka code j3.2 se jyon ka tyon (n5.9).
//  ISHARA = e2 Kachhua (JasTideRadarEA / tools/ftmo_test.py kachhua_trades) - D1, BUY + SELL:
//   BUY  = D1 close > pichhle 10 din ka HIGH  aur  EMA50 > EMA200 (kal ka)  aur  ATR14 >= 0.25% qeemat.
//   SELL = D1 close < pichhle 10 din ka LOW   aur  EMA50 < EMA200 (kal ka)  aur  ATR14 >= 0.25% qeemat.
//   Entry = us din ka close; SL = 2 x ATR14; SL roz sarakta (5 din ka low / high); band = SL / EMA ulat / close SL ke paar.
//   TP NAHI (trend ko chalne do). Ek waqt ek trade (har market).
//  REPAINT NAHI: D1 ka sara hisaab pichhle BAND din ka ([1] + lookahead_on); chart koi bhi TF (1D ya chhota).
//  DAAYEN TABLE: Python ke pakke number (2012-30 Oct 2026, Dukascopy H1, kharcha, swap 0) har market ke; neeche TV live.
//  IMAANDARI: ek akela market kamzor (Exp-2SE aksar < 0); PASS = 12 market ki tokri (#99 / #101), FTMO 0 fail (K17 / K18).
//  TRADE NAHI karta - sirf dikhata. EA (e2) hi asal trade karta hai.
// ============================================================================
indicator("JAS Kachhua Naqsha k1", "JAS KN k1", overlay = true, scale = scale.right, max_boxes_count = 50, max_lines_count = 50, max_labels_count = 70, max_bars_back = 300)

BUILD = "k1"

grZ = "1 · Zones S/R"
showZ  = input.bool(true, "Zones dikhao", group = grZ, display = display.none)
zN     = input.int(3, "Upar / neeche kitne zone", minval = 1, maxval = 6, group = grZ, display = display.none)
zTol   = input.float(0.25, "Jorne ki doori (x din ka ATR)", minval = 0.05, step = 0.05, group = grZ, display = display.none)
zH     = input.float(0.10, "Zone ki motai (x din ka ATR, aadhi)", minval = 0.02, step = 0.02, group = grZ, display = display.none)

grT = "2 · Khulasa table"
showT  = input.bool(true, "Table dikhao", group = grT, display = display.none)
tPos   = input.string("Middle Left", "Table ki jagah", options = ["Middle Left", "Top Left", "Bottom Left", "Middle Right", "Top Right", "Bottom Right", "Bottom Center"], group = grT, display = display.none)
tSize  = input.string("Small", "Likhai", options = ["Tiny", "Small", "Normal"], group = grT, display = display.none)

grN = "3 · News waqt"
showNB = input.bool(true, "Intraday chart par news waqt ka rang (+-15 min)", group = grN, display = display.none)

grK = "4 · Kachhua (e2 ke qaide - sirf dikhawa badlein)"
showE   = input.bool(true, "1D EMA50 / EMA200 lakeer", group = grK, display = display.none)
showCh  = input.bool(true, "Naali: 10 din high / low (toot ki lakeer)", group = grK, display = display.none)
showMk  = input.bool(true, "BUY / SELL / band nishan", group = grK, display = display.none)
showSL  = input.bool(true, "Khuli trade: entry + sarakta SL lakeer", group = grK, display = display.none)
showPs  = input.bool(true, "Khuli trade ka dabba (TV jaisa)", group = grK, display = display.none)
showR   = input.bool(true, "Band trade par R label (+1.2R)", group = grK, display = display.none)
rKeep   = input.int(10, "Kitne R label", minval = 1, maxval = 30, group = grK, display = display.none)
showNx  = input.bool(true, "AGLI trade ka dotted dabba (andaza)", group = grK, display = display.none)

grH = "5 · Hisaab table (daayen)"
showH  = input.bool(true, "Hisaab table dikhao", group = grH, display = display.none)
hPos   = input.string("Top Right", "Jagah", options = ["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group = grH, display = display.none)
mkSel  = input.string("Khud (auto)", "Chart ka market", options = ["Khud (auto)", "XAU", "XAG", "US500", "USTEC", "USOIL", "UKOIL", "BTC", "EURUSD", "GBPUSD", "USDJPY", "USDCHF", "AUDUSD"], group = grH, display = display.none)

// ============================================================================
//  HTF DATA (har TF ek tuple, pichhli band candle)
// ============================================================================
f_tf() =>
    e50 = ta.ema(close, 50)
    e200 = ta.ema(close, 200)
    [stv, dr] = ta.supertrend(3.0, 10)
    r = ta.rsi(close, 14)
    a = ta.atr(14)
    ph = ta.pivothigh(high, 5, 5)
    pl = ta.pivotlow(low, 5, 5)
    a10 = ta.atr(10)
    [close[1], e50[1], e200[1], dr[1], r[1], a[1], ph[1], pl[1], time[6], a10[1], stv[1]]

LA = barmerge.lookahead_on
[c0, m0, n0, d0, r0, a0, h0, l0, t0, k0, s0] = request.security(syminfo.tickerid, "15", f_tf(), lookahead = LA)
[c1, m1, n1, d1, r1, a1, h1, l1, t1, k1, s1] = request.security(syminfo.tickerid, "60", f_tf(), lookahead = LA)
[c2, m2, n2, d2, r2, a2, h2, l2, t2, k2, s2] = request.security(syminfo.tickerid, "240", f_tf(), lookahead = LA)
[c3, m3, n3, d3, r3, a3, h3, l3, t3, k3, s3] = request.security(syminfo.tickerid, "D", f_tf(), lookahead = LA)
[c4, m4, n4, d4, r4, a4, h4, l4, t4, k4, s4] = request.security(syminfo.tickerid, "W", f_tf(), lookahead = LA)
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = LA)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = LA)

chSec = timeframe.in_seconds()
ok0 = timeframe.in_seconds("15") >= chSec
ok1 = timeframe.in_seconds("60") >= chSec
ok2 = timeframe.in_seconds("240") >= chSec
ok3 = timeframe.in_seconds("D") >= chSec
ok4 = timeframe.in_seconds("W") >= chSec
aD = a3

// ============================================================================
//  ZONES: pivot -> jor -> array
// ============================================================================
type Lvl
    float p
    int rk
    int t
    int n

var array<Lvl> lv = array.new<Lvl>()

// n5.6: 80 se zyada hon to sab se kamzor zone nikalo: pehle kam rank (1H), phir kam dafa chhui, phir qeemat se sab se door.
// Naya (aakhri) zone bachaya jata hai. Pehle sab se purani nikalti thi, chahe majboot ho.
f_evict() =>
    int w = -1
    for i = 0 to lv.size() - 2
        L = lv.get(i)
        if w < 0
            w := i
        else
            Lw = lv.get(w)
            bool weaker = L.rk < Lw.rk or (L.rk == Lw.rk and (L.n < Lw.n or (L.n == Lw.n and math.abs(L.p - close) > math.abs(Lw.p - close))))
            if weaker
                w := i
    if w >= 0
        lv.remove(w)
    w

f_add(float p, int rk, int t, float tol) =>
    bool merged = false
    if lv.size() > 0
        for i = 0 to lv.size() - 1
            L = lv.get(i)
            if math.abs(L.p - p) <= tol
                L.p := (L.p * L.n + p) / (L.n + 1)
                L.n := L.n + 1
                L.rk := math.max(L.rk, rk)
                L.t := math.min(L.t, t)
                merged := true
                break
    if not merged
        lv.push(Lvl.new(p, rk, t, 1))
        if lv.size() > 80
            f_evict()
    merged

nw1 = ta.change(t1) != 0
nw2 = ta.change(t2) != 0
nw3 = ta.change(t3) != 0
nw4 = ta.change(t4) != 0

if not na(aD) and aD > 0
    tol = zTol * aD
    if ok1 and nw1
        if not na(h1)
            f_add(h1, 1, t1, tol)
        if not na(l1)
            f_add(l1, 1, t1, tol)
    if ok2 and nw2
        if not na(h2)
            f_add(h2, 2, t2, tol)
        if not na(l2)
            f_add(l2, 2, t2, tol)
    if ok3 and nw3
        if not na(h3)
            f_add(h3, 3, t3, tol)
        if not na(l3)
            f_add(l3, 3, t3, tol)
    if ok4 and nw4
        if not na(h4)
            f_add(h4, 4, t4, tol)
        if not na(l4)
            f_add(l4, 4, t4, tol)

f_rkName(int rk) =>
    rk == 4 ? "1W" : rk == 3 ? "1D" : rk == 2 ? "4H" : "1H"

// ============================================================================
//  RUKH / RSI / TOOT
// ============================================================================
f_dir(float c, float m, float n, float d) =>
    na(c) or na(m) or na(n) or na(d) ? 0 : (c > m and m > n and d < 0) ? 1 : (c < m and m < n and d > 0) ? -1 : 0

f_dirTxt(int v) =>
    v > 0 ? "▲ UPAR" : v < 0 ? "▼ NEECHE" : "◆ MILA"

f_dirCol(int v) =>
    v > 0 ? color.new(#2e7d32, 0) : v < 0 ? color.new(#c62828, 0) : color.new(#9e9e9e, 0)

f_rsiTxt(float r) =>
    na(r) ? "-" : str.tostring(r, "#") + (r >= 70 ? " OB" : r <= 30 ? " OS" : "")

f_rsiCol(float r) =>
    na(r) ? color.gray : r >= 70 ? color.new(#c62828, 0) : r <= 30 ? color.new(#2e7d32, 0) : color.new(#bdbdbd, 0)

f_distTxt(float m, float a) =>
    na(m) or na(a) or a <= 0 ? "-" : str.tostring((close - m) / a, "+0.0;-0.0") + " ATR"

dv0 = ok0 ? f_dir(c0, m0, n0, d0) : 0
dv1 = ok1 ? f_dir(c1, m1, n1, d1) : 0
dv2 = ok2 ? f_dir(c2, m2, n2, d2) : 0
dv3 = ok3 ? f_dir(c3, m3, n3, d3) : 0
dv4 = ok4 ? f_dir(c4, m4, n4, d4) : 0
nTf = (ok0 ? 1 : 0) + (ok1 ? 1 : 0) + (ok2 ? 1 : 0) + (ok3 ? 1 : 0) + (ok4 ? 1 : 0)
nUp = (dv0 > 0 ? 1 : 0) + (dv1 > 0 ? 1 : 0) + (dv2 > 0 ? 1 : 0) + (dv3 > 0 ? 1 : 0) + (dv4 > 0 ? 1 : 0)
nDn = (dv0 < 0 ? 1 : 0) + (dv1 < 0 ? 1 : 0) + (dv2 < 0 ? 1 : 0) + (dv3 < 0 ? 1 : 0) + (dv4 < 0 ? 1 : 0)

[bbM, bbU, bbL] = ta.bb(close, 20, 2.0)
bbw = bbM != 0 ? (bbU - bbL) / bbM : na
bbPct = ta.percentrank(bbw, 120)
rsiC = ta.rsi(close, 14)

// ============================================================================
//  NEWS WAQT (NY)
// ============================================================================
var fomc = array.from(20260128, 20260318, 20260429, 20260617, 20260729, 20260916, 20261028, 20261209)
NY = "America/New_York"

f_ymd(int t) =>
    year(t, NY) * 10000 + month(t, NY) * 100 + dayofmonth(t, NY)

f_isFomc(int t) =>
    array.includes(fomc, f_ymd(t))

f_isWk(int t) =>
    dw = dayofweek(t, NY)
    dw >= dayofweek.monday and dw <= dayofweek.friday

// bar ke andar (ya +-15 min) koi news waqt?  0 = nahi, 1 = aam US data, 2 = NFP / FOMC
f_newsBar() =>
    int lvl = 0
    if timeframe.isintraday and f_isWk(time)
        bs = hour(time, NY) * 60 + minute(time, NY)
        be = bs + int(chSec / 60)
        nfp = dayofweek(time, NY) == dayofweek.friday and dayofmonth(time, NY) <= 7
        if bs < 510 + 15 and be > 510 - 15
            lvl := nfp ? 2 : 1
        if bs < 600 + 15 and be > 600 - 15
            lvl := math.max(lvl, 1)
        if f_isFomc(time) and bs < 840 + 15 and be > 840 - 15
            lvl := 2
    lvl

nb = showNB and chSec <= 3600 ? f_newsBar() : 0
bgcolor(nb == 2 ? color.new(#ff9800, 75) : nb == 1 ? color.new(#ff9800, 90) : na, title = "News waqt")

f_nextNews() =>
    int nt = na
    string tag = ""
    for k = 0 to 9
        b = timenow + k * 86400000
        if f_isWk(b) and na(nt)
            y = year(b, NY)
            mo = month(b, NY)
            dd = dayofmonth(b, NY)
            nfp = dayofweek(b, NY) == dayofweek.friday and dd <= 7
            ta830 = timestamp(NY, y, mo, dd, 8, 30)
            ta1000 = timestamp(NY, y, mo, dd, 10, 0)
            ta1400 = timestamp(NY, y, mo, dd, 14, 0)
            if ta830 > timenow
                nt := ta830
                tag := nfp ? "NFP (aksar) 08:30 NY" : "US data 08:30 NY"
            else if ta1000 > timenow
                nt := ta1000
                tag := "US data 10:00 NY"
            else if f_isFomc(b) and ta1400 > timenow
                nt := ta1400
                tag := "FOMC 14:00 NY"
    [nt, tag]

// ============================================================================
//  KACHHUA ENGINE (D1) - tools/ftmo_test.py kachhua_trades jyon ka tyon
// ============================================================================
f_kach() =>
    a = ta.atr(14)
    ef = ta.ema(close, 50)
    es = ta.ema(close, 200)
    efp = ef[1]
    esp = es[1]
    hb = ta.highest(high, 10)[1]
    lb = ta.lowest(low, 10)[1]
    hx = ta.highest(high, 5)[1]
    lx = ta.lowest(low, 5)[1]
    hN = ta.highest(high, 10)
    lN = ta.lowest(low, 10)
    var int d = 0
    var float e = na
    var float r = na
    var float sl = na
    var int nT = 0
    var int nW = 0
    var float sR = 0.0
    float xR = na
    int ent = 0
    bool atc = false
    if d != 0
        bool hit = d == 1 ? low <= sl : high >= sl
        if hit
            float xp = d == 1 ? math.min(open, sl) : math.max(open, sl)
            xR := d * (xp - e) / r
        else if (d == 1 ? efp < esp : efp > esp)
            xR := d * (close - e) / r
            atc := true
        else
            sl := d == 1 ? math.max(sl, lx) : math.min(sl, hx)
            if (d == 1 ? close <= sl : close >= sl)
                xR := d * (close - e) / r
                atc := true
        if not na(xR)
            nT += 1
            nW += xR > 0 ? 1 : 0
            sR += xR
            d := 0
    if d == 0 and not atc and bar_index >= 200 and a > 0 and not na(hb)
        bool liveA = a / close * 100 >= 0.25
        if close > hb and efp > esp and liveA
            d := 1
        else if close < lb and efp < esp and liveA
            d := -1
        if d != 0
            e := close
            r := 2.0 * a
            sl := e - d * r
            ent := d
    [d, e, sl, r, ent, xR, ef, es, hN, lN, a, close, time, nT, nW, sR]

// pichhla BAND din (repaint nahi)
f_kach1() =>
    [d, e, sl, r, ent, xR, ef, es, hN, lN, a, c, t, nT, nW, sR] = f_kach()
    [d[1], e[1], sl[1], r[1], ent[1], xR[1], ef[1], es[1], hN[1], lN[1], a[1], c[1], t[1], nT[1], nW[1], sR[1]]

isOk = timeframe.in_seconds() <= 86400
[kD, kE, kSL, kR, kEnt, kXR, kEF, kES, kHN, kLN, kA, kC, kT, kN, kW, kS] = request.security(syminfo.tickerid, "D", f_kach1(), lookahead = LA)

newDay = isOk and ta.change(kT) != 0
entNow = newDay and kEnt != 0
xNow = newDay and not na(kXR)
var int entT = na
if entNow
    entT := time

plot(isOk and showE ? kEF : na, "1D EMA50", color = color.new(#ffb300, 0), linewidth = 2, style = plot.style_stepline)
plot(isOk and showE ? kES : na, "1D EMA200", color = color.new(#42a5f5, 0), linewidth = 2, style = plot.style_stepline)
plot(isOk and showCh and kD == 0 ? kHN : na, "Naali 10 din HIGH (BUY toot)", color = color.new(#00e676, 55), linewidth = 1, style = plot.style_linebr)
plot(isOk and showCh and kD == 0 ? kLN : na, "Naali 10 din LOW (SELL toot)", color = color.new(#ff5252, 55), linewidth = 1, style = plot.style_linebr)
plot(isOk and showSL and kD != 0 ? kE : na, "Entry", color = color.new(#b0bec5, 30), linewidth = 1, style = plot.style_linebr)
plot(isOk and showSL and kD != 0 ? kSL : na, "SL (sarakta)", color = color.new(#ff1744, 0), linewidth = 2, style = plot.style_linebr)
plotshape(showMk and entNow and kEnt > 0, "Kachhua BUY", shape.triangleup, location.belowbar, color.new(#00e676, 0), size = size.small, text = "BUY", textcolor = color.new(#00e676, 0))
plotshape(showMk and entNow and kEnt < 0, "Kachhua SELL", shape.triangledown, location.abovebar, color.new(#ff5252, 0), size = size.small, text = "SELL", textcolor = color.new(#ff5252, 0))
plotshape(showMk and xNow, "Band", shape.xcross, location.abovebar, color.new(#b0bec5, 0), size = size.tiny)

var array<label> rLb = array.new<label>()
if showR and xNow
    rLb.push(label.new(time, high, str.tostring(kXR, "+0.0;-0.0") + "R", xloc = xloc.bar_time, style = label.style_label_down, color = color.new(#263238, 20), textcolor = kXR > 0 ? color.new(#00e676, 0) : color.new(#ff5252, 0), size = size.tiny))
    while rLb.size() > rKeep
        label.delete(rLb.shift())

// ============================================================================
//  PYTHON KE PAKKE NUMBER (2012 - 30 Oct 2026, kharcha 0.75 x spread, swap 0; PnL / DD = 0.25% risk har trade)
// ============================================================================
var mName = array.from("XAU", "XAG", "US500", "USTEC", "USOIL", "UKOIL", "BTC", "EURUSD", "GBPUSD", "USDJPY", "USDCHF", "AUDUSD")
var pN    = array.from(114, 116, 131, 135, 111, 107, 62, 120, 124, 121, 124, 108)
var pJ    = array.from(41, 38, 50, 45, 38, 42, 44, 41, 38, 37, 35, 34)
var pExp  = array.from(0.234, 0.146, 0.091, 0.140, 0.076, 0.187, 0.535, 0.058, -0.014, 0.133, -0.092, -0.084)
var pS2   = array.from(-0.028, -0.125, -0.069, -0.016, -0.167, -0.076, 0.049, -0.130, -0.161, -0.146, -0.244, -0.241)
var pBuy  = array.from(0.280, 0.363, 0.124, 0.163, 0.095, 0.216, 0.642, 0.053, -0.067, 0.348, 0.016, -0.246)
var pSell = array.from(0.147, -0.037, -0.233, -0.069, 0.057, 0.163, 0.311, 0.062, 0.035, -0.355, -0.183, 0.032)
var pPnl  = array.from(6.7, 4.2, 3.0, 4.7, 2.1, 5.0, 8.3, 1.7, -0.4, 4.0, -2.8, -2.3)
var pDd   = array.from(1.3, 2.9, 1.5, 1.2, 2.7, 2.8, 0.8, 2.2, 2.9, 3.6, 3.9, 3.4)

f_mkAuto() =>
    string s = str.upper(syminfo.ticker)
    int k = -1
    if str.contains(s, "XAU") or str.contains(s, "GOLD")
        k := 0
    else if str.contains(s, "XAG") or str.contains(s, "SILVER")
        k := 1
    else if str.contains(s, "SPX") or str.contains(s, "US500") or str.contains(s, "SP500")
        k := 2
    else if str.contains(s, "NAS") or str.contains(s, "NDX") or str.contains(s, "USTEC") or str.contains(s, "US100")
        k := 3
    else if str.contains(s, "WTI") or str.contains(s, "USOIL") or str.contains(s, "LIGHT")
        k := 4
    else if str.contains(s, "BCO") or str.contains(s, "UKOIL") or str.contains(s, "BRENT")
        k := 5
    else if str.contains(s, "BTC")
        k := 6
    else if str.contains(s, "EURUSD")
        k := 7
    else if str.contains(s, "GBPUSD")
        k := 8
    else if str.contains(s, "USDJPY")
        k := 9
    else if str.contains(s, "USDCHF")
        k := 10
    else if str.contains(s, "AUDUSD")
        k := 11
    k

mk = mkSel == "Khud (auto)" ? f_mkAuto() : array.indexof(mName, mkSel)

// ============================================================================
//  AAKHRI CANDLE: zones + dabba + tables
// ============================================================================
var array<box> bx = array.new<box>()
var array<box> bxP = array.new<box>()
var label lbP = na
var label lbN = na
var table tb = na
var table th = na

f_pos(string s) =>
    s == "Middle Left" ? position.middle_left : s == "Top Left" ? position.top_left : s == "Middle Right" ? position.middle_right : s == "Top Right" ? position.top_right : s == "Bottom Right" ? position.bottom_right : s == "Bottom Center" ? position.bottom_center : position.bottom_left

f_sz(string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : size.small

f_num(float v, string f) =>
    na(v) ? "-" : str.tostring(v, f)

f_vCol(float v) =>
    na(v) ? color.new(#bdbdbd, 0) : v > 0 ? color.new(#00e676, 0) : v < 0 ? color.new(#ff5252, 0) : color.new(#bdbdbd, 0)

cTx = color.new(#e0e0e0, 0)
cBg = color.new(#121212, 15)
cHd = color.new(#263238, 0)
cBd = color.new(#37474f, 0)

if barstate.islast
    bool live = isOk and kD != 0
    float liveR = live and kR > 0 ? kD * (close - kE) / kR : na
    bool fresh = live and not na(entT) and time - entT < 86400000
    bool liveA = not na(kA) and not na(kC) and kC > 0 and kA / kC * 100 >= 0.25
    int side = na(kEF) or na(kES) ? 0 : kEF > kES ? 1 : kEF < kES ? -1 : 0
    string word = not isOk ? "TF" : fresh ? (kD > 0 ? "BUY" : "SELL") : live ? "CHALU" : (liveA and side != 0) ? "TAYYAR" : "RUKO"
    color wCol = word == "BUY" ? color.new(#00e676, 0) : word == "SELL" ? color.new(#ff5252, 0) : word == "CHALU" ? (kD > 0 ? color.new(#00e676, 0) : color.new(#ff5252, 0)) : word == "TAYYAR" ? color.new(#ffb300, 0) : color.new(#9e9e9e, 0)

    // zones (j3.2 jaisa)
    while bx.size() > 0
        box.delete(bx.pop())
    float nearUp = na
    float nearDn = na
    if not na(aD) and aD > 0 and lv.size() > 0
        array<float> dU = array.new<float>()
        array<int> iU = array.new<int>()
        array<float> dDn = array.new<float>()
        array<int> iD = array.new<int>()
        for i = 0 to lv.size() - 1
            L = lv.get(i)
            dist = L.p - close
            if math.abs(dist) <= 6 * aD
                if dist >= 0
                    dU.push(dist)
                    iU.push(i)
                else
                    dDn.push(-dist)
                    iD.push(i)
        sU = dU.size() > 0 ? array.sort_indices(dU, order.ascending) : array.new<int>()
        sD = dDn.size() > 0 ? array.sort_indices(dDn, order.ascending) : array.new<int>()
        hz = zH * aD
        if sU.size() > 0
            for j = 0 to math.min(zN, sU.size()) - 1
                L = lv.get(iU.get(sU.get(j)))
                if j == 0
                    nearUp := L.p
                if showZ
                    tr = 92 - L.rk * 8
                    bx.push(box.new(L.t, L.p + hz, time, L.p - hz, xloc = xloc.bar_time, extend = extend.right, border_color = color.new(#e53935, 60), bgcolor = color.new(#e53935, tr), text = "R " + f_rkName(L.rk) + " x" + str.tostring(L.n), text_size = size.tiny, text_color = color.new(#e53935, 20), text_halign = text.align_right, text_valign = text.align_center))
        if sD.size() > 0
            for j = 0 to math.min(zN, sD.size()) - 1
                L = lv.get(iD.get(sD.get(j)))
                if j == 0
                    nearDn := L.p
                if showZ
                    tr = 92 - L.rk * 8
                    bx.push(box.new(L.t, L.p + hz, time, L.p - hz, xloc = xloc.bar_time, extend = extend.right, border_color = color.new(#43a047, 60), bgcolor = color.new(#43a047, tr), text = "S " + f_rkName(L.rk) + " x" + str.tostring(L.n), text_size = size.tiny, text_color = color.new(#43a047, 20), text_halign = text.align_right, text_valign = text.align_center))

    // khuli trade ka dabba / AGLI ka andaza
    while bxP.size() > 0
        box.delete(bxP.pop())
    label.delete(lbP)
    label.delete(lbN)
    lbP := na
    lbN := na
    tR = time + 5 * 86400000
    if live and showPs and not na(entT)
        bxP.push(box.new(entT, kD > 0 ? kE : kSL, tR, kD > 0 ? kSL : kE, xloc = xloc.bar_time, border_color = color.new(#c62828, 30), bgcolor = color.new(#c62828, 85)))
        bxP.push(box.new(entT, math.max(kE, close), tR, math.min(kE, close), xloc = xloc.bar_time, border_color = color.new(liveR >= 0 ? #2e7d32 : #c62828, 30), bgcolor = color.new(liveR >= 0 ? #2e7d32 : #c62828, 80)))
        lbP := label.new(tR, close, (kD > 0 ? "BUY" : "SELL") + " khuli @" + str.tostring(kE, format.mintick) + "\nSL " + str.tostring(kSL, format.mintick) + " (roz sarakta) | TP nahi\nabhi " + str.tostring(liveR, "+0.00;-0.00") + "R", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(#263238, 10), textcolor = kD > 0 ? color.new(#00e676, 0) : color.new(#ff5252, 0), size = size.small)
    if showNx and word == "TAYYAR" and not na(kA)
        float eN = side > 0 ? kHN : kLN
        float slN = eN - side * 2.0 * kA
        bxP.push(box.new(time, side > 0 ? eN : slN, tR, side > 0 ? slN : eN, xloc = xloc.bar_time, border_color = color.new(#c62828, 30), border_style = line.style_dotted, bgcolor = color.new(#c62828, 92)))
        lbN := label.new(tR, eN, "AGLI " + (side > 0 ? "BUY" : "SELL") + " (andaza) - intezar\nD1 close " + (side > 0 ? "> " : "< ") + str.tostring(eN, format.mintick) + "\nSL ~" + str.tostring(slN, format.mintick) + " (2 ATR) | TP nahi", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(#263238, 10), textcolor = color.new(#ffb300, 0), size = size.small)

    // KHULASA table (j3.2 chhoti table jaisi)
    if not na(tb)
        table.delete(tb)
    if showT
        sz = f_sz(tSize)
        sq = not na(bbPct) and bbPct <= 25
        float dMin = na(aD) or aD <= 0 ? na : math.min(na(nearUp) ? 99.0 : (nearUp - close) / aD, na(nearDn) ? 99.0 : (close - nearDn) / aD)
        near = not na(dMin) and dMin <= 0.15
        tLvl = near and sq ? "UNCHA" : near or sq ? "DARMIYANA" : "KAM"
        [nt, tag] = f_nextNews()
        wWhy = word == "TF" ? "chart 1D ya chhota rakhein" : word == "BUY" or word == "SELL" ? "kal D1 close par toot - entry ~" + str.tostring(kE, format.mintick) + ", SL " + str.tostring(kSL, format.mintick) : word == "CHALU" ? (kD > 0 ? "BUY" : "SELL") + " khuli, abhi " + str.tostring(liveR, "+0.0;-0.0") + "R, SL " + str.tostring(kSL, format.mintick) : word == "TAYYAR" ? (side > 0 ? "D1 close > " + str.tostring(kHN, format.mintick) + " = BUY" : "D1 close < " + str.tostring(kLN, format.mintick) + " = SELL") : "ATR < 0.25% ya EMA barabar - koi trade nahi"
        kWd = nUp > nDn and nUp * 2 > nTf ? "UPAR" : nDn > nUp and nDn * 2 > nTf ? "NEECHE" : "MILA"
        rTx = "1D EMA50 " + (side > 0 ? "> 200 = sirf BUY" : side < 0 ? "< 200 = sirf SELL" : "= 200") + " · kul " + kWd
        zTx = (na(nearUp) ? "R -" : "R " + str.tostring(nearUp, format.mintick)) + " · " + (na(nearDn) ? "S -" : "S " + str.tostring(nearDn, format.mintick)) + (tLvl == "KAM" ? "" : " · toot " + tLvl)
        nTx = na(nt) ? "-" : str.format_time(nt, "EEE HH:mm", "Asia/Karachi") + " PKT" + (str.contains(tag, "NFP") ? " NFP" : str.contains(tag, "FOMC") ? " FOMC" : "")
        tb := table.new(f_pos(tPos), 2, 4, bgcolor = cBg, border_width = 1, border_color = cBd, frame_width = 1, frame_color = cBd)
        table.cell(tb, 0, 0, word, text_color = wCol, bgcolor = cHd, text_size = sz)
        table.cell(tb, 1, 0, wWhy, text_color = wCol, text_size = sz, text_halign = text.align_left)
        table.cell(tb, 0, 1, "Rukh", text_color = cTx, bgcolor = cHd, text_size = sz)
        table.cell(tb, 1, 1, rTx, text_color = side > 0 ? color.new(#2e7d32, 0) : side < 0 ? color.new(#c62828, 0) : color.new(#9e9e9e, 0), text_size = sz, text_halign = text.align_left)
        table.cell(tb, 0, 2, "Zone", text_color = cTx, bgcolor = cHd, text_size = sz)
        table.cell(tb, 1, 2, zTx, text_color = tLvl == "UNCHA" ? color.new(#ff5252, 0) : tLvl == "DARMIYANA" ? color.new(#ffb300, 0) : cTx, text_size = sz, text_halign = text.align_left)
        table.cell(tb, 0, 3, "News", text_color = cTx, bgcolor = cHd, text_size = sz)
        table.cell(tb, 1, 3, nTx, text_color = str.contains(tag, "NFP") or str.contains(tag, "FOMC") ? color.new(#ff9800, 0) : cTx, text_size = sz, text_halign = text.align_left)

    // HISAAB table (daayen, 5EA jaisi)
    if not na(th)
        table.delete(th)
    if showH
        th := table.new(f_pos(hPos), 10, 5, bgcolor = cBg, border_width = 1, border_color = cBd, frame_width = 1, frame_color = cBd)
        string nm = mk >= 0 ? mName.get(mk) : syminfo.ticker
        table.cell(th, 0, 0, nm + " - Kachhua (e2) hisaab 2012-30 Oct 2026 (Python, Dukascopy, kharcha) | abhi = TV live   [JAS KN " + BUILD + "]", text_color = cTx, text_size = size.tiny)
        table.merge_cells(th, 0, 0, 9, 0)
        hd = array.from("EA", "Abhi", "Abhi R", "Trades", "Jeet %", "Exp", "Exp-2SE", "BUY / SELL Exp", "PnL %", "DD %")
        for i = 0 to 9
            table.cell(th, i, 1, hd.get(i), text_color = cTx, bgcolor = cHd, text_size = size.tiny)
        string abhi = live ? (kD > 0 ? "BUY" : "SELL") + " khuli " + str.tostring(kE, format.mintick) + " | SL " + str.tostring(kSL, format.mintick) : "khali"
        table.cell(th, 0, 2, "Kachhua D1", text_color = cTx, text_size = size.tiny)
        table.cell(th, 1, 2, abhi, text_color = live ? (kD > 0 ? color.new(#00e676, 0) : color.new(#ff5252, 0)) : color.new(#9e9e9e, 0), text_size = size.tiny)
        table.cell(th, 2, 2, live ? str.tostring(liveR, "+0.00;-0.00") + "R" : "-", text_color = f_vCol(liveR), text_size = size.tiny)
        if mk >= 0
            table.cell(th, 3, 2, str.tostring(pN.get(mk)), text_color = cTx, text_size = size.tiny)
            table.cell(th, 4, 2, str.tostring(pJ.get(mk)) + "%", text_color = cTx, text_size = size.tiny)
            table.cell(th, 5, 2, str.tostring(pExp.get(mk), "+0.000;-0.000"), text_color = f_vCol(pExp.get(mk)), text_size = size.tiny)
            table.cell(th, 6, 2, str.tostring(pS2.get(mk), "+0.000;-0.000") + (pS2.get(mk) > 0 ? " >0" : " <0"), text_color = f_vCol(pS2.get(mk)), text_size = size.tiny)
            table.cell(th, 7, 2, str.tostring(pBuy.get(mk), "+0.00;-0.00") + " / " + str.tostring(pSell.get(mk), "+0.00;-0.00"), text_color = cTx, text_size = size.tiny)
            table.cell(th, 8, 2, str.tostring(pPnl.get(mk), "+0.0;-0.0") + "%", text_color = f_vCol(pPnl.get(mk)), text_size = size.tiny)
            table.cell(th, 9, 2, str.tostring(pDd.get(mk), "0.0") + "%", text_color = cTx, text_size = size.tiny)
        else
            table.cell(th, 3, 2, "is market ka Python hisaab nahi (e2 ke 12 mein nahi)", text_color = color.new(#ffb300, 0), text_size = size.tiny)
            table.merge_cells(th, 3, 2, 9, 2)
        float tvExp = kN > 0 ? kS / kN : na
        table.cell(th, 0, 3, "TV is chart", text_color = cTx, text_size = size.tiny)
        table.cell(th, 1, 3, "bina kharcha, poori TV history", text_color = color.new(#9e9e9e, 0), text_size = size.tiny)
        table.merge_cells(th, 1, 3, 2, 3)
        table.cell(th, 3, 3, f_num(kN, "#"), text_color = cTx, text_size = size.tiny)
        table.cell(th, 4, 3, kN > 0 ? str.tostring(100.0 * kW / kN, "#") + "%" : "-", text_color = cTx, text_size = size.tiny)
        table.cell(th, 5, 3, f_num(tvExp, "+0.000;-0.000"), text_color = f_vCol(tvExp), text_size = size.tiny)
        table.cell(th, 6, 3, "kul " + f_num(kS, "+0.0;-0.0") + "R", text_color = f_vCol(kS), text_size = size.tiny)
        table.merge_cells(th, 6, 3, 9, 3)
        table.cell(th, 0, 4, "Akela market kamzor ho sakta (Exp-2SE < 0) - PASS = 12 market ki tokri (#99 / #101), FTMO 0 fail (K17 / K18). PnL / DD = 0.25% risk har trade.", text_color = color.new(#ffb300, 0), text_size = size.tiny)
        table.merge_cells(th, 0, 4, 9, 4)
