//@version=6
// ============================================================================
//  JAS AAINA  (build a13, Pine v6)  — abhi wali nishani, history ke aaine mein
//
//  a1 (19 Oct 2026, user ki marzi): JAS TF LIVE jo ABHI dikhata hai (bari TF
//  ki chalti candle ka RANG + KAHAN), wahi nishani chart ki history mein
//  dhoondo. Har dafa jab bilkul yahi nishani bani thi, agli N candles mein
//  kya hua - table mein ginti:
//    KITNI DAFA     history mein ye nishani kitni dafa bani (jin ka nateeja aa chuka)
//    % OOPER        N candles baad close us waqt ke close se ooper - kitne %
//    HAR CANDLE     bunyaad: koi bhi candle ke baad % ooper / chal (muqabla)
//    AUSAT CHAL     N candles baad ausat chal (% aur ≈ daam abhi ke bhaav par)
//    SHOR ±2SE      ausat kitna shor ho sakta hai (2 standard error)
//    NAAP           nishani ka ausat bunyaad se 2SE zyada farq par? (30+ dafa)
//    MAX OOPER / NEECHE   N candles ke andar ausat sab se zyada ooper / neeche
//
//  Bari TF ki "chalti" candle script khud jodti hai: har chart candle par
//  us waqt tak ka open / high / low / close (timeframe.change) - jaisa us
//  waqt asal mein dikh raha tha. request.security lookahead NAHI, aage ka
//  data nishani mein NAHI. Nateeja sirf band candles par ginti hota hai.
//
//  a2 (19 Oct, jaanch ke baad): (1) ek nishani ke mauqe ek doosre par NA
//  charhein (N candles ka faasla) - warna ek hi chal kai dafa gini jati thi
//  aur SHOR chhota dikhta; "sirf naya mauqa" input hata diya; (2) bunyaad =
//  HAR candle, aur NAAP bunyaad se muqabla (gold ki apni tezi alag);
//  (3) "pehle X dafa / aakhri" mein abhi wali chal shamil nahi + "abhi X
//  candles se"; (4) sirf Candles / Heikin Ashi chart (Renko waghera par
//  waqt nahi - ginti band); (5) TF chart TF ka poora guna ho (mahina chhoot);
//  (6) max ooper/neeche 0 se kam nahi.
//  a3: KAHAN ka faisla bilkul JAS TF LIVE jaisa (67+ Upar, 33 tak Neeche,
//  bina gol kiye) - dono ek hi nishani dekhein; tooltips sahi.
//
//  a4 (19 Oct, user): CHART PAR sab se QAREEBI purane mauqe - taake aankh
//  dekh kar seekhe. Purani JAS script se kuch nahi liya; qaide kitab se:
//    QAREEBI   wahi nishani (rang + kahan) + har TF ke KAHAN % ka Lorentzian
//              faasla  sum log(1 + |farq|)  - jitna kam, utna qareeb (khayal:
//              TradingView "Lorentzian Classification", jdehorty).
//              #1 = sab se qareeb. Mauqe aapas mein N candles door.
//    NATEEJA   mauqe se agli N candles ka dabba: ooper = sab se zyada high,
//              neeche = sab se kam low, beech mein entry close ki lakeer;
//              hara = N baad close ooper, laal = neeche.
//    S / R     Elder "Trading for a Living" + Weinstein "Secrets for Profiting
//              in Bull and Bear Markets": pichli choti (peak) = resistance,
//              pichli tah (trough) = support. Choti/tah = dono taraf X candles
//              se ooper/neeche; sirf jo us mauqe tak PAKKI ho chuki thi.
//    LGB       Elder ka "false breakout" (jhoota toot): wick S/R ke paar gaya,
//              close wapas andar. Mauqe se pehle ki X candles mein.
//    ABHI      qareebi mauqon ka AUSAT dabba abhi ki candle se aage (abhi ke
//              bhaav par %): ausat max ooper / neeche + ausat chal ki lakeer.
//              Ye peshgoi NAHI - sirf "pehle aisa hua tha".
//  FVG / OB kisi mashhoor kitab mein nahi (ICT ke lafz) - is liye nahi.
//  a5 (19 Oct): TV error "historical offset beyond buffer" (purana mauqa
//  4000+ candles peeche) - ab har nishan WAQT (xloc.bar_time) se banta hai,
//  candle number se nahi; is ki koi hadd nahi.
//  a6 (19 Oct, user: "har TF par jaldi jaldi change"): (1) ABHI dabba ab
//  SAB mauqon ka ausat (table wala, 900+ dafa) - 10 ka nahi; shor ho to
//  SALETI; (2) qareebi 10 ab KAHAN ke 5% khanon se (har tick par nahi
//  badalte), barabar hon to naye pehle.
//  a7 (19 Oct, user): TABLE default BAND - chart ke nishan na chhupein;
//  hisaab peechhe chalta rahe, Settings 3 "Table dikhayein" se khule.
//  a8 (19 Oct, user: "dabba banta hai phir chala jata hai; abhi past jaisa
//  hua ya nahi kaise pata chale"): (1) nishani BAND chart candle ki - chalti
//  candle par pichli band candle wali; mauqe / ABHI / table poori candle tak
//  nahi badalte; (2) SAAYA: qareebi #1-#3 mauqon ke baad ka asal raasta (%)
//  band candle se aage halki lakeeron mein (#1 gehri); (3) saaye ek ke baad
//  ek, har saaya N candles (Settings 4 wala N) - nishani badle tab bhi
//  rehta hai; aakhri 3 purane + 1 chalta. N candles poori hon to label:
//  "✔ saaye jaisa" (asal chal ka rukh = saaye ke ausat ka rukh) ya "✖ nahi".
//  Saaya bhi peshgoi NAHI - sirf aankh se jaanch.
//  a9 (20 Oct, a8 TV ✅ 1D screenshot): saaye ke label aapas mein / ABHI par
//  charhte the - ab sirf "✔" / "✖" / "4/12"; baqi likhai tooltip mein.
//  a10 (20 Oct, a9 TV ✅ 15m screenshot): 22:30 ke baad saaya gayab - us
//  band candle ki nishani ka koi purana mauqa nahi tha, phir bhi N candles
//  chhod di jati thin. Ab mauqa na mile to AGLI band candle par phir koshish;
//  jab tak koi saaya na chale, aakhri band candle ke aage saleti "0 mauqe".
//  a11 (20 Oct, user: "record kahan jama ho"): SAAYA RECORD dabba - aakhri
//  ~100 saaye (Settings 5) ka ✔ / ✖ jod, 5 qataron mein: sab / lakeerein
//  ek taraf / alag / kal ki BAND 1D candle saaye jaisi / ulat. Har saaya
//  sirf apne waqt tak ki band candles se (aage ka kuch nahi). 50% = sikka.
//  Rang sirf 30+ saaye aur farq shor (100/sqrt(n) %) se bara. Sirf naap.
//  a12 (20 Oct, a11 TV ✅ 15m + 1D; 1D par 61% - shak: sirf gold ki tezi?):
//  record mein HARA saaya / LAAL saaya alag qataren + har qatar ka BUNYAAD
//  = isi muddat mein har candle ke baad N candles: hare saaye ke liye kitne
//  % ooper, laal ke liye kitne % neeche (aankh band kar ke wahi rukh). Rang
//  ab 50% se nahi, bunyaad se: farq > 2SE (bunyaad par) aur 30+ saaye.
//  a13 (20 Oct, user: "purane data se andaza - AGLI 15m candle kaunsi
//  tayyar hogi", a12 ki tweak): (1) AGLI CANDLE (Settings 6): har band
//  candle par isi nishani ke pichhle mauqon mein AGLI chart candle kitni
//  dafa hari / laal bani + ausat high / low (us candle ke open se) - chart
//  par aage ek SAAYA CANDLE (rang sirf jab bunyaad se 2SE farq, warna
//  saleti) aur label; pichli candles par ✔ / ✖ (andaza sahi / ghalat);
//  record dabba mein 2 nayi qataren (sab andaze / sirf rang wale) vs
//  bunyaad (aankh band kar ke hamesha wohi rang jo ab tak zyada bana).
//  Andaza sirf us waqt tak ki band candles se - aage ka kuch nahi.
//  Milaap alag: "Sirf Rang" (default, zyada mauqe) ya Settings 1 jaisa.
//  (2) TF 5 = 1W (default band - chalu karne se mauqe kam). 1m / 5m chart
//  (15m) se chhoti - un ki candle 15m ke andar hi band hoti hai.
//
//  Base chart: 5m / 15m. Chart se chhoti TF nishani mein nahi aati.
//  1D candle chart ki candles se banti hai: spot / CFD gold par TV jaisi;
//  futures (settlement close) par thori alag ho sakti hai.
//  Ye SIRF NAAP / DEKHNA hai - trade ka faisla NAHI. Trade ke liye pehle
//  koshish #23 ka qaida (TALAASH / IMTIHAN, TRADING.md sec 4).
//  Misaal ka khayal: Lorentzian Classification (kNN) - yahan "bilkul wahi
//  nishani" wala seedha milaap hai, koi andaza / training nahi.
// ============================================================================
indicator("JAS Aaina a13", "JAS AAINA a13", overlay = true, max_bars_back = 1000, max_boxes_count = 60, max_lines_count = 200, max_labels_count = 300, max_polylines_count = 20)

BUILD = "a13"

// --------------------------------------------------------- 1. NISHANI
g1   = "1. Nishani (bari TF ki chalti candle)"
onA  = input.bool(true, "", group = g1, inline = "a")
tfA  = input.timeframe("15",  "TF 1", group = g1, inline = "a")
onB  = input.bool(true, "", group = g1, inline = "b")
tfB  = input.timeframe("60",  "TF 2", group = g1, inline = "b")
onC  = input.bool(true, "", group = g1, inline = "c")
tfC  = input.timeframe("240", "TF 3", group = g1, inline = "c")
onD  = input.bool(true, "", group = g1, inline = "d")
tfD  = input.timeframe("D",   "TF 4", group = g1, inline = "d")
onE  = input.bool(false, "", group = g1, inline = "e")
tfE  = input.timeframe("W",   "TF 5", group = g1, inline = "e", tooltip = "a13: 1W (default band). Chalu karein to nishani sakht - mauqe kam.")
mode = input.string("Rang + Kahan", "Milaap", options = ["Rang + Kahan", "Sirf Rang"], group = g1, tooltip = "Rang + Kahan = har TF ka rang AUR range mein jagah (Upar / Beech / Neeche) dono milein. Sirf Rang = sirf hari / laal milein (zyada mauqe, kam sakht).")

// ------------------------------------------------------ 2. AAGE KYA HUA
g2      = "2. Aage kitni candles (chart ki)"
n1      = input.int(4,  "N 1", minval = 1, maxval = 500, group = g2, inline = "n")
n2      = input.int(12, "N 2", minval = 1, maxval = 500, group = g2, inline = "n")
n3      = input.int(48, "N 3", minval = 1, maxval = 500, group = g2, inline = "n", tooltip = "Ek nishani ke do mauqon mein kam az kam N candles ka faasla - ek hi chal do dafa nahi gini jati.")

// ---------------------------------------------------------------- 3. TABLE
g3       = "3. Table"
showTbl  = input.bool(false, "Table dikhayein", group = g3, tooltip = "Band ho to bhi saara hisaab peechhe chalta hai - sirf table chhupti hai, chart ke nishan wahi.")
tblPos   = input.string("Top Right", "Table kahan", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = g3)
tblSize  = input.string("Small", "Likhai ka size", options = ["Tiny", "Small", "Normal"], group = g3)
tblClear = input.bool(true, "Dabba transparent (peechhe candles nazar aayein)", group = g3)
tblAlpha = input.int(85, "Kitna transparent (0 = thos, 100 = bilkul gayab)", minval = 0, maxval = 100, group = g3)

// ------------------------------------------- 4. CHART PAR QAREEBI MAUQE
g4      = "4. Chart par qareebi mauqe"
showMap = input.bool(true, "Qareebi purane mauqe chart par", group = g4, tooltip = "Wahi nishani + KAHAN % sab se qareeb (Lorentzian faasla). #1 = sab se qareeb.")
kTop    = input.int(10, "Kitne mauqe", minval = 1, maxval = 30, group = g4)
nPick   = input.string("N 2", "Nateeja dabba: kitni candles", options = ["N 1", "N 2", "N 3"], group = g4, tooltip = "Section 2 wala N 1 / N 2 / N 3.")
showSR  = input.bool(true, "S / R (Elder, Weinstein: pichli choti / tah)", group = g4)
showJT  = input.bool(true, "LGB = jhoota toot (Elder false breakout)", group = g4)
showNow = input.bool(true, "ABHI: qareebi mauqon ka ausat dabba", group = g4)
pvLen   = input.int(5, "Choti / tah: dono taraf kitni candles", minval = 2, maxval = 20, group = g4)
jtLook  = input.int(20, "LGB: mauqe se kitni candles peeche tak", minval = 1, maxval = 100, group = g4)
showSy  = input.bool(true, "SAAYA: qareebi #1-#3 ka raasta + ✔ / ✖", group = g4, tooltip = "Band candle se aage qareebi 3 mauqon ka asal raasta (%). Har saaya N candles (upar wala nateeja dabba N), phir agla. N poori hon to ✔ = asal chal saaye ke rukh mein, ✖ = nahi. Peshgoi NAHI.")
yKeep   = input.int(3, "Purane saaye kitne rakhein", minval = 1, maxval = 5, group = g4)

// ------------------------------------------------------- 5. SAAYA RECORD
g5      = "5. Saaya record (✔ / ✖ ka jod)"
showRec = input.bool(true, "Record dabba dikhayein", group = g5, tooltip = "Aakhri saayon ka ✔ / ✖ jod. Saaya (Settings 4) chalu hona chahiye.")
recN    = input.int(100, "Aakhri kitne saaye gine", minval = 10, maxval = 300, group = g5, tooltip = "Zyada = behtar ginti, lekin TV dheema. 'Calculation timeout' aaye to kam karein.")
recPos  = input.string("Bottom Right", "Record kahan", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = g5)

// ------------------------------------------------- 6. a13 AGLI CANDLE
g6      = "6. AGLI candle (a13)"
showAg  = input.bool(true, "AGLI candle ka andaza chart par", group = g6, tooltip = "Isi nishani ke pichhle mauqon mein AGLI chart candle kitni dafa hari / laal bani. Chart par aage saaya candle + label. Peshgoi NAHI - sirf 'pehle aisa hua tha'.")
agMode  = input.string("Sirf Rang", "AGLI ka milaap", options = ["Sirf Rang", "Settings 1 jaisa"], group = g6, tooltip = "Sirf Rang = har TF ka sirf rang (zyada mauqe, andaza aksar milta hai). Settings 1 jaisa = upar wala Milaap (Rang + Kahan par mauqe bohot kam).")
agMin   = input.int(30, "Kam az kam mauqe (warna andaza nahi)", minval = 10, maxval = 500, group = g6)
agMk    = input.int(20, "✔ / ✖ kitni pichli candles par", minval = 0, maxval = 100, group = g6, tooltip = "0 = chart par ✔ / ✖ nahi (record dabba phir bhi ginta hai).")

// ---------------------------------------------------------------- RANG
cUp  = color.new(#26A69A, 0)
cDn  = color.new(#EF5350, 0)
cTxt = color.new(#37474F, 0)
cGr  = color.new(#78909C, 0)
cHd  = color.new(#ECEFF1, 0)
cOk  = color.new(#2962FF, 0)
cNo  = color.new(#FF9800, 0)

// ============================================================================
//  DATA — asal candles (Heikin Ashi par bhi; Renko / Range par ginti band), chart ki apni TF
// ============================================================================
// Isi TF + lookahead_off = har candle ka apna asal OHLC, aage ka kuch nahi.
tkStd = ticker.standard(syminfo.tickerid)
[sO, sH, sL, sC] = request.security(tkStd, timeframe.period, [open, high, low, close])

// Bari TF ki chalti candle, chart candle ke close tak (jaisa us waqt dikhta tha)
// wapsi: [shamil?, tayyar?, rang 0 barabar / 1 hari / 2 laal, jagah 0 Neeche / 1 Beech / 2 Upar, kahan %]
f_htf(simple string _tf, simple bool _on) =>
    var float _o   = na
    var float _h   = na
    var float _l   = na
    var bool _seen = false
    // TF chart TF ka poora guna ho (mahina hamesha poori candles ka - seconds barabar nahi batte)
    bool _mul = timeframe.in_seconds(_tf) >= 2592000 or timeframe.in_seconds(_tf) % timeframe.in_seconds() == 0
    bool _in  = _on and timeframe.in_seconds(_tf) >= timeframe.in_seconds() and _mul
    bool _new = timeframe.change(_tf)
    if _new or na(_o)
        _o := sO
        _h := sH
        _l := sL
        // chart ki pehli candle par TF candle aadhi hoti hai - agli nayi candle se tayyar
        if _new and bar_index > 0
            _seen := true
    else
        _h := math.max(_h, sH)
        _l := math.min(_l, sL)
    float _rg = _h - _l
    // JAS TF LIVE jaisa (bina gol kiye)
    float _kp = _rg > 0 ? (sC - _l) / _rg * 100 : 50.0
    int _rang = sC > _o ? 1 : sC < _o ? 2 : 0
    int _zone = _kp >= 67 ? 2 : _kp <= 33 ? 0 : 1
    [_in, _seen, _rang, _zone, _kp]

[inA, okA, rgA, znA, kpA] = f_htf(tfA, onA)
[inB, okB, rgB, znB, kpB] = f_htf(tfB, onB)
[inC, okC, rgC, znC, kpC] = f_htf(tfC, onC)
[inD, okD, rgD, znD, kpD] = f_htf(tfD, onD)
[inE, okE, rgE, znE, kpE] = f_htf(tfE, onE)

// har TF ki halat ek number (0-8); nishani = 5 halaton ka ek number
f_st(bool _in, int _rang, int _zone) => _in ? (mode == "Sirf Rang" ? _rang : _rang * 3 + _zone) : 0
int  key   = f_st(inA, rgA, znA) + f_st(inB, rgB, znB) * 9 + f_st(inC, rgC, znC) * 81 + f_st(inD, rgD, znD) * 729 + f_st(inE, rgE, znE) * 6561
// a13: AGLI candle ki nishani - "Sirf Rang" par sirf rang (0-2) har TF ka
int  keyR  = (inA ? rgA : 0) + (inB ? rgB : 0) * 3 + (inC ? rgC : 0) * 9 + (inD ? rgD : 0) * 27 + (inE ? rgE : 0) * 81
int  agKey = agMode == "Sirf Rang" ? keyR : key
// Renko / Range / Kagi waghera par candle = waqt nahi - ginti sirf Candles / Heikin Ashi par
bool chartOk = chart.is_standard or chart.is_heikinashi
bool valid = chartOk and (inA or inB or inC or inD or inE) and (not inA or okA) and (not inB or okB) and (not inC or okC) and (not inD or okD) and (not inE or okE)
bool isNew = valid and (not valid[1] or key != key[1])
// abhi wali chal kab shuru hui
var int runT = na
var int runB = na
if isNew
    runT := time
    runB := bar_index

// a8: nishani BAND candle ki - chalti candle par pichli band candle wali (mauqe poori candle tak nahi badalte)
bool  chalti = not barstate.isconfirmed
int   fKey  = chalti ? key[1] : key
bool  fOk   = chalti ? valid[1] : valid
float fKpA  = chalti ? kpA[1] : kpA
float fKpB  = chalti ? kpB[1] : kpB
float fKpC  = chalti ? kpC[1] : kpC
float fKpD  = chalti ? kpD[1] : kpD
float fKpE  = chalti ? kpE[1] : kpE
int   fRgA  = chalti ? rgA[1] : rgA
int   fRgB  = chalti ? rgB[1] : rgB
int   fRgC  = chalti ? rgC[1] : rgC
int   fRgD  = chalti ? rgD[1] : rgD
int   fRgE  = chalti ? rgE[1] : rgE
float fC    = chalti ? sC[1] : sC
int   fT    = chalti ? time[1] : time
int   fBI   = chalti ? bar_index - 1 : bar_index
int   fRunT = chalti ? runT[1] : runT
int   fRunB = chalti ? runB[1] : runB

// ============================================================================
//  GINTI — har nishani ka hisaab (sirf band candle par)
// ============================================================================
type St
    int   n     = 0
    int   up    = 0
    int   dn    = 0
    float sm    = 0.0
    float sq    = 0.0
    float mfe   = 0.0
    float mae   = 0.0
    int   lb    = -1000000

f_put(St _s, float _mv, float _fe, float _ae) =>
    _s.n   := _s.n + 1
    _s.up  := _s.up + (_mv > 0 ? 1 : 0)
    _s.dn  := _s.dn + (_mv < 0 ? 1 : 0)
    _s.sm  := _s.sm + _mv
    _s.sq  := _s.sq + _mv * _mv
    _s.mfe := _s.mfe + _fe
    _s.mae := _s.mae + _ae

var map<int, St> M1 = map.new<int, St>()
var map<int, St> M2 = map.new<int, St>()
var map<int, St> M3 = map.new<int, St>()
var St B1 = St.new()
var St B2 = St.new()
var St B3 = St.new()
var map<int, int> SEEN = map.new<int, int>()
var map<int, int> LAST = map.new<int, int>()
var map<int, int> PREV = map.new<int, int>()
var int firstT = na
var int nBars  = 0

// N candles pehle wali nishani ka nateeja ab poora hua: is ki ginti
f_hz(simple int _n, map<int, St> _m, St _b) =>
    // ta.* bahar (har candle par) - is candle tak pichli _n candles = nishani ke BAAD ki _n candles
    float _hh = ta.highest(sH, _n)
    float _ll = ta.lowest(sL, _n)
    float _c0 = sC[_n]
    if barstate.isconfirmed and bar_index >= _n and valid[_n] and _c0 > 0
        float _mv = (sC - _c0) / _c0 * 100
        float _fe = math.max(_hh - _c0, 0) / _c0 * 100
        float _ae = math.max(_c0 - _ll, 0) / _c0 * 100
        // bunyaad: har candle
        f_put(_b, _mv, _fe, _ae)
        int _k = key[_n]
        St _s = map.get(_m, _k)
        if na(_s)
            _s := St.new()
            map.put(_m, _k, _s)
        // is nishani ka pichhla mauqa kam az kam _n candles pehle (aapas mein na charhein)
        int _j = bar_index - _n
        if _j - _s.lb >= _n
            _s.lb := _j
            f_put(_s, _mv, _fe, _ae)

f_hz(n1, M1, B1)
f_hz(n2, M2, B2)
f_hz(n3, M3, B3)

if barstate.isconfirmed
    if valid and na(firstT)
        firstT := time
    nBars += valid ? 1 : 0
    // har chal (nishani shuru se khatam tak) ek dafa
    if isNew
        map.put(SEEN, key, nz(map.get(SEEN, key)) + 1)
        map.put(PREV, key, map.get(LAST, key))
        map.put(LAST, key, time)

// ============================================================================
//  a13 AGLI CANDLE — is nishani ke baad AGLI chart candle kaisi bani (rang + high / low us ke open se)
// ============================================================================
var map<int, St> M0 = map.new<int, St>()
var St B0 = St.new()
// abhi wala andaza (pichli band candle par bana, agli candle ke liye): 1 hari / 2 laal / 0 nahi
var int   gPr = 0
var int   gBs = 0
var bool  gNl = false
var int   gK  = 0
var float gP  = na
var float gBu = na
var float gMv = na
var float gFe = na
var float gAe = na
// record: sab andaze / sirf rang wale (bunyaad se 2SE farq) - aaina aur bunyaad dono ✔ / ✖
var int agOk  = 0
var int agNo  = 0
var int agBOk = 0
var int agBNo = 0
var int nlOk  = 0
var int nlNo  = 0
var int nlBOk = 0
var int nlBNo = 0
var int agFirstT = na
// chart ke ✔ / ✖ (aakhri 100): candle ka waqt, low, sahi?, tooltip
var array<int>    gmT  = array.new<int>()
var array<float>  gmL  = array.new<float>()
var array<bool>   gmOk = array.new<bool>()
var array<string> gmTp = array.new<string>()

f_hl(float _x) => (_x > 0 ? "+" : "") + str.tostring(_x, "0.00") + "%"

int agRang = sC > sO ? 1 : sC < sO ? 2 : 0
if barstate.isconfirmed and showAg
    // 1. pichli band candle par bana andaza - ye candle ab band: ✔ / ✖ (barabar candle gini nahi)
    if gPr != 0 and agRang != 0
        bool hitA = agRang == gPr
        bool hitB = agRang == gBs
        agOk  += hitA ? 1 : 0
        agNo  += hitA ? 0 : 1
        agBOk += hitB ? 1 : 0
        agBNo += hitB ? 0 : 1
        if gNl
            nlOk  += hitA ? 1 : 0
            nlNo  += hitA ? 0 : 1
            nlBOk += hitB ? 1 : 0
            nlBNo += hitB ? 0 : 1
        array.push(gmT, time)
        array.push(gmL, sL)
        array.push(gmOk, hitA)
        array.push(gmTp, (hitA ? "✔ andaza sahi" : "✖ andaza ghalat") + "\nAndaza: " + (gPr == 1 ? "HARI " : "LAAL ") + str.tostring(gPr == 1 ? gP : 100 - gP, "0") + "% (" + str.tostring(gK) + " mauqe" + (gNl ? ", rang wala" : ", shor") + ")\nBani: " + (agRang == 1 ? "HARI " : "LAAL ") + f_hl((sC - sO) / sO * 100) + "\nBunyaad (" + (gBs == 1 ? "HARI" : "LAAL") + "): " + (hitB ? "✔" : "✖"))
        if array.size(gmT) > 100
            array.shift(gmT)
            array.shift(gmL)
            array.shift(gmOk)
            array.shift(gmTp)
    // 2. seekho: pichli band candle ki nishani -> ye candle (sirf ab tak ka data)
    if bar_index > 0 and valid[1] and sO > 0
        float mv0 = (sC - sO) / sO * 100
        float fe0 = (sH - sO) / sO * 100
        float ae0 = (sO - sL) / sO * 100
        f_put(B0, mv0, fe0, ae0)
        int k0 = agKey[1]
        St s0 = map.get(M0, k0)
        if na(s0)
            s0 := St.new()
            map.put(M0, k0, s0)
        f_put(s0, mv0, fe0, ae0)
    // 3. agli candle ka andaza - is band candle ki nishani, ab tak ki ginti se
    gPr := 0
    gNl := false
    gK  := 0
    gBu := B0.up + B0.dn > 0 ? 100.0 * B0.up / (B0.up + B0.dn) : na
    if valid and not na(gBu)
        St s1 = map.get(M0, agKey)
        int n1g = na(s1) ? 0 : s1.up + s1.dn
        gK := n1g
        if n1g >= agMin
            gP  := 100.0 * s1.up / n1g
            gMv := s1.sm / s1.n
            gFe := s1.mfe / s1.n
            gAe := s1.mae / s1.n
            gBs := gBu >= 50 ? 1 : 2
            gPr := gP > 50 ? 1 : gP < 50 ? 2 : gBs
            // rang sirf jab nishani andaze ki taraf bunyaad se 2SE zyada
            gNl := (gPr == 1 ? gP - gBu : gBu - gP) > 2 * math.sqrt(gBu * (100 - gBu) / n1g)
            if na(agFirstT)
                agFirstT := time

// ============================================================================
//  a4 YAADDASHT — har band candle ki nishani, KAHAN %, daam (chart par dikhane ke liye)
// ============================================================================
var array<int>   aBI  = array.new<int>()
var array<int>   aKey = array.new<int>()
var array<bool>  aOk  = array.new<bool>()
var array<float> aKA  = array.new<float>()
var array<float> aKB  = array.new<float>()
var array<float> aKC  = array.new<float>()
var array<float> aKD  = array.new<float>()
var array<float> aKE  = array.new<float>()
var array<float> aC   = array.new<float>()
var array<float> aH   = array.new<float>()
var array<float> aL   = array.new<float>()
var array<int>   aT   = array.new<int>()

// S / R: choti (peak) aur tah (trough); kis candle par PAKKI hui wo bhi yaad (us se pehle istemal nahi)
float pkH = ta.pivothigh(sH, pvLen, pvLen)
float pkL = ta.pivotlow(sL, pvLen, pvLen)
// rT / uT = choti / tah ki candle ka WAQT (nishan waqt se banta hai), rK / uK = pakki hone ki candle
int pvT = time[pvLen]
var array<float> rP = array.new<float>()
var array<int>   rT = array.new<int>()
var array<int>   rK = array.new<int>()
var array<float> uP = array.new<float>()
var array<int>   uT = array.new<int>()
var array<int>   uK = array.new<int>()
// LGB (jhoota toot): candle, daam, taraf (-1 = R ke ooper wick, +1 = S ke neeche wick)
var array<int>   eB = array.new<int>()
var array<float> eP = array.new<float>()
var array<int>   eD = array.new<int>()
var array<int>   eT = array.new<int>()
var float jtR  = na
var bool  jtRu = true
var float jtS  = na
var bool  jtSu = true

if barstate.isconfirmed
    array.push(aBI, bar_index)
    array.push(aKey, key)
    array.push(aOk, valid)
    array.push(aKA, inA ? kpA : na)
    array.push(aKB, inB ? kpB : na)
    array.push(aKC, inC ? kpC : na)
    array.push(aKD, inD ? kpD : na)
    array.push(aKE, inE ? kpE : na)
    array.push(aC, sC)
    array.push(aH, sH)
    array.push(aL, sL)
    array.push(aT, time)
    // Pine array ki hadd 100,000 - purana hissa chhodo
    if array.size(aBI) > 90000
        array.shift(aBI)
        array.shift(aKey)
        array.shift(aOk)
        array.shift(aKA)
        array.shift(aKB)
        array.shift(aKC)
        array.shift(aKD)
        array.shift(aKE)
        array.shift(aC)
        array.shift(aH)
        array.shift(aL)
        array.shift(aT)
    if not na(pkH)
        array.push(rP, pkH)
        array.push(rT, pvT)
        array.push(rK, bar_index)
        jtR  := pkH
        jtRu := false
    if not na(pkL)
        array.push(uP, pkL)
        array.push(uT, pvT)
        array.push(uK, bar_index)
        jtS  := pkL
        jtSu := false
    // jhoota toot: wick paar, close wapas andar (ek level par ek dafa); close paar = asal toot, LGB nahi
    if not jtRu and not na(jtR) and sH > jtR
        if sC < jtR
            array.push(eB, bar_index)
            array.push(eP, sH)
            array.push(eD, -1)
            array.push(eT, time)
        jtRu := true
    if not jtSu and not na(jtS) and sL < jtS
        if sC > jtS
            array.push(eB, bar_index)
            array.push(eP, sL)
            array.push(eD, 1)
            array.push(eT, time)
        jtSu := true

// ============================================================================
//  MADADGAR
// ============================================================================
f_pos(_s) => _s == "Top Left" ? position.top_left : _s == "Bottom Right" ? position.bottom_right : _s == "Bottom Left" ? position.bottom_left : _s == "Middle Right" ? position.middle_right : position.top_right
f_size(_s) => _s == "Tiny" ? size.tiny : _s == "Normal" ? size.normal : size.small

// TF ka chhota naam: 15m, 1H, 4H, 1D, 1W
f_tfName(simple string _tf) =>
    int _s = timeframe.in_seconds(_tf)
    _s >= 2592000 and _s % 604800 != 0 ? str.tostring(math.round(_s / 2628000)) + "M" : _s % 604800 == 0 ? str.tostring(int(_s / 604800)) + "W" : _s % 86400 == 0 ? str.tostring(int(_s / 86400)) + "D" : _s % 3600 == 0 ? str.tostring(int(_s / 3600)) + "H" : _s % 60 == 0 ? str.tostring(int(_s / 60)) + "m" : str.tostring(_s) + "s"

// waqt ki lambai: 1H, 3H 20m, 2D
f_dur(int _s) =>
    int _d = int(_s / 86400)
    int _h = int((_s % 86400) / 3600)
    int _m = int((_s % 3600) / 60)
    _d > 0 ? str.tostring(_d) + "D" + (_h > 0 ? " " + str.tostring(_h) + "H" : "") : _h > 0 ? str.tostring(_h) + "H" + (_m > 0 ? " " + str.tostring(_m) + "m" : "") : str.tostring(_m) + "m"

f_pct(float _x) => (_x > 0 ? "+" : "") + str.tostring(_x, "0.00") + "%"
f_px(float _x) => str.tostring(_x * sC / 100, format.mintick)

// transparent: dabba halka, likhai chart ke rang mein (kaale aur safed chart dono par)
f_bg(color _c) => tblClear ? color.new(_c == color.white or _c == cHd ? chart.bg_color : _c, tblAlpha) : _c
f_tc(color _c) => tblClear and (_c == cTxt or _c == color.white) ? chart.fg_color : _c

// ============================================================================
//  TABLE — sirf aakhri candle par
// ============================================================================
var table TB = table.new(f_pos(tblPos), 4, 20, border_width = 1, border_color = color.new(#CFD8DC, tblClear ? 75 : 0))

f_cell(int _col, int _row, string _t, color _fg, color _bg, string _tip) =>
    table.cell(TB, _col, _row, _t, text_color = f_tc(_fg), bgcolor = f_bg(_bg), text_size = f_size(tblSize), text_halign = text.align_left, tooltip = _tip)

// ABHI ki nishani: ek TF ki qatar
f_now(int _r, simple string _tf, bool _in, bool _ok, int _rang, float _kp) =>
    string _nm = f_tfName(_tf)
    if not _in
        f_cell(0, _r, _nm, cGr, color.white, "")
        f_cell(1, _r, "bahar", cGr, color.white, "Ye TF band hai, chart se chhoti hai, ya chart TF ka poora guna nahi - nishani mein nahi.")
        f_cell(2, _r, "", cGr, color.white, "")
        f_cell(3, _r, "", cGr, color.white, "")
    else
        color  _cc = _rang == 1 ? cUp : _rang == 2 ? cDn : cGr
        string _rn = _rang == 1 ? "▲ HARI" : _rang == 2 ? "▼ LAAL" : "= BARABAR"
        string _kw = _kp >= 67 ? "Upar " : _kp <= 33 ? "Neeche " : "Beech "
        color  _kc = _kp >= 67 ? cUp : _kp <= 33 ? cDn : cTxt
        f_cell(0, _r, _nm, cTxt, color.white, "")
        f_cell(1, _r, _rn, color.white, _cc, "Chalti candle ka rang (close open se upar = hari).")
        f_cell(2, _r, mode == "Sirf Rang" ? "-" : _kw + str.tostring(_kp, "0") + "%", _kc, color.white, "Close range mein kahan: 67% ya zyada Upar, 33% ya kam Neeche (JAS TF LIVE jaisa).")
        f_cell(3, _r, _ok ? "" : "(nayi)", cGr, color.white, _ok ? "" : "Chart ki history is TF ki ek poori candle se kam - ginti abhi tayyar nahi.")

// ============================================================================
//  a4 CHART — sab se qareebi purane mauqe (sirf aakhri candle par banta hai)
// ============================================================================
int nD = nPick == "N 1" ? n1 : nPick == "N 3" ? n3 : n2
var int    qN   = 0
var int    qUp  = 0
var string qTxt = "Qareebi mauqe: -"

// KAHAN % ke 5% khane (har tick par chhoti harkat se qareebi mauqe na badlein)
f_q(float _x) => math.round(_x / 5) * 5

// Lorentzian faasla: har shamil TF ke KAHAN % (khane) ka log(1 + |farq|) - jitna kam utna qareeb
f_dist(int _i, float _a, float _b, float _c, float _e, float _w) =>
    float _d = 0.0
    if inA
        _d += math.log(1 + math.abs(f_q(array.get(aKA, _i)) - f_q(_a)))
    if inB
        _d += math.log(1 + math.abs(f_q(array.get(aKB, _i)) - f_q(_b)))
    if inC
        _d += math.log(1 + math.abs(f_q(array.get(aKC, _i)) - f_q(_c)))
    if inD
        _d += math.log(1 + math.abs(f_q(array.get(aKD, _i)) - f_q(_e)))
    if inE
        _d += math.log(1 + math.abs(f_q(array.get(aKE, _i)) - f_q(_w)))
    _d

// candle (array jagah) _j ki nishani ke sab se qareebi purane mauqe - sirf wo jin ki nD candles _j tak poori
// wapsi: mauqon ki array jagah (sab se qareeb pehle), aapas mein nD candles door (aakhri 30,000 candles tak)
f_near(int _j, int _key, float _a, float _b, float _c, float _e, float _w, int _kMax) =>
    array<int>   _cI  = array.new<int>()
    array<float> _cD  = array.new<float>()
    int          _iLo = math.max(0, _j - 30000)
    if _j - nD >= _iLo
        for _i = _j - nD to _iLo
            if array.get(aOk, _i) and array.get(aKey, _i) == _key
                array.push(_cI, _i)
                // barabar faasla ho to naya mauqa pehle (chhota sa izafa purane par)
                array.push(_cD, f_dist(_i, _a, _b, _c, _e, _w) + (_j - _i) * 0.0000001)
    array<int> _pk = array.new<int>()
    if array.size(_cD) > 0
        array<int> _ord = array.sort_indices(_cD, order.ascending)
        for _o in _ord
            int  _ci  = array.get(_cI, _o)
            int  _cb  = array.get(aBI, _ci)
            bool _far = true
            for _q in _pk
                if math.abs(array.get(aBI, _q) - _cb) < nD
                    _far := false
                    break
            if _far
                array.push(_pk, _ci)
            if array.size(_pk) >= _kMax
                break
    _pk

// candle _j tak PAKKI choti / tah (aakhri 10) mein se daam _px ke sab se qareeb: ooper = R, neeche = S
// wapsi: [daam, choti / tah ka waqt]
f_lvl(array<float> _p, array<int> _b, array<int> _k, int _j, float _px, bool _up) =>
    float _v    = na
    int   _vb   = na
    int   _seen = 0
    int   _n    = array.size(_p)
    if _n > 0
        for _i = _n - 1 to 0
            if array.get(_k, _i) <= _j
                float _x = array.get(_p, _i)
                if (_up ? _x > _px : _x < _px) and (na(_v) or math.abs(_x - _px) < math.abs(_v - _px))
                    _v  := _x
                    _vb := array.get(_b, _i)
                _seen += 1
                if _seen >= 10
                    break
    [_v, _vb]

// S / R lakeer: choti / tah ke waqt se _x1 (waqt) tak; _j0 = mauqe ki candle (sirf pakki hone ki jaanch)
f_srDraw(int _j0, int _x1, float _px) =>
    [_r, _rt] = f_lvl(rP, rT, rK, _j0, _px, true)
    [_s, _st] = f_lvl(uP, uT, uK, _j0, _px, false)
    if not na(_r)
        line.new(_rt, _r, _x1, _r, xloc = xloc.bar_time, color = color.new(cDn, 35), style = line.style_dashed, width = 1)
        label.new(_x1, _r, "R", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(cDn, 100), textcolor = cDn, size = size.tiny, tooltip = "Resistance = pichli choti " + str.tostring(_r, format.mintick) + " (Elder / Weinstein), us waqt tak pakki.")
    if not na(_s)
        line.new(_st, _s, _x1, _s, xloc = xloc.bar_time, color = color.new(cUp, 35), style = line.style_dashed, width = 1)
        label.new(_x1, _s, "S", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(cUp, 100), textcolor = cUp, size = size.tiny, tooltip = "Support = pichli tah " + str.tostring(_s, format.mintick) + " (Elder / Weinstein), us waqt tak pakki.")

// candle _j se pehle jtLook candles mein jhoote toot (zyada se zyada 2, sab se naye)
f_jtDraw(int _j) =>
    int _n = array.size(eB)
    int _c = 0
    if _n > 0
        for _i = _n - 1 to 0
            int _b = array.get(eB, _i)
            if _b < _j - jtLook or _c >= 2
                break
            if _b <= _j
                int _d = array.get(eD, _i)
                label.new(array.get(eT, _i), array.get(eP, _i), _d > 0 ? "LGB↑" : "LGB↓", xloc = xloc.bar_time, style = _d > 0 ? label.style_label_up : label.style_label_down, color = color.new(_d > 0 ? cUp : cDn, 100), textcolor = _d > 0 ? cUp : cDn, size = size.tiny, tooltip = _d > 0 ? "Jhoota toot (Elder false breakout): wick support ke neeche, close wapas ooper." : "Jhoota toot (Elder false breakout): wick resistance ke ooper, close wapas neeche.")
                _c += 1

// ============================================================================
//  a8 SAAYA — band candle par qareebi #1-#3 mauqon ka raasta yaad (ek ke baad ek, har saaya nD candles)
// ============================================================================
var array<int>    yJ   = array.new<int>()
var array<float>  yP0  = array.new<float>()
var array<int>    yN   = array.new<int>()
var array<string> yTip = array.new<string>()
// har saaye ke 3 raaste x (nD + 1) % - lagatar
var array<float>  yPa  = array.new<float>()
var int           yNext = na
int yW = 3 * (nD + 1)

// a11 RECORD: kal ki BAND 1D candle ka rang (1 hara / -1 laal / 0 barabar ya pata nahi)
var float dO  = na
var int   kal = 0
float prvC = sC[1]
if timeframe.change("D")
    if not na(dO)
        kal := prvC > dO ? 1 : prvC < dO ? -1 : 0
    dO := sO
// chalte saaye (nateeja baqi): shuru candle, daam, rukh, lakeerein ek taraf?, kal 1D
var array<int>   pJ  = array.new<int>()
var array<float> pP0 = array.new<float>()
var array<int>   pSg = array.new<int>()
var array<bool>  pEk = array.new<bool>()
var array<int>   pK  = array.new<int>()
// qataren: 0 sab, 1 ek taraf, 2 alag, 3 kal 1D saaye jaisi, 4 kal 1D ulat, 5 hara saaya, 6 laal saaya
var array<int>   rOk = array.new<int>(7, 0)
var array<int>   rNo = array.new<int>(7, 0)
// a12: har qatar mein kitne hare / laal saaye (bunyaad ka hisaab)
var array<int>   rH  = array.new<int>(7, 0)
var array<int>   rL  = array.new<int>(7, 0)
var int          rSeen = 0
// a12 BUNYAAD: pehle gine gaye saaye se aage har band candle - N baad close ooper / neeche
var int          rFirst  = na
var int          rFirstT = na
var int          bN  = 0
var int          bUp = 0
var int          bDn = 0

f_rec(int _i, bool _ok, int _sg) =>
    if _ok
        array.set(rOk, _i, array.get(rOk, _i) + 1)
    else
        array.set(rNo, _i, array.get(rNo, _i) + 1)
    if _sg > 0
        array.set(rH, _i, array.get(rH, _i) + 1)
    if _sg < 0
        array.set(rL, _i, array.get(rL, _i) + 1)

if barstate.isconfirmed and showSy and not na(rFirst) and bar_index - nD >= rFirst and array.size(aC) > nD
    float bC0 = array.get(aC, array.size(aC) - 1 - nD)
    bN  += 1
    bUp += sC > bC0 ? 1 : 0
    bDn += sC < bC0 ? 1 : 0

// N candles poori: asal close saaye ke rukh mein? (label wala hi hisaab)
if barstate.isconfirmed and showSy and array.size(pJ) > 0
    if bar_index - array.get(pJ, 0) >= nD
        float rP0 = array.get(pP0, 0)
        int   rSg = array.get(pSg, 0)
        int   rKl = array.get(pK, 0)
        float act = (sC - rP0) / rP0 * 100
        bool  rOkB = rSg != 0 and act != 0 and (act > 0) == (rSg > 0)
        f_rec(0, rOkB, rSg)
        f_rec(array.get(pEk, 0) ? 1 : 2, rOkB, rSg)
        if rKl != 0 and rSg != 0
            f_rec(rKl == rSg ? 3 : 4, rOkB, rSg)
        if rSg != 0
            f_rec(rSg > 0 ? 5 : 6, rOkB, rSg)
        rSeen += 1
        array.shift(pJ)
        array.shift(pP0)
        array.shift(pSg)
        array.shift(pEk)
        array.shift(pK)

if barstate.isconfirmed and showSy and valid and (na(yNext) or bar_index >= yNext)
    // sirf aakhri saayon ka hisaab - puri history par bhaari loop nahi (wahan sirf baari chalti hai)
    // a11: record ke liye aakhri recN saaye bhi gine jate hain
    if not barstate.isrealtime and bar_index < last_bar_index - math.max(yKeep + 2, showRec ? recN + 1 : 0) * nD - 2
        yNext := bar_index + nD
    else
        array<int> yPk = f_near(array.size(aBI) - 1, key, kpA, kpB, kpC, kpD, kpE, 3)
        // a10: koi mauqa nahi = yNext wahi rahe, agli band candle par phir koshish
        if array.size(yPk) > 0
            yNext := bar_index + nD
            array.push(yJ, bar_index)
            array.push(yP0, sC)
            array.push(yN, array.size(yPk))
            string yTp = ""
            float  yEnd = 0.0
            int    yUp  = 0
            int    yDn  = 0
            for r = 0 to 2
                if r < array.size(yPk)
                    int   ci = array.get(yPk, r)
                    float c0 = array.get(aC, ci)
                    float ce = (array.get(aC, ci + nD) - c0) / c0 * 100
                    yEnd += ce
                    yUp  += ce > 0 ? 1 : 0
                    yDn  += ce < 0 ? 1 : 0
                    yTp += "\n#" + str.tostring(r + 1) + " " + str.format_time(array.get(aT, ci), "dd MMM yy HH:mm", syminfo.timezone) + " → " + f_pct((array.get(aC, ci + nD) - c0) / c0 * 100)
                    for k = 0 to nD
                        array.push(yPa, (array.get(aC, ci + k) - c0) / c0 * 100)
                else
                    for k = 0 to nD
                        array.push(yPa, 0.0)
            int  ySg = yEnd > 0 ? 1 : yEnd < 0 ? -1 : 0
            int  yNp = array.size(yPk)
            bool yEk = yNp >= 2 and (yUp == yNp or yDn == yNp)
            yTp += "\nLakeerein: " + (yEk ? "sab ek taraf" : "alag alag") + " · Kal 1D: " + (kal == 1 ? "hara" : kal == -1 ? "laal" : "-")
            array.push(yTip, yTp)
            if na(rFirst)
                rFirst  := bar_index
                rFirstT := time
            array.push(pJ, bar_index)
            array.push(pP0, sC)
            array.push(pSg, ySg)
            array.push(pEk, yEk)
            array.push(pK, kal)
            // aakhri yKeep purane + 1 chalta
            if array.size(yJ) > yKeep + 1
                array.shift(yJ)
                array.shift(yP0)
                array.shift(yN)
                array.shift(yTip)
                for k = 1 to yW
                    array.shift(yPa)

if barstate.islast
    // pichli dafa ka naqsha mitao (har tick par naya)
    int nBx = array.size(box.all)
    if nBx > 0
        for i = nBx - 1 to 0
            box.delete(array.get(box.all, i))
    int nLn = array.size(line.all)
    if nLn > 0
        for i = nLn - 1 to 0
            line.delete(array.get(line.all, i))
    int nLb = array.size(label.all)
    if nLb > 0
        for i = nLb - 1 to 0
            label.delete(array.get(label.all, i))
    int nPl = array.size(polyline.all)
    if nPl > 0
        for i = nPl - 1 to 0
            polyline.delete(array.get(polyline.all, i))
    qN   := 0
    qUp  := 0
    qTxt := not showMap ? "Qareebi mauqe: band (settings 4)" : not fOk ? "Qareebi mauqe: nishani tayyar nahi" : "Qareebi mauqe: nahi mile"
    int aSz = array.size(aBI)
    if showMap and fOk and aSz > nD
        // a8: aakhri BAND candle (arrays ki aakhri jagah) ki nishani - wahi nishani, jis ke baad nD candles poori
        array<int> pk = f_near(aSz - 1, fKey, fKpA, fKpB, fKpC, fKpD, fKpE, kTop)
        float sMv = 0.0
        float sFe = 0.0
        float sAe = 0.0
        int   rnk = 0
        for ci in pk
            rnk += 1
            int   j0 = array.get(aBI, ci)
            float c0 = array.get(aC, ci)
            float hi = c0
            float lo = c0
            for k = 1 to nD
                hi := math.max(hi, array.get(aH, ci + k))
                lo := math.min(lo, array.get(aL, ci + k))
            float mv = array.get(aC, ci + nD) - c0
            qN  += 1
            qUp += mv > 0 ? 1 : 0
            sMv += mv / c0 * 100
            sFe += (hi - c0) / c0 * 100
            sAe += (c0 - lo) / c0 * 100
            color cc = mv > 0 ? cUp : mv < 0 ? cDn : cGr
            string tip = str.format_time(array.get(aT, ci), "dd MMM yy HH:mm", syminfo.timezone) + " · faasla " + str.tostring(f_dist(ci, fKpA, fKpB, fKpC, fKpD, fKpE), "0.00") + "\n" + str.tostring(nD) + " candles baad close: " + (mv > 0 ? "+" : "") + str.tostring(mv, format.mintick) + "\nBeech mein max ooper +" + str.tostring(hi - c0, format.mintick) + " · max neeche -" + str.tostring(c0 - lo, format.mintick)
            int x0 = array.get(aT, ci)
            int x1 = array.get(aT, ci + nD)
            box.new(x0, hi, x1, lo, xloc = xloc.bar_time, border_color = color.new(cc, 40), bgcolor = color.new(cc, 88))
            line.new(x0, c0, x1, c0, xloc = xloc.bar_time, color = color.new(cc, 20), style = line.style_dotted)
            label.new(x0, hi, "#" + str.tostring(rnk) + (mv > 0 ? " ▲+" : mv < 0 ? " ▼" : " =") + str.tostring(mv, format.mintick), xloc = xloc.bar_time, style = label.style_label_down, color = color.new(cc, 15), textcolor = color.white, size = size.small, tooltip = tip)
            if showSR
                f_srDraw(j0, x1, c0)
            if showJT
                f_jtDraw(j0)
        // ABHI ka aage ka waqt, aakhri band candle se (chart TF x nD; weekend ka khana nahi ginta)
        int xNow = fT
        int xEnd = fT + nD * timeframe.in_seconds() * 1000
        if qN > 0
            qTxt := "Chart par qareebi " + str.tostring(qN) + " (" + str.tostring(nD) + " candles): " + str.tostring(qUp) + " ooper · " + str.tostring(qN - qUp) + " neeche · ausat " + f_pct(sMv / qN)
        // ABHI dabba: is nishani ke SAB mauqon ka ausat (table wala) - 10 ka nahi, mustaqil
        St sAb = nPick == "N 1" ? map.get(M1, fKey) : nPick == "N 3" ? map.get(M3, fKey) : map.get(M2, fKey)
        St bAb = nPick == "N 1" ? B1 : nPick == "N 3" ? B3 : B2
        if showNow and not na(sAb) and sAb.n > 0
            int   kA  = sAb.n
            float aMv = sAb.sm / kA
            float aFe = sAb.mfe / kA
            float aAe = sAb.mae / kA
            float vrA = kA > 1 ? (sAb.sq - kA * aMv * aMv) / (kA - 1) : na
            float seA = na(vrA) ? na : math.sqrt(math.max(vrA, 0) / kA)
            float dfA = bAb.n > 0 ? aMv - bAb.sm / bAb.n : na
            string nvA = kA < 30 or na(seA) or na(dfA) ? "kam data" : math.abs(dfA) > 2 * seA ? (dfA > 0 ? "✔ ooper" : "✔ neeche") : "shor"
            // rang sirf jab naap shor se bahar ho; warna saleti
            color cn = nvA == "✔ ooper" ? cUp : nvA == "✔ neeche" ? cDn : cGr
            box.new(xNow, fC * (1 + aFe / 100), xEnd, fC * (1 - aAe / 100), xloc = xloc.bar_time, border_color = color.new(cn, 30), bgcolor = color.new(cn, 90), border_style = line.style_dashed)
            line.new(xNow, fC, xEnd, fC * (1 + aMv / 100), xloc = xloc.bar_time, color = cn, width = 2, style = line.style_arrow_right)
            label.new(xEnd, fC * (1 + aMv / 100), "ABHI · " + str.tostring(kA) + " mauqon ka ausat " + f_pct(aMv) + " ≈" + f_px(aMv) + " · " + nvA, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(cn, 15), textcolor = color.white, size = size.small, tooltip = "Peshgoi NAHI. Pehle jab yahi nishani thi (" + str.tostring(kA) + " dafa), " + str.tostring(nD) + " candles mein ausat chal " + f_pct(aMv) + ", max ooper +" + str.tostring(aFe, "0.00") + "%, max neeche -" + str.tostring(aAe, "0.00") + "%. Naap '" + nvA + "' (table jaisa).")
        if showSR
            f_srDraw(fBI, xEnd, fC)
        if showJT
            f_jtDraw(fBI)
    // a10: koi saaya nahi chal raha (abhi tak ki band candles ki nishani ka koi purana mauqa nahi) - chhota saleti nishan
    if showSy and fOk and aSz > 0
        int  nY   = array.size(yJ)
        bool yRun = nY > 0 and array.get(yJ, nY - 1) + nD > fBI
        if not yRun
            label.new(fT + 2 * timeframe.in_seconds() * 1000, fC, "0 mauqe", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(cGr, 100), textcolor = cGr, size = size.tiny, tooltip = "SAAYA nahi: aakhri band candle ki nishani ka koi purana mauqa (jis ke baad " + str.tostring(nD) + " candles poori) history mein nahi. Har agli band candle par phir koshish.")
    // a8 SAAYA: har yaad saaye ke 3 raaste (asal candles ke waqt par; aage ka waqt chart TF se), N poori to ✔ / ✖
    if showSy and array.size(yJ) > 0 and aSz > 0
        int b0   = array.get(aBI, 0)
        int tL   = array.get(aT, aSz - 1)
        int tfMs = timeframe.in_seconds() * 1000
        for s = 0 to array.size(yJ) - 1
            int   i0 = array.get(yJ, s) - b0
            float p0 = array.get(yP0, s)
            int   nP = array.get(yN, s)
            if i0 >= 0
                float sEnd = 0.0
                for r = 0 to nP - 1
                    sEnd += array.get(yPa, s * yW + r * (nD + 1) + nD)
                float sAv = sEnd / nP
                color cS  = sAv > 0 ? cUp : sAv < 0 ? cDn : cGr
                for r = 0 to nP - 1
                    array<chart.point> pts = array.new<chart.point>()
                    for k = 0 to nD
                        int ix = i0 + k
                        int tx = ix <= aSz - 1 ? array.get(aT, ix) : tL + (ix - (aSz - 1)) * tfMs
                        array.push(pts, chart.point.from_time(tx, p0 * (1 + array.get(yPa, s * yW + r * (nD + 1) + k) / 100)))
                    // #1 sab se qareeb = gehri, #2 / #3 halki
                    polyline.new(pts, xloc = xloc.bar_time, line_color = color.new(cS, r == 0 ? 25 : 60), line_style = line.style_dotted, line_width = r == 0 ? 2 : 1)
                int    iE  = i0 + nD
                int    tE  = iE <= aSz - 1 ? array.get(aT, iE) : tL + (iE - (aSz - 1)) * tfMs
                string sTp = "SAAYA " + str.format_time(array.get(aT, math.min(i0, aSz - 1)), "dd MMM yy HH:mm", syminfo.timezone) + ": qareebi " + str.tostring(nP) + " mauqon ka raasta, " + str.tostring(nD) + " candles · ausat " + f_pct(sAv) + array.get(yTip, s)
                string sLb = ""
                color  sLc = cS
                if iE <= aSz - 1
                    float act = (array.get(aC, iE) - p0) / p0 * 100
                    bool  ok  = sAv != 0 and act != 0 and (act > 0) == (sAv > 0)
                    sLb := ok ? "✔" : "✖"
                    sLc := ok ? cOk : cNo
                    sTp := (ok ? "✔ SAAYE JAISA\n" : "✖ SAAYE JAISA NAHI\n") + sTp + "\nAsal " + str.tostring(nD) + " candles baad: " + f_pct(act) + (ok ? " - saaye ke rukh mein" : " - saaye ke ulat / barabar")
                else
                    sLb := str.tostring(aSz - 1 - i0) + "/" + str.tostring(nD)
                    sTp += "\nAbhi chal raha - " + str.tostring(nD) + " candles poori hon to ✔ / ✖."
                label.new(tE, p0 * (1 + sAv / 100), sLb, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(sLc, 20), textcolor = color.white, size = size.tiny, tooltip = sTp + "\nPeshgoi NAHI - sirf aankh se jaanch.")

// a13 AGLI: aage saaya candle + label, pichli candles par ✔ / ✖ (upar sab nishan mit chuke - naye yahan)
if barstate.islast and showAg and chartOk
    int   tfMsG = timeframe.in_seconds() * 1000
    // chalti candle = andaza isi ke liye (open maloom); band = agli ke liye (open ≈ abhi ka close)
    int   tG = chalti ? time : time + tfMsG
    float oG = chalti ? sO : sC
    int   nM = array.size(gmT)
    if agMk > 0 and nM > 0
        for i = math.max(0, nM - agMk) to nM - 1
            bool okM = array.get(gmOk, i)
            label.new(array.get(gmT, i), array.get(gmL, i), okM ? "✔" : "✖", xloc = xloc.bar_time, style = label.style_label_up, color = color.new(okM ? cOk : cNo, 30), textcolor = color.white, size = size.tiny, tooltip = array.get(gmTp, i))
    string agTp = "AGLI candle (a13) - peshgoi NAHI, sirf 'pehle aisa hua tha'. Milaap: " + agMode + "."
    if gPr == 0
        string why = not fOk ? "nishani tayyar nahi" : na(gBu) ? "ginti abhi shuru" : "is nishani ke sirf " + str.tostring(gK) + " mauqe (chahiye " + str.tostring(agMin) + ")"
        label.new(tG, math.max(sH, oG), "AGLI: andaza nahi", xloc = xloc.bar_time, style = label.style_label_lower_left, color = color.new(cGr, 100), textcolor = cGr, size = size.small, tooltip = agTp + "\n" + why)
    else
        color  cG  = gNl ? (gPr == 1 ? cUp : cDn) : cGr
        float  hG  = oG * (1 + gFe / 100)
        float  lG  = oG * (1 - gAe / 100)
        float  cGc = oG * (1 + gMv / 100)
        // saaya candle: wick = ausat high / low, body = ausat open -> close
        line.new(tG, lG, tG, hG, xloc = xloc.bar_time, color = color.new(cG, chalti ? 50 : 30), width = 1)
        line.new(tG, oG, tG, cGc == oG ? oG * 1.00001 : cGc, xloc = xloc.bar_time, color = color.new(cG, chalti ? 60 : 20), width = chalti ? 2 : 6)
        string pTx = (gPr == 1 ? "HARI " : "LAAL ") + str.tostring(gPr == 1 ? gP : 100 - gP, "0") + "%"
        string bTxG = (gBu >= 50 ? "HARI " : "LAAL ") + str.tostring(gBu >= 50 ? gBu : 100 - gBu, "0") + "%"
        agTp += "\nIs nishani ke " + str.tostring(gK) + " mauqon mein agli candle: hari " + str.tostring(gP, "0") + "%, laal " + str.tostring(100 - gP, "0") + "% (barabar nahi gini)." + "\nBunyaad (har candle ke baad agli): " + bTxG + "\nAusat: open se high " + f_hl(gFe) + ", low -" + str.tostring(gAe, "0.00") + "%, close " + f_hl(gMv) + "\n" + (gNl ? "Rang: farq bunyaad se 2SE se bara." : "Saleti: farq shor ke andar (sikka).")
        label.new(tG + tfMsG, hG, (chalti ? "ABHI chalti " : "AGLI ") + f_tfName(timeframe.period) + ": " + pTx + " · " + str.tostring(gK) + " mauqe · bunyaad " + bTxG + (gNl ? "" : " · shor"), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(cG, 15), textcolor = color.white, size = size.small, tooltip = agTp)

// ek N ka kalam (column): is nishani ka nateeja vs har candle (bunyaad)
f_col(int _c, simple int _n, St _s, St _b) =>
    f_cell(_c, 8, str.tostring(_n) + " (" + f_dur(_n * timeframe.in_seconds()) + ")", cTxt, cHd, "Agli " + str.tostring(_n) + " chart candles.")
    int _k = na(_s) ? 0 : _s.n
    float _bu = _b.n > 0 ? 100.0 * _b.up / _b.n : na
    float _bm = _b.n > 0 ? _b.sm / _b.n : na
    f_cell(_c, 9, str.tostring(_k), _k >= 30 ? cTxt : cDn, color.white, _k >= 30 ? "Itne mauqe jin ka nateeja aa chuka (do mauqon mein kam az kam N candles ka faasla). Lambi chal mein kai mauqe ho sakte hain - abhi wali chal ke band hisse bhi shamil." : "30 se kam - ginti par bharosa nahi.")
    f_cell(_c, 11, na(_bu) ? "-" : str.tostring(_bu, "0") + "%", cGr, color.white, "Bunyaad: HAR candle (" + str.tostring(_b.n) + ") ke baad kitne % ooper.")
    f_cell(_c, 13, na(_bm) ? "-" : f_pct(_bm) + " ≈" + f_px(_bm), cGr, color.white, "Bunyaad: HAR candle ke baad ausat chal (bazaar ki apni tezi / mandi).")
    if _k == 0
        for _r in array.from(10, 12, 14, 15, 16, 17)
            f_cell(_c, _r, "-", cGr, color.white, "")
    else
        float _up = 100.0 * _s.up / _k
        float _mn = _s.sm / _k
        float _vr = _k > 1 ? (_s.sq - _k * _mn * _mn) / (_k - 1) : na
        float _se = na(_vr) ? na : math.sqrt(math.max(_vr, 0) / _k)
        // rang sirf jab farq shor (2SE) se bara ho aur 30+ dafa
        float _pe = na(_bu) ? na : 2 * math.sqrt(_bu * (100 - _bu) / _k)
        color _uc = _k < 30 or na(_pe) ? cTxt : _up > _bu + _pe ? cUp : _up < _bu - _pe ? cDn : cTxt
        f_cell(_c, 10, str.tostring(_up, "0") + "%", _uc, color.white, "Is nishani ke baad " + str.tostring(_s.up) + " / " + str.tostring(_k) + " dafa close ooper. Rang sirf jab bunyaad se farq shor se bara (30+ dafa).")
        f_cell(_c, 12, f_pct(_mn) + " ≈" + f_px(_mn), _mn > 0 ? cUp : _mn < 0 ? cDn : cTxt, color.white, "Ausat chal: % mein, aur ≈ daam abhi ke bhaav par.")
        f_cell(_c, 14, na(_se) ? "-" : "±" + str.tostring(2 * _se, "0.00") + "%", cGr, color.white, "2 standard error: ausat itna shor se hil sakta hai.")
        float _df = na(_bm) ? na : _mn - _bm
        string _nv = _k < 30 or na(_se) or na(_df) ? "kam data" : math.abs(_df) > 2 * _se ? (_df > 0 ? "✔ ooper" : "✔ neeche") : "shor"
        color  _nc = _nv == "✔ ooper" ? cUp : _nv == "✔ neeche" ? cDn : cGr
        f_cell(_c, 15, _nv, _nc, color.white, "Nishani ka ausat - bunyaad ka ausat > 2SE aur 30+ dafa = shor se bahar. Phir bhi FAISLA NAHI - pehle TALAASH / IMTIHAN.")
        f_cell(_c, 16, "+" + str.tostring(_s.mfe / _k, "0.00") + "% ≈" + f_px(_s.mfe / _k), cUp, color.white, "N candles ke andar ausat sab se zyada ooper (high), entry close se.")
        f_cell(_c, 17, "-" + str.tostring(_s.mae / _k, "0.00") + "% ≈" + f_px(_s.mae / _k), cDn, color.white, "N candles ke andar ausat sab se zyada neeche (low), entry close se.")

if barstate.islast and not showTbl
    table.clear(TB, 0, 0, 3, 19)
if barstate.islast and showTbl
    table.clear(TB, 0, 0, 3, 19)
    f_cell(0, 0, "JAS AAINA · " + BUILD, cTxt, cHd, "Abhi wali nishani history mein - aage kya hua. Sirf naap - faisla nahi.")
    table.merge_cells(TB, 0, 0, 3, 0)
    f_now(1, tfA, inA, okA, fRgA, fKpA)
    f_now(2, tfB, inB, okB, fRgB, fKpB)
    f_now(3, tfC, inC, okC, fRgC, fKpC)
    f_now(4, tfD, inD, okD, fRgD, fKpD)
    f_now(5, tfE, inE, okE, fRgE, fKpE)
    // abhi wali chal pehle hi gini ja chuki (band bazaar / candle band) to us ko nikalo
    bool inRun = fOk and map.get(LAST, fKey) == fRunT
    int nSeen  = nz(map.get(SEEN, fKey)) - (inRun ? 1 : 0)
    int tLast  = inRun ? map.get(PREV, fKey) : map.get(LAST, fKey)
    string sInfo = not chartOk ? "Sirf Candles / Heikin Ashi chart par" : not fOk ? "Nishani abhi tayyar nahi" : "Pehle " + str.tostring(nSeen) + " chal" + (na(tLast) ? "" : " · aakhri " + str.format_time(tLast, "dd MMM yy HH:mm", syminfo.timezone)) + " · abhi " + str.tostring(fBI - fRunB + 1) + " candles se (band candle)"
    f_cell(0, 6, sInfo, not chartOk ? cDn : cTxt, color.white, "Milaap: " + mode + ". Ek chal = nishani shuru se badalne tak. Abhi wali chal is ginti mein nahi.")
    table.merge_cells(TB, 0, 6, 3, 6)
    f_cell(0, 7, "AAGE KYA HUA (" + mode + ")", cTxt, cHd, "")
    table.merge_cells(TB, 0, 7, 3, 7)
    f_cell(0, 8, "Agli candles", cTxt, cHd, "")
    string[] lb = array.from("Kitni dafa", "% ooper", "Har candle", "Ausat chal", "Har candle", "Shor ±2SE", "Naap", "Max ooper", "Max neeche")
    for i = 0 to 8
        f_cell(0, 9 + i, array.get(lb, i), i == 2 or i == 4 ? cGr : cTxt, color.white, i == 2 or i == 4 ? "Bunyaad - upar wali qatar ka muqabla." : "")
    f_col(1, n1, fOk ? map.get(M1, fKey) : na, B1)
    f_col(2, n2, fOk ? map.get(M2, fKey) : na, B2)
    f_col(3, n3, fOk ? map.get(M3, fKey) : na, B3)
    f_cell(0, 18, qTxt, qN == 0 ? cGr : qUp * 2 > qN ? cUp : qUp * 2 < qN ? cDn : cTxt, color.white, "Chart par dikhaye gaye sab se qareebi mauqe (Lorentzian faasla). Kam ginti - sirf aankh ke liye; naap upar wali qataron mein.")
    table.merge_cells(TB, 0, 18, 3, 18)
    f_cell(0, 19, "Data: " + (na(firstT) ? "-" : str.format_time(firstT, "dd MMM yy", syminfo.timezone)) + " se · " + str.tostring(nBars) + " candles · sirf naap, faisla nahi", cGr, color.white, "Chart par jitni history load hai, utni hi ginti. Trade se pehle koshish #23 qaida (TALAASH / IMTIHAN).")
    table.merge_cells(TB, 0, 19, 3, 19)

// ============================================================================
//  a11 SAAYA RECORD — aakhri saayon ka ✔ / ✖ jod (sirf naap, faisla nahi)
// ============================================================================
var table RT = table.new(f_pos(recPos), 5, 12, border_width = 1, border_color = color.new(#CFD8DC, tblClear ? 75 : 0))

f_rc(int _col, int _row, string _t, color _fg, color _bg, string _tip) =>
    table.cell(RT, _col, _row, _t, text_color = f_tc(_fg), bgcolor = f_bg(_bg), text_size = f_size(tblSize), text_halign = text.align_left, tooltip = _tip)

// a13 AGLI qatar: aaina ✔ / ✖ vs bunyaad (wahi candles)
f_agRow(int _r, string _nm, string _tp, int _ok, int _no, int _bok, int _bno) =>
    int   _n  = _ok + _no
    float _p  = _n > 0 ? 100.0 * _ok / _n : na
    float _bs = _bok + _bno > 0 ? 100.0 * _bok / (_bok + _bno) : na
    float _hd = na(_bs) or _n == 0 ? na : 200 * math.sqrt(math.max(_bs / 100 * (1 - _bs / 100), 0) / _n)
    color _pc = na(_p) or na(_bs) or _n < 30 ? cGr : _p > _bs + _hd ? cOk : _p < _bs - _hd ? cNo : cTxt
    f_rc(0, _r, _nm, cTxt, color.white, _tp)
    f_rc(1, _r, str.tostring(_ok), cTxt, color.white, "")
    f_rc(2, _r, str.tostring(_no), cTxt, color.white, "")
    f_rc(3, _r, na(_p) ? "-" : str.tostring(_p, "0") + "%", _pc, color.white, _n < 30 ? "30 se kam - bharosa nahi." : "Neela = bunyaad se behtar, narangi = bunyaad se bura, siyah = shor. Shor hadd ±" + str.tostring(_hd, "0") + "%.")
    f_rc(4, _r, na(_bs) ? "-" : str.tostring(_bs, "0") + "%", cGr, color.white, "Bunyaad: inhi candles par aankh band kar ke hamesha wohi rang jo ab tak zyada bana.")

if barstate.islast
    table.clear(RT, 0, 0, 4, 11)
    if showRec and showAg
        string agFr = na(agFirstT) ? "" : " (" + str.format_time(agFirstT, "dd MMM yy", syminfo.timezone) + " se)"
        f_agRow(9, "AGLI candle: sab", "a13: har band candle par agli candle ka andaza (hari / laal)" + agFr + ". Barabar candle gini nahi.", agOk, agNo, agBOk, agBNo)
        f_agRow(10, "AGLI: sirf rang wale", "a13: sirf wo andaze jin mein nishani ka hari % bunyaad se 2SE door tha (chart par rangeen saaya candle).", nlOk, nlNo, nlBOk, nlBNo)
    if showRec and (showSy or showAg)
        f_rc(0, 1, showSy ? "Saaya" : "Andaza", cTxt, cHd, "")
        f_rc(1, 1, "✔", cOk, cHd, "Saaye / andaze ke rukh mein")
        f_rc(2, 1, "✖", cNo, cHd, "Saaye / andaze ke ulat / barabar")
        f_rc(3, 1, "%", cTxt, cHd, "✔ ka hissa.")
        f_rc(0, 11, "Neela sirf jab bunyaad se behtar · sirf naap, faisla nahi (koshish #23 qaida)", cGr, color.white, "Rang sirf 30+ saaye aur farq 2SE se bara. Trade se pehle TALAASH / IMTIHAN (TRADING.md sec 4).")
        table.merge_cells(RT, 0, 11, 4, 11)
        if not showSy
            f_rc(0, 0, "RECORD · AGLI candle (a13)", cTxt, cHd, "Saaya (Settings 4) band - sirf AGLI candle ki qataren.")
            table.merge_cells(RT, 0, 0, 4, 0)
            f_rc(4, 1, "Bunyaad", cGr, cHd, "Aankh band kar ke hamesha wohi rang jo ab tak zyada bana.")
    if showRec and showSy
        float qU = bN > 0 ? 100.0 * bUp / bN : na
        float qD = bN > 0 ? 100.0 * bDn / bN : na
        string bTx = bN > 0 ? "Isi muddat mein har candle (" + str.tostring(bN) + ") ke " + str.tostring(nD) + " candles baad: ooper " + str.tostring(qU, "0") + "%, neeche " + str.tostring(qD, "0") + "%." : "Bunyaad abhi tayyar nahi."
        f_rc(0, 0, "SAAYA RECORD · aakhri " + str.tostring(rSeen) + " saaye · N " + str.tostring(nD) + (na(rFirstT) ? "" : " · " + str.format_time(rFirstT, "dd MMM yy", syminfo.timezone) + " se"), cTxt, cHd, "Har saaya: N candles baad asal close saaye ke rukh mein = ✔, warna ✖. Har saaya sirf apne waqt tak ki band candles se bana.")
        table.merge_cells(RT, 0, 0, 4, 0)
        f_rc(4, 1, "Bunyaad", cGr, cHd, "Aankh band kar ke har candle par wahi rukh kehte (hare saaye = ooper, laal = neeche) to isi muddat mein kitna % sahi hota. " + bTx)
        string[] rl = array.from("Sab saaye", "Lakeerein ek taraf", "Lakeerein alag", "Kal 1D saaye jaisa", "Kal 1D ulat", "Hara saaya (ooper)", "Laal saaya (neeche)")
        string[] rt = array.from("Har saaya.", "Teeno (ya do) lakeerein ek hi taraf khatam hui thin - purane mauqe mutafiq.", "Gehri aur halki lakeerein alag taraf - purane mauqon mein ikhtilaf.", "Kal ki BAND 1D candle ka rang saaye ke rukh jaisa (hari + hara saaya / laal + laal).", "Kal ki BAND 1D candle saaye ke ulat rang ki.", "Sirf hare saaye (ausat ooper). Bunyaad = isi muddat mein kitni candles ke baad ooper.", "Sirf laal saaye (ausat neeche). Bunyaad = isi muddat mein kitni candles ke baad neeche.")
        for i = 0 to 6
            int   ok = array.get(rOk, i)
            int   no = array.get(rNo, i)
            int   n  = ok + no
            float p  = n > 0 ? 100.0 * ok / n : na
            // bunyaad: is qatar ke hare / laal saayon jitni dafa aankh band kar ke wahi rukh
            float bs = n > 0 and bN > 0 ? (array.get(rH, i) * qU + array.get(rL, i) * qD) / n : na
            // shor: bunyaad se 2SE se zyada farq aur 30+ saaye
            float hd = na(bs) or n == 0 ? na : 200 * math.sqrt(math.max(bs / 100 * (1 - bs / 100), 0) / n)
            color pc = na(p) or na(bs) or n < 30 ? cGr : p > bs + hd ? cOk : p < bs - hd ? cNo : cTxt
            f_rc(0, 2 + i, array.get(rl, i), cTxt, color.white, array.get(rt, i))
            f_rc(1, 2 + i, str.tostring(ok), cTxt, color.white, "")
            f_rc(2, 2 + i, str.tostring(no), cTxt, color.white, "")
            f_rc(3, 2 + i, na(p) ? "-" : str.tostring(p, "0") + "%", pc, color.white, n < 30 ? "30 se kam - bharosa nahi." : "Neela = bunyaad se behtar, narangi = bunyaad se bura, siyah = shor. Shor hadd ±" + str.tostring(hd, "0") + "%.")
            f_rc(4, 2 + i, na(bs) ? "-" : str.tostring(bs, "0") + "%", cGr, color.white, bTx)
