//@version=5
// ============================================================================
//  JAS PRO BOX — Claude Code ka tohfa (2 Oct 2026)
//
//  Ye script TRADE NAHI karta. Sirf dekhne aur seekhne ke liye hai.
//  Teen mashhoor tareeqe saath saath chalte hain. Har ek ka apna ishara,
//  apna TradingView jaisa dabba, aur apni ALAG ginti hoti hai, taake
//  mahinon ki observation ke baad khud nazar aaye ke kaun sa kaam karta hai.
//
//   A · MA      : rukh MA21 > MA63 (BUY) ya MA21 < MA63 (SELL). Price wapas
//                 MA21 ko chhu kar rukh ki taraf candle band kare (pullback).
//   B · Candle  : pichhle swing low (support) par bullish engulfing ya pin bar
//                 (lambi neeche wali wick). SELL: swing high par ulta.
//   C · SMC     : pehle swing low toot kar close wapas upar (liquidity sweep),
//                 phir pichhla swing high close se toote (CHOCH), phir price
//                 wapas FVG mein aa kar upar band ho. SELL: bilkul ulta.
//
//  ITTIFAQ (default ON): chart par sirf EK dabba - jab naya ishara aaye aur
//  kam az kam ek aur tareeqa pehle se usi taraf khula ho, aur koi ulta na ho.
//  Table ki pehli line seedhi zabaan mein batati hai: ABHI kya karna hai.
//
//  Teeno par ek pro filter: bare TF (default 1H) ki BAND candle ki MA21/MA63
//  jis taraf ho, sirf usi taraf ka ishara. Ishara sirf BAND candle par.
//
//  Har trade: SL swing ke peeche + ATR buffer (0.5 - 3.5 ATR ke beech),
//  TP1 = 1R (aadhi band, SL entry par), TP2 = 2R (baqi band),
//  64 candle mein kuch na ho to khud band. Har tareeqe ki ek waqt mein ek trade.
//  Laal dabba = Entry se SL, hara dabba = Entry se TP2. Sirf KHULI trade dikhti hai.
//
//  Lot: cent (USC) aur standard (USD) dono mein 0.01 lot par gold $1 hile to
//  1 USC / $1. Is liye lot = risk ki raqam / (SL ka faasla $ x 100).
//
//  Table ki ginti chart ki history se hai. 20 trades se kam ho to bharosa
//  nahi. Pehle mahinon ki observation, phir demo, phir faisla.
// ============================================================================
indicator("JAS Pro Box (Claude Code)", shorttitle = "JAS Pro Box", overlay = true,
     max_boxes_count = 50, max_lines_count = 100, max_labels_count = 100)

// ============================================================================
//  INPUTS
// ============================================================================
gM   = "1 · Tareeqe"
useA    = input.bool(true, "A · MA pullback (MA21 / MA63)", group = gM)
useB    = input.bool(true, "B · Candle (swing par engulfing / pin bar)", group = gM)
useC    = input.bool(true, "C · SMC (sweep → CHOCH → FVG)", group = gM)
ittOn   = input.bool(true, "ITTIFAQ: sirf jab 2-3 tareeqe EK taraf hon (asaan, sirf ek dabba)", group = gM)
showBox = input.string("Sab", "Ittifaq band ho to: kis tareeqe ka dabba", options = ["Sab", "A", "B", "C"], group = gM)

gF   = "2 · Pro filter"
useHTF  = input.bool(true, "Sirf bare TF ke rukh mein (MA21 vs MA63)", group = gF)
htfIn   = input.string("Auto", "Bara TF (Auto = chart ke hisaab se khud)", options = ["Auto", "15", "60", "240", "D", "W"], group = gF)
maFLen  = input.int(21, "MA fast", minval = 2, group = gF)
maSLen  = input.int(63, "MA slow", minval = 3, group = gF)
pivLen  = input.int(3, "Swing: dono taraf kitni candles", minval = 1, maxval = 10, group = gF)

gR   = "3 · SL / TP"
swLook  = input.int(10, "SL: kitni candles ka swing", minval = 3, maxval = 50, group = gR)
slBuf   = input.float(0.2, "SL buffer (x ATR)", minval = 0, step = 0.05, group = gR)
slMin   = input.float(0.5, "SL kam az kam (x ATR)", minval = 0.2, step = 0.1, group = gR)
slMax   = input.float(3.5, "SL zyada se zyada (x ATR)", minval = 0.5, step = 0.1, group = gR)
tp1R    = input.float(1.0, "TP1 (R) - aadhi band + BE", minval = 0.3, step = 0.1, group = gR)
tp2R    = input.float(2.0, "TP2 (R)", minval = 0.5, step = 0.1, group = gR)
spreadU = input.float(0.30, "Spread + kharcha fi trade ($) - nateeje se kat-ta hai", minval = 0, step = 0.05, group = gR)
maxBars = input.int(64, "N candle baad khud band (0 = kabhi nahi)", minval = 0, group = gR)
coolBar = input.int(5, "Trade band hone ke baad kitni candle ruko", minval = 0, group = gR)

gL   = "4 · Lot ka hisaab"
acct    = input.float(50000, "Balance", minval = 1, group = gL)
acctCur = input.string("USC", "Currency", options = ["USC", "USD"], group = gL)
riskPct = input.float(1.0, "Risk fi trade (%)", minval = 0.1, maxval = 5, step = 0.1, group = gL)

gP   = "5 · Dikhawa"
topPad  = input.int(2, "Table upar se kitni khali rows (TradingView ki likhai ke neeche)", minval = 0, maxval = 8, group = gP)
tblPos  = input.string("Top Right", "Table ki jagah", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = gP)
fontSz  = input.string("Small", "Font", options = ["Tiny", "Small", "Normal", "Large"], group = gP)
tzLbl   = input.string("Asia/Karachi", "Waqt kis zone mein", group = gP)
futBars = input.int(8, "Dabba aage kitni candle tak", minval = 1, maxval = 50, group = gP)
showMA  = input.bool(true, "MA21 / MA63 dikhao", group = gP)

// ============================================================================
//  HELPERS
// ============================================================================
f_px(x) => str.tostring(x, format.mintick)
f_pos(s) => s == "Top Left" ? position.top_left : s == "Top Right" ? position.top_right : s == "Bottom Left" ? position.bottom_left : position.bottom_right
f_size(s) => s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Normal" ? size.normal : size.large
FS = f_size(fontSz)
f_dir(_d) => _d == 1 ? "BUY" : "SELL"
f_r(_v) => (_v > 0 ? "+" : "") + str.tostring(_v, "#.##") + "R"
// Ittifaq trade (jagah 3) kin tareeqon ki ek raye se khuli: "A+C" waghera
var string ittWho = ""
f_nm(_k) => _k == 0 ? "A · MA" : _k == 1 ? "B · Candle" : _k == 2 ? "C · SMC" : "ITTIFAQ (" + ittWho + ")"
// Ittifaq on: chart par SIRF ittifaq ka dabba. Off: purana tareeqa.
f_show(_k) => ittOn ? _k == 3 : (_k < 3 and (showBox == "Sab" or (showBox == "A" and _k == 0) or (showBox == "B" and _k == 1) or (showBox == "C" and _k == 2)))

atr  = ta.atr(14)
emaF = ta.ema(close, maFLen)
emaS = ta.ema(close, maSLen)
plot(showMA ? emaF : na, "MA21", color = color.new(color.aqua, 0), linewidth = 2)
plot(showMA ? emaS : na, "MA63", color = color.new(color.fuchsia, 0), linewidth = 2)

// Bare TF ka rukh: aakhri BAND candle ([1] + lookahead_on = repaint nahi)
// Auto: bara TF chart se kam az kam 4 guna bara (2H/4H chart par 1H "bara" nahi hota)
_cs = timeframe.in_seconds()
htfTF = htfIn != "Auto" ? htfIn : _cs <= 60 ? "15" : _cs <= 900 ? "60" : _cs <= 3600 ? "240" : _cs <= 14400 ? "D" : _cs <= 86400 ? "W" : "M"
f_tfName(_t) => _t == "15" ? "15m" : _t == "60" ? "1H" : _t == "240" ? "4H" : _t == "D" ? "1D" : _t == "W" ? "1W" : _t == "M" ? "1M" : _t
htfName = f_tfName(htfTF)
[hF, hS] = request.security(syminfo.tickerid, htfTF, [ta.ema(close, maFLen)[1], ta.ema(close, maSLen)[1]], barmerge.gaps_off, barmerge.lookahead_on)
htfUp = not useHTF or (not na(hF) and hF > hS)
htfDn = not useHTF or (not na(hF) and hF < hS)

// Pakke swing (pivot): pivLen candles baad pakka hota hai
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
var float lastHi = na
var float lastLo = na
if not na(ph)
    lastHi := ph
if not na(pl)
    lastLo := pl

conf = barstate.isconfirmed

// ============================================================================
//  A · MA PULLBACK
// ============================================================================
aBuy  = emaF > emaS and emaF > emaF[3] and low <= emaF + atr * 0.1 and close > emaF and close > open and close[1] > emaS
aSell = emaF < emaS and emaF < emaF[3] and high >= emaF - atr * 0.1 and close < emaF and close < open and close[1] < emaS

// ============================================================================
//  B · CANDLE PATTERN SWING PAR
// ============================================================================
cRng  = math.max(high - low, syminfo.mintick)
cBody = math.abs(close - open)
loWk  = math.min(open, close) - low
upWk  = high - math.max(open, close)
bullEng = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bearEng = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
bullPin = loWk >= 2 * cBody and loWk >= 0.55 * cRng and close >= low + 0.5 * cRng
bearPin = upWk >= 2 * cBody and upWk >= 0.55 * cRng and close <= high - 0.5 * cRng
nearSup = not na(lastLo) and low <= lastLo + atr * 0.5 and low >= lastLo - atr * 1.0
nearRes = not na(lastHi) and high >= lastHi - atr * 0.5 and high <= lastHi + atr * 1.0
bBuy  = nearSup and (bullEng or bullPin)
bSell = nearRes and (bearEng or bearPin)

// ============================================================================
//  C · SMC: sweep → CHOCH → FVG retest
//  BUY ki tayyari (u*) aur SELL ki tayyari (d*) alag alag chalti hai.
// ============================================================================
var int   uSwB = na   // sweep wali candle
var float uSwL = na   // sweep ka low (SL isi ke neeche)
var int   uChB = na   // CHOCH wali candle
var float uFT  = na   // FVG ka upar wala kinara
var float uFB  = na   // FVG ka neeche wala kinara
var int   dSwB = na
var float dSwH = na
var int   dChB = na
var float dFT  = na
var float dFB  = na

// Naya sweep = nayi tayyari (purani mit jati hai)
if not na(lastLo) and low < lastLo and close > lastLo
    uSwB := bar_index
    uSwL := low
    uChB := na
    uFT  := na
    uFB  := na
if not na(lastHi) and high > lastHi and close < lastHi
    dSwB := bar_index
    dSwH := high
    dChB := na
    dFT  := na
    dFB  := na

// Sweep ke baad bana FVG yaad rakho; phir CHOCH ka intezar
if not na(uSwB) and bar_index > uSwB
    if low > high[2]
        uFT := low
        uFB := high[2]
    if na(uChB) and not na(lastHi) and close > lastHi
        uChB := bar_index
if not na(dSwB) and bar_index > dSwB
    if high < low[2]
        dFT := low[2]
        dFB := high
    if na(dChB) and not na(lastLo) and close < lastLo
        dChB := bar_index

// Tayyari ki umar: sweep ke 30 candle mein CHOCH, CHOCH ke 20 candle mein entry.
// ">=" zaroori hai: sweep wali candle ka low khud uSwL hai. Pehle ">" tha, is
// liye tayyari usi candle par mar jati thi aur C ki ginti hamesha 0 rehti thi.
uAlive = not na(uSwB) and (na(uChB) ? bar_index - uSwB <= 30 : bar_index - uChB <= 20) and low >= uSwL
dAlive = not na(dSwB) and (na(dChB) ? bar_index - dSwB <= 30 : bar_index - dChB <= 20) and high <= dSwH

cBuy  = uAlive and not na(uChB) and bar_index > uChB and not na(uFT) and low <= uFT and close >= uFB and close > open
cSell = dAlive and not na(dChB) and bar_index > dChB and not na(dFB) and high >= dFB and close <= dFT and close < open

if not na(uSwB) and not uAlive
    uSwB := na
if not na(dSwB) and not dAlive
    dSwB := na

// ============================================================================
//  SL (swing + buffer, hadd ke andar)
// ============================================================================
slB  = math.max(math.min(ta.lowest(low, swLook) - atr * slBuf, close - atr * slMin), close - atr * slMax)
slS  = math.min(math.max(ta.highest(high, swLook) + atr * slBuf, close + atr * slMin), close + atr * slMax)
// SMC ka SL sweep ke peeche; bohot door ho to trade nahi
slCB = math.min(nz(uSwL, low) - atr * slBuf, close - atr * slMin)
slCS = math.max(nz(dSwH, high) + atr * slBuf, close + atr * slMin)
cBOk = close - slCB <= atr * slMax
cSOk = slCS - close <= atr * slMax

// ============================================================================
//  TRADE ENGINE — har tareeqa (0 = A, 1 = B, 2 = C) apni jagah par
// ============================================================================
var int[]   tDir = array.from(0, 0, 0, 0)
var float[] tE   = array.new_float(4, na)
var float[] tSL  = array.new_float(4, na)
var float[] tR   = array.new_float(4, na)
var float[] tT1  = array.new_float(4, na)
var float[] tT2  = array.new_float(4, na)
var int[]   tBar = array.from(0, 0, 0, 0)
var bool[]  tH1  = array.from(false, false, false, false)
var int[]   tEnd = array.from(-100000, -100000, -100000, -100000)
var int[]   sN   = array.from(0, 0, 0, 0)
var int[]   sW   = array.from(0, 0, 0, 0)
var float[] sR   = array.from(0.0, 0.0, 0.0, 0.0)

var box[]   dbR = array.new_box(4)
var box[]   dbG = array.new_box(4)
var line[]  dlE = array.new_line(4)
var line[]  dlS = array.new_line(4)
var line[]  dl1 = array.new_line(4)
var line[]  dl2 = array.new_line(4)
var label[] dgE = array.new_label(4)
var label[] dgS = array.new_label(4)
var label[] dg1 = array.new_label(4)
var label[] dg2 = array.new_label(4)
var label[] dgM = array.new_label(4)

f_del(_k) =>
    box.delete(array.get(dbR, _k))
    box.delete(array.get(dbG, _k))
    line.delete(array.get(dlE, _k))
    line.delete(array.get(dlS, _k))
    line.delete(array.get(dl1, _k))
    line.delete(array.get(dl2, _k))
    label.delete(array.get(dgE, _k))
    label.delete(array.get(dgS, _k))
    label.delete(array.get(dg1, _k))
    label.delete(array.get(dg2, _k))
    label.delete(array.get(dgM, _k))
    true

// Qeemat ka saaf dabba: rangeen pas-manzar, safed likhai
f_tag(_x, _y, _t, _c) =>
    label.new(_x, _y, _t, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left,
         color = _c, textcolor = color.white, size = size.normal)

f_lot(_dist) =>
    _amt = acct * riskPct / 100.0
    _raw = _dist > 0 ? _amt / (_dist * 100.0) : 0.0
    math.max(0.01, math.floor(_raw * 100.0) / 100.0)

f_open(_k, _d, _sl) =>
    _e  = close
    _r  = math.abs(_e - _sl)
    _t1 = _e + _d * _r * tp1R
    _t2 = _e + _d * _r * tp2R
    array.set(tDir, _k, _d)
    array.set(tE,   _k, _e)
    array.set(tSL,  _k, _sl)
    array.set(tR,   _k, _r)
    array.set(tT1,  _k, _t1)
    array.set(tT2,  _k, _t2)
    array.set(tBar, _k, bar_index)
    array.set(tH1,  _k, false)
    f_del(_k)
    if f_show(_k)
        _x2  = bar_index + futBars
        _lot = f_lot(_r)
        _cM  = _d == 1 ? color.teal : color.purple
        array.set(dbR, _k, box.new(bar_index, _e, _x2, _sl, xloc = xloc.bar_index, bgcolor = color.new(color.red, 85), border_color = color.new(color.red, 100)))
        array.set(dbG, _k, box.new(bar_index, _e, _x2, _t2, xloc = xloc.bar_index, bgcolor = color.new(color.green, 85), border_color = color.new(color.green, 100)))
        array.set(dlE, _k, line.new(bar_index, _e,  _x2, _e,  color = color.new(color.blue, 0), width = 2))
        array.set(dlS, _k, line.new(bar_index, _sl, _x2, _sl, color = color.new(color.red, 0), width = 2, style = line.style_dashed))
        array.set(dl1, _k, line.new(bar_index, _t1, _x2, _t1, color = color.new(#2E7D32, 0), width = 2))
        array.set(dl2, _k, line.new(bar_index, _t2, _x2, _t2, color = color.new(#1B5E20, 0), width = 2, style = line.style_dotted))
        array.set(dgE, _k, f_tag(_x2, _e,  "Entry " + f_px(_e), color.new(color.blue, 0)))
        array.set(dgS, _k, f_tag(_x2, _sl, "SL " + f_px(_sl), color.new(color.red, 0)))
        array.set(dg1, _k, f_tag(_x2, _t1, "TP1 " + f_px(_t1) + "  (aadhi band)", color.new(#2E7D32, 0)))
        array.set(dg2, _k, f_tag(_x2, _t2, "TP2 " + f_px(_t2), color.new(#1B5E20, 0)))
        array.set(dgM, _k, label.new(bar_index, _d == 1 ? low : high,
             f_nm(_k) + " " + f_dir(_d) + "\n" + str.format_time(time, "dd MMM HH:mm", tzLbl) + "  @ " + f_px(_e) +
             "\n" + htfName + " rukh: " + (na(hF) ? "-" : hF > hS ? "UP" : "DN") + "   Lot " + str.tostring(_lot, "#.##") + "  (risk " + str.tostring(riskPct, "#.#") + "% = " + str.tostring(acct * riskPct / 100.0, "#") + " " + acctCur + ")",
             xloc = xloc.bar_index, yloc = yloc.price, style = _d == 1 ? label.style_label_up : label.style_label_down,
             color = color.new(_cM, 0), textcolor = color.white, size = size.normal))
    alert(f_nm(_k) + " " + f_dir(_d) + " " + syminfo.ticker + " | Entry " + f_px(_e) + " | SL " + f_px(_sl) +
          " | TP1 " + f_px(_t1) + " | TP2 " + f_px(_t2), alert.freq_once_per_bar_close)
    true

f_manage(_k) =>
    _d = array.get(tDir, _k)
    if _d != 0
        _e   = array.get(tE, _k)
        _sl  = array.get(tSL, _k)
        _r   = array.get(tR, _k)
        _t1  = array.get(tT1, _k)
        _t2  = array.get(tT2, _k)
        _h1  = array.get(tH1, _k)
        float _res = na
        if (_d == 1 and low <= _sl) or (_d == -1 and high >= _sl)
            _res := _h1 ? 0.5 * tp1R : -1.0
        else
            if not _h1 and ((_d == 1 and high >= _t1) or (_d == -1 and low <= _t1))
                _h1 := true
                array.set(tH1, _k, true)
                array.set(tSL, _k, _e)
                if f_show(_k)
                    line.set_y1(array.get(dlS, _k), _e)
                    line.set_y2(array.get(dlS, _k), _e)
                    label.set_y(array.get(dgS, _k), _e)
                    label.set_text(array.get(dgS, _k), "SL ab Entry par (BE) " + f_px(_e))
                    label.set_text(array.get(dg1, _k), "TP1 " + f_px(_t1) + " ✓")
            if (_d == 1 and high >= _t2) or (_d == -1 and low <= _t2)
                _res := 0.5 * tp1R + 0.5 * tp2R
        if na(_res) and maxBars > 0 and bar_index - array.get(tBar, _k) >= maxBars
            _o = _d * (close - _e) / _r
            _res := _h1 ? 0.5 * tp1R + 0.5 * _o : _o
        if not na(_res)
            // Spread / kharcha: har trade ke nateeje se kato (R mein)
            _res := _res - spreadU / _r
            array.set(sN, _k, array.get(sN, _k) + 1)
            array.set(sW, _k, array.get(sW, _k) + (_res > 0 ? 1 : 0))
            array.set(sR, _k, array.get(sR, _k) + _res)
            array.set(tDir, _k, 0)
            array.set(tEnd, _k, bar_index)
            f_del(_k)
    true

// Pehle khuli trades sambhalo, phir naye ishare
f_manage(0)
f_manage(1)
f_manage(2)
f_manage(3)

f_free(_k) => array.get(tDir, _k) == 0 and bar_index - array.get(tEnd, _k) >= coolBar

goAB = useA and conf and aBuy  and htfUp and f_free(0)
goAS = useA and conf and aSell and htfDn and f_free(0) and not goAB
goBB = useB and conf and bBuy  and htfUp and f_free(1)
goBS = useB and conf and bSell and htfDn and f_free(1) and not goBB
goCB = useC and conf and cBuy  and htfUp and cBOk and f_free(2)
goCS = useC and conf and cSell and htfDn and cSOk and f_free(2) and not goCB

if goAB
    f_open(0, 1, slB)
else if goAS
    f_open(0, -1, slS)
if goBB
    f_open(1, 1, slB)
else if goBS
    f_open(1, -1, slS)
if goCB
    f_open(2, 1, slCB)
else if goCS
    f_open(2, -1, slCS)

// ============================================================================
//  ITTIFAQ: naya ishara aaya AUR kam az kam ek aur tareeqa pehle se usi taraf
//  khula hai, aur koi tareeqa ulti taraf khula nahi -> ek saaf trade.
// ============================================================================
f_cnt(_d) => (array.get(tDir, 0) == _d ? 1 : 0) + (array.get(tDir, 1) == _d ? 1 : 0) + (array.get(tDir, 2) == _d ? 1 : 0)
f_who(_d) =>
    string _s = ""
    for k = 0 to 2
        if array.get(tDir, k) == _d
            _s := _s + (_s == "" ? "" : "+") + (k == 0 ? "A" : k == 1 ? "B" : "C")
    _s

nOpB  = f_cnt(1)
nOpS  = f_cnt(-1)
ittB  = ittOn and conf and (goAB or goBB or goCB) and nOpB >= 2 and nOpS == 0 and f_free(3)
ittS  = ittOn and conf and (goAS or goBS or goCS) and nOpS >= 2 and nOpB == 0 and f_free(3) and not ittB
if ittB
    ittWho := f_who(1)
    f_open(3, 1, slB)
else if ittS
    ittWho := f_who(-1)
    f_open(3, -1, slS)

// SMC tayyari istemal ho gayi: nayi sweep ka intezar
if cBuy and conf
    uSwB := na
if cSell and conf
    dSwB := na

// ============================================================================
//  KHULI TRADES: dabba aage chalao + abhi kitne R par
// ============================================================================
f_liveR(_k) =>
    _d = array.get(tDir, _k)
    _d == 0 ? na : _d * (close - array.get(tE, _k)) / array.get(tR, _k)

if barstate.islast
    for k = 0 to 3
        if array.get(tDir, k) != 0 and f_show(k)
            _x2 = bar_index + futBars
            box.set_right(array.get(dbR, k), _x2)
            box.set_right(array.get(dbG, k), _x2)
            line.set_x2(array.get(dlE, k), _x2)
            line.set_x2(array.get(dlS, k), _x2)
            line.set_x2(array.get(dl1, k), _x2)
            line.set_x2(array.get(dl2, k), _x2)
            label.set_x(array.get(dgE, k), _x2)
            label.set_x(array.get(dgS, k), _x2)
            label.set_x(array.get(dg1, k), _x2)
            label.set_x(array.get(dg2, k), _x2)
            label.set_text(array.get(dgE, k), "Entry " + f_px(array.get(tE, k)) + "   |   abhi " + f_r(f_liveR(k)))

// ============================================================================
//  TABLE: upar seedhi line "ABHI kya karna hai", phir teeno + ittifaq ki ginti
// ============================================================================
f_st(_k) => array.get(tDir, _k) == 1 ? "BUY" : array.get(tDir, _k) == -1 ? "SELL" : "intezar"

var table tb = table.new(f_pos(tblPos), 5, 9 + 8, border_width = 1, border_color = color.new(color.gray, 70))
if barstate.islast
    _P   = topPad
    if _P > 0
        for r = 0 to _P - 1
            table.cell(tb, 0, r, " ", bgcolor = color.new(color.white, 100), text_size = FS)
    _bg  = color.new(color.white, 10)
    _bg2 = color.new(color.silver, 40)
    _htf = not useHTF ? "filter band" : na(hF) ? "-" : hF > hS ? "UP (sirf BUY)" : "DN (sirf SELL)"

    // --- Line 1: ABHI KYA KARNA HAI (seedhi zabaan) ---
    _iD  = array.get(tDir, 3)
    string _say = ""
    color  _sayBg = color.new(color.gray, 75)
    if not ittOn
        _say := "Ittifaq BAND hai - har tareeqa apna dabba dikha raha hai (settings mein ON karein)"
    else if _iD == 0
        _say := "ABHI: INTEZAR  -  koi ittifaq nahi, kuch nahi karna"
    else
        _say := "ABHI: " + f_dir(_iD) + " chal rahi hai (" + ittWho + " ek raye)  -  naya kuch nahi karna, " +
             (array.get(tH1, 3) ? "TP1 ho gaya, SL ab Entry par: nuqsan ka khatra khatam" : "SL " + f_px(array.get(tSL, 3)) + " ya TP ka intezar") +
             "   |   abhi " + f_r(f_liveR(3))
        _sayBg := color.new(_iD == 1 ? color.green : color.red, 70)
    table.cell(tb, 0, _P + 0, _say, bgcolor = _sayBg, text_color = color.black, text_size = size.normal)
    table.merge_cells(tb, 0, _P + 0, 4, _P + 0)

    // --- Line 2: teeno kya keh rahe hain ---
    _clash = nOpB > 0 and nOpS > 0
    _lin2 = "A: " + f_st(0) + "   B: " + f_st(1) + "   C: " + f_st(2) + "   |   " + htfName + " rukh: " + _htf +
         (_clash ? "   |   tareeqe ULTE hain -> market ne faisla nahi kiya" : "")
    table.cell(tb, 0, _P + 1, _lin2, bgcolor = _bg, text_color = _clash ? color.new(#E65100, 0) : color.black, text_size = FS)
    table.merge_cells(tb, 0, _P + 1, 4, _P + 1)

    string[] hdr = array.from("Tareeqa", "Abhi", "Trades", "Jeet %", "Exp (R)")
    for c = 0 to 4
        table.cell(tb, c, _P + 2, array.get(hdr, c), bgcolor = _bg2, text_color = color.black, text_size = FS)
    for k = 0 to 3
        _on  = k == 0 ? useA : k == 1 ? useB : k == 2 ? useC : ittOn
        _d   = array.get(tDir, k)
        _n   = array.get(sN, k)
        _w   = array.get(sW, k)
        _ex  = _n > 0 ? array.get(sR, k) / _n : na
        _now = not _on ? "band" : _d == 0 ? "intezar" : f_dir(_d) + " khuli " + f_r(f_liveR(k)) + (array.get(tH1, k) ? " (TP1 ✓)" : "")
        _cNow = _d == 1 ? color.new(#1B5E20, 0) : _d == -1 ? color.new(#B71C1C, 0) : color.new(#37474F, 0)
        _cEx = na(_ex) or _n < 20 ? color.new(#37474F, 0) : _ex > 0 ? color.new(#1B5E20, 0) : color.new(#B71C1C, 0)
        _exT = na(_ex) ? "-" : f_r(_ex) + (_n < 20 ? " (kam ginti)" : _ex <= 0 ? " KAMZOR" : "")
        _rowBg = k == 3 ? color.new(color.yellow, 80) : _bg
        table.cell(tb, 0, _P + 3 + k, k == 3 ? "ITTIFAQ (2+ ek taraf)" : f_nm(k), bgcolor = _rowBg, text_color = color.black, text_size = FS, text_halign = text.align_left)
        table.cell(tb, 1, _P + 3 + k, _now, bgcolor = _rowBg, text_color = _cNow, text_size = FS)
        table.cell(tb, 2, _P + 3 + k, str.tostring(_n), bgcolor = _rowBg, text_color = color.black, text_size = FS)
        table.cell(tb, 3, _P + 3 + k, _n > 0 ? str.tostring(int(math.round(100.0 * _w / _n))) + "%" : "-", bgcolor = _rowBg, text_color = color.black, text_size = FS)
        table.cell(tb, 4, _P + 3 + k, _exT, bgcolor = _rowBg, text_color = _cEx, text_size = FS)
    table.cell(tb, 0, _P + 7, "Lot: risk " + str.tostring(riskPct, "#.#") + "% = " + str.tostring(acct * riskPct / 100.0, "#") + " " + acctCur +
         "  ÷  (SL ka faasla $ × 100)   |   TP1 " + str.tostring(tp1R, "#.#") + "R aadhi + BE, TP2 " + str.tostring(tp2R, "#.#") + "R   |   spread $" + str.tostring(spreadU, "#.##") + " har trade se kata",
         bgcolor = _bg, text_color = color.black, text_size = FS)
    table.merge_cells(tb, 0, _P + 7, 4, _P + 7)
    table.cell(tb, 0, _P + 8, "Sirf observation. 20+ trades aur kai mahine ki ginti se pehle real par nahi.",
         bgcolor = _bg, text_color = color.new(#B71C1C, 0), text_size = FS)
    table.merge_cells(tb, 0, _P + 8, 4, _P + 8)
