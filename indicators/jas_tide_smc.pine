//@version=6
// ============================================================================
//  JAS TIDE + SMC   (build s2.11, Pine v6)
//  Naqsha: docs/tide_smc_s2_naqsha.md (11 Oct - 3 agent samjhe, 3 designer,
//  3 judge; design C + A/B ki achhi cheezein). Pehla naqsha: docs/tide_smc_naqsha.md.
//
//  CONCEPT (user ke liye):
//   1. Trade ka faisla sirf TIDE karta hai (Turtle), sirf DAILY candle par.
//   2. Rukh D1 EMA50/200: upar = sirf BUY, neeche = sirf SELL.
//   3. Daily candle 10 din ke high ke upar BAND = BUY (low ke neeche = SELL),
//      entry wohi daily close. ATR >= 0.25% (bohot susat bazaar mein nahi).
//   4. SL entry se 2 ATR = 1R. SL roz sirf aage, 5 din ke low/high tak. TP NAHI.
//   5. Bahar: SL chhu jaye, D1 rukh palte, ya close SL ke paar.
//   6. 1H, 15m, 1D - har chart par WOHI ek trade (Tester ne cent tak dikhaya).
//   7. SMC (DZ/SZ, FVG, BOS) sirf naqsha - kabhi naapa nahi. Is se trade nahi.
//
//  ENGINE: indicators/jas_tide_radar.pine (r3) ka f_tide - qaide BILKUL WAHI;
//  s2 mein sirf zyada values wapas (entry ka waqt, aakhri band trade, saal se
//  naap). request.security lookahead_on + engine andar [1] = repaint nahi.
//
//  s2 (11 Oct): Tide DABBA har TF par (xloc.bar_time): SHART (trade se pehle,
//  sleti nuqte wala, khali), RISK (trade chalu: entry se shuru ke SL tak laal =
//  1R), ABHI (abhi kitne R), kal ke SL ki nuqte wali lakeer, NATEEJA (aakhri
//  band trade), faisle ke waqt ki khari lakeer. Table: HAAL / MT5 MEIN / KAB /
//  RISK / LOT / NAAP / DHYAN. SMC ek sleti rang, sirf qareeb wale (1 DZ, 1 SZ,
//  2 FVG, 2 BOS), 15m-1D par. Hata diya: toot ke diamond plots, entry plot,
//  bare ▲ label, s1 ki "Agla" row.
//  s2.1 (11 Oct, 4-lens jaanch: 21 dawe sahi, sab dikhawa/likhai - engine wahi):
//  bazaar band ho to "faisla agle session ki PEHLI candle par" (pehle "agli
//  daily close" - gold ki trade chhoot sakti thi); toot ka level number mein;
//  "aaj close X ke neeche = BAND" (close wala nikalna) + agle din yaad dihani;
//  der se entry ka lot abhi ki qeemat se (risk % se zyada nahi); aage wale
//  kinare candle ginti se (hafte mein simatte nahi); usi din dobara khuli trade
//  ka "khuli" alert; HAAL rang nateeje se; tick chart; vSym BTCUSDc bhi maane.
//  s2.2 (11 Oct, teesri jaanch): RISK dabbe ka bayan kinara 9999 candle se
//  peeche nahi (1m/5m par purani trade se script nahi rukti); "chart se pehle"
//  wapas; entry ke din ki close ho chuki ho (hafta/break) to "der se entry
//  NAHI" aur lot nahi.
//  s2.3 (11 Oct, user ka 1H screenshot): SHART aur RISK dabbe ki likhai ab
//  label mein (small, safed pas-e-manzar) - patle dabbe mein toot kar column
//  nahi banti. SHART: toot ke level par; RISK: abhi ke SL par (qeemat ke qareeb).
//  s2.4 (11 Oct, user: zoom par dabbe upar chhup jate): SHART/RISK ki likhai
//  ab ABHI ki qeemat par (label_left) - zoom par bhi nazar aaye; "abhi ±R"
//  RISK label mein. Dabba khud level/SL tak hi rehta hai.
//  s2.5 (12 Oct raat, user): SMC rang - UPAR wale (FVG↑, DZ, BOS↑/CHOCH↑, LGB↑)
//  HARE, NEECHE wale (FVG↓, SZ, BOS↓/CHOCH↓, LGB↓) LAAL; SMC ki likhai box ke
//  bahar label mein (patle dabbe mein ghaib na ho); likhai bari (Settings →
//  5 · 'Chart ki likhai', default Normal; table default Normal + Large).
//  Dabbon mein NAZAR WALI baat alag mota rangeen label (SHART: toot level + SL;
//  TRADE: rukh, abhi R, SL, close par BAND ka level), baqi tafseel neeche.
//  Table mein HAAL / MT5 MEIN / RISK mote. LGB default chalu; LGB ka teer =
//  umeed ki taraf (high ka sweep = LGB↓ laal; SMC Coach mein usi ko LGB↑ kehte).
//  Mota label trend ki ulti taraf (BUY: qeemat ke neeche) taake table ke neeche
//  na chhupe. Jaanch (4 agent): text_formatting sirf seedhe constant se. Engine WAHI.
//  s2.6 (12 Oct raat, user ka screenshot): SHART ka KHALI dabba (toot level se
//  SL tak, sleti nuqte wala) aur us ke kinare wali SL lakeer default BAND -
//  likhai mein level aur SL pehle se hain. Wapas chahiye to Settings → 2 ·
//  'SHART ka khali dabba'. Engine WAHI.
//  s2.7 (13 Oct, user ka gold screenshot - peele X / magenta dabba): chart par
//  Tide ki likhai (SHART ka laal mota label + 'SL ~ / pending order' label,
//  aur trade ke waqt wale dono label) default BAND - wahi baat table mein;
//  table PATLI (har ' · ' nayi line) taake daayen khali hisse mein rahe;
//  LOT aur NAAP rows default BAND. Sab Settings se wapas. Engine WAHI.
//  s2.8 (14 Oct, user 'D'): S/R lakeerein SIRF DEKHNE ke liye (default BAND,
//  Settings → 6): pichle HAFTE / MAHINE ka high-low (band candle, repaint nahi)
//  aur Tide ki apni 10 din naali (wahi level jis ke toot par trade). Engine,
//  signal, SL, table WAHI - S/R faisle mein shamil NAHI (naapa nahi gaya).
//  s1.1 ki durustiyan sab qaim (SL chhoona, +/- faasla, bazaar band, standard
//  candles, DZ/SZ band candle par).
//  s2.9 (19 Oct, user): TABLE TRANSPARENT (default, OB Radar r3 jaisa) - peechhe
//  candles nazar aati hain; likhai chart ke rang (chart.fg_color) mein taake
//  kaali aur safed dono chart par parhi jaye. Settings → 5 se band / kitna.
//  Engine, signal, SL, table ki baatein WAHI.
//  s2.10 (21 Oct, user: "is mein S/R bhi aana chahiye"): SWING S / R (Elder,
//  Weinstein: pichli choti = resistance, pichli tah = support). Sirf PAKKI
//  swing (pivot 5, band candle - repaint nahi), daam ke upar qareebi 2 R,
//  neeche qareebi 2 S, dashed lakeer + qeemat. Default ON (Settings → 6).
//  Sirf dekhna - Tide ka faisla WAHI, S/R naapa nahi gaya.
//  s2.11 (21 Oct, user: "BOS/CHOCH, S/R, FVG/LGB sare TFs par PERFECT, ZONES aur
//  MA bhi, chart achha lage aur samajh bhi aaye"): SMC ab HAR TF (1m - 1M) par,
//  asal candles se (Heikin Ashi par bhi asal daam). Sab BAND candle par pakka;
//  nishan sirf aakhri candle par bante (repaint nahi, chhupi cheezein nahi).
//  BOS/CHOCH: toot pehle, nayi swing baad mein (pehle toot chhoot jata tha);
//  BOS = seedhi patli lakeer, CHOCH = moti nuqte wali + rangeen label, likhai
//  lakeer ke beech; aakhri 2 gehre, purane halke. S/R aur DZ/SZ ek hi swing ka
//  record: sirf NA-TOOTI (band close paar = khatam), 1m par paas paas do ho to
//  ek. FVG sirf jab beech wali candle poora gap paar kare (session / weekend
//  gap FVG nahi); jitna bhara utna chhota. LGB har na-tooti swing par + sweep
//  hue level ki nuqte wali lakeer. Zinda S/R / zone / FVG daayen tak, likhai
//  daayen EK qatar mein (paas wali mil kar 'R 4143.40 · SZ↓' - ek dusre par nahi
//  charhti). Har nishan par tooltip (kya hai + D1 rukh se rishta). MA = Tide ka
//  APNA rukh: D1 EMA50 (hara / laal) + EMA200, default ON (chhoti TF par door ho
//  to chhupi - candles chapti nahi). PEHCHAN table Settings → 7 (default BAND).
//  Engine, signal, SL, Tide dabba, table WAHI - SMC phir bhi naapa nahi gaya.
//
//  Naap: strategies/jas_tide_smc_test.pine. Peshangoi nahi. Tide ~55-60% trades
//  haarta hai; kamai chand bari jeet se.
// ============================================================================
indicator("JAS Tide + SMC", shorttitle = "JAS Tide+SMC", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

BUILD = "s2.11"

// ============================================================================
//  INPUTS
// ============================================================================
grQ = "1 · Tide qawaid (naape hue - mat badlein)"
entryLen  = input.int(10, "Naali: kitne din ka high/low", minval = 3, maxval = 200, group = grQ, display = display.none)
exitLen   = input.int(5, "SL sarakna: kitne din", minval = 2, maxval = 100, group = grQ, display = display.none)
atrLen    = input.int(14, "ATR length", minval = 2, group = grQ, display = display.none)
atrMult   = input.float(2.0, "Shuru ka SL (x ATR)", minval = 0.5, step = 0.1, group = grQ, display = display.none)
emaFLen   = input.int(50, "D1 rukh EMA fast", minval = 2, group = grQ, display = display.none)
emaSLen   = input.int(200, "D1 rukh EMA slow", minval = 3, group = grQ, display = display.none)
minAtrPct = input.float(0.25, "Kam az kam ATR (% qeemat ka)", minval = 0, step = 0.05, group = grQ, display = display.none)
costPct   = input.float(0.005, "Kharcha (% har taraf)", minval = 0, step = 0.001, group = grQ, display = display.none)
statYear  = input.int(2019, "Naap: is saal se alag ginti", minval = 1990, maxval = 2100, group = grQ, display = display.none)

grT = "2 · Tide chart par"
showBox    = input.bool(true, "Tide dabba (shart / trade / nateeja)", group = grT, display = display.none)
showPlanBx = input.bool(false, "SHART ka khali dabba (level se SL tak)", tooltip = "s2.6: default BAND - level aur SL likhai mein pehle se hain.", group = grT, display = display.none)
showLbl    = input.bool(false, "Tide ki likhai chart par (SHART / trade ke label)", tooltip = "s2.7: default BAND (user: chart saaf) - yahi baat table ke HAAL / MT5 MEIN / RISK mein hai.", group = grT, display = display.none)
showSLplot = input.bool(true, "Sarakta SL ki lakeer", group = grT, display = display.none)
showFaisla = input.bool(true, "Faisle ka waqt (daily close) - khari lakeer", group = grT, display = display.none)
nMarks     = input.int(5, "Purane nateeje (±R) kitne", minval = 0, maxval = 10, group = grT, display = display.none)

grS = "3 · SMC (sirf dikhawa, NAAPA NAHI)"
smcOn    = input.bool(true, "SMC nishan", tooltip = "Trade ka faisla sirf Tide dabba (DAILY close). SMC kabhi naapa nahi gaya. s2.11: har TF (1m - 1M) par, sab band candle par pakka; har nishan par mouse rakhein - tooltip mein matlab.", group = grS, display = display.none)
showMA   = input.bool(false, "EMA21 / EMA63 (chart TF) - Tide ka rukh NAHI", tooltip = "Tide ka asal rukh: Settings → 7 · D1 EMA50 / EMA200 (default ON).", group = grS, display = display.none)
showBOS  = input.bool(true, "BOS / CHOCH (aakhri 2 gehre + purane halke)", tooltip = "BOS = pichli pakki swing ke paar BAND close (structure jari) - seedhi patli lakeer. CHOCH = ulta pehla toot - moti nuqte wali lakeer + rangeen label. Likhai lakeer ke beech.", group = grS, display = display.none)
showZone = input.bool(true, "DZ / SZ (qareeb wala 1-1)", tooltip = "Swing candle ka zone (wick se body, 0.1 - 1 ATR). Band close paar = khatam. SZ aur R ek hi choti ho to ek likhai 'R ... · SZ↓'.", group = grS, display = display.none)
showFVG  = input.bool(true, "FVG (qareebi 1 upar + 1 neeche)", tooltip = "Sirf jab beech wali candle poora gap paar kare (session / weekend ka gap FVG nahi). Jitna bhara utna chhota, poora bhare to khatam.", group = grS, display = display.none)
showLGB  = input.bool(true, "LGB (liquidity sweep)", tooltip = "Har na-tooti swing par: wick paar, close wapas andar. Teer = umeed ki taraf (s2.5).", group = grS, display = display.none)
swLen    = input.int(5, "Swing: pivot left/right", minval = 2, maxval = 20, tooltip = "Swing itni candle baad pakki hoti hai (bari TF 1W / 1M par der se).", group = grS, display = display.none)
keepN    = input.int(3, "Purane BOS / CHOCH aur LGB kitne (halke)", minval = 1, maxval = 8, tooltip = "s2.11: aakhri 2 gehre + itne purane halke. Zone / FVG / S-R ki yaad alag (50 / 30) - dikhte sirf qareebi.", group = grS, display = display.none)
fvgMin   = input.float(0.1, "FVG kam az kam (x ATR)", minval = 0, step = 0.05, tooltip = "Chhoti TF (1m / 5m) par 0.2 - 0.3 se chart saaf.", group = grS, display = display.none)

grL = "4 · Lot (MT5)"
bal     = input.float(0, "Balance (account currency)", minval = 0, group = grL, display = display.none)
curTxt  = input.string("USC", "Account currency", group = grL, display = display.none)
riskPct = input.float(1.0, "Risk fi trade (%)", minval = 0.1, maxval = 2.0, step = 0.1, group = grL, display = display.none)
vMove   = input.float(0, "V: 0.01 lot par qeemat 1.00 hile = kitne (account currency)", minval = 0, step = 0.01,
     tooltip = "Exness: XAUUSDc = 1 · BTCUSDc = 0.01 · XAUUSDm (USD) = 1. Demo par 0.01 lot ka test order khol kar MT5 se milayein.", group = grL, display = display.none)
vSym    = input.string("", "V kis symbol ki (jaise XAUUSD ya BTCUSD, bina c/m)", group = grL, display = display.none)

grR = "6 · S/R lakeerein (sirf dekhna - Tide ka faisla NAHI)"
showWk  = input.bool(false, "Pichle HAFTE ka high / low", group = grR, display = display.none)
showMo  = input.bool(false, "Pichle MAHINE ka high / low", group = grR, display = display.none)
showNal = input.bool(false, "Tide naali (10 din high / low - toot ka level)", group = grR, display = display.none)
showSR  = input.bool(true, "Swing S / R (pichli pakki choti / tah)", tooltip = "s2.10: Elder / Weinstein - pichli choti = R (daam ke upar), pichli tah = S (neeche). Swing = Settings 3 wala pivot, sirf band candle par pakka. s2.11: sirf NA-TOOTI (kisi band close ne paar nahi ki), 0.2 ATR ke andar do ho to ek; har TF par.", group = grR, display = display.none)
srN     = input.int(2, "S / R kitni (har taraf)", minval = 1, maxval = 5, group = grR, display = display.none)

grV = "5 · Table"
showTable = input.bool(true, "Table dikhao", group = grV, display = display.none)
tablePos  = input.string("Top Right", "Table ki jagah", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grV, display = display.none)
thinTbl   = input.bool(true, "Table patli (har ' · ' nayi line mein)", tooltip = "s2.7: table chart ke daayen khali hisse mein rahe, candles par na aaye.", group = grV, display = display.none)
showLot   = input.bool(false, "Table: LOT row", tooltip = "s2.7: default BAND (user).", group = grV, display = display.none)
showNaap  = input.bool(false, "Table: NAAP (1D) row", tooltip = "s2.7: default BAND (user). Naap repo / Tester mein hai.", group = grV, display = display.none)
tableFont = input.string("Normal", "Table ka font", options = ["Tiny", "Small", "Normal", "Large"], group = grV, display = display.none)
tblClear  = input.bool(true, "Table transparent (peechhe candles nazar aayein)", tooltip = "s2.9: likhai chart ke rang mein.", group = grV, display = display.none)
tblAlpha  = input.int(85, "Kitna transparent (0 = thos, 100 = bilkul gayab)", minval = 0, maxval = 100, group = grV, display = display.none)
chartFont = input.string("Normal", "Chart ki likhai (SMC + Tide dabba)", options = ["Small", "Normal", "Large"], group = grV, display = display.none)
tz        = input.string("Asia/Karachi", "Waqt ka zone", group = grV, display = display.none)
tzName    = input.string("PKT", "Zone ka naam", group = grV, display = display.none)

// s2.11: naye inputs sab se AAKHIR mein (purani saved settings apni jagah rahein)
grP = "7 · MA + pehchan (sirf dekhna)"
showDMA = input.bool(true, "Tide ka rukh: D1 EMA50 / EMA200 lakeer (har TF)", tooltip = "s2.11 (user: MA bhi). Wahi EMA jin se Tide ka rukh (kal tak ki band daily candles, repaint nahi). EMA50 hara = rukh UPAR (sirf BUY), laal = NEECHE (sirf SELL).", group = grP, display = display.none)
maFar   = input.float(8.0, "Chhoti TF: EMA kitne chart-ATR tak qareeb ho to dikhe", minval = 0, step = 1, tooltip = "1D se chhoti TF par door ki lakeer candles ko patli kar deti - is liye chhupti. 0 = hamesha dikhao. 1D aur bari TF par hamesha.", group = grP, display = display.none)
maFill  = input.bool(false, "EMA50 aur EMA200 ke beech halka rang", group = grP, display = display.none)
rOff    = input.int(3, "Daayen likhai: kitni candle aage", minval = 2, maxval = 30, tooltip = "Zinda zone / S-R / FVG yahan tak, likhai yahan se. Likhai kate to TradingView ka right margin barhayein.", group = grP, display = display.none)
showLeg = input.bool(false, "PEHCHAN table (har nishan ka matlab)", tooltip = "Default BAND (naye table default band). Har nishan ke tooltip mein bhi yahi matlab hai.", group = grP, display = display.none)
legPos  = input.string("Bottom Left", "PEHCHAN ki jagah", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], tooltip = "Tide table wale kone mein ho to khud upar / neeche ho jati.", group = grP, display = display.none)
legFont = input.string("Small", "PEHCHAN ka font", options = ["Tiny", "Small", "Normal"], group = grP, display = display.none)

// ============================================================================
//  HELPERS
// ============================================================================
f_pos(string s) => s == "Top Left" ? position.top_left : s == "Top Right" ? position.top_right : s == "Bottom Left" ? position.bottom_left : position.bottom_right
f_size(string s) => s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Large" ? size.large : size.normal
f_px(float x) => na(x) ? "-" : str.tostring(x, format.mintick)
f_r(float x) => na(x) ? "-" : (x > 0 ? "+" : "") + str.tostring(x, "0.00") + "R"
f_dur(int ms) =>
    int m = math.max(int(ms / 60000), 0)
    int h = int(m / 60)
    (h > 0 ? str.tostring(h) + " ghante " : "") + str.tostring(m % 60) + " min"

C_BULL = color.new(#26A69A, 0)
C_BEAR = color.new(#EF5350, 0)
C_PLAN = color.new(#78909C, 0)
C_SL   = color.new(#E65100, 0)
C_TXT  = color.new(#37474F, 0)
C_UP   = color.new(#00A86B, 0)   // SMC upar wale (hara)
C_DN   = color.new(#E53935, 0)   // SMC neeche wale (laal)
fsC    = f_size(chartFont)

// ============================================================================
//  TIDE ENGINE — 1D candles par, sirf BAND candle (radar r3 ka f_tide; qaide
//  wahi. s2: entry ka waqt, aakhri band trade aur saal se naap sirf WAPAS)
// ============================================================================
f_tide() =>
    // ta.* sab upar (Pine v6: shart ke andar nahi)
    _atrA = ta.atr(atrLen)
    _hbA  = ta.highest(high, entryLen)
    _lbA  = ta.lowest(low, entryLen)
    _hxA  = ta.highest(high, exitLen)
    _lxA  = ta.lowest(low, exitLen)
    _efA  = ta.ema(close, emaFLen)
    _esA  = ta.ema(close, emaSLen)
    // pichli (BAND) candle aur us waqt ke level
    _o  = open[1]
    _h  = high[1]
    _l  = low[1]
    _c  = close[1]
    _a  = _atrA[1]
    _hb = _hbA[2]
    _lb = _lbA[2]
    _hx = _hxA[2]
    _lx = _lxA[2]
    _ef = _efA[2]
    _es = _esA[2]
    _tc1 = time_close[1]        // us band din ka close (entry/exit ka waqt)
    _td1 = time_tradingday[1]   // us band din ki tareekh
    var int   _d   = 0
    var float _e   = na
    var float _r   = na
    var float _sl  = na
    var int   _age = 0
    var int   _n   = 0
    var int   _w   = 0
    var float _sR  = 0.0
    var float _sQ  = 0.0
    var float _sW  = 0.0
    var float _sL  = 0.0
    var float _lR  = na
    // s2: sirf dikhane ke liye yaad (qaidon par asar nahi)
    var int   _eT   = na
    var int   _eTd  = na
    var int   _lD   = 0
    var float _lE   = na
    var float _lRk  = na
    var float _lX   = na
    var int   _lXt  = na
    var int   _lEt  = na
    var int   _lWhy = 0
    var int   _n19  = 0
    var float _s19  = 0.0
    var float _q19  = 0.0
    bool  _cl  = false
    bool  _atC = false
    float _px  = na
    int   _why = 0    // 1 SL · 4 sarakta SL · 2 D1 palta · 3 close SL ke paar
    if _d != 0 and not na(_c)
        _age += 1
        // candle ke andar SL (gap ho to open par)
        if _d == 1 and _l <= _sl
            _px := _o < _sl ? _o : _sl
            _cl := true
            _why := _sl != _e - _d * _r ? 4 : 1
        else if _d == -1 and _h >= _sl
            _px := _o > _sl ? _o : _sl
            _cl := true
            _why := _sl != _e - _d * _r ? 4 : 1
        // close par: D1 rukh palta
        if not _cl and not na(_ef) and not na(_es) and (_d == 1 ? _ef < _es : _ef > _es)
            _px  := _c
            _cl  := true
            _atC := true
            _why := 2
        // close par: SL aage, close peeche ho to band
        if not _cl
            _sl := _d == 1 ? math.max(_sl, nz(_lx, _sl)) : math.min(_sl, nz(_hx, _sl))
            if (_d == 1 and _c <= _sl) or (_d == -1 and _c >= _sl)
                _px  := _c
                _cl  := true
                _atC := true
                _why := 3
    if _cl
        _rr = _d * (_px - _e) / _r - 2.0 * costPct / 100.0 * _e / _r
        _n  += 1
        _sR += _rr
        _sQ += _rr * _rr
        _lR := _rr
        if _rr > 0
            _w  += 1
            _sW += _rr
        else
            _sL -= _rr
        _lD   := _d
        _lE   := _e
        _lRk  := _r
        _lX   := _px
        _lXt  := _tc1
        _lEt  := _eT
        _lWhy := _why
        if not na(_eTd) and year(_eTd, "UTC") >= statYear
            _n19 += 1
            _s19 += _rr
            _q19 += _rr * _rr
        _d := 0
    if _d == 0 and not _atC and not na(_c) and not na(_a) and _a > 0 and not na(_hb) and not na(_lb)
        _bull = not na(_ef) and not na(_es) and _ef > _es
        _bear = not na(_ef) and not na(_es) and _ef < _es
        _live = _a / _c * 100.0 >= minAtrPct
        _buy  = _c > _hb and _bull and _live
        _sell = _c < _lb and _bear and _live
        if _buy or _sell
            _d   := _buy ? 1 : -1
            _e   := _c
            _r   := atrMult * _a
            _sl  := _c - _d * _r
            _age := 0
            _eT  := _tc1
            _eTd := _td1
    // aaj ke liye (sab band din): rukh, aaj ke close ke liye toot ke level, ATR
    _rk = not na(_efA[1]) and not na(_esA[1]) ? (_efA[1] > _esA[1] ? 1 : _efA[1] < _esA[1] ? -1 : 0) : 0
    _ok = not na(_esA[1])
    // _lxA[1] / _hxA[1]: aaj ke close par SL kahan tak sarkega (5 din, kal tak)
    [_d, _e, _r, _sl, _age, _n, _w, _sR, _sQ, _sW, _sL, _lR, _rk, _hbA[1], _lbA[1], _atrA[1], _lxA[1], _hxA[1],
     _eT, _eTd, _lD, _lE, _lRk, _lX, _lXt, _lEt, _lWhy, _n19, _s19, _q19, _ok]

// ticker.standard: Heikin Ashi / Renko chart par bhi asal candles.
tkStd = ticker.standard(syminfo.tickerid)
// lookahead_on BINA [1]: engine khud sirf pichli (band) candle aur us se pehle
// ka data parhta hai, is liye har candle par "aakhri band din tak" ka haal.
[tD, tE, tR, tSL, tAge, tN, tW, tSR, tSQ, tSW, tSLs, tLR, tRk, tUp, tDn, tAtr, tLx1, tHx1, tET, tETd, lD, lE, lRk, lX, lXt, lEt, lWhy, n19, s19, q19, tOk] = request.security(tkStd, "D", f_tide(), barmerge.gaps_off, barmerge.lookahead_on)
// chart TF ki asal candles (aam chart par bilkul open/high/low/close; tick chart par chart ki apni)
[rqO, rqH, rqL, rqC] = request.security(tkStd, timeframe.isticks ? "1" : timeframe.period, [open, high, low, close])
stO = timeframe.isticks ? open : rqO
stH = timeframe.isticks ? high : rqH
stL = timeframe.isticks ? low : rqL
stC = timeframe.isticks ? close : rqC
// AAJ ki daily candle: lookahead_on = history par aage ka data - is liye SIRF
// aakhri candle (barstate.islast) par parhi jati hai
[dO, dH, dL, dCt] = request.security(tkStd, "D", [open, high, low, time_close], barmerge.gaps_off, barmerge.lookahead_on)

// s2.8: S/R - pichli BAND hafta / mahina candle ([1] + lookahead_on = repaint nahi)
[wkH, wkL] = request.security(tkStd, "W", [high[1], low[1]], barmerge.gaps_off, barmerge.lookahead_on)
[moH, moL] = request.security(tkStd, "M", [high[1], low[1]], barmerge.gaps_off, barmerge.lookahead_on)

tfSec = timeframe.in_seconds()
isHi  = not na(tfSec) and tfSec > 86400     // 1D se bari TF: Tide ka dabba nahi
bd    = na(tfSec) ? 0 : tfSec * 1000        // ek candle ka waqt (ms)
var int firstT = time                        // chart ki pehli candle

// AAJ ka din (history ke liye chart ki candles se, aage ka data nahi)
newDayC = ta.change(time("D")) != 0
var float dOp = na
var float dLo = na
var float dHi = na
if newDayC or na(dLo)
    dOp := stO
    dLo := stL
    dHi := stH
else
    dLo := math.min(dLo, stL)
    dHi := math.max(dHi, stH)
hitHist = tD != 0 and not na(tSL) and (tD == 1 ? dLo <= tSL : dHi >= tSL)
hitLast = tD != 0 and not na(tSL) and not na(dL) and (tD == 1 ? dL <= tSL : dH >= tSL)
slHit   = isHi ? false : barstate.islast ? hitLast : hitHist
openD   = barstate.islast ? dO : dOp
slPx    = slHit ? (tD == 1 ? math.min(openD, tSL) : math.max(openD, tSL)) : na   // gap ho to open par (engine jaisa)
csT     = tD == 1 ? math.max(tSL, nz(tLx1, tSL)) : tD == -1 ? math.min(tSL, nz(tHx1, tSL)) : na   // aaj close par SL

// ============================================================================
//  TIDE CHART PAR: sarakta SL + purane nateeje
// ============================================================================
// s2.11: ta.change alag (Pine v6 mein 'or' ka doosra hissa kabhi chhoot jata - warning); nateeja wahi
wkHc = ta.change(wkH)
wkLc = ta.change(wkL)
moHc = ta.change(moH)
moLc = ta.change(moL)
bool wkNew = wkHc != 0 or wkLc != 0
bool moNew = moHc != 0 or moLc != 0
plot(showWk and not isHi and not wkNew ? wkH : na, "Hafta high", color = color.new(#EF5350, 35), style = plot.style_linebr, linewidth = 1, display = display.pane)
plot(showWk and not isHi and not wkNew ? wkL : na, "Hafta low", color = color.new(#26A69A, 35), style = plot.style_linebr, linewidth = 1, display = display.pane)
plot(showMo and not isHi and not moNew ? moH : na, "Mahina high", color = color.new(#EF5350, 0), style = plot.style_linebr, linewidth = 2, display = display.pane)
plot(showMo and not isHi and not moNew ? moL : na, "Mahina low", color = color.new(#26A69A, 0), style = plot.style_linebr, linewidth = 2, display = display.pane)
plot(showNal and not isHi ? tUp : na, "Tide naali high", color = color.new(#FFA726, 20), style = plot.style_stepline, linewidth = 1, display = display.pane)
plot(showNal and not isHi ? tDn : na, "Tide naali low", color = color.new(#FFA726, 20), style = plot.style_stepline, linewidth = 1, display = display.pane)
plot(showSLplot and not isHi and tD != 0 and not slHit ? tSL : na, "Tide SL (sarakta)", color = C_SL, style = plot.style_linebr, linewidth = 2, display = display.pane)

var array<label> tideMarks = array.new<label>()
f_keep(array<label> a, int k) =>
    while array.size(a) > k
        label.delete(array.shift(a))
endTrade = not na(tN[1]) and tN > tN[1]   // pehli candle par pichli ginti maloom nahi - nishan nahi
newT     = tD != 0 and (nz(tD[1]) != tD or tE != tE[1] or tN != tN[1])   // nayi trade (usi din dobara khuli bhi)
var int eBar = na      // entry ke baad pehli chart candle - RISK dabba yahan se
if newT
    eBar := bar_index
dayT = time("D")       // aaj ki daily candle ka shuru (har candle par ek dafa)
var int exDay = na     // jis din pata chala ke trade close par band hui (MT5 mein khud band nahi hoti)
if endTrade
    exDay := dayT
if nMarks > 0 and not isHi and endTrade
    array.push(tideMarks, label.new(bar_index, tD[1] == 1 ? high : low, "Tide " + f_r(tLR),
         style = tD[1] == 1 ? label.style_label_down : label.style_label_up, size = fsC,
         color = color.new(#FFFFFF, 100), textcolor = nz(tLR) > 0 ? C_BULL : C_BEAR, text_formatting = text.format_bold))
f_keep(tideMarks, nMarks)

// ============================================================================
//  TIDE DABBA (sirf aakhri candle par). Aage wale kinare candle ginti se
//  (xloc.bar_index) - hafte/break mein waqt wale kinare simat jate. NATEEJA aur
//  faisle ki lakeer asal waqt par (xloc.bar_time).
// ============================================================================
var box  bxPlan = na
var line lnPlan = na
var box  bxRisk = na
var box  bxNow  = na
var line lnNext = na
var box  bxRes  = na
var line lnDay  = na
var label lbPlan = na   // dabbe ki likhai label mein (dabba patla ho to bhi nahi toot-ti)
var label lbRisk = na
var label lbPlanH = na  // s2.5: nazar wali baat - mota rangeen label (qeemat ke UPAR)
var label lbRiskH = na

if barstate.islast
    box.delete(bxPlan)
    line.delete(lnPlan)
    box.delete(bxRisk)
    box.delete(bxNow)
    line.delete(lnNext)
    box.delete(bxRes)
    line.delete(lnDay)
    label.delete(lbPlan)
    label.delete(lbRisk)
    label.delete(lbPlanH)
    label.delete(lbRiskH)
    bxPlan := na
    lnPlan := na
    bxRisk := na
    bxNow  := na
    lnNext := na
    bxRes  := na
    lnDay  := na
    lbPlan := na
    lbRisk := na
    lbPlanH := na
    lbRiskH := na
    if showBox and not isHi and bd > 0
        bool   dDone    = not na(dCt) and timenow >= dCt
        string closeTxt = dDone ? "agle session ki PEHLI candle" : str.format_time(dCt, "HH:mm", tz) + " " + tzName
        int    rgt      = bar_index + 20
        // --- SHART: trade se pehle (khali, sleti, nuqte wala) ---------------
        if tD == 0 and tRk != 0 and tOk and not na(tAtr) and tAtr > 0 and not na(stC) and stC > 0
            float  lvl   = tRk == 1 ? tUp : tDn
            float  slp   = lvl - tRk * atrMult * tAtr
            float  atrP  = tAtr / stC * 100.0
            bool   liveT = atrP >= minAtrPct
            bool   past  = tRk == 1 ? stC > lvl : stC < lvl
            string sdTxt = tRk == 1 ? "BUY" : "SELL"
            int    pL    = bar_index + 2
            int    pR    = rgt
            string l1 = dDone ? "Daily candle BAND ho chuki · " + (past ? sdTxt + " ka imkaan - agle session ki PEHLI candle par table dekhein" : "toot nahi hua") : not liveT ? "Bazaar susat (kal ATR " + str.tostring(atrP, "0.00") + "%)" : past ? "Qeemat level ke paar · DAILY close ka intezar · abhi entry NAHI" : "SHART · abhi trade NAHI"
            string l2 = "DAILY close " + f_px(lvl) + (tRk == 1 ? " ke UPAR" : " ke NEECHE") + (liveT ? "" : " + ATR >= " + str.tostring(minAtrPct) + "%") + " = " + sdTxt + (dDone ? "" : " (" + closeTxt + ")")
            string l3 = "SL ~" + f_px(slp) + " (kal ki ATR) · 1R ~" + f_px(atrMult * tAtr)
            string l4 = sdTxt + " Stop / pending order mat lagayein"
            // s2.6: khali dabba default BAND (user: chart saaf) - Settings se wapas
            if showPlanBx
                bxPlan := box.new(pL, math.max(lvl, slp), pR, math.min(lvl, slp), xloc = xloc.bar_index,
                     border_color = C_PLAN, border_style = liveT ? line.style_dotted : line.style_dashed, border_width = 1,
                     bgcolor = color.new(C_PLAN, 100))
            // likhai toot ke level par, dabbe ke andar ki taraf (BUY: level ke neeche, SELL: upar)
            // likhai ABHI ki qeemat par (zoom karne par bhi nazar aaye; level ka number likhai mein hai)
            // s2.5: NAZAR WALI baat (toot level + SL) mota rangeen label qeemat ke UPAR, tafseel NEECHE
            string hs = dDone ? "Daily BAND ho chuki · " + (past ? sdTxt + " ka imkaan · agle session dekhein" : "toot nahi hua") : not liveT ? "Bazaar susat · trade NAHI" : past ? "Level paar · DAILY close ka INTEZAR · entry NAHI" : "SHART · abhi trade NAHI"
            // mota label trend ki ULTI taraf (BUY: qeemat ke neeche) - upar table ke neeche na chhupe
            if showLbl
                lbPlanH := label.new(pL, stC, hs + "\n" + l2 + "\nSL ~" + f_px(slp), xloc = xloc.bar_index,
                     style = tRk == 1 ? label.style_label_upper_left : label.style_label_lower_left, size = fsC,
                     color = color.new(tRk == 1 ? C_BULL : C_BEAR, 10), textcolor = color.white, textalign = text.align_left,
                     text_formatting = text.format_bold)
                lbPlan := label.new(pL, stC, l3 + "\n" + l4, xloc = xloc.bar_index,
                     style = tRk == 1 ? label.style_label_lower_left : label.style_label_upper_left, size = fsC,
                     color = color.new(#FFFFFF, 15), textcolor = C_TXT, textalign = text.align_left)
            if showPlanBx
                lnPlan := line.new(pL, slp, pR, slp, xloc = xloc.bar_index, color = color.new(C_SL, 30), style = line.style_dotted, width = 1)
        // --- RISK: trade chalu (laal = entry se shuru ke SL tak = 1R) ---------
        if tD != 0 and not na(tE) and not na(tR) and tR > 0
            // bar_index wala kinara 9999 candle se peeche nahi ja sakta (warna script ruk jati)
            int    lft   = math.max(nz(eBar, 0), bar_index - 9999)
            bool   clamp = (not na(tET) and tET < firstT) or lft != nz(eBar, 0)
            bool   pastCs = not na(csT) and not na(stC) and (tD == 1 ? stC <= csT : stC >= csT)
            float  sl0   = tE - tD * tR
            float  rSL   = tD * (tSL - tE) / tR - 2.0 * costPct / 100.0 * tE / tR
            float  slR   = slHit ? tD * (slPx - tE) / tR - 2.0 * costPct / 100.0 * tE / tR : na
            string eDay  = na(tETd) ? "" : str.format_time(tETd, "dd MMM", "UTC")
            string t1 = (tD == 1 ? "▲ TIDE BUY" : "▼ TIDE SELL") + " · din " + str.tostring(tAge) + (slHit or na(stC) ? "" : " · abhi " + f_r(tD * (stC - tE) / tR)) + " · entry " + f_px(tE) + " (" + eDay + " daily close" + (clamp ? ", chart se pehle" : "") + ")"
            string t2 = slHit ? "AAJ SL CHHU GAYA @ " + f_px(slPx) + " · ~" + f_r(slR) + " (qaide se) · MT5 mein band karein" : "SL abhi " + f_px(tSL) + " · SL par band ~" + f_r(rSL) + " (qaide se; gap ho to kam, swap/spread nahi gina)" + (dDone ? ((tRk == -tD or pastCs) ? "\nDaily close ho chuki · BAND ka imkaan · agle session ki PEHLI candle par table dekhein" : not na(csT) and csT != tSL ? "\nAgle session se SL " + f_px(csT) : "") : (not na(csT) and csT != tSL ? "\nAaj DAILY close " + f_px(csT) + (tD == 1 ? " ke neeche" : " ke upar") + " = BAND" : "") + (tRk == -tD ? "\nD1 rukh palta: aaj daily close par BAND" : ""))
            string t3 = "Laal = 1R risk (shuru ka SL " + f_px(sl0) + ") · TP NAHI: SL roz aage"
            bxRisk := box.new(lft, math.max(tE, sl0), rgt, math.min(tE, sl0), xloc = xloc.bar_index,
                 border_color = color.new(C_BEAR, 30), border_style = slHit ? line.style_dashed : line.style_solid, border_width = 1,
                 bgcolor = color.new(C_BEAR, 85))
            // likhai abhi ke SL par (qeemat ke qareeb rehta hai), SL ke us taraf jidhar nuqsan
            // s2.5: NAZAR WALI baat mota rangeen label qeemat ke UPAR (BUY hara, SELL laal), tafseel NEECHE
            string h1 = (tD == 1 ? "▲ BUY" : "▼ SELL") + (slHit ? " · AAJ SL CHHU GAYA" : na(stC) ? "" : " · abhi " + f_r(tD * (stC - tE) / tR))
            string h2 = slHit ? "Band @ " + f_px(slPx) + " · ~" + f_r(slR) : "SL " + f_px(tSL) + (dDone ? ((tRk == -tD or pastCs) ? "\nDaily close ho chuki · BAND ka imkaan · agle session dekhein" : not na(csT) and csT != tSL ? "\nAgle session se SL " + f_px(csT) : "") : tRk == -tD ? "\nD1 palta: aaj DAILY close par BAND" : not na(csT) and csT != tSL ? "\nDAILY close " + f_px(csT) + (tD == 1 ? " ke neeche" : " ke upar") + " = BAND" : "")
            color  cH = slHit ? (nz(slR) > 0 ? C_BULL : C_BEAR) : (tD == 1 ? C_BULL : C_BEAR)
            if showLbl
                lbRiskH := label.new(bar_index + 2, nz(stC, tSL), h1 + "\n" + h2, xloc = xloc.bar_index,
                     style = tD == 1 ? label.style_label_upper_left : label.style_label_lower_left, size = fsC,
                     color = color.new(cH, 10), textcolor = color.white, textalign = text.align_left,
                     text_formatting = text.format_bold)
                lbRisk := label.new(bar_index + 2, nz(stC, tSL), t1 + "\n" + t2 + "\n" + t3, xloc = xloc.bar_index,
                     style = tD == 1 ? label.style_label_lower_left : label.style_label_upper_left, size = fsC,
                     color = color.new(#FFFFFF, 15), textcolor = C_TXT, textalign = text.align_left)
            // ABHI: entry se abhi ki qeemat tak (halka - ye faida/nuqsan hai, rukh nahi)
            if not slHit and not na(stC)
                float rNowV = tD * (stC - tE) / tR
                color cNow  = rNowV >= 0 ? C_BULL : C_BEAR
                bxNow := box.new(bar_index, math.max(tE, stC), rgt, math.min(tE, stC), xloc = xloc.bar_index,
                     border_color = color.new(cNow, 60), bgcolor = color.new(cNow, 93), text = "",
                     text_size = size.tiny, text_color = cNow, text_halign = text.align_left, text_valign = text.align_center)
            // kal ka SL: aaj ke daily close ke baad SL yahan sarkega (qeemat paar ho to dashed = close aisa raha to BAND)
            if not slHit and not na(csT) and csT != tSL and tRk != -tD
                lnNext := line.new(bar_index, csT, rgt, csT, xloc = xloc.bar_index, color = C_SL, style = pastCs ? line.style_dashed : line.style_dotted, width = 2)
        // --- NATEEJA: aakhri band trade (chart par nazar aaye to) -----------
        if not na(lXt) and lXt >= firstT and not na(lE) and not na(lX)
            string why = lWhy == 1 ? "SL" : lWhy == 4 ? "sarakta SL" : lWhy == 2 ? "D1 rukh palta" : lWhy == 3 ? "close SL ke paar" : "band"
            color  cRes = nz(tLR) > 0 ? C_BULL : C_BEAR
            bxRes := box.new(math.max(nz(lEt, firstT), firstT), math.max(lE, lX), lXt, math.min(lE, lX), xloc = xloc.bar_time,
                 border_color = color.new(cRes, 30), bgcolor = color.new(cRes, 85), text = "Tide " + f_r(tLR) + " · " + why,
                 text_size = fsC, text_color = cRes, text_halign = text.align_center, text_valign = text.align_center,
                 text_formatting = text.format_bold)
        // --- faisle ka waqt: aaj ki daily close (sirf chhoti TF par) ---------
        if showFaisla and not timeframe.isdaily and not na(dCt) and dCt > timenow and not na(stL) and not na(stH)
            lnDay := line.new(dCt, stL, dCt, stH + syminfo.mintick, xloc = xloc.bar_time, extend = extend.both,
                 color = color.new(C_PLAN, 40), style = line.style_dotted, width = 1)

// ============================================================================
//  SMC NISHAN (chart ki TF, sirf dikhawa, NAAPA NAHI) — s2.11: HAR TF (1m - 1M)
//  Tarteeb: (1) sab ta.* bahar, har candle par (Pine v6). (2) yaad (swing, toot,
//  sweep, FVG) sirf BAND candle par badalti. (3) nishan sirf AAKHRI candle par
//  bante - purane mita kar naye: repaint nahi, chhupi cheezein nahi, TradingView
//  ki hadd kabhi nahi bharti. Qeemat: asal candles stO/stH/stL/stC (Heikin Ashi
//  par bhi asal daam; aam chart par bilkul open/high/low/close).
//  Rang: upar wale hare (C_UP), neeche wale laal (C_DN), zone halke, FVG aur
//  halke - Tide ke dabbe sab se gehre rehte hain.
// ============================================================================
smcAct = smcOn                                   // s2.11: TF ki hadd khatam (pehle sirf 15m - 1D)
trS    = na(stC[1]) ? stH - stL : math.max(stH - stL, math.abs(stH - stC[1]), math.abs(stL - stC[1]))
atrC   = ta.rma(trS, 14)                         // chart TF ka ATR(14), asal candles se
e21    = ta.ema(stC, 21)
e63    = ta.ema(stC, 63)
ph     = ta.pivothigh(stH, swLen, swLen)
pl     = ta.pivotlow(stL, swLen, swLen)
refC   = barstate.isconfirmed ? stC : stC[1]     // aakhri BAND close: chalti candle par R / S / zone na uchhlein
smEND  = "\nBand candle par pakka (repaint nahi). Sirf dekhna - Tide ka faisla NAHI (Tide: sirf DAILY close, D1 rukh + " + str.tostring(entryLen) + " din ka toot)."
// bar_index wala x 9999 candle se peeche = script ruk jati (s2.2 ka sabaq) - har SMC ka bayan kinara is se
f_x(int b) => math.max(b, bar_index - 9990)
// nishan ka D1 rukh (Tide) se rishta - tooltip ke liye
f_rk(int rk, int d) => rk == d ? "D1 rukh bhi isi taraf (Tide ke saath)." : rk == -d ? "D1 rukh ULTA - Tide is taraf trade nahi deta." : "D1 rukh saaf nahi."

// --- MA: chart TF ki EMA21 / EMA63 (purani, default BAND) + s2.11 Tide ka APNA rukh: D1 EMA50 / EMA200
// D1 EMA: bilkul wahi values jin se tRk banta ([1] + lookahead_on = repaint nahi). Din bhar wohi EMA jo
// aaj ki DAILY close par Tide ka faisla karegi. Chhoti TF par qeemat se door ho to chhupi (warna
// TradingView candles ko patli lakeer bana deta). 1D aur bari TF par hamesha.
[dE50, dE200] = request.security(tkStd, "D", [ta.ema(close, emaFLen)[1], ta.ema(close, emaSLen)[1]], barmerge.gaps_off, barmerge.lookahead_on)
dmaLo  = (na(tfSec) or tfSec < 86400) and maFar > 0
pE50   = showDMA and not na(dE50) and (not dmaLo or math.abs(dE50 - stC) <= maFar * nz(atrC, 0)) ? dE50 : na
pE200  = showDMA and not na(dE200) and (not dmaLo or math.abs(dE200 - stC) <= maFar * nz(atrC, 0)) ? dE200 : na
cE50   = tRk == 1 ? C_BULL : tRk == -1 ? C_BEAR : color.new(chart.fg_color, 50)   // rukh ka rang (Tide wala hara / laal)
cE200  = color.new(chart.fg_color, 45)

plot(showMA ? e21 : na, "EMA21 (chart TF)", color = color.new(#42A5F5, 30), linewidth = 1, display = display.pane)
plot(showMA ? e63 : na, "EMA63 (chart TF)", color = color.new(#AB47BC, 30), linewidth = 1, display = display.pane)
p50  = plot(pE50, "Tide rukh EMA50 (D1)", color = cE50, style = plot.style_linebr, linewidth = 2, display = display.pane)
p200 = plot(pE200, "Tide rukh EMA200 (D1)", color = cE200, style = plot.style_linebr, linewidth = 2, display = display.pane)
fill(p50, p200, color = maFill ? color.new(cE50, 92) : na, title = "Tide rukh: EMA50 - EMA200 ke beech")

// --- s2.11 YAAD: har cheez pehle data mein (sirf band candle par), nishan baad mein (aakhri candle par)
// ek pakki swing = EK record: daam (R / S level), candle, zone (SZ / DZ) ke kinare, sweep ho chuka?
type SmcSwing
    float p
    int   b
    float zt
    float zb
    bool  swept = false

// BOS / CHOCH: level, swing candle -> toot candle, rukh (1 upar / -1 neeche), CHOCH?, us waqt D1 rukh
type SmcBreak
    float lvl
    int   x1
    int   x2
    int   dir
    bool  choch = false
    int   rk = 0

// LGB: sweep wala level, swing candle -> sweep candle, wick ka daam, teer (1 = LGB↑, -1 = LGB↓), D1 rukh
type SmcSweep
    float lvl
    int   x1
    int   x2
    float y
    int   dir
    int   rk = 0

// FVG: abhi tak KHULA hissa (top / bot), rukh, pehli candle
type SmcGap
    float top
    float bot
    int   dir
    int   x1

// daayen qatar ki ek likhai: daam, likhai, rang, tooltip, mota?
type SmcTag
    float  p
    string t
    color  c
    string k
    bool   bo = false

var array<SmcSwing> swH  = array.new<SmcSwing>()   // na-tooti chotiyan: R + SZ (aakhri 50)
var array<SmcSwing> swL  = array.new<SmcSwing>()   // na-tooti tahen: S + DZ (aakhri 50)
var array<SmcBreak> brk  = array.new<SmcBreak>()   // BOS / CHOCH (aakhri keepN + 2)
var array<SmcSweep> swp  = array.new<SmcSweep>()   // LGB (aakhri keepN + 2)
var array<SmcGap>   gaps = array.new<SmcGap>()     // khule FVG (aakhri 30)
var float sH    = na      // BOS ke liye: aakhri pakki choti / tah
var int   sHB   = na
var bool  sHBrk = true
var float sL    = na
var int   sLB   = na
var bool  sLBrk = true
var int   sDir  = 0       // structure: 1 = upar, -1 = neeche, 0 = abhi nahi

if barstate.isconfirmed
    // (1) BOS / CHOCH: is candle ka close PICHLI pakki swing ke paar? (s2.11: nayi swing is ke BAAD
    //     judti - pehle naya pivot purani swing ko mita deta tha aur us ka toot chhoot jata tha)
    bool upBrk = not sHBrk and not na(sH) and stC > sH
    bool dnBrk = not sLBrk and not na(sL) and stC < sL
    if upBrk
        array.push(brk, SmcBreak.new(sH, sHB, bar_index, 1, sDir < 0, tRk))
        sDir  := 1
        sHBrk := true
    else if dnBrk
        array.push(brk, SmcBreak.new(sL, sLB, bar_index, -1, sDir > 0, tRk))
        sDir  := -1
        sLBrk := true
    while array.size(brk) > keepN + 2
        array.shift(brk)
    // (2) har na-tooti swing (S / R + zone): close paar = TOOT (record khatam, phir R / S / zone nahi);
    //     sirf wick paar aur close wapas andar = SWEEP (LGB, ek swing par ek dafa). Ek candle ka ek
    //     LGB har taraf, sab se door wale sweep level par.
    float wH  = na
    int   wHB = na
    int   nH  = array.size(swH)
    if nH > 0
        for i = nH - 1 to 0
            SmcSwing hS = array.get(swH, i)
            if stC > hS.p
                array.remove(swH, i)
            else if not hS.swept and stH > hS.p and stC < hS.p
                hS.swept := true
                if na(wH) or hS.p > wH
                    wH  := hS.p
                    wHB := hS.b
    if not na(wH)
        array.push(swp, SmcSweep.new(wH, wHB, bar_index, stH, -1, tRk))
    float wL  = na
    int   wLB = na
    int   nL  = array.size(swL)
    if nL > 0
        for i = nL - 1 to 0
            SmcSwing lS = array.get(swL, i)
            if stC < lS.p
                array.remove(swL, i)
            else if not lS.swept and stL < lS.p and stC > lS.p
                lS.swept := true
                if na(wL) or lS.p < wL
                    wL  := lS.p
                    wLB := lS.b
    if not na(wL)
        array.push(swp, SmcSweep.new(wL, wLB, bar_index, stL, 1, tRk))
    while array.size(swp) > keepN + 2
        array.shift(swp)
    // (3) nayi pakki swing (pivot swLen candle pehle wali candle par) - S / R, zone aur BOS ke liye.
    //     Zone = swing candle ki wick se body tak, kam az kam 0.1 aur zyada se zyada 1 ATR mota.
    if not na(ph)
        int   bH = bar_index - swLen
        float aH = nz(atrC[swLen], stH[swLen] - stL[swLen])
        float zB = math.min(math.max(math.min(stO[swLen], stC[swLen]), ph - aH), ph - 0.1 * aH)
        array.push(swH, SmcSwing.new(ph, bH, ph, zB))
        if array.size(swH) > 50
            array.shift(swH)
        sH    := ph
        sHB   := bH
        sHBrk := false
    if not na(pl)
        int   bL = bar_index - swLen
        float aL = nz(atrC[swLen], stH[swLen] - stL[swLen])
        float zT = math.max(math.min(math.max(stO[swLen], stC[swLen]), pl + aL), pl + 0.1 * aL)
        array.push(swL, SmcSwing.new(pl, bL, zT, pl))
        if array.size(swL) > 50
            array.shift(swL)
        sL    := pl
        sLB   := bL
        sLBrk := false
    // (4) FVG: pehle purane (banne ke AGLE candle se): jitna bhara utna chhota, poora bhare to khatam
    int nG = array.size(gaps)
    if nG > 0
        for i = nG - 1 to 0
            SmcGap gS = array.get(gaps, i)
            if bar_index > gS.x1 + 2
                if gS.dir == 1
                    if stL <= gS.bot
                        array.remove(gaps, i)
                    else if stL < gS.top
                        gS.top := stL
                else
                    if stH >= gS.top
                        array.remove(gaps, i)
                    else if stH > gS.bot
                        gS.bot := stH
    // naya FVG: candle 1 aur 3 ke beech khula gap, aur BEECH wali candle poora gap paar kare - is se
    // session / weekend / chhutti ka khulne wala gap FVG nahi banta (har TF par). Kam az kam fvgMin x ATR.
    if not na(atrC)
        bool fvUp = stL > stH[2] and stL[1] <= stH[2] and stH[1] >= stL and stL - stH[2] >= fvgMin * atrC
        bool fvDn = stH < stL[2] and stH[1] >= stL[2] and stL[1] <= stH and stL[2] - stH >= fvgMin * atrC
        if fvUp
            array.push(gaps, SmcGap.new(stL, stH[2], 1, bar_index - 2))
        if fvDn
            array.push(gaps, SmcGap.new(stL[2], stH, -1, bar_index - 2))
        while array.size(gaps) > 30
            array.shift(gaps)

// --- NISHAN: sirf aakhri candle par (har dafa purane mita kar naye, ~40 cheezein) -----------
var array<line>  smLn = array.new<line>()
var array<label> smLb = array.new<label>()
var array<box>   smBx = array.new<box>()

// daayen qatar ki likhai: candles ke DAAYEN khali jagah mein (candles par nahi), text_formatting
// 'const' maangta hai - is liye do shakhen
f_tag(float _p, string _t, color _c, string _k, bool _bo, int _x) =>
    if _bo
        array.push(smLb, label.new(_x, _p, _t, xloc = xloc.bar_index, style = label.style_label_left, size = fsC,
             color = color.new(#FFFFFF, 100), textcolor = _c, tooltip = _k, text_formatting = text.format_bold))
    else
        array.push(smLb, label.new(_x, _p, _t, xloc = xloc.bar_index, style = label.style_label_left, size = fsC,
             color = color.new(#FFFFFF, 100), textcolor = _c, tooltip = _k))

// qareebi srN na-tooti swing (_up: daam ke upar = R, warna neeche = S); qareeb pehle, kisi chuni hui
// se _gap (0.2 ATR) ke andar ho to dobara nahi (1m par do chotiyan chand tick door = ek lakeer)
f_srPick(array<SmcSwing> _a, bool _up, float _ref, float _gap) =>
    array<int> _out = array.new<int>()
    int _n = array.size(_a)
    if _n > 0
        for _k = 1 to srN
            int   _best = -1
            float _bd   = na
            for _i = 0 to _n - 1
                SmcSwing _s = array.get(_a, _i)
                float _d    = _up ? _s.p - _ref : _ref - _s.p
                bool  _near = false
                for _j in _out
                    SmcSwing _o = array.get(_a, _j)
                    if math.abs(_o.p - _s.p) <= _gap
                        _near := true
                if _d >= 0 and not _near and (na(_bd) or _d < _bd)
                    _best := _i
                    _bd   := _d
            if _best >= 0
                array.push(_out, _best)
    _out

if barstate.islast
    while array.size(smLn) > 0
        line.delete(array.pop(smLn))
    while array.size(smLb) > 0
        label.delete(array.pop(smLb))
    while array.size(smBx) > 0
        box.delete(array.pop(smBx))
    int   xR   = bar_index + (showLbl ? rOff + 12 : rOff)   // daayen qatar (Tide ki likhai chalu ho to us se aage)
    int   xMin = bar_index - 9990
    float aC   = nz(atrC, 0)
    string rkNow = tRk == 1 ? "UPAR (sirf BUY)" : tRk == -1 ? "NEECHE (sirf SELL)" : "saaf nahi"
    array<SmcTag> tags = array.new<SmcTag>()
    bool zOn = showZone and smcAct
    // --- DZ / SZ: qareebi 1-1 (qeemat zone ke andar ho to wahi) --------------------------
    int   iSZ = -1
    int   iDZ = -1
    float bSZ = na
    float tDZ = na
    for [i, zH] in swH
        if na(bSZ) or zH.zb < bSZ
            iSZ := i
            bSZ := zH.zb
    for [i, zL] in swL
        if na(tDZ) or zL.zt > tDZ
            iDZ := i
            tDZ := zL.zt
    // --- S / R: qareebi srN na-tooti har taraf. Jo choti SZ wali hi ho us ki alag lakeer nahi -
    //     zone ka kinara wahi level hai, likhai ek: 'R 4143.40 · SZ↓' (do dafa ek hi baat nahi)
    bool rInZ = false
    bool sInZ = false
    if showSR
        array<int> rI = f_srPick(swH, true, refC, 0.2 * aC)
        array<int> sI = f_srPick(swL, false, refC, 0.2 * aC)
        for j in rI
            SmcSwing rS = array.get(swH, j)
            if zOn and j == iSZ
                rInZ := true
            else
                array.push(smLn, line.new(f_x(rS.b), rS.p, xR, rS.p, xloc = xloc.bar_index, color = color.new(C_DN, 25), style = line.style_dotted, width = 1))
                array.push(tags, SmcTag.new(rS.p, "R " + f_px(rS.p), C_DN, "R = Resistance " + f_px(rS.p) + " · pichli pakki CHOTI, abhi tak kisi band close ne nahi todi · qeemat yahan ruk / palat sakti. Close UPAR = toot (phir R nahi)." + smEND, false))
        for j in sI
            SmcSwing sS = array.get(swL, j)
            if zOn and j == iDZ
                sInZ := true
            else
                array.push(smLn, line.new(f_x(sS.b), sS.p, xR, sS.p, xloc = xloc.bar_index, color = color.new(C_UP, 25), style = line.style_dotted, width = 1))
                array.push(tags, SmcTag.new(sS.p, "S " + f_px(sS.p), C_UP, "S = Support " + f_px(sS.p) + " · pichli pakki TAH, abhi tak kisi band close ne nahi todi · qeemat yahan ruk / uchhal sakti. Close NEECHE = toot (phir S nahi)." + smEND, false))
    if zOn and iSZ >= 0
        SmcSwing zS = array.get(swH, iSZ)
        array.push(smBx, box.new(f_x(zS.b), zS.zt, xR, zS.zb, xloc = xloc.bar_index, border_color = color.new(C_DN, 55), border_width = 1, bgcolor = color.new(C_DN, 90)))
        string tipSZ = "SZ↓ = Supply zone (bechne wale) " + f_px(zS.zb) + " - " + f_px(zS.zt) + " · swing CHOTI wali candle (wick se body tak) · qeemat wapas aaye to ruk / palat sakti. Close UPAR = zone khatam.\n" + f_rk(tRk, -1) + smEND
        if rInZ
            array.push(tags, SmcTag.new(zS.p, "R " + f_px(zS.p) + " · SZ↓", C_DN, "R = Resistance " + f_px(zS.p) + " = isi zone ki choti, abhi tak kisi band close ne nahi todi.\n\n" + tipSZ, true))
        else
            array.push(tags, SmcTag.new((zS.zt + zS.zb) / 2, "SZ↓", C_DN, tipSZ, true))
    if zOn and iDZ >= 0
        SmcSwing zD = array.get(swL, iDZ)
        array.push(smBx, box.new(f_x(zD.b), zD.zt, xR, zD.zb, xloc = xloc.bar_index, border_color = color.new(C_UP, 55), border_width = 1, bgcolor = color.new(C_UP, 90)))
        string tipDZ = "DZ↑ = Demand zone (khareedar) " + f_px(zD.zb) + " - " + f_px(zD.zt) + " · swing TAH wali candle (wick se body tak) · qeemat wapas aaye to ruk / uchhal sakti. Close NEECHE = zone khatam.\n" + f_rk(tRk, 1) + smEND
        if sInZ
            array.push(tags, SmcTag.new(zD.p, "S " + f_px(zD.p) + " · DZ↑", C_UP, "S = Support " + f_px(zD.p) + " = isi zone ki tah, abhi tak kisi band close ne nahi todi.\n\n" + tipDZ, true))
        else
            array.push(tags, SmcTag.new((zD.zt + zD.zb) / 2, "DZ↑", C_UP, tipDZ, true))
    // --- FVG: qareebi 1 upar (FVG↓) + 1 neeche (FVG↑), sirf abhi tak KHULA hissa -------------
    if showFVG and smcAct
        int   iFU = -1
        int   iFD = -1
        float tFU = na
        float bFD = na
        for [i, gq] in gaps
            if gq.dir == 1 and (na(tFU) or gq.top > tFU)
                iFU := i
                tFU := gq.top
            if gq.dir == -1 and (na(bFD) or gq.bot < bFD)
                iFD := i
                bFD := gq.bot
        if iFU >= 0
            SmcGap gU = array.get(gaps, iFU)
            array.push(smBx, box.new(f_x(gU.x1), gU.top, xR, gU.bot, xloc = xloc.bar_index, border_color = color.new(C_UP, 60), border_style = line.style_dotted, border_width = 1, bgcolor = color.new(C_UP, 93)))
            array.push(tags, SmcTag.new((gU.top + gU.bot) / 2, "FVG↑", C_UP, "FVG↑ = Fair Value Gap " + f_px(gU.bot) + " - " + f_px(gU.top) + " · 3 candle ki tez chaal UPAR mein khula gap · qeemat aksar wapas aa kar bharti (wahan ruk / uchhal sakti) · jitna bhara utna chhota, poora bhare to khatam.\n" + f_rk(tRk, 1) + smEND, true))
        if iFD >= 0
            SmcGap gD = array.get(gaps, iFD)
            array.push(smBx, box.new(f_x(gD.x1), gD.top, xR, gD.bot, xloc = xloc.bar_index, border_color = color.new(C_DN, 60), border_style = line.style_dotted, border_width = 1, bgcolor = color.new(C_DN, 93)))
            array.push(tags, SmcTag.new((gD.top + gD.bot) / 2, "FVG↓", C_DN, "FVG↓ = Fair Value Gap " + f_px(gD.bot) + " - " + f_px(gD.top) + " · 3 candle ki tez chaal NEECHE mein khula gap · qeemat aksar wapas aa kar bharti (wahan ruk / palat sakti) · jitna bhara utna chhota, poora bhare to khatam.\n" + f_rk(tRk, -1) + smEND, true))
    // --- D1 EMA ki likhai (sirf jab lakeer chart par ho) ------------------------------------
    string tipE = "Tide ka RUKH = D1 EMA" + str.tostring(emaFLen) + " " + f_px(dE50) + " vs EMA" + str.tostring(emaSLen) + " " + f_px(dE200) + " · abhi rukh " + rkNow + ".\nEMA" + str.tostring(emaFLen) + " UPAR = sirf BUY, NEECHE = sirf SELL. Kal tak ki band daily candles se (repaint nahi) - aaj ki DAILY close par Tide isi se faisla karta. Ye Tide ka hissa hai; lakeer sirf dikhati hai."
    if not na(pE50)
        array.push(tags, SmcTag.new(pE50, "EMA" + str.tostring(emaFLen) + " D1", cE50, tipE, false))
    if not na(pE200)
        array.push(tags, SmcTag.new(pE200, "EMA" + str.tostring(emaSLen) + " D1", color.new(chart.fg_color, 20), tipE, false))
    // --- daayen EK qatar: daam ke hisaab se tarteeb; 0.3 ATR ke andar wali ek likhai mein (' · ')
    //     taake likhai ek dusre par na charhe
    int nT = array.size(tags)
    if nT > 0
        array<float> tagP = array.new<float>()
        for tg0 in tags
            array.push(tagP, tg0.p)
        array<int> ord = array.sort_indices(tagP, order.ascending)
        float  gSum = 0.0
        int    gCnt = 0
        float  gLst = na
        string gTxt = ""
        string gTip = ""
        color  gCol = na
        bool   gBo  = false
        for j in ord
            SmcTag tg = array.get(tags, j)
            if gCnt > 0 and tg.p - gLst > 0.3 * aC
                f_tag(gSum / gCnt, gTxt, gCol, gTip, gBo, xR)
                gSum := 0.0
                gCnt := 0
                gTxt := ""
                gTip := ""
                gBo  := false
            gTxt := gCnt == 0 ? tg.t : gTxt + " · " + tg.t
            gTip := gCnt == 0 ? tg.k : gTip + "\n\n" + tg.k
            gCol := gCnt == 0 ? tg.c : gCol == tg.c ? gCol : chart.fg_color
            gBo  := gBo or tg.bo
            gSum += tg.p
            gCnt += 1
            gLst := tg.p
        f_tag(gSum / gCnt, gTxt, gCol, gTip, gBo, xR)
    // --- BOS / CHOCH: swing se toot tak lakeer, likhai lakeer ke BEECH (upar toot: likhai upar).
    //     BOS = seedhi patli, CHOCH = moti nuqte wali + rangeen label. Aakhri 2 (aur aakhri CHOCH)
    //     gehre, purane halke - peeche scroll karein to structure ki kahani nazar aaye.
    if showBOS and smcAct
        int nB     = array.size(brk)
        int lastCh = -1
        for [i, eB] in brk
            if eB.choch
                lastCh := i
        for [i, eB] in brk
            if eB.x2 >= xMin
                bool   bStrong = i >= nB - 2 or i == lastCh
                color  cB = eB.dir == 1 ? C_UP : C_DN
                int    bx1 = f_x(eB.x1)
                int    bxm = int((bx1 + eB.x2) / 2)
                string bNm = (eB.choch ? "CHOCH" : "BOS") + (eB.dir == 1 ? "↑" : "↓")
                string bTip = eB.choch ? (eB.dir == 1 ? "CHOCH↑ = pehla ULTA toot: neeche wala silsila toota (choti " + f_px(eB.lvl) + " ke UPAR band close) · rukh badalne ka PEHLA ishara, pakka nahi. Tide ka rukh sirf D1 EMA se badalta." : "CHOCH↓ = pehla ULTA toot: upar wala silsila toota (tah " + f_px(eB.lvl) + " ke NEECHE band close) · rukh badalne ka PEHLA ishara, pakka nahi. Tide ka rukh sirf D1 EMA se badalta.") : (eB.dir == 1 ? "BOS↑ = candle pichli pakki CHOTI " + f_px(eB.lvl) + " ke UPAR band hui · structure UPAR jari." : "BOS↓ = candle pichli pakki TAH " + f_px(eB.lvl) + " ke NEECHE band hui · structure NEECHE jari.")
                array.push(smLn, line.new(bx1, eB.lvl, eB.x2, eB.lvl, xloc = xloc.bar_index, color = color.new(cB, eB.choch ? (bStrong ? 0 : 60) : (bStrong ? 15 : 65)),
                     style = eB.choch ? line.style_dashed : line.style_solid, width = eB.choch and bStrong ? 2 : 1))
                array.push(smLb, label.new(bxm, eB.lvl, bNm, xloc = xloc.bar_index, style = eB.dir == 1 ? label.style_label_down : label.style_label_up, size = fsC,
                     color = eB.choch ? color.new(cB, bStrong ? 0 : 55) : color.new(#FFFFFF, 100), textcolor = eB.choch ? color.new(color.white, bStrong ? 0 : 25) : color.new(cB, bStrong ? 0 : 50),
                     tooltip = bTip + "\nUs waqt: " + f_rk(eB.rk, eB.dir) + smEND, text_formatting = text.format_bold))
    // --- LGB: sweep candle ki wick par teer (s2.5: teer = umeed ki taraf) + sweep hue level ki
    //     chhoti nuqte wali lakeer (kaun si choti / tah uthai gayi)
    if showLGB and smcAct
        int nS = array.size(swp)
        for [i, eS] in swp
            if eS.x2 >= xMin
                bool  sStrong = i >= nS - 2
                color cS = eS.dir == 1 ? C_UP : C_DN
                string sTip = eS.dir == -1 ? "LGB↓ = liquidity sweep: wick pichli pakki CHOTI " + f_px(eS.lvl) + " ke UPAR gayi, close wapas NEECHE · upar ke stop uthaye, toot jhoota · teer = neeche ka imkaan.\nUs waqt: " + f_rk(eS.rk, -1) + "\n(SMC Coach mein isi ko LGB↑ kehte.)" : "LGB↑ = liquidity sweep: wick pichli pakki TAH " + f_px(eS.lvl) + " ke NEECHE gayi, close wapas UPAR · neeche ke stop uthaye, toot jhoota · teer = upar ka imkaan.\nUs waqt: " + f_rk(eS.rk, 1) + "\n(SMC Coach mein isi ko LGB↓ kehte.)"
                array.push(smLn, line.new(f_x(eS.x1), eS.lvl, eS.x2, eS.lvl, xloc = xloc.bar_index, color = color.new(cS, sStrong ? 40 : 70), style = line.style_dotted, width = 1))
                array.push(smLb, label.new(eS.x2, eS.y, eS.dir == 1 ? "LGB↑" : "LGB↓", xloc = xloc.bar_index, style = eS.dir == 1 ? label.style_label_up : label.style_label_down, size = fsC,
                     color = color.new(#FFFFFF, 100), textcolor = color.new(cS, sStrong ? 0 : 45), tooltip = sTip + smEND, text_formatting = text.format_bold))

// --- s2.11 PEHCHAN: har nishan ka matlab, alag chhoti table (default BAND - HIDAYAT 19 Oct;
//     Settings → 7). Tide ki table ko haath nahi lagaya; usi kone mein ho to upar / neeche badal jati.
f_flip(string s) => s == "Top Right" ? "Bottom Right" : s == "Top Left" ? "Bottom Left" : s == "Bottom Right" ? "Top Right" : "Top Left"
legPosE = showTable and legPos == tablePos ? f_flip(legPos) : legPos
var table lg = table.new(f_pos(legPosE), 3, 9, border_width = 0)
f_lgRow(int _r, string _a, color _ca, string _b, color _cb, string _m, string _tip, string _fs, color _bg) =>
    table.cell(lg, 0, _r, _a, text_color = _ca, bgcolor = _bg, text_size = _fs, text_halign = text.align_center, tooltip = _tip, text_formatting = text.format_bold)
    table.cell(lg, 1, _r, _b, text_color = _cb, bgcolor = _bg, text_size = _fs, text_halign = text.align_center, tooltip = _tip, text_formatting = text.format_bold)
    table.cell(lg, 2, _r, _m, text_color = chart.fg_color, bgcolor = _bg, text_size = _fs, text_halign = text.align_left, tooltip = _tip)

if showLeg and barstate.islast
    string lfs = f_size(legFont)
    color  lbg = tblClear ? color.new(#FFFFFF, 100) : color.new(chart.bg_color, 10)
    table.clear(lg, 0, 0, 2, 8)
    int r = 0
    f_lgRow(r, "PEHCHAN", chart.fg_color, "", chart.fg_color, "sirf dekhna · faisla sirf Tide", "Har nishan par mouse rakhein - tooltip mein poora matlab. SMC kabhi naapa nahi gaya; Tide ka faisla sirf DAILY close par (badi table).", lfs, lbg)
    r += 1
    if smcAct and showBOS
        f_lgRow(r, "BOS↑", C_UP, "BOS↓", C_DN, "toot · structure jari", "BOS = pichli pakki choti / tah ke paar BAND close · structure usi taraf jari. Seedhi patli lakeer, likhai beech mein.", lfs, lbg)
        r += 1
        f_lgRow(r, "CHOCH↑", C_UP, "CHOCH↓", C_DN, "ulta toot · rukh badla?", "CHOCH = structure ke ULTA pehla toot · rukh badalne ka pehla ishara, pakka nahi. Moti nuqte wali lakeer + rangeen label. Tide ka rukh sirf D1 EMA se badalta.", lfs, lbg)
        r += 1
    if showSR
        f_lgRow(r, "S", C_UP, "R", C_DN, "na-tooti tah / choti", "S = neeche ki pakki tah, R = upar ki pakki choti (Elder / Weinstein) - jo abhi tak kisi band close ne nahi todi. Nuqte wali lakeer.", lfs, lbg)
        r += 1
    if smcAct and showZone
        f_lgRow(r, "DZ↑", C_UP, "SZ↓", C_DN, "khareed / farokht zone", "DZ = swing tah wali candle ka zone (khareedar), SZ = swing choti wali (bechne wale). Band close zone ke paar = khatam.", lfs, lbg)
        r += 1
    if smcAct and showFVG
        f_lgRow(r, "FVG↑", C_UP, "FVG↓", C_DN, "khula gap (bharta hai)", "FVG = 3 candle ki tez chaal mein khula gap (beech wali candle poora paar). Jitna bhara utna chhota, poora bhare to khatam. Halka dabba, nuqte wala kinara.", lfs, lbg)
        r += 1
    if smcAct and showLGB
        f_lgRow(r, "LGB↑", C_UP, "LGB↓", C_DN, "sweep · wick paar, close wapas", "LGB = liquidity sweep: wick swing ke paar, close wapas andar. Teer = umeed ki taraf (choti ka sweep = LGB↓ laal).", lfs, lbg)
        r += 1
    if showDMA
        string door = not na(dE50) and (na(pE50) or na(pE200)) ? " (door - chhupi)" : ""
        f_lgRow(r, "EMA" + str.tostring(emaFLen), cE50, "EMA" + str.tostring(emaSLen), color.new(chart.fg_color, 20), (tRk == 1 ? "D1 rukh UPAR = sirf BUY" : tRk == -1 ? "D1 rukh NEECHE = sirf SELL" : "D1 rukh saaf nahi") + door, "Tide ka RUKH: D1 EMA50 upar EMA200 = sirf BUY, neeche = sirf SELL (kal tak ki band daily candles). Chhoti TF par qeemat se door ho to lakeer chhupi - chart chapta na ho (Settings → 7).", lfs, lbg)

// ============================================================================
//  TABLE (Top Right, chhoti) — sirf aakhri candle par
// ============================================================================
var table tb = table.new(f_pos(tablePos), 2, 9, border_width = 1, border_color = color.new(#CFD8DC, tblClear ? 75 : 0))
// s2.9: transparent table - safed dabba gayab, rangeen dabba halka, likhai chart ke rang mein
f_tbg(color c) => tblClear ? color.new(c, c == color.new(#FFFFFF, 10) ? 100 : tblAlpha) : c
f_ttc(color c) => tblClear and (c == C_TXT or c == color.white) ? chart.fg_color : c
// text_formatting 'const' maangta hai - is liye do shakhen, har ek mein seedha constant
f_row(table t, int r, string a, string b0, color bgB, color fgB, string fs, string tip, bool bo) =>
    // s2.7: patli table - har ' · ' nayi line (table daayen khali hisse mein rahe)
    string b = thinTbl ? str.replace_all(b0, " · ", "\n") : b0
    if bo
        table.cell(t, 0, r, a, text_color = f_ttc(C_TXT), bgcolor = f_tbg(color.new(#FFFFFF, 10)), text_size = fs, text_halign = text.align_left, tooltip = tip, text_formatting = text.format_bold)
        table.cell(t, 1, r, b, text_color = f_ttc(fgB), bgcolor = f_tbg(bgB), text_size = fs, text_halign = text.align_left, tooltip = tip, text_formatting = text.format_bold)
    else
        table.cell(t, 0, r, a, text_color = f_ttc(C_TXT), bgcolor = f_tbg(color.new(#FFFFFF, 10)), text_size = fs, text_halign = text.align_left, tooltip = tip)
        table.cell(t, 1, r, b, text_color = f_ttc(fgB), bgcolor = f_tbg(bgB), text_size = fs, text_halign = text.align_left, tooltip = tip)

if showTable and barstate.islast
    fs  = f_size(tableFont)
    bgW = color.new(#FFFFFF, 10)
    cG  = color.new(#78909C, 0)
    table.clear(tb, 0, 0, 1, 8)
    bool   dDone    = not na(dCt) and timenow >= dCt
    string closeTxt = dDone ? "agle session ki PEHLI candle" : str.format_time(dCt, "HH:mm", tz) + " " + tzName
    bool   utc0     = not na(dCt) and hour(dCt, "UTC") == 0 and minute(dCt, "UTC") == 0
    float  rNow     = tD != 0 and not na(tR) and tR > 0 and not na(stC) ? tD * (stC - tE) / tR : na
    float  rSL      = tD != 0 and not na(tR) and tR > 0 ? tD * (tSL - tE) / tR - 2.0 * costPct / 100.0 * tE / tR : na
    float  slR      = slHit and not na(tR) and tR > 0 ? tD * (slPx - tE) / tR - 2.0 * costPct / 100.0 * tE / tR : na
    float  lvl      = tRk == 1 ? tUp : tRk == -1 ? tDn : na
    float  slp      = na(lvl) or na(tAtr) ? na : lvl - tRk * atrMult * tAtr
    string sdTxt    = tD == 1 or (tD == 0 and tRk == 1) ? "BUY" : "SELL"
    // Row 0: naam
    string tip0 = "Feed: " + syminfo.prefix + ":" + syminfo.ticker + ". Is feed ki daily candle " + (na(dCt) ? "-" : str.format_time(dCt, "HH:mm", "UTC")) + " UTC par band hoti hai; Exness D1 00:00 UTC - level JasTideRadarEA panel se milayein.\nSELL ka SL ask par lagta hai (spread jitna pehle).\nSMC nishan kabhi naape nahi gaye.\nDin ki hadd dekhni ho: TradingView mein Session breaks on karein."
    f_row(tb, 0, "TIDE 1D · " + BUILD, isHi ? "Tide 1D ka system · 1D/4H/1H par dekhein" : syminfo.ticker + " · faisla sirf DAILY close", bgW, C_TXT, fs, tip0, false)
    // Row 1: HAAL (sirf khuli trade par rangeen)
    string haal = not tOk ? "200 din ka daily data chahiye" : slHit ? "AAJ SL CHHU GAYA" : tD == 1 ? "▲ BUY chalu · " + str.tostring(tAge) + " din" : tD == -1 ? "▼ SELL chalu · " + str.tostring(tAge) + " din" : tRk == 1 ? "INTEZAR · rukh UPAR (sirf BUY)" : tRk == -1 ? "INTEZAR · rukh NEECHE (sirf SELL)" : "INTEZAR · rukh saaf nahi"
    color  hBg  = tD == 0 ? bgW : slHit ? (nz(slR) > 0 ? C_BULL : C_BEAR) : tD == 1 ? C_BULL : C_BEAR
    f_row(tb, 1, "HAAL", haal, hBg, tD == 0 ? C_TXT : color.white, fs, "Tide ka haal aakhri BAND daily candle tak. Rukh = D1 EMA50/200.", true)
    // Row 6: NAAP (hamesha sleti - kabhi hara nahi)
    float exT  = tN > 0 ? tSR / tN : na
    float se2  = tN > 1 ? 2.0 * math.sqrt(math.max(tSQ - tSR * tSR / tN, 0.0) / (tN - 1)) / math.sqrt(tN) : na
    float pfT  = tSLs > 0 ? tSW / tSLs : na
    float ex19 = n19 > 0 ? s19 / n19 : na
    float se19 = n19 > 1 ? 2.0 * math.sqrt(math.max(q19 - s19 * s19 / n19, 0.0) / (n19 - 1)) / math.sqrt(n19) : na
    bool  sabit = n19 >= 30 and not na(se19) and ex19 - se19 > 0
    string naap = tN == 0 ? "Abhi koi band trade nahi" : "Sab: " + str.tostring(tN) + " · Exp " + f_r(exT) + (na(se2) ? "" : " ±" + str.tostring(se2, "0.00")) + " · PF " + (na(pfT) ? "-" : str.tostring(pfT, "0.00")) + "\n" + str.tostring(statYear) + " se: " + str.tostring(n19) + (n19 > 0 ? " · Exp " + f_r(ex19) + (na(se19) ? "" : " ±" + str.tostring(se19, "0.00")) : "") + " · " + (sabit ? "SABIT" : "SABIT NAHI") + "\nswap/spread nahi gina"
    if showNaap
        f_row(tb, 6, "NAAP (1D)", naap, bgW, cG, fs, "Isi symbol ki daily history par Tide ke band trades (kharcha 0.005% har taraf). SABIT = " + str.tostring(statYear) + " se kam az kam 30 trades aur Exp - 2SE > 0. Purana naap aage ki zamanat nahi.", false)
    if not isHi
        // Row 2: MT5 MEIN (sirf yahi karna hai)
        string mt5 = ""
        bool   pastCs = tD != 0 and not na(csT) and not na(stC) and (tD == 1 ? stC <= csT : stC >= csT)
        string csRule = na(csT) or csT == tSL ? "" : dDone ? " · agle session se SL " + f_px(csT) : " · aaj close " + f_px(csT) + (tD == 1 ? " ke neeche" : " ke upar") + " = BAND, warna kal se SL " + f_px(csT)
        if slHit
            mt5 := "SL chhu gaya · MT5 mein band hui? check karein · nayi trade sirf band daily candle ke toot se"
        else if dDone and tD != 0 and (tRk == -tD or pastCs)
            mt5 := "Daily close ho chuki · trade band hone ka imkaan · agle session ki PEHLI candle par table dekhein"
        else if tD != 0 and tRk == -tD
            mt5 := "D1 rukh palta · aaj daily close (" + closeTxt + ") par BAND karein"
        else if tD != 0 and pastCs
            mt5 := "Qeemat naye SL " + f_px(csT) + " ke paar · daily close aisa raha to close par BAND karein (abhi SL " + f_px(tSL) + ")"
        else if dDone and tD != 0 and tAge == 0
            mt5 := "Entry ka din BAND ho chuka · der se entry NAHI · SL " + f_px(tSL) + csRule + " · agle session ki PEHLI candle par table dekhein"
        else if tD != 0 and tAge == 0
            mt5 := sdTxt + " kholein · SL " + f_px(tSL) + " · TP khali" + csRule
        else if tD != 0
            mt5 := "Nayi entry NAHI · SL " + f_px(tSL) + csRule + " · TP nahi"
        else if not na(exDay) and exDay == dayT and (lWhy == 2 or lWhy == 3)
            mt5 := "Tide trade pichli daily close par band (" + (lWhy == 2 ? "D1 rukh palta" : "close SL ke paar") + ") · MT5 mein khuli ho to ABHI band karein"
        else if dDone
            mt5 := "Kuch nahi abhi · agle session ki PEHLI candle par table dekhein"
        else
            mt5 := "Kuch nahi · " + closeTxt + " ke baad dekhein"
        f_row(tb, 2, "MT5 MEIN", mt5, bgW, C_TXT, fs, "Sirf yahi karna hai. Entry sirf daily close ke baad, BUY/SELL Stop ya pending order nahi. TP kabhi nahi.", true)
        // Row 3: KAB
        string kab = dDone ? "Daily candle BAND ho chuki · Tide ka faisla agle session ki PEHLI candle par" : "Daily band " + closeTxt + " · " + f_dur(dCt - timenow)
        f_row(tb, 3, "KAB", kab, bgW, C_TXT, fs, "Tide ka har faisla daily candle BAND hone par. Chhoti TF ki candle level ke paar ho jaye to bhi faisla nahi.", false)
        // Row 4: RISK
        string rsk = slHit ? "nateeja ~" + f_r(slR) + " (band @ " + f_px(slPx) + ")" : tD != 0 ? "abhi " + f_r(rNow) + " · SL par ~" + f_r(rSL) : na(slp) ? "-" : "Toot " + f_px(lvl) + " · SL ~" + f_px(slp) + " · 1R ~" + f_px(atrMult * tAtr)
        f_row(tb, 4, "RISK", rsk, bgW, C_TXT, fs, "1R = entry se shuru ke SL tak (2 ATR). R mein kharcha gina, swap/spread nahi.", true)
        // Row 5: LOT (MT5) - TradingView broker ka contract nahi janta: V aap bharein
        string lotTxt = ""
        if tD != 0 and (tAge >= 1 or dDone) and not slHit
            lotTxt := "Is trade mein nayi entry NAHI (lot nahi)"
        else if bal <= 0 or vMove <= 0
            lotTxt := "Balance aur V bharein (Settings → 4 · Lot)"
        else if vSym == "" or not (str.contains(str.upper(syminfo.ticker), str.upper(vSym)) or str.contains(str.upper(vSym), str.upper(syminfo.ticker)))
            lotTxt := vSym == "" ? "V kis symbol ki? (Settings → 4 · Lot)" : "V " + vSym + " ki hai · is symbol ki bharein"
        else
            // entry ke din der se: abhi ki qeemat se SL tak zyada door ho to usi se (risk % se zyada kabhi nahi)
            float dLate = tD != 0 and tAge == 0 and not slHit and not na(stC) ? tD * (stC - tSL) : na
            bool  late  = not na(dLate) and dLate > tR
            float dist  = tD != 0 and not slHit ? (late ? dLate : tR) : (na(tAtr) ? na : atrMult * tAtr)
            float risk  = bal * riskPct / 100.0
            float one   = na(dist) ? na : dist * vMove   // 0.01 lot ka SL tak nuqsan (account currency)
            if not na(dLate) and dLate <= 0
                lotTxt := "Qeemat SL ke paar · entry NAHI"
            else if na(one) or one <= 0
                lotTxt := "-"
            else
                float lots = math.floor(risk / one) * 0.01
                lotTxt := lots < 0.01 ? "0.01 = " + str.tostring(100.0 * one / bal, "0.0") + "% risk (aap ne " + str.tostring(riskPct, "0.0") + "%) · trade NAHI" : "~" + str.tostring(lots, "0.00") + " lot (" + str.tostring(riskPct, "0.0") + "% = " + str.tostring(risk, "#,###") + " " + curTxt + ") · 0.01 lot ka SL tak " + str.tostring(one, "#,##0.00") + " · MT5 se milayein" + (late ? " · abhi ki qeemat se (der se entry, NAAPA NAHI)" : "")
        if showLot
            f_row(tb, 5, "LOT", lotTxt, bgW, C_TXT, fs, "Lot kabhi upar gol nahi hota. Pehle demo par 0.01 lot ka test order khol kar 1R MT5 se milayein.", false)
        // Row 7: DHYAN (sirf zaroorat par)
        string dh = ""
        if not utc0 and not na(dCt)
            dh := "Feed ka din " + str.format_time(dCt, "HH:mm", "UTC") + " UTC par band · MT5 (00:00 UTC) ka level thora alag"
        if tD != 0 and tAge == 0 and not slHit and not dDone and not na(rNow)
            dh := dh + (dh == "" ? "" : "\n") + (rNow <= -1 ? "Qeemat SL ke paar · entry NAHI" : "Entry daily close par thi · abhi farq " + f_r(rNow) + " · der se entry NAAPA NAHI")
        if dh != ""
            f_row(tb, 7, "DHYAN", dh, bgW, C_BEAR, fs, "Ye baatein faisla nahi badaltin, sirf hoshiyari.", false)
    if str.startswith(tablePos, "Bottom")
        table.cell(tb, 0, 8, " ", bgcolor = color.new(#FFFFFF, 100), text_size = fs)

// ============================================================================
//  ALERTS (Create Alert → "Any alert() function call") - din mein ek faisla
// ============================================================================
if not barstate.ishistory and not isHi
    if endTrade
        alert("Tide " + syminfo.ticker + ": trade band " + f_r(tLR), alert.freq_once_per_bar)
    if newT
        alert("Tide " + syminfo.ticker + ": " + (tD == 1 ? "BUY" : "SELL") + " khuli @ " + f_px(tE) + " · SL " + f_px(tSL) + " · TP nahi", alert.freq_once_per_bar)
    else if tD != 0 and tSL != tSL[1]
        alert("Tide " + syminfo.ticker + ": SL sarkao → " + f_px(tSL), alert.freq_once_per_bar)
