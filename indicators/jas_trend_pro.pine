//@version=6
// JAS Trend Pro t3.4 (30 Oct 2026) - ATR Supertrend (10, 3.0), repaint nahi (nishan sirf band candle par)
// t2: chhote B / S nishan; daayen dabba = rukh, SL, chalti trade (sirf BUY) + is chart ka nateeja.
// t3: 4H (Koshish #34 ASLI PASS: 4H TOKRI XAU, XAG, US500, USTEC, sirf BUY; 2019+ 641 tr +0.208R) + 1D (#26).
//     Dabbe mein "Pakka TF" is chart ki TF ke hisaab se. Patli S/R lakeerein (band pivot, qareeb wali mila di).
// t3.1: 1D pehchaan theek. t3.2: Resistance laal, Support hari (patli dashed).
// t3.3: neeche TOKRI table - 4 market (isi TF par) ka sirf-BUY nateeja + KUL (Exp, Exp - 2SE), wahi qaida.
// t3.4: B / S nishan default BAND (setting se on). LuxAlgo "SuperTrend AI (Clustering)" andar (CC BY-NC-SA 4.0, (c) LuxAlgo):
//       ATR, factor range / step, performance memory, cluster, AI lakeer + AMA + candle rang + score nishan.
//       AI hissa sirf DEKHNE ke liye (test NAHI hua) - dabba / tokri ka nateeja wahi PASS wala Supertrend 10/3.
// Koshish #26 ASLI PASS (28 Oct): 1D, 6 market tokri (XAU, XAG, XPT, USOIL, SPX, NDX), SIRF BUY:
//   B = BUY agli candle ke open par, S = BUY band agli open par (short nahi), 1R = 3 x ATR(10), kharcha 0.03%/taraf.
// Dabbe ka nateeja sirf ANDAZA (is chart ka saara data, EMA filter ke baghair) - sahi nateeja MT5 / demo se.
indicator("JAS Trend Pro t3.4", shorttitle="JAS Trend t3.4", overlay=true, max_lines_count=50, max_labels_count=500)

// Settings - default hi pakki hain, badalne ki zaroorat nahi
atrLen   = input.int(10, "ATR length", minval=1, group="Trend")
atrMult  = input.float(3.0, "ATR multiplier", minval=0.1, step=0.1, group="Trend")
useEma   = input.bool(false, "EMA 200 filter", group="Filter")
emaLen   = input.int(200, "EMA length", minval=1, group="Filter")
colorBar = input.bool(false, "Candle rangat", group="Dikhawa")
showBS   = input.bool(false, "B / S nishan", group="Dikhawa")
showBox  = input.bool(true, "Dabba", group="Dikhawa")
srOn     = input.bool(true, "S/R lakeerein", group="S/R")
srLen    = input.int(10, "Pivot (dono taraf candle)", minval=2, group="S/R")
srCount  = input.int(3, "Upar / neeche kitni", minval=1, maxval=6, group="S/R")
srMerge  = input.float(0.5, "Qareeb mila do (x ATR)", minval=0.0, step=0.1, group="S/R")
resCol   = input.color(color.new(#ef5350, 25), "Resistance (upar)", group="S/R")
supCol   = input.color(color.new(#26a69a, 25), "Support (neeche)", group="S/R")
tokOn    = input.bool(true, "Tokri table", group="Tokri (#34)")
tk1      = input.symbol("OANDA:XAUUSD", "1", group="Tokri (#34)")
tk2      = input.symbol("OANDA:XAGUSD", "2", group="Tokri (#34)")
tk3      = input.symbol("OANDA:SPX500USD", "3", group="Tokri (#34)")
tk4      = input.symbol("OANDA:NAS100USD", "4", group="Tokri (#34)")
GAI      = "AI Supertrend (LuxAlgo) - test nahi"
aiOn     = input.bool(true, "AI Supertrend dikhao", group=GAI)
aiLen    = input.int(10, "ATR Length", minval=1, group=GAI)
aiMin    = input.int(1, "Factor Range", minval=0, inline="aif", group=GAI)
aiMax    = input.int(5, "", minval=0, inline="aif", group=GAI)
aiStep   = input.float(0.5, "Step", minval=0.1, step=0.1, group=GAI)
aiAlpha  = input.float(10, "Performance Memory", minval=2, group=GAI)
aiFrom   = input.string("Best", "From Cluster", options=["Best", "Average", "Worst"], group=GAI)
aiIter   = input.int(1000, "Maximum Iteration Steps", minval=0, group=GAI)
aiData   = input.int(10000, "Historical Bars Calculation", minval=0, group=GAI)
aiAma    = input.bool(true, "AMA lakeer", group=GAI)
aiCandle = input.bool(true, "Candle Coloring (AI)", group=GAI)
aiSig    = input.bool(true, "AI score nishan (0-10)", group=GAI)

colUp = color.new(#26a69a, 0)
colDn = color.new(#ef5350, 0)

[st, dir] = ta.supertrend(atrMult, atrLen)
isUp  = dir < 0
ema   = ta.ema(close, emaLen)
since = ta.barssince(dir != dir[1])

flipUp = isUp and not isUp[1]
flipDn = not isUp and isUp[1]
buySig  = flipUp and (not useEma or close > ema) and barstate.isconfirmed
sellSig = flipDn and (not useEma or close < ema) and barstate.isconfirmed

plot(isUp ? st : na, "BUY line", colUp, 2, plot.style_linebr)
plot(isUp ? na : st, "SELL line", colDn, 2, plot.style_linebr)
plot(useEma ? ema : na, "EMA 200", color.new(color.gray, 30), 1)

plotshape(showBS and buySig, "BUY", shape.labelup, location.belowbar, colUp, text="B", textcolor=color.white, size=size.tiny)
plotshape(showBS and sellSig, "SELL", shape.labeldown, location.abovebar, colDn, text="S", textcolor=color.white, size=size.tiny)

// ---- AI Supertrend (LuxAlgo clustering, CC BY-NC-SA 4.0) - sirf dikhawa ----
type aiST
    float upper = hl2
    float lower = hl2
    float output
    float perf = 0
    float factor
    int trend = 0

type aiVec
    array<float> out

var aiHolder  = array.new<aiST>(0)
var aiFactors = array.new<float>(0)
if barstate.isfirst and aiOn
    if aiMin > aiMax
        runtime.error("AI: Factor Range ka pehla number doosre se bara hai")
    for i = 0 to int((aiMax - aiMin) / aiStep)
        aiFactors.push(aiMin + i * aiStep)
        aiHolder.push(aiST.new())

aiAtr = ta.atr(aiLen)
aiDen = ta.ema(math.abs(close - close[1]), int(aiAlpha))

var array<aiVec> aiFClu = na
var array<aiVec> aiPClu = na
var float aiTarget = na
var float aiPerf = na
var float aiPama = na
var aiUpper = hl2
var aiLower = hl2
var int aiOs = 0
float aiTs = na
aiFromIdx = aiFrom == "Best" ? 2 : aiFrom == "Average" ? 1 : 0

if aiOn
    k = 0
    for f in aiFactors
        g = aiHolder.get(k)
        upF = hl2 + aiAtr * f
        dnF = hl2 - aiAtr * f
        g.trend := close > g.upper ? 1 : close < g.lower ? 0 : g.trend
        g.upper := close[1] < g.upper ? math.min(upF, g.upper) : upF
        g.lower := close[1] > g.lower ? math.max(dnF, g.lower) : dnF
        diff = nz(math.sign(close[1] - g.output))
        g.perf += 2 / (aiAlpha + 1) * (nz(close - close[1]) * diff - g.perf)
        g.output := g.trend == 1 ? g.lower : g.upper
        g.factor := f
        k += 1
    if last_bar_index - bar_index <= aiData
        data = array.new<float>(0)
        facA = array.new<float>(0)
        for el in aiHolder
            data.push(el.perf)
            facA.push(el.factor)
        cents = array.from(data.percentile_linear_interpolation(25), data.percentile_linear_interpolation(50), data.percentile_linear_interpolation(75))
        for _ = 0 to aiIter
            aiFClu := array.from(aiVec.new(array.new<float>(0)), aiVec.new(array.new<float>(0)), aiVec.new(array.new<float>(0)))
            aiPClu := array.from(aiVec.new(array.new<float>(0)), aiVec.new(array.new<float>(0)), aiVec.new(array.new<float>(0)))
            j = 0
            for v in data
                d0 = math.abs(v - cents.get(0))
                d1 = math.abs(v - cents.get(1))
                d2 = math.abs(v - cents.get(2))
                idx = d0 <= d1 and d0 <= d2 ? 0 : d1 <= d2 ? 1 : 2
                aiPClu.get(idx).out.push(v)
                aiFClu.get(idx).out.push(facA.get(j))
                j += 1
            nc = array.from(aiPClu.get(0).out.avg(), aiPClu.get(1).out.avg(), aiPClu.get(2).out.avg())
            if nc.get(0) == cents.get(0) and nc.get(1) == cents.get(1) and nc.get(2) == cents.get(2)
                break
            cents := nc
    if not na(aiPClu)
        aiTarget := nz(aiFClu.get(aiFromIdx).out.avg(), aiTarget)
        aiPerf := math.max(nz(aiPClu.get(aiFromIdx).out.avg()), 0) / aiDen
    upA = hl2 + aiAtr * aiTarget
    dnA = hl2 - aiAtr * aiTarget
    aiUpper := close[1] < aiUpper ? math.min(upA, aiUpper) : upA
    aiLower := close[1] > aiLower ? math.max(dnA, aiLower) : dnA
    aiOs := close > aiUpper ? 1 : close < aiLower ? 0 : aiOs
    aiTs := aiOs == 1 ? aiLower : aiUpper
    if na(aiTs[1]) and not na(aiTs)
        aiPama := aiTs
    else
        aiPama += aiPerf * (aiTs - aiPama)

aiCss = aiOs == 1 ? color.teal : color.red
aiCross = ta.cross(close, aiPama)
plot(aiOn ? aiTs : na, "AI Trailing Stop", aiOs != aiOs[1] ? na : aiCss)
plot(aiOn and aiAma ? aiPama : na, "AI AMA", aiCross ? na : close > aiPama ? color.new(color.teal, 50) : color.new(color.red, 50))
if aiOn and aiSig and barstate.isconfirmed and aiOs != aiOs[1] and not na(aiPerf)
    label.new(time, aiTs, str.tostring(int(aiPerf * 10)), xloc=xloc.bar_time, color=aiCss,
      style=aiOs > aiOs[1] ? label.style_label_up : label.style_label_down, textcolor=color.white, size=size.tiny)

aiBar = aiOn and aiCandle and not na(aiPerf) ? color.from_gradient(aiPerf, 0, 1, color.new(aiCss, 80), aiCss) : na
barcolor(colorBar ? (isUp ? colUp : colDn) : aiBar)

alertcondition(buySig, "BUY", "JAS Trend Pro: BUY {{ticker}} {{interval}} @ {{close}}")
alertcondition(sellSig, "SELL", "JAS Trend Pro: SELL {{ticker}} {{interval}} @ {{close}}")

// ---- Sirf BUY ka hisaab (Koshish #26 ke qaide, tokri k1 jaisa) ----
COST = 0.0003                            // 0.03% har taraf
atr = ta.atr(atrLen)
var int   pos   = 0                      // 0 = khali, 1 = BUY khuli
var bool  pEnt  = false                  // B aya: agli candle ke open par khulegi
var bool  pExit = false                  // S aya: agli candle ke open par band
var float ruP   = na
var float eP    = na
var float ru    = na
var int   cN    = 0
var float cR    = 0.0
var float cR2   = 0.0
var int   cW    = 0
// candle ka open: pichhli candle ke order bharo
if pExit and pos == 1
    if ru > 0
        r = (open - eP - COST * (eP + open)) / ru
        cN  += 1
        cR  += r
        cR2 += r * r
        cW  += r > 0 ? 1 : 0
    pos := 0
pExit := false
if pEnt and pos == 0
    pos := 1
    eP  := open
    ru  := ruP
pEnt := false
// candle band: faisla
if barstate.isconfirmed
    if flipUp and pos == 0 and bar_index > atrLen * 3
        pEnt := true
        ruP  := atrMult * atr
    if flipDn and pos == 1
        pExit := true

var table box = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 80), border_width=1)
if showBox and barstate.islast
    expR = cN > 0 ? cR / cN : 0.0
    sd   = cN > 1 ? math.sqrt(math.max((cR2 - cN * expR * expR) / (cN - 1), 0.0)) : 0.0
    edge = expR - 2 * (cN > 0 ? sd / math.sqrt(cN) : 0.0)
    rNow = pos == 1 and ru > 0 ? (close - eP) / ru : 0.0
    tr   = pos == 1 ? "BUY @ " + str.tostring(eP, format.mintick) + " | " + (rNow >= 0 ? "+" : "") + str.tostring(rNow, "#.##") + "R" :
           pEnt ? "B aya - agli candle par" : "khali - B ka intezar"
    table.cell(box, 0, 0, "JAS Trend Pro t3.3", text_color=color.white, text_size=size.small)
    table.cell(box, 1, 0, timeframe.period, text_color=color.white, text_size=size.small)
    table.cell(box, 0, 1, "Rukh", text_color=color.white, text_size=size.small)
    table.cell(box, 1, 1, isUp ? "BUY" : "SELL", text_color=isUp ? colUp : colDn, text_size=size.small)
    table.cell(box, 0, 2, "SL (line)", text_color=color.white, text_size=size.small)
    table.cell(box, 1, 2, str.tostring(st, format.mintick), text_color=color.white, text_size=size.small)
    table.cell(box, 0, 3, "Candle", text_color=color.white, text_size=size.small)
    table.cell(box, 1, 3, str.tostring(nz(since) + 1), text_color=color.white, text_size=size.small)
    table.cell(box, 0, 4, "Trade (sirf BUY)", text_color=color.white, text_size=size.small)
    table.cell(box, 1, 4, tr, text_color=pos == 1 ? (rNow >= 0 ? colUp : colDn) : color.white, text_size=size.small)
    table.cell(box, 0, 5, "Is chart: trades / jeet", text_color=color.white, text_size=size.small)
    table.cell(box, 1, 5, str.tostring(cN) + " / " + str.tostring(cN > 0 ? 100.0 * cW / cN : 0.0, "#") + "%", text_color=color.white, text_size=size.small)
    table.cell(box, 0, 6, "Exp R / trade", text_color=color.white, text_size=size.small)
    table.cell(box, 1, 6, str.tostring(expR, "#.###"), text_color=expR > 0 ? colUp : colDn, text_size=size.small)
    table.cell(box, 0, 7, "Exp - 2SE (R)", text_color=color.white, text_size=size.small)
    table.cell(box, 1, 7, str.tostring(edge, "#.###"), text_color=edge > 0 ? colUp : colDn, text_size=size.small)
    is4h = timeframe.isminutes and timeframe.multiplier == 240
    is1d = timeframe.isdaily and timeframe.multiplier == 1
    pk   = is4h ? "4H tokri (XAU, XAG, US500, USTEC): ASLI PASS #34" : is1d ? "1D, 6 market tokri: ASLI PASS #26" : "is TF par PASS nahi - 4H / 1D lagayein"
    table.cell(box, 0, 8, "Pakka TF", text_color=color.white, text_size=size.small)
    table.cell(box, 1, 8, pk, text_color=is4h or is1d ? colUp : colDn, text_size=size.small)

// ---- S/R: band pivot (srLen dono taraf) ki satah; price se qareeb wali upar / neeche, qareeb satah mila di ----
ph = ta.pivothigh(high, srLen, srLen)
pl = ta.pivotlow(low, srLen, srLen)
var array<float> lv = array.new<float>()
var array<int>   lt = array.new<int>()
if not na(ph)
    array.push(lv, ph)
    array.push(lt, time[srLen])
if not na(pl)
    array.push(lv, pl)
    array.push(lt, time[srLen])
while array.size(lv) > 60
    array.shift(lv)
    array.shift(lt)
var array<line> srLines = array.new<line>()
f_pick(bool above) =>
    array<float> got = array.new<float>()
    array<int>   gt  = array.new<int>()
    if array.size(lv) > 0
        for k = 1 to srCount
            float best = na
            int   bt   = na
            for i = 0 to array.size(lv) - 1
                float v = array.get(lv, i)
                bool side = above ? v > close : v < close
                bool far = true
                if array.size(got) > 0
                    for g = 0 to array.size(got) - 1
                        if math.abs(array.get(got, g) - v) < srMerge * atr
                            far := false
                if side and far and (na(best) or (above ? v < best : v > best))
                    best := v
                    bt   := array.get(lt, i)
            if not na(best)
                array.push(got, best)
                array.push(gt, bt)
    [got, gt]
if srOn and barstate.islast and array.size(lv) > 0
    while array.size(srLines) > 0
        line.delete(array.shift(srLines))
    [rv, rt] = f_pick(true)
    [sv, st2] = f_pick(false)
    if array.size(rv) > 0
        for i = 0 to array.size(rv) - 1
            array.push(srLines, line.new(array.get(rt, i), array.get(rv, i), time, array.get(rv, i), xloc=xloc.bar_time, extend=extend.right, color=resCol, width=1, style=line.style_dashed))
    if array.size(sv) > 0
        for i = 0 to array.size(sv) - 1
            array.push(srLines, line.new(array.get(st2, i), array.get(sv, i), time, array.get(sv, i), xloc=xloc.bar_time, extend=extend.right, color=supCol, width=1, style=line.style_dashed))

// ---- TOKRI: har market par wahi sirf-BUY qaida (pichhli band candle ka flip -> is candle ke open par), isi TF par ----
f_tok() =>
    [stT, dirT] = ta.supertrend(atrMult, atrLen)
    upT = dirT < 0
    aT  = ta.atr(atrLen)
    var int   p  = 0
    var float e  = na
    var float u  = na
    var int   n  = 0
    var float sr = 0.0
    var float s2 = 0.0
    var int   w  = 0
    bool fu = upT[1] and not upT[2]
    bool fd = not upT[1] and upT[2]
    if p == 1 and fd
        float r = (open - e - COST * (e + open)) / u
        n  += 1
        sr += r
        s2 += r * r
        w  += r > 0 ? 1 : 0
        p  := 0
    if p == 0 and fu and bar_index > atrLen * 3 and aT[1] > 0
        p := 1
        e := open
        u := atrMult * aT[1]
    float rn = p == 1 ? (close - e) / u : 0.0
    [n, sr, s2, w, p, rn, upT ? 1 : -1]

[n1, r1, q1, w1, p1, k1, d1] = request.security(tk1, timeframe.period, f_tok(), barmerge.gaps_off, barmerge.lookahead_off)
[n2, r2, q2, w2, p2, k2, d2] = request.security(tk2, timeframe.period, f_tok(), barmerge.gaps_off, barmerge.lookahead_off)
[n3, r3, q3, w3, p3, k3, d3] = request.security(tk3, timeframe.period, f_tok(), barmerge.gaps_off, barmerge.lookahead_off)
[n4, r4, q4, w4, p4, k4, d4] = request.security(tk4, timeframe.period, f_tok(), barmerge.gaps_off, barmerge.lookahead_off)

var table tok = table.new(position.bottom_right, 6, 6, bgcolor=color.new(color.black, 80), border_width=1)
f_row(int row, string sym, int n, float sr, int w, int p, float rn, int d) =>
    float ex = n > 0 ? sr / n : 0.0
    string nm = array.get(str.split(sym, ":"), array.size(str.split(sym, ":")) - 1)
    table.cell(tok, 0, row, nm, text_color=color.white, text_size=size.small)
    table.cell(tok, 1, row, d > 0 ? "BUY" : "SELL", text_color=d > 0 ? colUp : colDn, text_size=size.small)
    table.cell(tok, 2, row, str.tostring(n), text_color=color.white, text_size=size.small)
    table.cell(tok, 3, row, str.tostring(n > 0 ? 100.0 * w / n : 0.0, "#") + "%", text_color=color.white, text_size=size.small)
    table.cell(tok, 4, row, str.tostring(ex, "#.###"), text_color=ex > 0 ? colUp : colDn, text_size=size.small)
    table.cell(tok, 5, row, p == 1 ? (rn >= 0 ? "+" : "") + str.tostring(rn, "#.##") + "R" : "-", text_color=p == 1 ? (rn >= 0 ? colUp : colDn) : color.gray, text_size=size.small)

if tokOn and barstate.islast
    table.cell(tok, 0, 0, "TOKRI " + timeframe.period, text_color=color.white, text_size=size.small)
    table.cell(tok, 1, 0, "Rukh", text_color=color.white, text_size=size.small)
    table.cell(tok, 2, 0, "Trades", text_color=color.white, text_size=size.small)
    table.cell(tok, 3, 0, "Jeet", text_color=color.white, text_size=size.small)
    table.cell(tok, 4, 0, "Exp R", text_color=color.white, text_size=size.small)
    table.cell(tok, 5, 0, "Khuli", text_color=color.white, text_size=size.small)
    f_row(1, tk1, nz(n1), nz(r1), nz(w1), nz(p1), nz(k1), nz(d1))
    f_row(2, tk2, nz(n2), nz(r2), nz(w2), nz(p2), nz(k2), nz(d2))
    f_row(3, tk3, nz(n3), nz(r3), nz(w3), nz(p3), nz(k3), nz(d3))
    f_row(4, tk4, nz(n4), nz(r4), nz(w4), nz(p4), nz(k4), nz(d4))
    int   nK = nz(n1) + nz(n2) + nz(n3) + nz(n4)
    float rK = nz(r1) + nz(r2) + nz(r3) + nz(r4)
    float qK = nz(q1) + nz(q2) + nz(q3) + nz(q4)
    int   wK = nz(w1) + nz(w2) + nz(w3) + nz(w4)
    float eK = nK > 0 ? rK / nK : 0.0
    float sK = nK > 1 ? math.sqrt(math.max((qK - nK * eK * eK) / (nK - 1), 0.0)) / math.sqrt(nK) : 0.0
    table.cell(tok, 0, 5, "KUL", text_color=color.white, text_size=size.small)
    table.cell(tok, 1, 5, "Exp-2SE", text_color=color.white, text_size=size.small)
    table.cell(tok, 2, 5, str.tostring(nK), text_color=color.white, text_size=size.small)
    table.cell(tok, 3, 5, str.tostring(nK > 0 ? 100.0 * wK / nK : 0.0, "#") + "%", text_color=color.white, text_size=size.small)
    table.cell(tok, 4, 5, str.tostring(eK, "#.###"), text_color=eK > 0 ? colUp : colDn, text_size=size.small)
    table.cell(tok, 5, 5, str.tostring(eK - 2 * sK, "#.###"), text_color=eK - 2 * sK > 0 ? colUp : colDn, text_size=size.small)
