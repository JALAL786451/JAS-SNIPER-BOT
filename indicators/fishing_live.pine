//@version=6
// ============================================================================
//  FISHING LIVE — chart par dikhao ke kitab mein kya chal raha hai
//
//  fishing_lots_test.pine NAAPTA hai (alag pane mein equity curve).
//  YE DIKHATA hai. Chart par, har lot, har waqt.
//
//  Maqsad ek hi hai, Jalal ke apne alfaaz mein:
//      "mujhe samajh mein aaye ke mein aisa he kerta hoon"
//
//  Is liye ye har lamhe likh kar batata hai ke abhi kaun sa phase chal raha
//  hai, kitni lots kis taraf hain, agli lot kahan lagegi, aur kitab kab
//  jamegi. Aap ise dekh kar keh sakein: "haan, mein yehi karta hoon" ya
//  "nahi, ye ghalat hai" -- aur tab main qaida theek kar doonga.
//
//  GOLD KE ILAWA (BTC waghera) ke liye:
//  Aapke qawaid gold ke dollar mein hain ($1 faida, $3.50 ladder, $4 turn).
//  BTC 84,000 par hai - wahan $1 kuch bhi nahi. Is liye "Paimana" ko
//  "Khud ba khud (ATR)" kar dein: tab wohi qawaid us symbol ki apni chaal
//  ke hisaab se naap liye jayenge.
//
//  YE TRADE NAHI KARTA. Sirf dikhata hai.
// ============================================================================
indicator("Fishing Live", "FISH LIVE", overlay = true, max_lines_count = 100, max_labels_count = 100)

// ------------------------------------------------------------- 1. PAIMANA
gS        = "1. Paimana (gold ya koi aur symbol)"
scaleMode = input.string("Gold ke dollar", "Qawaid kis paimane par", options = ["Gold ke dollar", "Khud ba khud (ATR)"], group = gS)
atrLen    = input.int(14, "ATR ki lambai (auto ke liye)", minval = 1, group = gS)
fishMult  = input.float(1.7, "Faida     = ATR x", minval = 0.1, step = 0.1, group = gS)
ladMult   = input.float(6.0, "Ladder    = ATR x", minval = 0.1, step = 0.5, group = gS)
turnMult  = input.float(6.7, "Turn      = ATR x", minval = 0.1, step = 0.5, group = gS)

// -------------------------------------------------------------- 2. QAWAID
gR        = "2. Qawaid (gold ke dollar mein)"
fishTgtD  = input.float(1.0,  "Ek lot kitne dollar faide par band", minval = 0.01, step = 0.1, group = gR)
ladderD   = input.float(3.50, "Agli lot kitne dollar baad", minval = 0.01, step = 0.1, group = gR)
turnD     = input.float(4.0,  "Kitne dollar nuqsan par ulti taraf", minval = 0.01, step = 0.5, group = gR)
emaFast   = input.int(20, "EMA fast", minval = 1, group = gR)
emaSlow   = input.int(50, "EMA slow", minval = 2, group = gR)
maxAdds   = input.int(12, "Ek taraf zyada se zyada lots", minval = 1, maxval = 40, group = gR)
basketUSD = input.float(0.10, "Basket kitne USD faide par Close All", minval = 0.001, step = 0.05, group = gR)

// ------------------------------------------------------------- 3. ACCOUNT
gA        = "3. Account"
accType   = input.string("Cent (gold)", "Account", options = ["Cent (gold)", "Standard (gold)", "Khud likhein"], group = gA)
customPL  = input.float(1.0, "Khud likhein: 1.00 lot par $1 harkat = kitne $", minval = 0.0001, step = 0.5, group = gA)
lotSize   = input.float(0.01, "Har lot ka size", minval = 0.001, step = 0.01, group = gA)
startBal  = input.float(500.0, "Balance (USD)", minval = 1, group = gA)

// ------------------------------------------------------------- 4. DIKHAWA
gD        = "4. Dikhawa"
showLines = input.bool(true, "Har khuli lot ki lakeer", group = gD)
showMarks = input.bool(true, "Kahan lot lagi aur kahan band hui", group = gD)
showNext  = input.bool(true, "Agli lot kahan lagegi", group = gD)
cBuy      = input.color(#089981, "Buy",  group = gD, inline = "c")
cSell     = input.color(#F23645, "Sell", group = gD, inline = "c")
cFlat     = input.color(#787B86, "Khali", group = gD, inline = "c")
cTxt      = input.color(#111111, "Likhai", group = gD, inline = "e")
cBg       = input.color(#FFFFFFEE, "Panel", group = gD, inline = "e")

// ============================================================================
//  PAIMANA — gold ke dollar, ya us symbol ki apni chaal
// ============================================================================
atrV   = ta.atr(atrLen)
isAuto = scaleMode == "Khud ba khud (ATR)"
fishU  = isAuto ? atrV * fishMult : fishTgtD
ladU   = isAuto ? atrV * ladMult  : ladderD
turnU  = isAuto ? atrV * turnMult : turnD

perLot = accType == "Cent (gold)" ? 1.0 : accType == "Standard (gold)" ? 100.0 : customPL
f_money(_move) => _move * lotSize * perLot

emaF = ta.ema(close, emaFast)
emaS = ta.ema(close, emaSlow)
bias = emaF > emaS ? 1 : emaF < emaS ? -1 : 0

// ============================================================================
//  KITAB
// ============================================================================
var array<int>   legDir = array.new<int>()
var array<float> legPx  = array.new<float>()
var float lastAdd  = na
var int   origDir  = 0
var bool  unwound  = false
var int   baskets  = 0
var float bal      = startBal
var string phase   = "INTEZAR"

f_net() =>
    _n = 0
    if array.size(legDir) > 0
        for i = 0 to array.size(legDir) - 1
            _n := _n + array.get(legDir, i)
    _n

f_pl(_px) =>
    _s = 0.0
    if array.size(legDir) > 0
        for i = 0 to array.size(legDir) - 1
            _s := _s + f_money((_px - array.get(legPx, i)) * array.get(legDir, i))
    _s

f_worst(_px) =>
    _w = 0.0
    if array.size(legDir) > 0
        for i = 0 to array.size(legDir) - 1
            _w := math.min(_w, (_px - array.get(legPx, i)) * array.get(legDir, i))
    _w

f_breakeven() =>
    _sum = 0.0
    _n = 0
    if array.size(legDir) > 0
        for i = 0 to array.size(legDir) - 1
            _sum := _sum + array.get(legPx, i) * array.get(legDir, i)
            _n := _n + array.get(legDir, i)
    _n != 0 ? _sum / _n : na

// ============================================================================
//  AMAL — band ho chuki candle par, taake jo dikhe woh pakka ho
// ============================================================================
opened = 0
closed = false

if barstate.isconfirmed and bar_index > emaSlow + atrLen + 2 and not na(atrV)
    px  = close
    n   = array.size(legDir)
    pl  = f_pl(px)
    net = f_net()

    if n == 0
        phase := "INTEZAR"
        if bias != 0
            array.push(legDir, bias)
            array.push(legPx, px)
            origDir := bias
            lastAdd := px
            unwound := false
            phase := "FISHING"
            opened := bias
    else
        worst = f_worst(px)
        if pl >= basketUSD
            bal := bal + pl
            baskets := baskets + 1
            array.clear(legDir)
            array.clear(legPx)
            lastAdd := na
            origDir := 0
            unwound := false
            closed := true
            phase := "CLOSE ALL"
        else if n == 1 and (px - array.get(legPx, 0)) * array.get(legDir, 0) >= fishU
            bal := bal + pl
            baskets := baskets + 1
            array.clear(legDir)
            array.clear(legPx)
            lastAdd := na
            origDir := 0
            unwound := false
            closed := true
            phase := "MACHLI PAKRI"
        else if net == 0 and origDir != 0 and bias == origDir
            _i = array.size(legDir) - 1
            while _i >= 0
                if array.get(legDir, _i) != origDir
                    bal := bal + f_money((px - array.get(legPx, _i)) * array.get(legDir, _i))
                    array.remove(legDir, _i)
                    array.remove(legPx, _i)
                _i := _i - 1
            lastAdd := px
            unwound := true
            phase := "UNWIND"
        else if not unwound and worst <= -turnU and net != 0 and n < maxAdds * 2
            array.push(legDir, net > 0 ? -1 : 1)
            array.push(legPx, px)
            opened := net > 0 ? -1 : 1
            phase := "FREEZE BANA RAHA"
        else if net != 0 and math.abs(net) < maxAdds and not na(lastAdd) and math.abs(px - lastAdd) >= ladU
            array.push(legDir, net > 0 ? 1 : -1)
            array.push(legPx, px)
            lastAdd := px
            opened := net > 0 ? 1 : -1
            phase := "LADDER"
        else
            phase := net == 0 ? "JAMI HUI (freeze)" : math.abs(f_worst(px)) >= turnU * 0.5 ? "INTEZAR (nuqsan mein)" : "CHAL RAHI HAI"

// ============================================================================
//  CHART PAR NISHAN
// ============================================================================
plotshape(showMarks and opened ==  1, "Lot lagi (buy)",  style = shape.triangleup,   location = location.belowbar, color = cBuy,  size = size.tiny, display = display.pane)
plotshape(showMarks and opened == -1, "Lot lagi (sell)", style = shape.triangledown, location = location.abovebar, color = cSell, size = size.tiny, display = display.pane)
plotshape(showMarks and closed, "Basket band", style = shape.xcross, location = location.abovebar, color = #2962FF, size = size.small, display = display.pane)

var array<line>  LN = array.new<line>()
var array<label> LB = array.new<label>()

if barstate.islast
    while array.size(LN) > 0
        line.delete(array.pop(LN))
    while array.size(LB) > 0
        label.delete(array.pop(LB))

    if showLines and array.size(legDir) > 0
        for i = 0 to array.size(legDir) - 1
            _d  = array.get(legDir, i)
            _p  = array.get(legPx, i)
            _g  = (close - _p) * _d
            _c  = _d == 1 ? cBuy : cSell
            array.push(LN, line.new(bar_index - 30, _p, bar_index + 8, _p, xloc = xloc.bar_index, color = color.new(_c, 35), style = line.style_dotted, width = 1))
            array.push(LB, label.new(bar_index + 9, _p, (_d == 1 ? "BUY  " : "SELL ") + str.tostring(lotSize, "#.##") + "   " + (_g >= 0 ? "+" : "") + str.tostring(f_money(_g), "#.##"), xloc = xloc.bar_index, style = label.style_label_left, color = color.new(_c, 20), textcolor = color.white, size = size.tiny))

        _be = f_breakeven()
        if not na(_be)
            array.push(LN, line.new(bar_index - 30, _be, bar_index + 8, _be, xloc = xloc.bar_index, color = color.new(#2962FF, 10), style = line.style_solid, width = 2))
            array.push(LB, label.new(bar_index + 9, _be, "BARABAR  " + str.tostring(_be, format.mintick), xloc = xloc.bar_index, style = label.style_label_left, color = color.new(#2962FF, 10), textcolor = color.white, size = size.tiny))

    if showNext and not na(lastAdd) and array.size(legDir) > 0
        _nt = f_net()
        if _nt != 0 and math.abs(_nt) < maxAdds
            _up = lastAdd + ladU
            _dn = lastAdd - ladU
            array.push(LN, line.new(bar_index, _up, bar_index + 8, _up, xloc = xloc.bar_index, color = color.new(cFlat, 45), style = line.style_dashed))
            array.push(LN, line.new(bar_index, _dn, bar_index + 8, _dn, xloc = xloc.bar_index, color = color.new(cFlat, 45), style = line.style_dashed))
            array.push(LB, label.new(bar_index + 9, _up, "agli lot yahan", xloc = xloc.bar_index, style = label.style_label_left, color = color.new(cFlat, 30), textcolor = color.white, size = size.tiny))
            array.push(LB, label.new(bar_index + 9, _dn, "agli lot yahan", xloc = xloc.bar_index, style = label.style_label_left, color = color.new(cFlat, 30), textcolor = color.white, size = size.tiny))

// ============================================================================
//  PANEL — abhi kitab mein kya hai
// ============================================================================
var table TB = table.new(position.top_right, 2, 10, border_width = 1)

f_row(_r, _a, _b, _tc) =>
    table.cell(TB, 0, _r, _a, text_color = cTxt, text_size = size.small, text_halign = text.align_left, bgcolor = cBg)
    table.cell(TB, 1, _r, _b, text_color = _tc, text_size = size.small, text_halign = text.align_right, bgcolor = cBg)

if barstate.islast
    nB = 0
    nS = 0
    if array.size(legDir) > 0
        for i = 0 to array.size(legDir) - 1
            if array.get(legDir, i) == 1
                nB := nB + 1
            else
                nS := nS + 1
    pl  = f_pl(close)
    net = nB - nS
    pCol = phase == "JAMI HUI (freeze)" ? #2962FF : phase == "CLOSE ALL" or phase == "MACHLI PAKRI" ? cBuy : phase == "FREEZE BANA RAHA" or phase == "LADDER" ? #F57C00 : cFlat

    table.cell(TB, 0, 0, "ABHI: " + phase, text_color = color.white, text_size = size.normal, bgcolor = pCol)
    table.cell(TB, 1, 0, str.tostring(nB + nS) + " lot", text_color = color.white, text_size = size.normal, bgcolor = pCol)
    f_row(1, "Buy ki lots",  str.tostring(nB) + "  (" + str.tostring(nB * lotSize, "#.##") + ")", nB > 0 ? cBuy : cFlat)
    f_row(2, "Sell ki lots", str.tostring(nS) + "  (" + str.tostring(nS * lotSize, "#.##") + ")", nS > 0 ? cSell : cFlat)
    f_row(3, "Net (barabar = 0)", str.tostring(net), net == 0 and nB + nS > 0 ? #2962FF : net > 0 ? cBuy : net < 0 ? cSell : cFlat)
    f_row(4, "Kitab ka haal", (pl >= 0 ? "+" : "") + "$" + str.tostring(pl, "#.##"), pl >= 0 ? cBuy : cSell)
    f_row(5, "Sab se bura leg", str.tostring(f_worst(close), "#.##") + " " + (isAuto ? "" : "$"), cSell)
    f_row(6, "Barabar hone ka price", na(f_breakeven()) ? "-" : str.tostring(f_breakeven(), format.mintick), cTxt)
    f_row(7, "Baskets band hue", str.tostring(baskets), cTxt)
    f_row(8, "Balance", "$" + str.tostring(bal, "#.##"), bal >= startBal ? cBuy : cSell)
    f_row(9, "Paimana", isAuto ? "ATR: faida " + str.tostring(fishU, format.mintick) + " / ladder " + str.tostring(ladU, format.mintick) : "gold ke dollar", cTxt)
