//@version=5
// Fishing Lots - Hold vs Hedge Tester
//
// Mirrors the decision logic inside FishingLotsEA_v3.mq5 so the behaviour can
// be SEEN on a chart before the EA touches a demo account.
//
// WHY THIS IS AN INDICATOR AND NOT A STRATEGY:
// Pine cannot hold a long and a short at the same time. A strategy() here is
// netting, so entering a 2x short against an open long would just close the
// long and leave a 1x short. That is not a hedge and would test nothing. So
// this tracks VIRTUAL positions in its own variables and does its own money
// maths. It proves the DECISION logic, not fills, spread or broker behaviour.
//
// Use the PRESET list at the top to step through the changes one at a time.
// Pick "Custom" to drive every setting yourself.

// Bumped on every change so a screenshot says which file was running.
VER = "v6"

indicator("Fishing Lots - Hold vs Hedge Tester v6", overlay = true,
          max_labels_count = 500, max_lines_count = 500)

// ---------------------------------------------------------------- presets
P0 = "0 - Baseline (as first run)"
P1 = "1 - Price stop"
P2 = "2 - Price stop + 1.00 target"
P3 = "3 - Price stop + 1.00 target + NO hedging"
P4 = "4 - Close stop + 1.00 target + hedge target 3.00"
P5 = "5 - HEDGE TEST: coin flip + basket target 3.00"
PC = "Custom (use settings below)"

preset = input.string(P0, "PRESET - change this first",
                      options = [P0, P1, P2, P3, P4, P5, PC], group = "Preset")

grpT = "Trend"
fastLen  = input.int(20,    "Fast EMA",       group = grpT)
slowLen  = input.int(50,    "Slow EMA",       group = grpT)
useADX   = input.bool(false,"Use ADX filter", group = grpT)
adxLen   = input.int(14,    "ADX length",     group = grpT)
adxMin   = input.float(18.0,"ADX minimum",    group = grpT)

grpS = "FVG / Liquidity grab"
pivotLR   = input.int(3, "Pivot left/right", minval = 1, group = grpS)
sigWindow = input.int(1, "Signal stays live for N bars", minval = 1, maxval = 10, group = grpS)

grpTF = "Scan timeframes - keep the CHART on your lowest one"
tf1    = input.timeframe("",   "TF1 (blank = chart)", group = grpTF)
useTF2 = input.bool(true,      "Use TF2",             group = grpTF)
tf2    = input.timeframe("5",  "TF2",                 group = grpTF)
useTF3 = input.bool(true,      "Use TF3",             group = grpTF)
tf3    = input.timeframe("15", "TF3",                 group = grpTF)
useTF4 = input.bool(false,     "Use TF4",             group = grpTF)
tf4    = input.timeframe("60", "TF4",                 group = grpTF)

grpE = "Entry rule - the control test"
// "Coin flip" ignores every signal and enters at random. With the same
// target and stop it should score almost exactly the "needed" win rate,
// because that number IS the random-walk rate. If the real signal cannot
// beat the coin flip, the signal is adding nothing and no amount of exit
// tuning will help.
entryMode = input.string("Signal (trend + FVG/LGB)", "Entry rule", options = ["Signal (trend + FVG/LGB)", "Trend only", "Coin flip (control)"], group = grpE)

grpM = "Money (only used on Custom)"
lotSize    = input.float(0.01, "Lot size",                     step = 0.01, group = grpM)
inProfitT  = input.float(0.50, "Profit target per trade ($)",  step = 0.05, group = grpM)
inSlDist   = input.float(3.0,  "Stop distance ($ of price)",   step = 0.1,  group = grpM)
inPriceStp = input.bool(false, "Stop fills at the price, not the candle close", group = grpM)
inHedgeOn  = input.bool(true,  "Hedging enabled",              group = grpM)
hedgeMult  = input.float(2.0,  "Hedge multiple",               step = 0.5,  group = grpM)
inBasketT  = input.float(0.0,  "Basket target ($)",            step = 0.5,  group = grpM)
inBasketX  = input.float(10.0, "Basket max loss ($, 0 = off)", step = 1.0,  group = grpM)
commPerLot = input.float(7.0,  "Commission per 1.00 lot, round turn ($)", step = 0.5, group = grpM)

grpV = "Display"
showLabels = input.bool(true, "Show decision labels", group = grpV)
showTable  = input.bool(true, "Show state table",     group = grpV)

// A preset overrides the money settings. Custom leaves them alone.
string effEntry = entryMode
float profitTgt = inProfitT
float slDist    = inSlDist
bool  priceStop = inPriceStp
bool  hedgeOn   = inHedgeOn
float basketTgt = inBasketT
float basketMax = inBasketX

if preset == P0
    priceStop := false
    profitTgt := 0.50
    hedgeOn   := true
    basketTgt := 0.0
    basketMax := 10.0
else if preset == P1
    priceStop := true
    profitTgt := 0.50
    hedgeOn   := true
    basketTgt := 0.0
    basketMax := 10.0
else if preset == P2
    priceStop := true
    profitTgt := 1.00
    hedgeOn   := true
    basketTgt := 0.0
    basketMax := 10.0
else if preset == P3
    priceStop := true
    profitTgt := 1.00
    hedgeOn   := false
    basketTgt := 0.0
    basketMax := 10.0
else if preset == P5
    // Isolates the hedge from the entry entirely. Entries are random, so
    // whatever the basket earns is the hedge's own doing and not an artefact
    // of the signal. The target comes from the measured breakeven, near 1.50,
    // set to 3.00 to leave room once the higher target converts some wins
    // into losses.
    effEntry  := "Coin flip (control)"
    priceStop := false
    profitTgt := 0.50
    hedgeOn   := true
    basketTgt := 3.00
    basketMax := 10.0
else if preset == P4
    // The price stop turned out to fire far more often and cost more in
    // total, so this keeps the close stop. The hedge target comes from the
    // measured basket win rate rather than the earlier stale figure.
    priceStop := false
    profitTgt := 1.00
    hedgeOn   := true
    basketTgt := 3.00
    basketMax := 10.0

// ------------------------------------------------------- signal calculation
// Returns the four booleans for whatever timeframe this runs in, already
// shifted to the LAST CLOSED bar so nothing repaints.
calcSignals() =>
    ph = ta.pivothigh(high, pivotLR, pivotLR)
    pl = ta.pivotlow(low,  pivotLR, pivotLR)
    var float lastHi = na
    var float lastLo = na
    if not na(ph)
        lastHi := ph
    if not na(pl)
        lastLo := pl
    bull  = low > high[2]
    bear  = high < low[2]
    sBuy  = not na(lastHi) and high > lastHi and close < lastHi
    sSell = not na(lastLo) and low  < lastLo and close > lastLo
    [bull[1], bear[1], sBuy[1], sSell[1]]

// request.security must be called unconditionally, so all four always run and
// the enable flags mask the results afterwards.
[b1, be1, sb1, ss1] = request.security(syminfo.tickerid, tf1, calcSignals(), lookahead = barmerge.lookahead_off)
[b2, be2, sb2, ss2] = request.security(syminfo.tickerid, tf2, calcSignals(), lookahead = barmerge.lookahead_off)
[b3, be3, sb3, ss3] = request.security(syminfo.tickerid, tf3, calcSignals(), lookahead = barmerge.lookahead_off)
[b4, be4, sb4, ss4] = request.security(syminfo.tickerid, tf4, calcSignals(), lookahead = barmerge.lookahead_off)

holdBars(src) =>
    out = false
    for i = 0 to sigWindow - 1
        out := out or src[i]
    out

bull1  = holdBars(b1)
bear1  = holdBars(be1)
sbuy1  = holdBars(sb1)
ssell1 = holdBars(ss1)
bull2  = useTF2 and holdBars(b2)
bear2  = useTF2 and holdBars(be2)
sbuy2  = useTF2 and holdBars(sb2)
ssell2 = useTF2 and holdBars(ss2)
bull3  = useTF3 and holdBars(b3)
bear3  = useTF3 and holdBars(be3)
sbuy3  = useTF3 and holdBars(sb3)
ssell3 = useTF3 and holdBars(ss3)
bull4  = useTF4 and holdBars(b4)
bear4  = useTF4 and holdBars(be4)
sbuy4  = useTF4 and holdBars(sb4)
ssell4 = useTF4 and holdBars(ss4)

anyBull  = bull1  or bull2  or bull3  or bull4
anyBear  = bear1  or bear2  or bear3  or bear4
anySBuy  = sbuy1  or sbuy2  or sbuy3  or sbuy4
anySSell = ssell1 or ssell2 or ssell3 or ssell4

// Names the timeframe responsible, which is the whole point of scanning more
// than one: a loss caused by a grab on another timeframe is NOT a trend change.
favourReason(dir) =>
    string r = ""
    if dir > 0
        r := ssell1 ? "sell sweep TF1" : bull1 ? "bull FVG TF1" : ssell2 ? "sell sweep TF2" : bull2 ? "bull FVG TF2" : ssell3 ? "sell sweep TF3" : bull3 ? "bull FVG TF3" : ssell4 ? "sell sweep TF4" : bull4 ? "bull FVG TF4" : ""
    else
        r := sbuy1 ? "buy sweep TF1" : bear1 ? "bear FVG TF1" : sbuy2 ? "buy sweep TF2" : bear2 ? "bear FVG TF2" : sbuy3 ? "buy sweep TF3" : bear3 ? "bear FVG TF3" : sbuy4 ? "buy sweep TF4" : bear4 ? "bear FVG TF4" : ""
    r

// ------------------------------------------------------------------ trend
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
[dipV, dimV, adxVal] = ta.dmi(adxLen, adxLen)
adxOK = not useADX or adxVal >= adxMin
trend = not adxOK ? 0 : emaFast > emaSlow ? 1 : emaFast < emaSlow ? -1 : 0

// --------------------------------------------------------- virtual account
// Gold: one lot is 100 ounces, so 0.01 lot moves $1 per $1 of price.
pnlOf(dir, entry, lots) => (close - entry) * dir * lots * 100.0
costOf(lots) => lots * commPerLot

var int   origDir    = 0
var float origEntry  = na
var float origLots   = 0.0
var int   hedgeDir   = 0
var float hedgeEntry = na
var float hedgeLots  = 0.0

var float normalNet  = 0.0
var float hedgeNet   = 0.0
var float lossSum    = 0.0
var int   nHold      = 0
var int   nHedge     = 0
var int   nBasketTP  = 0
var int   nBasketSL  = 0
var int   nNormalTP  = 0
var int   nStopped   = 0

mkLabel(txt, col) =>
    if showLabels
        label.new(bar_index, high, txt, style = label.style_label_down,
                  color = col, textcolor = color.white, size = size.small)

origPnl  = origDir  != 0 ? pnlOf(origDir,  origEntry,  origLots)  - costOf(origLots)  : 0.0
hedgePnl = hedgeDir != 0 ? pnlOf(hedgeDir, hedgeEntry, hedgeLots) - costOf(hedgeLots) : 0.0
basket   = origPnl + hedgePnl

momoUp = anyBull or anySSell
momoDn = anyBear or anySBuy

if barstate.isconfirmed

    // ---------- no position: look for an entry
    if origDir == 0
        coin    = math.random(0.0, 1.0, 20260909) > 0.5
        wantBuy  = effEntry == "Coin flip (control)" ? coin : effEntry == "Trend only" ? trend == 1 : (trend == 1 and momoUp)
        wantSell = effEntry == "Coin flip (control)" ? not coin : effEntry == "Trend only" ? trend == -1 : (trend == -1 and momoDn)
        if wantBuy
            origDir   := 1
            origEntry := close
            origLots  := lotSize
            mkLabel("BUY", color.new(color.teal, 20))
        else if wantSell
            origDir   := -1
            origEntry := close
            origLots  := lotSize
            mkLabel("SELL", color.new(color.maroon, 20))

    // ---------- chained pair: one combined decision, never leg by leg
    // The EA re-checks the basket on every tick, so the target and the floor
    // can both be reached INSIDE a bar. The combined result moves in a
    // straight line with price, so the exact price for each is solved for and
    // compared against the bar's own high and low.
    else if hedgeDir != 0
        slope = (origDir * origLots + hedgeDir * hedgeLots) * 100.0
        inter = (-origEntry * origDir * origLots - hedgeEntry * hedgeDir * hedgeLots) * 100.0 - costOf(origLots) - costOf(hedgeLots)
        pTgt  = slope != 0 ? (basketTgt - inter) / slope : na
        pStop = slope != 0 ? (-basketMax - inter) / slope : na
        tgtTouched  = slope != 0 and (slope > 0 ? high >= pTgt : low <= pTgt)
        stopTouched = slope != 0 and basketMax > 0 and (slope > 0 ? low <= pStop : high >= pStop)
        // When one bar reaches both, which came first is unknowable, so the
        // loss is taken first and the test never flatters itself.
        if stopTouched
            hedgeNet  := hedgeNet - basketMax
            nBasketSL := nBasketSL + 1
            mkLabel("BASKET STOP " + str.tostring(-basketMax, "#.##"), color.new(color.red, 10))
            origDir   := 0
            hedgeDir  := 0
            origLots  := 0.0
            hedgeLots := 0.0
        else if tgtTouched
            hedgeNet  := hedgeNet + basketTgt
            nBasketTP := nBasketTP + 1
            mkLabel("BASKET TP " + str.tostring(basketTgt, "#.##"), color.new(color.green, 10))
            origDir   := 0
            hedgeDir  := 0
            origLots  := 0.0
            hedgeLots := 0.0

    // ---------- single position
    // Order matters and mirrors the EA: profit is checked on every tick, the
    // stop is its own separate check, and only then is hedging considered.
    // An earlier version skipped the stop whenever it decided to hold, which
    // let held trades dodge losses the EA would really have taken.
    else
        grossNeed = profitTgt + costOf(origLots)
        tgtPrice  = origDir == 1 ? origEntry + grossNeed / (origLots * 100.0) : origEntry - grossNeed / (origLots * 100.0)
        tpHit     = origDir == 1 ? high >= tgtPrice : low <= tgtPrice

        stopPrice   = origDir == 1 ? origEntry - slDist : origEntry + slDist
        stopTouched = origDir == 1 ? low <= stopPrice : high >= stopPrice
        stopClosed  = origDir == 1 ? close <= stopPrice : close >= stopPrice
        stopHit     = priceStop ? stopTouched : stopClosed
        cappedLoss  = -slDist * origLots * 100.0 - costOf(origLots)
        bookStop    = priceStop ? cappedLoss : origPnl

        // With a price stop the target and the stop can both be touched in one
        // bar, so the loss is assumed first.
        if priceStop and stopTouched
            normalNet := normalNet + bookStop
            lossSum   := lossSum + bookStop
            nStopped  := nStopped + 1
            mkLabel("STOP " + str.tostring(bookStop, "#.##"), color.new(color.red, 30))
            origDir  := 0
            origLots := 0.0
        else if tpHit
            normalNet := normalNet + profitTgt
            nNormalTP := nNormalTP + 1
            mkLabel("TP " + str.tostring(profitTgt, "#.##"), color.new(color.green, 30))
            origDir  := 0
            origLots := 0.0
        else if stopHit
            normalNet := normalNet + bookStop
            lossSum   := lossSum + bookStop
            nStopped  := nStopped + 1
            mkLabel("STOP " + str.tostring(bookStop, "#.##"), color.new(color.red, 30))
            origDir  := 0
            origLots := 0.0
        else if origPnl < 0 and ((origDir == 1 and trend == -1) or (origDir == -1 and trend == 1))
            reason = favourReason(origDir)
            if reason != ""
                // The drawdown is explained by a grab or gap elsewhere. Wait.
                nHold := nHold + 1
                mkLabel("HOLD: " + reason, color.new(color.orange, 30))
            else if hedgeOn
                // Nothing favourable left anywhere. Real trend change.
                hedgeDir   := -origDir
                hedgeEntry := close
                hedgeLots  := origLots * hedgeMult
                nHedge     := nHedge + 1
                mkLabel("HEDGE " + str.tostring(hedgeLots, "#.##"), color.new(color.blue, 10))

// ------------------------------------------------------------------ visuals
plot(emaFast, "Fast EMA", color = color.new(color.aqua, 0),   linewidth = 1)
plot(emaSlow, "Slow EMA", color = color.new(color.orange, 0), linewidth = 1)
plot(origDir  != 0 ? origEntry  : na, "Original entry", color = color.new(color.teal, 0), style = plot.style_linebr, linewidth = 2)
plot(hedgeDir != 0 ? hedgeEntry : na, "Hedge entry",    color = color.new(color.blue, 0), style = plot.style_linebr, linewidth = 2)

tfMark(a, b, c, d) => (a ? "1" : "") + (b ? "2" : "") + (c ? "3" : "") + (d ? "4" : "")

tblPos = input.string("bottom_right", "Table position",
                      options = ["top_right", "middle_right", "bottom_right", "bottom_left"], group = grpV)

if showTable and barstate.islast
    // Everything the next screenshot needs, kept short enough not to be cut off.
    avgLoss  = nStopped > 0 ? -lossSum / nStopped : 0.0
    winRate  = (nNormalTP + nStopped) > 0 ? nNormalTP / (nNormalTP + nStopped) * 100.0 : 0.0
    needRate = (avgLoss + profitTgt) > 0 ? avgLoss / (avgLoss + profitTgt) * 100.0 : 0.0
    verdict  = winRate >= needRate ? "CAN WIN" : "CANNOT WIN"
    vCol     = winRate >= needRate ? color.new(color.green, 30) : color.new(color.red, 30)
    pos      = tblPos == "top_right" ? position.top_right : tblPos == "middle_right" ? position.middle_right : tblPos == "bottom_left" ? position.bottom_left : position.bottom_right

    var table t = table.new(pos, 2, 12, border_width = 1)
    table.cell(t, 0, 0, "PRESET  " + VER, bgcolor = color.new(color.blue, 40), text_color = color.white)
    table.cell(t, 1, 0, preset,   bgcolor = color.new(color.blue, 40), text_color = color.white)
    table.cell(t, 0, 1, "Entry rule")
    table.cell(t, 1, 1, effEntry)
    table.cell(t, 0, 2, "Target / Stop / type")
    table.cell(t, 1, 2, str.tostring(profitTgt, "#.##") + " / " + str.tostring(slDist, "#.##") + " / " + (priceStop ? "price" : "close"))
    table.cell(t, 0, 3, "Hedge / target / floor")
    table.cell(t, 1, 3, (hedgeOn ? "on" : "OFF") + " / " + str.tostring(basketTgt, "#.##") + " / " + str.tostring(basketMax, "#.##"))
    table.cell(t, 0, 4, "Signals now (TF)")
    table.cell(t, 1, 4, "bull " + tfMark(bull1, bull2, bull3, bull4) + "  bear " + tfMark(bear1, bear2, bear3, bear4) + "  sw " + tfMark(sbuy1 or ssell1, sbuy2 or ssell2, sbuy3 or ssell3, sbuy4 or ssell4))
    table.cell(t, 0, 5, "Open now")
    table.cell(t, 1, 5, (origDir == 0 ? "flat" : (origDir == 1 ? "BUY " : "SELL ") + str.tostring(origPnl, "#.##")) + (hedgeDir == 0 ? "" : " + hedge " + str.tostring(hedgePnl, "#.##")))
    table.cell(t, 0, 6, "Wins / Stops / avg loss")
    table.cell(t, 1, 6, str.tostring(nNormalTP) + " / " + str.tostring(nStopped) + " / " + str.tostring(avgLoss, "#.##"))
    table.cell(t, 0, 7, "Holds / Hedges")
    table.cell(t, 1, 7, str.tostring(nHold) + " / " + str.tostring(nHedge))
    table.cell(t, 0, 8, "Basket win / loss")
    table.cell(t, 1, 8, str.tostring(nBasketTP) + " / " + str.tostring(nBasketSL))
    // The row that decides everything: with this target and this average
    // loss, the win rate has to clear the needed figure or nothing else
    // matters. It is arithmetic, not opinion.
    table.cell(t, 0, 9, "Win rate / needed", bgcolor = vCol, text_color = color.white)
    table.cell(t, 1, 9, str.tostring(winRate, "#.#") + "% / " + str.tostring(needRate, "#.#") + "%  " + verdict, bgcolor = vCol, text_color = color.white)
    table.cell(t, 0, 10, "Normal / Hedging $", text_color = color.yellow)
    table.cell(t, 1, 10, str.tostring(normalNet, "#.##") + "  /  " + str.tostring(hedgeNet, "#.##"), text_color = color.yellow)
    table.cell(t, 0, 11, "TOTAL $", bgcolor = color.new(color.gray, 40), text_color = color.white)
    table.cell(t, 1, 11, str.tostring(normalNet + hedgeNet, "#.##"), bgcolor = color.new(color.gray, 40), text_color = color.white)
