//@version=6
// ============================================================================
//  JAS GOLD UNIVERSAL  (build u1, Pine v6, 11 Nov 2026)
//  User (11 Nov): "ek universal script jo gold ko 1m se 1D tak le kar chale, repaint nahi, strategy
//  test mein koi nuqs nahi, apne result se poora insaaf kare."
//
//  IMAANDAR BAAT: har TF par alag qaida nafe mein NAHI (Python, gold M1 2010-2026, kharcha + swap):
//     1D  +0.177R (62 tr)   4H  +0.095R (331 tr)   1H +0.033R (kamzor)   15m -0.033R FAIL   5m -0.110R FAIL
//  Is liye ENGINE hamesha bari candle par: chart 1m..4H -> 4H engine, chart 4H se bara..1D -> 1D engine.
//  Chart chhota karne se sirf TASVEER bareek hoti hai - trades WAHI rehti hain (yahi "universal").
//
//  QAIDA (JasTrendEA t5 / Python jaisa): Supertrend(10, 3.0), SIRF BUY.
//    - Engine candle BAND hui aur Supertrend NEECHE se UPAR palta  -> agli candle ki open par BUY.
//    - Engine candle BAND hui aur Supertrend UPAR se NEECHE palta  -> agli candle ki open par BAND.
//    - SL = entry - 6 x ATR(10) (signal candle ka ATR). 1R = yahi faasla. TP NAHI. Ek waqt mein ek trade.
//    - Filter (default BAND = EA jaisa): 1D Supertrend UPAR ho tab hi BUY.
//
//  PYTHON NAAP (M1 data -> NY 17:00 se bani candles, kharcha $0.50 aana-jana + swap 3% saalana):
//     4H            : 331 tr, jeet 41%, Exp +0.095R, kul +31.6R, girawat 8.5R  (2010-18 +5.6R | 2019-26 +25.9R)
//     4H + 1D filter: 134 tr, jeet 47%, Exp +0.199R, kul +26.6R, girawat 4.7R  (2010-18 +6.8R | 2019-26 +19.9R)
//     1D            :  62 tr, jeet 46%, Exp +0.177R, kul +11.0R, girawat 3.0R  (2010-18 +3.8R | 2019-26 +7.1R)
//   Filter 3 azmaye gaye (1D Supertrend, EMA200, EMA50>EMA200) - sirf ye ek dono hisson mein behtar nikla.
//   Sirf BUY hai: gold charhe to kamata, na charhe to taqreeban barabar (2010-18). Aage ki GUARANTEE NAHI.
//
//  REPAINT NAHI - kaise:
//    1) Har faisla sirf BAND candle par (barstate.isconfirmed), order agli candle ki open par bharta hai.
//    2) Engine ka data do raaston se: (a) block ki AAKHRI chart candle par band hoti engine candle
//       (lookahead_off - us lamhe history aur live ek jaise), sirf tab jab us ka waqt engine candle se mile;
//       (b) warna pichhli BAND engine candle ([1] + lookahead_on) - ek chart candle der se, lekin pakka.
//    3) Lakeer hamesha pichhli BAND engine candle ki (chalti candle ki nahi).
//    4) Signal hamesha aam (standard) candles se; Heikin Ashi / Renko chart par trade nahi.
//
//  STRATEGY TESTER: kharcha $0.25 har taraf har unit (= $0.50 aana-jana, Python jaisa). TV mein swap nahi
//  hota - is liye DABBE ka R hamara apna hisaab hai (kharcha + swap), tester ka paisa swap ke baghair.
//  1m / 5m chart par TV thori history deta hai = trades kam; poora hisaab 4H chart par dekhein.
// ============================================================================
strategy("JAS Gold Universal u1", shorttitle = "JAS GOLD u1", overlay = true, initial_capital = 100000, currency = currency.USD, pyramiding = 0, default_qty_type = strategy.fixed, default_qty_value = 1, commission_type = strategy.commission.cash_per_contract, commission_value = 0.25, slippage = 0, process_orders_on_close = false, calc_on_every_tick = false, calc_on_order_fills = false, fill_orders_on_standard_ohlc = true, margin_long = 0, margin_short = 0, max_labels_count = 500)

COST = 0.25   // har taraf, har unit - upar commission_value ke barabar (badlein to dono jagah)

grQ = "1 · Qaida (Python / EA jaisa - mat badlein)"
atrLen  = input.int(10, "Supertrend ATR length", minval = 2, group = grQ, display = display.none)
atrMult = input.float(3.0, "Supertrend multiplier", minval = 0.5, step = 0.1, group = grQ, display = display.none)
slMult  = input.float(6.0, "SL = kitne x ATR", minval = 0.5, step = 0.5, group = grQ, display = display.none)
useD    = input.bool(false, "Filter: 1D Supertrend UPAR ho tab hi BUY (band = EA t5 jaisa)", group = grQ, display = display.none)

grR = "2 · Risk / hisaab"
riskPct = input.float(0.75, "Risk % har trade", minval = 0.01, step = 0.05, group = grR, display = display.none)
fixBase = input.bool(true, "Risk pakke balance par (EA jaisa). Band = chalti equity par", group = grR, display = display.none)
baseBal = input.float(100000, "Pakka balance ($)", minval = 1, group = grR, display = display.none)
swapPct = input.float(3.0, "Swap % saalana - sirf dabbe ke R mein (swap-free account = 0)", minval = 0, step = 0.5, group = grR, display = display.none)
fromT   = input.time(timestamp("2010-01-01T00:00:00+00:00"), "Trade / hisaab is tareekh se", group = grR, display = display.none)

grV = "3 · Dikhawa"
showLn  = input.bool(true, "Supertrend lakeer (pichhli band engine candle)", group = grV, display = display.none)
showPos = input.bool(true, "Khuli trade: entry + SL lakeer", group = grV, display = display.none)
showMk  = input.bool(true, "BUY / BAND nishan", group = grV, display = display.none)
showTbl = input.bool(true, "Dabba dikhao", group = grV, display = display.none)
tblPos  = input.string("Top Right", "Dabbe ki jagah", options = ["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group = grV, display = display.none)
alertOn = input.bool(true, "Alert bhejo (BUY / BAND) - TV mein 'Any alert() function call' chunein", group = grV, display = display.none)

// ============================================================================
//  ENGINE: chart 1m..4H -> 4H ; 4H se bara..1D -> 1D ; 1D se bara -> kuch nahi
// ============================================================================
chSec  = timeframe.in_seconds()
engTF  = chSec <= 14400 ? "240" : "D"
engSec = timeframe.in_seconds(engTF)
okTF   = chSec <= 86400
okCh   = chart.is_standard
stdTk  = ticker.standard(syminfo.tickerid)
useDf  = useD and engTF == "240"

f_cur() =>
    [s, d] = ta.supertrend(atrMult, atrLen)
    a = ta.atr(atrLen)
    [s, d, a, time]

f_prv() =>
    [s, d] = ta.supertrend(atrMult, atrLen)
    a = ta.atr(atrLen)
    [s[1], d[1], a[1], time[1]]

f_dcur() =>
    [s, d] = ta.supertrend(atrMult, atrLen)
    [d, time]

f_dprv() =>
    [s, d] = ta.supertrend(atrMult, atrLen)
    [d[1], time[1]]

// (a) band hoti engine candle - SIRF block ki aakhri chart candle par istemal   (b) pichhli BAND engine candle
[stC, drC, atC, tC] = request.security(stdTk, engTF, f_cur(), lookahead = barmerge.lookahead_off)
[stP, drP, atP, tP] = request.security(stdTk, engTF, f_prv(), lookahead = barmerge.lookahead_on)
[ddC, tdC] = request.security(stdTk, "D", f_dcur(), lookahead = barmerge.lookahead_off)
[ddP, tdP] = request.security(stdTk, "D", f_dprv(), lookahead = barmerge.lookahead_on)

int  engOpen = time(engTF)
int  dayOpen = time("D")
bool lastEng = time_close == time_close(engTF)
bool lastDay = time_close == time_close("D")
bool dPrevUp = not na(ddP) and ddP < 0

// ============================================================================
//  FAISLA: har engine candle sirf EK dafa, band hone ke baad
// ============================================================================
var int   eDir     = 0       // aakhri dekhi hui band engine candle ka rukh: 1 upar, -1 neeche, 0 abhi nahi
var int   procT    = na      // us candle ka open waqt
var float pendRisk = na      // aakhri BUY order ka SL faasla (6 x ATR)
var bool  qtyZero  = false
var int   lateN    = 0       // kitni dafa faisla ek chart candle der se hua (raasta b)
var int   firstT   = time    // is chart ki pehli candle (dabbe mein "data kab se")

bool  sigBuy  = false
bool  sigExit = false
float sigAtr  = na
bool  sigD    = true

if barstate.isconfirmed and okTF and okCh
    for stp = 0 to 1
        bool  has  = false
        int   nDir = 0
        float nAtr = na
        int   nT   = na
        bool  nD   = true
        if stp == 0
            // (b) pichhli band engine candle abhi tak dekhi nahi gayi (aakhri chart candle ghayab thi / TF poora nahi bat-ta)
            if not na(tP) and not na(drP) and not na(atP) and (na(procT) or tP > procT)
                has  := true
                nDir := drP < 0 ? 1 : -1
                nAtr := atP
                nT   := tP
                nD   := dPrevUp
                lateN += 1
        else
            // (a) ye chart candle engine candle ko band kar rahi hai aur data usi candle ka hai
            if lastEng and not na(tC) and tC == engOpen and not na(drC) and not na(atC) and (na(procT) or tC > procT)
                has  := true
                nDir := drC < 0 ? 1 : -1
                nAtr := atC
                nT   := tC
                nD   := (lastDay and not na(tdC) and tdC == dayOpen and not na(ddC)) ? ddC < 0 : dPrevUp
        if has
            if eDir != 0
                if nDir > 0 and eDir < 0
                    sigBuy  := true
                    sigExit := false
                    sigAtr  := nAtr
                    sigD    := nD
                if nDir < 0 and eDir > 0
                    sigExit := true
                    sigBuy  := false
            eDir  := nDir
            procT := nT

// ============================================================================
//  ORDER
// ============================================================================
bool inRange = time_close >= fromT
var array<float> risks = array.new<float>()     // har trade ka SL faasla, khulne ki tarteeb mein
var float enPx = na
var float slPx = na

if sigBuy and strategy.position_size == 0 and inRange and (not useDf or sigD) and not na(sigAtr) and sigAtr > 0
    float rd   = slMult * sigAtr
    float base = fixBase ? baseBal : strategy.equity
    float mc   = na(syminfo.mincontract) or syminfo.mincontract <= 0 ? 0.01 : syminfo.mincontract
    float q    = math.floor(base * riskPct / 100.0 / (rd * syminfo.pointvalue) / mc) * mc
    if q > 0
        pendRisk := rd
        qtyZero  := false
        strategy.entry("BUY", strategy.long, qty = q, comment = "BUY")
        strategy.exit("SL", from_entry = "BUY", stop = close - rd, comment_loss = "SL")
        if alertOn
            alert("JAS Gold Universal u1 " + syminfo.ticker + ": BUY (Supertrend " + engTF + " UPAR palta) | qeemat ~" + str.tostring(close, format.mintick) + " | SL ~" + str.tostring(close - rd, format.mintick), alert.freq_once_per_bar_close)
    else
        qtyZero := true

// har nayi trade ka SL faasla yaad (usi candle mein khul kar band ho jaye tab bhi ginti na bigre)
int nAll = strategy.closedtrades + strategy.opentrades
while risks.size() < nAll
    risks.push(pendRisk)

bool opened = strategy.position_size > 0 and strategy.position_size[1] <= 0
bool closed = strategy.position_size <= 0 and strategy.position_size[1] > 0

if strategy.position_size > 0
    if opened and risks.size() > 0
        enPx := strategy.position_avg_price
        slPx := enPx - risks.last()
    if not na(slPx)
        strategy.exit("SL", from_entry = "BUY", stop = slPx, comment_loss = "SL")
    if sigExit
        strategy.close("BUY", comment = "BAND")
        if alertOn
            alert("JAS Gold Universal u1 " + syminfo.ticker + ": BAND (Supertrend " + engTF + " NEECHE palta) | qeemat ~" + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
else
    enPx := na
    slPx := na

// ============================================================================
//  DIKHAWA
// ============================================================================
cUp = color.new(#26a69a, 0)
cDn = color.new(#ef5350, 0)
cOr = color.new(#ff9800, 0)
cMu = color.new(#787b86, 0)
bool engUp = not na(drP) and drP < 0

plot(showLn and okTF ? stP : na, "Supertrend (band engine candle)", color = engUp ? cUp : cDn, linewidth = 2, style = plot.style_stepline)
plot(showPos ? enPx : na, "Entry", color = color.new(#2962ff, 0), linewidth = 1, style = plot.style_linebr)
plot(showPos ? slPx : na, "SL (6 x ATR)", color = cOr, linewidth = 1, style = plot.style_linebr)
plotshape(showMk and opened, "BUY", style = shape.labelup, location = location.belowbar, color = cUp, textcolor = color.white, text = "BUY", size = size.small)
plotshape(showMk and closed, "BAND", style = shape.labeldown, location = location.abovebar, color = cMu, textcolor = color.white, text = "BAND", size = size.small)

// ============================================================================
//  DABBA (sirf aakhri candle par): is chart ke data ka hisaab + Python ka pakka naap
// ============================================================================
f_tpos(string p) => p == "Top Left" ? position.top_left : p == "Bottom Right" ? position.bottom_right : p == "Bottom Left" ? position.bottom_left : position.top_right

var table tb = table.new(f_tpos(tblPos), 2, 13, bgcolor = color.new(chart.bg_color, 10), frame_color = color.new(#787b86, 60), frame_width = 1, border_color = color.new(#787b86, 60), border_width = 1)

f_row(int r, string a, string b, color c) =>
    table.cell(tb, 0, r, a, text_color = cMu, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, r, b, text_color = c, text_size = size.small, text_halign = text.align_left)

if showTbl and barstate.islast
    color fg = chart.fg_color
    // ---- is chart ki band trades ka R (kharcha + swap ke baad)
    int   n   = 0
    int   w   = 0
    float s   = 0.0
    float s2  = 0.0
    float cum = 0.0
    float pk  = 0.0
    float dd  = 0.0
    float gp  = 0.0
    float gl  = 0.0
    if strategy.closedtrades > 0
        for i = 0 to strategy.closedtrades - 1
            if i < risks.size()
                float rd = risks.get(i)
                float e  = strategy.closedtrades.entry_price(i)
                float x  = strategy.closedtrades.exit_price(i)
                int   te = strategy.closedtrades.entry_time(i)
                int   tx = strategy.closedtrades.exit_time(i)
                if not na(rd) and rd > 0
                    float nights = math.max(0.0, math.floor(tx / 86400000.0) - math.floor(te / 86400000.0))
                    float r = (x - e - 2.0 * COST - swapPct / 100.0 / 365.0 * nights * e) / rd
                    n += 1
                    w += r > 0 ? 1 : 0
                    s += r
                    s2 += r * r
                    cum += r
                    pk := math.max(pk, cum)
                    dd := math.max(dd, pk - cum)
                    if r > 0
                        gp += r
                    else
                        gl += -r
    float ex  = n > 0 ? s / n : 0.0
    float se2 = n > 1 ? 2.0 * math.sqrt(math.max(s2 - s * s / n, 0.0) / (n - 1)) / math.sqrt(n) : 0.0
    float pf  = gl > 0 ? gp / gl : na
    // ---- chart ki jaanch
    string tu = str.upper(syminfo.ticker)
    bool isGold = str.contains(tu, "XAU") or str.contains(tu, "GOLD")
    bool divOk  = engSec % chSec == 0
    bool nyOk   = engTF != "240" or hour(engOpen, "America/New_York") % 4 == 1
    string chk = not okTF ? "1D ya chhota chart lagayein - is TF par kuch nahi" : not okCh ? "Aam candle chart lagayein (Heikin Ashi / Renko par trade nahi)" : not isGold ? "Ye gold nahi - naap sirf gold ka hai" : not nyOk ? "4H candle NY 17:00 se nahi bani - EA / Python se farq aayega (OANDA:XAUUSD behtar)" : not divOk ? "Ye TF engine mein poora nahi bat-ta - entry 1 candle der se" : "theek"
    color chkC = chk == "theek" ? cUp : cOr
    // ---- abhi ka haal
    string now_ = "-"
    color nowC = fg
    if strategy.position_size > 0 and not na(enPx) and not na(slPx) and enPx > slPx
        now_ := "BUY khuli @ " + str.tostring(enPx, format.mintick) + " | SL " + str.tostring(slPx, format.mintick) + " | abhi " + str.tostring((close - enPx) / (enPx - slPx), "+0.00;-0.00") + "R"
        nowC := cUp
    else if eDir > 0
        now_ := "intezar: rukh pehle se UPAR - naya palta chahiye"
    else if eDir < 0
        now_ := "intezar: " + engTF + " candle " + str.tostring(stP, format.mintick) + " ke UPAR band ho = BUY" + (useDf and not dPrevUp ? " (1D filter abhi rok raha)" : "")
    else
        now_ := "data load ho raha hai"
    // ---- faisla (sirf is chart ke data par)
    string vd = n < 30 ? "trades kam (" + str.tostring(n) + ") - is chart se faisla nahi, 4H chart dekhein" : ex - se2 > 0 ? "PASS - is data par ausat zero se upar" : ex > 0 ? "musbat, lekin pakka nahi (ittefaq ho sakta)" : "FAIL - is data par nuqsan"
    color vdC = n < 30 ? cMu : ex - se2 > 0 ? cUp : ex > 0 ? cOr : cDn
    string py = engTF == "D" ? "62 trades | jeet 46% | +0.177R | kul +11.0R | girawat 3.0R" : useDf ? "134 trades | jeet 47% | +0.199R | kul +26.6R | girawat 4.7R" : "331 trades | jeet 41% | +0.095R | kul +31.6R | girawat 8.5R"
    string py2 = engTF == "D" ? "2010-18 +3.8R | 2019-26 +7.1R" : useDf ? "2010-18 +6.8R | 2019-26 +19.9R" : "2010-18 +5.6R | 2019-26 +25.9R"
    table.cell(tb, 0, 0, "JAS GOLD UNIVERSAL u1", text_color = fg, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 0, "engine " + (engTF == "D" ? "1D" : "4H") + (useDf ? " + 1D filter" : "") + " | sirf BUY | repaint nahi", text_color = fg, text_size = size.small, text_halign = text.align_left)
    f_row(1, "Chart", chk, chkC)
    f_row(2, "Rukh (" + (engTF == "D" ? "1D" : "4H") + ")", eDir > 0 ? "UPAR" : eDir < 0 ? "NEECHE" : "-", eDir > 0 ? cUp : eDir < 0 ? cDn : cMu)
    f_row(3, "1D rukh", (dPrevUp ? "UPAR" : "NEECHE") + (useDf ? " (filter CHALU)" : " (filter band)"), dPrevUp ? cUp : cDn)
    f_row(4, "Abhi", now_, nowC)
    f_row(5, "Is chart ka data", str.format_time(math.max(fromT, firstT), "dd MMM yyyy", "UTC") + " se | trades " + str.tostring(n) + " | jeet " + (n > 0 ? str.tostring(100.0 * w / n, "0") : "-") + "%", fg)
    f_row(6, "Har trade ausat", n > 0 ? str.tostring(ex, "+0.000;-0.000") + "R  (+- " + str.tostring(se2, "0.000") + ")  PF " + (na(pf) ? "-" : str.tostring(pf, "0.00")) : "-", n > 0 and ex > 0 ? cUp : n > 0 ? cDn : cMu)
    f_row(7, "Kul / girawat", n > 0 ? str.tostring(s, "+0.0;-0.0") + "R  /  " + str.tostring(dd, "0.0") + "R" : "-", n > 0 and s > 0 ? cUp : n > 0 ? cDn : cMu)
    f_row(8, "Faisla", vd, vdC)
    f_row(9, "Python 2010-26", py, fg)
    f_row(10, "Do hisse", py2 + " (sirf BUY: gold charhe to kamata)", cMu)
    f_row(11, "Chhote TF ka sach", "1H +0.03R kamzor | 15m -0.03R FAIL | 5m -0.11R FAIL  ->  is liye engine bara", cMu)
    f_row(12, "Note", "R = kharcha $0.50 + swap " + str.tostring(swapPct, "0.#") + "% ke baad. TV tester mein swap nahi." + (qtyZero ? " | LOT 0: balance / risk barhayein" : "") + (lateN > 2 ? " | der se faisle: " + str.tostring(lateN - 1) : ""), qtyZero ? cOr : cMu)
