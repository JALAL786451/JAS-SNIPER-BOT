//@version=6
// ============================================================================
//  JAS EMA 50/200 — 4H  (build f3, Pine v6)
//  21 Nov 2026 - Python test (XAUUSD, 4H, 10 saal: 21 Nov 2016 - 4 Nov 2026)
//  ke har trade ko TradingView par dohrane ke liye. TradingView 4H par kayi saal
//  ki history deta hai, is liye yahan poora nateeja parakha ja sakta hai.
//
//  QAWAID (Python test jaise - test ke dauran mat badlein), XAUUSD 4H:
//   1) EMA(50) neeche se EMA(200) ke oopar kate = BUY (agli candle ke open par)
//   2) EMA(50) oopar se EMA(200) ke neeche kate = BUY band (SELL NAHI)
//   3) ATR stop = entry se 4 x ATR(14) neeche (ATR signal wali candle ka). Stop lagne ke
//      baad dobara BUY tab hi jab EMA pehle ulta aur phir seedha cross kare
//   4) Ek waqt sirf EK position; sirf BUY. Koi grid, martingale, hedging, averaging nahi
//   5) Kharcha $0.25 har taraf = $0.50 har trade; 100% equity (1x), jama hota hua
//
//  PYTHON NATEEJA (4H, 10 saal): +159%, sab se bari girawat -17.3%, 44 trades,
//  PF 3.64, jeet ki dar 34%, sab se bara ek trade nuqsan -2.6%. Buy&hold: +236%, girawat -30%.
//  f2 (21 Nov): chart ke kone mein 'AAJ KA FAISLA' panel - BUY chalu / flat / ishara, stop, EMA faasla, candle band hone mein kitne ghantay.
//  f3 (21 Nov): panel mein 2 aur market (USATECH, USA500 - OANDA:NAS100USD / SPX500USD, input se badlein) ka BUY zone / ishara.
//     NOTE: strategy ke trade sirf is chart ke symbol par; doosre market ke liye us ka alag 4H chart + yehi script lagayen.
//  Pichle 4 trade jo TradingView mein milne chahiye (taareekh chart ke waqt ke hisab se
//  thori aage peechhe ho sakti hai, qeemat thori alag ho sakti hai):
//    11 Jul 2025 BUY ~3358 -> 30 Jul stop ~3297   |  5 Aug 2025 BUY ~3377 -> 19 Aug ~3316
//    25 Aug 2025 BUY ~3366 -> 19 Mar 2026 ~4727   |  7 Aug 2026 BUY ~4252 -> 15 Sep ~4303
// ============================================================================
strategy("JAS EMA 50/200 4H f3", shorttitle = "JAS EMA 4H f3", overlay = true,
     initial_capital         = 10000,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 100,
     pyramiding              = 0,
     commission_type         = strategy.commission.cash_per_contract,
     commission_value        = 0.25,
     calc_on_every_tick      = false,
     process_orders_on_close = false)

BUILD = "f3"

grQ    = "Qaida (mat badlein)"
fastL  = input.int(50, "Tez EMA", group = grQ, minval = 2, display = display.none)
slowL  = input.int(200, "Sust EMA", group = grQ, minval = 3, display = display.none)
atrK   = input.float(4.0, "ATR stop (0 = band)", group = grQ, minval = 0.0, step = 0.5, display = display.none)
atrLen = input.int(14, "ATR lambai", group = grQ, minval = 1, display = display.none)

emaF  = ta.ema(close, fastL)
emaS  = ta.ema(close, slowL)
atrV  = ta.atr(atrLen)
upX   = ta.crossover(emaF, emaS)
dnX   = ta.crossunder(emaF, emaS)
is4h  = timeframe.in_seconds() == 14400
warm  = bar_index >= slowL

var float atrEntry = na
var int   firstT   = na
if na(firstT)
    firstT := time

buySig = upX and warm and strategy.position_size == 0
if buySig
    atrEntry := atrV
    strategy.entry("Buy", strategy.long)

if dnX and strategy.position_size > 0
    strategy.close("Buy", comment = "EMA ulta")

if atrK > 0 and not na(atrEntry) and (buySig or strategy.position_size > 0)
    strategy.exit("ATR SL", from_entry = "Buy", loss = atrK * atrEntry / syminfo.mintick)

stopLvl = (atrK > 0 and strategy.position_size > 0 and not na(atrEntry)) ? strategy.position_avg_price - atrK * atrEntry : na

plot(emaF, "EMA tez", color = color.new(color.orange, 0), linewidth = 2)
plot(emaS, "EMA sust", color = color.new(color.blue, 0), linewidth = 2)
plot(stopLvl, "ATR stop", color = color.new(color.red, 0), style = plot.style_linebr, linewidth = 2)
bgcolor(strategy.position_size > 0 ? color.new(color.green, 92) : na)

alertcondition(buySig, "JAS EMA BUY", "JAS EMA 4H: BUY ishara (agli candle ke open par)")
alertcondition(dnX, "JAS EMA band", "JAS EMA 4H: EMA ulta - BUY band karein")

grM   = "Doosre markets (sirf panel mein dikhte hain)"
showM = input.bool(true, "Doosre markets ka panel dikhayen", group = grM)
sym2  = input.symbol("OANDA:NAS100USD", "Market 2 (USATECH)", group = grM)
sym3  = input.symbol("OANDA:SPX500USD", "Market 3 (USA500)", group = grM)

f_mm(fL, sL) =>
    f  = ta.ema(close, fL)
    s_ = ta.ema(close, sL)
    [f, s_, ta.barssince(ta.crossover(f, s_)), ta.barssince(ta.crossunder(f, s_))]

f_txt(f, s_, bu, bd) =>
    bd == 0 ? "BUY BAND ishara" : bu == 0 ? "BUY ISHARA (agli candle par)" : f > s_ ? "BUY zone (" + str.tostring(bu) + " candle se)" : "Flat (EMA neeche)"

[f2, s2, bu2, bd2] = request.security(sym2, timeframe.period, f_mm(fastL, slowL), lookahead = barmerge.lookahead_off)
[f3, s3, bu3, bd3] = request.security(sym3, timeframe.period, f_mm(fastL, slowL), lookahead = barmerge.lookahead_off)
nm2 = array.get(str.split(sym2, ":"), array.size(str.split(sym2, ":")) - 1)
nm3 = array.get(str.split(sym3, ":"), array.size(str.split(sym3, ":")) - 1)

var table info = table.new(position.top_right, 1, 11, bgcolor = color.new(color.black, 15), frame_width = 1)
if barstate.islast
    inUp   = emaF > emaS
    gapPct = (emaF - emaS) / emaS * 100
    hrsLeft = math.max(0.0, (time_close - timenow) / 3600000.0)
    pnlPct = strategy.position_size > 0 ? (close / strategy.position_avg_price - 1) * 100 : na
    faisla = not warm ? "WARMUP: " + str.tostring(slowL - bar_index) + " candle baqi"
         : buySig ? "BUY ISHARA: agli 4H candle ke open par BUY karein"
         : (dnX and strategy.position_size > 0) ? "EMA ULTA HUA: agli candle ke open par BUY BAND karein"
         : strategy.position_size > 0 ? "BUY chalu hai - rakhein, kuch nahi karna"
         : inUp ? "Aaj kuch nahi karna (EMA oopar hai, naye BUY cross ka intezar)"
         : "Aaj kuch nahi karna - flat rahein (EMA neeche hai)"
    faislaCol = (buySig or (dnX and strategy.position_size > 0)) ? color.lime : color.yellow
    table.cell(info, 0, 0, "JAS EMA 50/200 4H " + BUILD, text_color = color.white, text_size = size.small)
    table.cell(info, 0, 1, is4h ? "TF theek (4H)" : "GHALAT TF - 4H chart kholen", text_color = is4h ? color.lime : color.red, text_size = size.small)
    table.cell(info, 0, 2, "AAJ KA FAISLA: " + faisla, text_color = faislaCol, text_size = size.normal)
    table.cell(info, 0, 3, strategy.position_size > 0 ? "Entry " + str.tostring(strategy.position_avg_price, "#.##") + " | ab " + str.tostring(pnlPct, "#.##") + "%" : "Koi position nahi", text_color = color.white, text_size = size.small)
    table.cell(info, 0, 4, na(stopLvl) ? "ATR stop: band / position nahi" : "ATR stop " + str.tostring(stopLvl, "#.##") + " (qeemat se " + str.tostring((close - stopLvl) / close * 100, "#.##") + "% neeche)", text_color = color.white, text_size = size.small)
    table.cell(info, 0, 5, "EMA faasla (50 vs 200): " + str.tostring(gapPct, "#.##") + "%" + (inUp ? " (50 oopar)" : " (50 neeche)"), text_color = color.white, text_size = size.small)
    table.cell(info, 0, 6, "Is candle ke band hone mein: " + str.tostring(hrsLeft, "#.#") + " ghantay", text_color = color.white, text_size = size.small)
    table.cell(info, 0, 7, "History: " + str.tostring(bar_index + 1) + " candle, " + str.format_time(firstT, "dd MMM yyyy") + " se", text_color = color.gray, text_size = size.tiny)
    if showM
        table.cell(info, 0, 8, "--- doosre markets (panel) ---", text_color = color.gray, text_size = size.tiny)
        table.cell(info, 0, 9, nm2 + ": " + f_txt(f2, s2, bu2, bd2), text_color = color.white, text_size = size.small)
        table.cell(info, 0, 10, nm3 + ": " + f_txt(f3, s3, bu3, bd3), text_color = color.white, text_size = size.small)
