//@version=6
// ============================================================================
//  JAS RSI2 — TEST  (build c1, Pine v6)
//  11 Oct 2026 raat - user: "ek aur sahi, hamara kaam karte rehna hai -
//  universal ya scalping". Claude ne chuna: Connors RSI(2) - Larry Connors &
//  Cesar Alvarez, "Short Term Trading Strategies That Work" (2008).
//  Naqsha + pehle se likha qaida: docs/rsi2_naqsha.md
//
//  QAWAID (pehle se tay - mat badlein), sirf 1D chart, daily close par:
//   1) Rukh: close SMA(200) ke upar = sirf BUY, neeche = sirf SELL
//   2) Entry: RSI(2) < 10 = BUY, RSI(2) > 90 = SELL (usi close par)
//   3) Band: BUY jab close SMA(5) ke upar; SELL jab close SMA(5) ke neeche
//   4) SL (hifazat, asal kitaab mein nahi): entry se 3 x ATR(14) = 1R, risk 1%
//   5) Ek position, koi averaging / add nahi
//   6) Kharcha 0.01% har taraf. Swap nahi gina.
//
//  QAIDA (table khud likhta hai): 2000 se trades >= 100, Exp - 2SE > 0,
//  aur 2000-2018 aur 2019-aaj dono daur mein Exp > 0 = PASS. Warna FAIL.
//  Markets: XAUUSD 1D aur OANDA:SPX500USD 1D - har ek alag faisla.
//
//  Ek position ek waqt mein. Koi grid, martingale, hedging ya averaging nahi.
//  Ye sirf naap hai. Achha nateeja bhi aage ki zamanat nahi.
// ============================================================================
strategy("JAS RSI2 — Test (Connors RSI(2), 1D)", shorttitle = "JAS RSI2 Test", overlay = true,
     initial_capital         = 100000,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     pyramiding              = 0,
     calc_on_every_tick      = false,
     process_orders_on_close = true,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.01,
     slippage                = 0,
     margin_long             = 1,
     margin_short            = 1)

BUILD = "c1"

// ============================================================================
//  INPUTS
// ============================================================================
grT = "0 · Test"
riskPct = input.float(1.0, "Risk fi trade (% equity)", minval = 0.1, maxval = 5, step = 0.1, group = grT, display = display.none)

grQ = "1 · Connors RSI(2) qawaid (mat badlein)"
rsiLen   = input.int(2, "RSI length", minval = 2, group = grQ, display = display.none)
buyLvl   = input.float(10, "BUY: RSI is se neeche", group = grQ, display = display.none)
sellLvl  = input.float(90, "SELL: RSI is se upar", group = grQ, display = display.none)
trendLen = input.int(200, "Rukh: SMA", minval = 10, group = grQ, display = display.none)
exitLen  = input.int(5, "Band: SMA", minval = 2, group = grQ, display = display.none)
atrLen   = input.int(14, "ATR length", minval = 2, group = grQ, display = display.none)
slMult   = input.float(3.0, "SL (x ATR) - hifazat", minval = 0.5, step = 0.5, group = grQ, display = display.none)

grV = "2 · Dikhawa"
showLines = input.bool(true, "Entry / SL / SMA200 lakeer", group = grV, display = display.none)
tblPos    = input.string("Bottom Left", "Table ki jagah", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grV, display = display.none)

// ============================================================================
//  HELPERS
// ============================================================================
f_pos(_s) => _s == "Top Left" ? position.top_left : _s == "Top Right" ? position.top_right : _s == "Bottom Left" ? position.bottom_left : position.bottom_right
f_rr(_x) => na(_x) ? "-" : (_x > 0 ? "+" : "") + str.tostring(_x, "0.00") + "R"
f_r3(_x) => na(_x) ? "-" : (_x > 0 ? "+" : "") + str.tostring(_x, "0.000")
f_px(_x) => na(_x) ? "-" : str.tostring(_x, format.mintick)
f_day(_t) => na(_t) ? "-" : str.format_time(_t, "dd MMM yyyy", "UTC")
f_ok(_b) => _b ? "✓" : "✗"
// Exp aur us ki 2 x SE (95% ke qareeb)
f_se2(_n, _s, _q) => _n > 1 ? 2.0 * math.sqrt(math.max(_q - _s * _s / _n, 0.0) / (_n - 1)) / math.sqrt(_n) : na
f_era(_y) => _y < 1970 ? 0 : _y < 2000 ? 1 : _y < 2019 ? 2 : 3

// ============================================================================
//  ISHARE (sirf 1D, band candle par - process_orders_on_close = usi close par)
// ============================================================================
isD1 = timeframe.isdaily and timeframe.multiplier == 1
rsi  = ta.rsi(close, rsiLen)
smaT = ta.sma(close, trendLen)
smaX = ta.sma(close, exitLen)
atr  = ta.atr(atrLen)

longSig  = isD1 and not na(smaT) and not na(rsi) and close > smaT and rsi < buyLvl
shortSig = isD1 and not na(smaT) and not na(rsi) and close < smaT and rsi > sellLvl

// ============================================================================
//  R ka hisaab har entry ka (kharche samet): (netprofit badla) / risk ki raqam
// ============================================================================
var bool  inTrade = false
var float riskAmt = na
var float npAt    = na
var int   nEnt    = 0
var int   nWinR   = 0
var float sumR    = 0.0
var float sumW    = 0.0
var float sumL    = 0.0
var float sumQ    = 0.0
var array<float> eN  = array.new<float>(4, 0.0)
var array<float> eW  = array.new<float>(4, 0.0)
var array<float> eS  = array.new<float>(4, 0.0)
var array<float> eQ  = array.new<float>(4, 0.0)
var array<float> eSW = array.new<float>(4, 0.0)
var array<float> eSL = array.new<float>(4, 0.0)
var int   xSma   = 0
var int   xSL    = 0
var int   nSkip  = 0
var int   nBuy   = 0
var float rBuy   = 0.0
var int   firstT = time
var int   tFirst = na
var int   tLast  = na
var array<string> logT = array.new<string>()

var int   pDir  = 0
var float pE    = na
var float pSL   = na
var bool  pX    = false     // SMA5 se band hui (warna SL)
var int   pYear = na
var int   pDay  = na

// pichli trade band ho gayi? -> hisaab
if inTrade and strategy.position_size == 0
    _rr = (strategy.netprofit - npAt) / riskAmt
    nEnt  += 1
    nWinR += _rr > 0 ? 1 : 0
    sumR  += _rr
    sumQ  += _rr * _rr
    if pDir == 1
        nBuy += 1
        rBuy += _rr
    _k = f_era(nz(pYear, year(time, "UTC")))
    array.set(eN, _k, array.get(eN, _k) + 1)
    array.set(eW, _k, array.get(eW, _k) + (_rr > 0 ? 1 : 0))
    array.set(eS, _k, array.get(eS, _k) + _rr)
    array.set(eQ, _k, array.get(eQ, _k) + _rr * _rr)
    if _rr > 0
        array.set(eSW, _k, array.get(eSW, _k) + _rr)
        sumW += _rr
    else
        array.set(eSL, _k, array.get(eSL, _k) - _rr)
        sumL -= _rr
    if pX
        xSma += 1
    else
        xSL += 1
    _xp = strategy.closedtrades > 0 ? strategy.closedtrades.exit_price(strategy.closedtrades - 1) : na
    array.push(logT, f_day(pDay) + (pDir == 1 ? "  ▲ " : "  ▼ ") + f_px(pE) + " → " + f_px(_xp) + "  " + f_rr(_rr) + " · " + (pX ? "SMA5" : "SL"))
    if array.size(logT) > 6
        array.shift(logT)
    inTrade := false
    pDir    := 0
    pX      := false

// khuli trade: SMA5 ke paar daily close = band (usi close par)
if inTrade and strategy.position_size != 0 and isD1
    if pDir == 1 and close > smaX
        pX := true
        strategy.close("L", comment = "SMA5 ke upar")
    else if pDir == -1 and close < smaX
        pX := true
        strategy.close("S", comment = "SMA5 ke neeche")

// nayi trade: koi position na ho
if isD1 and strategy.position_size == 0 and not inTrade and (longSig or shortSig) and atr > 0
    _d    = longSig ? 1 : -1
    _r0   = slMult * atr
    _step = syminfo.mincontract > 0 ? syminfo.mincontract : 1.0
    _q    = math.floor((strategy.equity * riskPct / 100.0) / (_r0 * syminfo.pointvalue) / _step) * _step
    if _q >= _step
        _id  = _d == 1 ? "L" : "S"
        _xid = _d == 1 ? "XL" : "XS"
        pDir   := _d
        pE     := close
        pSL    := close - _d * _r0
        pX     := false
        pDay   := time
        pYear  := year(time, "UTC")
        tFirst := na(tFirst) ? time : tFirst
        tLast  := time
        strategy.entry(_id, _d == 1 ? strategy.long : strategy.short, qty = _q)
        strategy.exit(_xid, from_entry = _id, stop = pSL)
        inTrade := true
        riskAmt := _q * _r0 * syminfo.pointvalue   // asal khatra (gol size ke baad)
        npAt    := strategy.netprofit
    else
        nSkip += 1   // size symbol ke qadam se chhota

plot(showLines and isD1 ? smaT : na, "SMA200 (rukh)", color = color.new(color.gray, 30), linewidth = 1, display = display.pane)
plot(showLines and strategy.position_size != 0 ? pSL : na, "SL (3 ATR)", color = color.new(#E65100, 0), style = plot.style_linebr, linewidth = 2, display = display.pane)
plot(showLines and strategy.position_size != 0 ? pE : na, "Entry", color = color.new(color.blue, 0), style = plot.style_linebr, linewidth = 1, display = display.pane)

// ============================================================================
//  NATEEJA TABLE (screenshot ke liye)
// ============================================================================
var table rt = table.new(f_pos(tblPos), 2, 26, border_width = 1, border_color = color.new(color.gray, 70))
f_row(_r, _a, _b, _c) =>
    table.cell(rt, 0, _r, _a, bgcolor = color.new(color.white, 10), text_color = color.black, text_size = size.small, text_halign = text.align_left)
    table.cell(rt, 1, _r, _b, bgcolor = color.new(color.white, 10), text_color = _c, text_size = size.small, text_halign = text.align_left)
// Strategy chalti candle par nahi chalti - table pichli band candle par bhi banao
if barstate.islast or barstate.islastconfirmedhistory
    table.clear(rt, 0, 0, 1, 25)
    cOK = color.new(#1B5E20, 0)
    cNO = color.new(#B71C1C, 0)
    cMD = color.new(#E65100, 0)
    table.cell(rt, 0, 0, "JAS RSI2 TEST " + BUILD + " · Connors RSI(2) · " + syminfo.ticker + " 1D", bgcolor = color.new(color.silver, 40), text_color = color.black, text_size = size.small)
    table.merge_cells(rt, 0, 0, 1, 0)
    if not isD1
        f_row(1, "TF ghalat", "Ye test sirf 1D chart par chalta hai", cNO)
    else
        _ex = nEnt > 0 ? sumR / nEnt : na
        _pf = sumL > 0 ? sumW / sumL : na
        _se = f_se2(nEnt, sumR, sumQ)
        f_row(1, "Net profit", str.tostring(strategy.netprofit, "#,###") + " $  (" + str.tostring(100 * strategy.netprofit / strategy.initial_capital, "0.0") + "%)", strategy.netprofit >= 0 ? cOK : cNO)
        f_row(2, "Trades (sab)", str.tostring(nEnt) + "  (BUY " + str.tostring(nBuy) + " " + f_rr(rBuy) + " · SELL " + str.tostring(nEnt - nBuy) + " " + f_rr(sumR - rBuy) + ")" + (strategy.position_size != 0 ? "  + 1 abhi khuli" : ""), color.black)
        f_row(3, "Jeet %", nEnt > 0 ? str.tostring(100.0 * nWinR / nEnt, "0.0") + "%" : "-", color.black)
        f_row(4, "Exp (R fi trade, kharche samet)", na(_ex) ? "-" : f_rr(_ex) + (na(_se) ? "" : "  (± " + str.tostring(_se, "0.00") + ")"), na(_ex) ? color.black : _ex > 0 ? cOK : cNO)
        f_row(5, "Profit Factor · kul R", (na(_pf) ? "-" : str.tostring(_pf, "0.00")) + "  ·  " + f_rr(sumR), na(_pf) ? color.black : _pf >= 1.3 ? cOK : _pf >= 1 ? cMD : cNO)
        f_row(6, "Max drawdown", str.tostring(strategy.max_drawdown, "#,###") + " $", cNO)
        f_row(7, "Kaise band huin", "SMA5 " + str.tostring(xSma) + "  ·  SL (3 ATR) " + str.tostring(xSL), color.black)
        f_row(8, "Arsa", "chart ki pehli candle " + f_day(firstT) + "  ·  trades " + f_day(tFirst) + " → " + f_day(tLast), color.black)
        _names = array.from("1970 se pehle", "1970-1999", "2000-2018", "2019-aaj")
        _row = 9
        for _k = 0 to 3
            _n = array.get(eN, _k)
            if _n > 0
                _s   = array.get(eS, _k)
                _exk = _s / _n
                _sek = f_se2(_n, _s, array.get(eQ, _k))
                _slk = array.get(eSL, _k)
                _pfk = _slk > 0 ? array.get(eSW, _k) / _slk : na
                _txt = str.tostring(_n, "#") + " trades · jeet " + str.tostring(100.0 * array.get(eW, _k) / _n, "0") + "% · Exp " + f_rr(_exk) + (na(_sek) ? "" : " (± " + str.tostring(_sek, "0.00") + ")") + " · PF " + (na(_pfk) ? "-" : str.tostring(_pfk, "0.00")) + " · kul " + f_rr(_s)
                f_row(_row, "Daur " + array.get(_names, _k), _txt, _exk > 0 ? cOK : cNO)
                _row += 1
        // PEHLE SE LIKHA QAIDA: 2000 se (daur 2 + 3)
        _n2  = array.get(eN, 2) + array.get(eN, 3)
        _s2  = array.get(eS, 2) + array.get(eS, 3)
        _q2  = array.get(eQ, 2) + array.get(eQ, 3)
        _ex2 = _n2 > 0 ? _s2 / _n2 : na
        _se2 = f_se2(_n2, _s2, _q2)
        _c1  = _n2 >= 100
        _c2  = not na(_ex2) and not na(_se2) and _ex2 - _se2 > 0
        _c3  = array.get(eN, 2) > 0 and array.get(eS, 2) > 0 and array.get(eN, 3) > 0 and array.get(eS, 3) > 0
        _pass = _c1 and _c2 and _c3
        f_row(_row, "2000 se (faisla)", str.tostring(_n2, "#") + " trades · Exp " + f_r3(_ex2) + "R (± " + (na(_se2) ? "-" : str.tostring(_se2, "0.000")) + ") · Exp - 2SE " + f_r3(na(_ex2) or na(_se2) ? na : _ex2 - _se2), _c2 ? cOK : cNO)
        _row += 1
        f_row(_row, "QAIDA", (_pass ? "PASS - demo ke qabil" : "FAIL - settings NAHI badalni") + "  ·  trades >= 100 " + f_ok(_c1) + " · Exp - 2SE > 0 " + f_ok(_c2) + " · dono daur musbat " + f_ok(_c3), _pass ? cOK : cNO)
        _row += 1
        _nl = array.size(logT)
        if _nl > 0
            for _i = _nl - 1 to 0
                f_row(_row, _i == _nl - 1 ? "Aakhri trades" : "", array.get(logT, _i), color.black)
                _row += 1
        f_row(_row, "Note", "Sirf naap. SL 3 ATR hifazat ke liye (asal kitaab mein nahi). Swap shamil nahi." + (nSkip > 0 ? "  CHHOOTI: " + str.tostring(nSkip) + " (size bohot chhota)." : ""), cNO)
