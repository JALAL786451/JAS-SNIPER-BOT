//@version=5
// ============================================================================
//  SMC SIMPLE — Zones + FVG + Liquidity Grab + Buy/Sell
//
//  Chart par chaar cheezein:
//    1. Support / Resistance zones  (hare aur laal boxes)
//    2. FVG — fair value gap        (halke boxes, bharne par khud mit-te)
//    3. Liquidity Grab              (shaded hissa + "LG" label)
//    4. BUY / SELL signal           (teer + Entry / SL / TP1 / TP2 + halat)
//
//  Saath mein ek MA 20 — kyunke ek entry us par retest se banti hai.
//  Signal ka trend filter alag EMA(50) hai.
//
//  JO IS MEIN NAHI HAI (jaan boojh kar):
//    - Koi RSI / Stochastic / overbought-oversold
//    - Koi score panel, koi teacher panel
//
//  Signal ka usool — chaar mein se koi ek rasta + candle ka rukh:
//    BUY  = (support zone chua  YA  neeche liquidity grab  YA  swing high
//            toota  YA  MA20 par wapas aa kar palta)
//           + candle bullish band hui  + (chahen to) EMA se upar
//           + (chahen to) bara timeframe bhi UP ho
//    SELL = ulta.
//    Entry us candle ka close, SL zone/grab ke paar + buffer, TP 1R aur 2R.
//
//  Zones aur grabs pivot par bante hain, jo pivLen bars baad pakke hote hain —
//  is liye zone thora baad mein nazar aata hai, magar baad mein badalta nahi.
//
// ----------------------------------------------------------------------------
//  v2 mein kya barha (aur kya JAAN BOOJH KAR nahi barha)
//
//  Is waqt is script ka forward test chal raha hai. Is liye v2 mein signal ki
//  logic ko haath NAHI lagaya gaya — default settings par ye script bilkul
//  wohi signal deta hai jo pehle deta tha. Jo naya hai wo do qism ka hai:
//
//  A. Sirf DIKHANE wali cheezein (signal par koi asar nahi):
//     - Lot size calculator: account aur risk% se bata deta hai ke kitna lot
//       lena chahiye, aur kya sab se chhota lot (0.01) bhi zyada to nahi
//     - Live scorecard: is chart par ab tak kitne signal jeete/haare aur PF
//     - Panel ab chart ke rang ke mutabiq khud badal jata hai (dark/light)
//     - HTF ka data ab ek hi request.security se aata hai, do se nahi
//
//  B. Naye filter — sab DEFAULT OFF. Jab tak aap khud on na karein, script ka
//     amal bilkul nahi badalta:
//     - Sab se qareeb zone se SL naapna (pehle list mein pehla zone lagta tha)
//     - Session filter (sust ghanton mein trade na karna)
//     - Bara SL rad karna (jab ATR phool jaye to SL account se bara ho jata hai)
//
//  Har naya filter alag se on kar ke, alag se test karna chahiye. Ek saath teen
//  badal kar behtar nateeja aa jaye to pata nahi chalta kis ne kiya.
// ============================================================================
indicator("SMC Simple — Zones + FVG + Liquidity Grab", overlay = true, max_boxes_count = 200, max_lines_count = 200, max_labels_count = 300)

// ============================================================================
//  INPUTS
// ============================================================================
g1 = "1 · Zones (support / resistance)"
pivLen    = input.int(5, "Swing (pivot) bars", minval = 2, group = g1)
zoneMax   = input.int(4, "Kitne zones chart par rahen", minval = 1, maxval = 20, group = g1)
zonePad   = input.float(0.25, "Zone ki mota'i (x ATR)", step = 0.05, minval = 0.05, group = g1)
showZones = input.bool(true, "Zones dikhayen", group = g1)

g2 = "2 · FVG (fair value gap)"
showFVG = input.bool(true, "FVG dikhayen", group = g2)
fvgMax  = input.int(3, "Kitne FVG chart par rahen", minval = 1, maxval = 20, group = g2)

g3 = "3 · Liquidity Grab"
showLGB = input.bool(true, "Liquidity grab ka label dikhayen", group = g3)
lgMax   = input.int(2, "Kitne LG labels chart par rahen (purane khud mit jayenge)", minval = 1, maxval = 20, group = g3)

g4 = "4 · BUY / SELL signal"
useTrend  = input.bool(true, "EMA trend filter chalu", group = g4)
emaLen    = input.int(50, "EMA length", minval = 5, group = g4)
minBodyPc = input.float(45.0, "Signal candle ka body kam se kam (%)", step = 5.0, minval = 0.0, maxval = 100.0, group = g4)
coolBars  = input.int(8, "Do signals ke darmiyan kam se kam bars", minval = 0, group = g4)

// Trend ke saath chalne wali entry (continuation). Zone/grab wali logic sirf
// tab chalti hai jab price level par wapas aaye — jab market seedhi ek taraf
// bhaage to wo khaali reh jati hai. Ye do rasty us khali jagah ko bharte hain.
useBreak  = input.bool(true,  "Continuation: swing high/low tootne par entry", group = g4)
brkBufAtr = input.float(0.10, "Break buffer (x ATR)", step = 0.05, minval = 0.0, group = g4)
useRetest = input.bool(true,  "Continuation: MA20 par wapas aa kar palatne par entry", group = g4)
retestAtr = input.float(0.50, "MA20 se kitna qareeb (x ATR)", step = 0.05, minval = 0.05, group = g4)

// Bara timeframe (HTF) ki direction. Isse chota (chart ka) TF sirf usi taraf
// signal deta hai — jaise 1H par sirf BUY jab 4H bhi UP ho. Bara TF sirf
// direction batata hai, chota TF entry deta hai.
useHtf    = input.bool(false, "Higher-timeframe filter chalu", group = g4)
htfTF     = input.timeframe("240", "Bara timeframe (misal: 240 = 4H, D = 1 din)", group = g4)
htfEmaLen = input.int(50, "HTF EMA length", minval = 5, group = g4)

g5 = "5 · Trade plan"
atrLen    = input.int(14, "ATR length", minval = 2, group = g5)
slBuf     = input.float(0.35, "SL buffer (x ATR)", step = 0.05, minval = 0.0, group = g5)
tp1R      = input.float(1.0, "TP1 (R)", step = 0.1, minval = 0.2, group = g5)
tp2R      = input.float(2.0, "TP2 (R)", step = 0.1, minval = 0.2, group = g5)
showPlan  = input.bool(true, "Entry / SL / TP lines dikhayen", group = g5)
onlyLast  = input.bool(true, "SIRF aakhri signal chart par rakhen (purane mita dein)", group = g5)
showArrow = input.bool(true, "Purane signals ke chhote teer rehne dein", group = g5)
showPanel = input.bool(true, "Chhota panel dikhayen", group = g5)

g6 = "6 · Rang"
cSup  = input.color(color.new(color.teal,   80), "Support zone",   group = g6)
cRes  = input.color(color.new(color.red,    80), "Resistance zone", group = g6)
cFvgU = input.color(color.new(color.blue,   80), "FVG bullish",    group = g6)
cFvgD = input.color(color.new(color.orange, 80), "FVG bearish",    group = g6)
cLgUp = input.color(color.new(color.red,    75), "Liquidity grab upar",  group = g6)
cLgDn = input.color(color.new(color.teal,   75), "Liquidity grab neeche", group = g6)
cEma  = input.color(color.new(color.gray,   0), "EMA line",       group = g6)
cBuy  = input.color(color.new(color.teal,   0), "BUY",            group = g6)
cSell = input.color(color.new(color.red,    0), "SELL",           group = g6)

g7 = "7 · MA 20"
// Sirf ek MA. Ye sajawat nahi — "MA20 par wapas aa kar palatna" wali entry
// isi se naapi jati hai. Line chhupa dene se wo entry band nahi hoti.
showMAs   = input.bool(true, "MA 20 ki line dikhayen", group = g7)
maType    = input.string("EMA", "MA ki qism", options = ["EMA", "SMA"], group = g7)
ma1Len    = input.int(20,  "MA 20 length", minval = 2, group = g7)
cMa1      = input.color(color.new(color.purple, 0), "MA 20 rang",  group = g7)
showMaTag = input.bool(true, "MA par us ka naam likhen", group = g7)

g8 = "8 · Volume / dabao panel (sirf dekhne ke liye)"
// Ye panel signal ko HAATH NAHI LAGATA. Jab tak ise backtest se nahi parkha
// jata, is par trade na karein.
showVP  = input.bool(true, "Volume / dabao panel dikhayen", group = g8)
vpLen   = input.int(20, "Kitni candles ka ausat", minval = 5, group = g8)
vpTf1   = input.timeframe("D",   "Bara timeframe 1", group = g8)
vpTf2   = input.timeframe("240", "Bara timeframe 2", group = g8)

g9 = "9 · Lot size calculator (sirf hisaab, signal par asar nahi)"
// Sab se aam tarika account gawane ka ye hai ke SL to theek lagaya jaye magar
// lot us ke mutabiq na rakha jaye. $4 ka SL 0.10 lot par $40 ka nuqsan hai.
// Ye panel har signal par khud hisaab kar deta hai.
showRisk  = input.bool(true, "Lot size panel dikhayen", group = g9)
acctSize  = input.float(500.0, "Account ka size ($)", step = 50.0, minval = 10.0, group = g9)
riskPct   = input.float(1.0, "Har trade par risk (% account)", step = 0.25, minval = 0.1, maxval = 10.0, group = g9)
contrSize = input.float(100.0, "1 lot mein kitni units (gold = 100 ounce)", step = 1.0, minval = 0.01, group = g9)
minLot    = input.float(0.01, "Broker ka sab se chhota lot", step = 0.01, minval = 0.001, group = g9)
showStats = input.bool(true, "Live scorecard dikhayen (jeet / haar / PF)", group = g9)
// Strategy version TP1 ke baad SL ko breakeven par le aati hai. Scorecard bhi
// wohi hisaab kare, warna dono alag nateeja denge — aur wo farq strategy ka
// nahi, do alag ginti ka hota hai.
beAfterTp1 = input.bool(true, "TP1 ke baad SL breakeven par (strategy jaisa)", group = g9)
statsUseDt = input.bool(false, "Scorecard sirf ek tareekh ke baad se ginen", group = g9)
statsFrom  = input.time(timestamp("05 Sep 2026 00:00 +0000"), "Scorecard kis din se", group = g9)

g10 = "10 · Extra filter (SAB DEFAULT BAND — ek waqt mein ek chalayen)"
// In mein se koi bhi on karne se signal badal jayenge. Us ke baad purana
// backtest is script ko bayan nahi karta — dobara test karna paregi.
useNearZone = input.bool(false, "SL ke liye sab se QAREEB zone lein (warna list ka pehla)", group = g10)
useSession  = input.bool(false, "Sirf muqarrara ghanton mein signal lein", group = g10)
sessStr     = input.session("0800-2000", "Ghante (chart ke timezone mein)", group = g10)
useMaxStop  = input.bool(false, "Bara SL wala signal rad kar dein", group = g10)
maxStopAtr  = input.float(3.0, "SL kitne ATR se zyada na ho", step = 0.5, minval = 0.5, group = g10)

// ============================================================================
//  BUNYADI HISAAB
// ============================================================================
atr = ta.atr(atrLen)
ema = ta.ema(close, emaLen)
f_px(x) => str.tostring(x, format.mintick)

plot(useTrend ? ema : na, "EMA (trend filter)", color = cEma, linewidth = 2)

// --- HTF direction: EMA vs close usi bare TF par, non-repainting (band hui
//     candle ka data). Ek hi request.security — pehle do call lagte the, jo
//     bilkul wahi kaam do dafa karte the.
f_htfPair() =>
    [close[1], ta.ema(close, htfEmaLen)[1]]

[htfC, htfE] = request.security(syminfo.tickerid, htfTF, f_htfPair(), lookahead = barmerge.lookahead_off)

int htfDir = not useHtf ? 0 : (na(htfC) or na(htfE)) ? 0 : htfC > htfE ? 1 : htfC < htfE ? -1 : 0
bool htfOKb = not useHtf or htfDir == 1
bool htfOKs = not useHtf or htfDir == -1

// --- MA 20. Hamesha hisaab hota hai (retest entry ise naapti hai), magar
//     line dikhana marzi ki baat hai.
f_ma(_len) => maType == "SMA" ? ta.sma(close, _len) : ta.ema(close, _len)
float ma1 = f_ma(ma1Len)
plot(showMAs ? ma1 : na, "MA 20", color = cMa1, linewidth = 1)

var label mTag1 = na
if showMAs and showMaTag and barstate.islast
    if na(mTag1)
        mTag1 := label.new(bar_index + 3, ma1, str.tostring(ma1Len), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(color.gray, 30), textcolor = color.white, size = size.tiny)
    else
        label.set_xy(mTag1, bar_index + 3, ma1)

// --- Panel ke rang chart se lete hain, taake dark aur light dono par parhe
//     jayen. Pehle safed background tay tha, jo dark chart par bura lagta tha.
color panelBg   = color.new(chart.bg_color, 15)
color panelHdBg = color.new(chart.fg_color, 85)
color panelTx   = chart.fg_color
color panelDim  = color.new(chart.fg_color, 40)

// ============================================================================
//  1 · ZONES (pivot high = resistance, pivot low = support)
// ============================================================================
var box[]  zBox = array.new_box()
var bool[] zSup = array.new_bool()

ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow (low,  pivLen, pivLen)

if showZones and not na(ph)
    float pad = atr * zonePad
    box nb = box.new(bar_index - pivLen, ph + pad, bar_index + 5, ph - pad, xloc = xloc.bar_index, bgcolor = cRes, border_color = color.new(color.red, 55))
    array.push(zBox, nb)
    array.push(zSup, false)

if showZones and not na(pl)
    float pad = atr * zonePad
    box nb = box.new(bar_index - pivLen, pl + pad, bar_index + 5, pl - pad, xloc = xloc.bar_index, bgcolor = cSup, border_color = color.new(color.teal, 55))
    array.push(zBox, nb)
    array.push(zSup, true)

// zone ko aage barhao; toot jaye to hata do
if array.size(zBox) > 0
    for i = array.size(zBox) - 1 to 0
        box  b   = array.get(zBox, i)
        bool sup = array.get(zSup, i)
        box.set_right(b, bar_index + 5)
        bool broken = sup ? (close < box.get_bottom(b)) : (close > box.get_top(b))
        if broken
            box.delete(b)
            array.remove(zBox, i)
            array.remove(zSup, i)

while array.size(zBox) > zoneMax
    box.delete(array.shift(zBox))
    array.shift(zSup)

// Is bar zone ko chua? Chua to us zone ka kinara wapas do (SL ke liye).
//
// Do tareeqe hain, aur farq asli hai:
//   - Default: list ka PEHLA milta hua zone (yani sab se purana). Yehi amal
//     ab tak ka hai, aur isi par saara backtest hua hai.
//   - useNearZone: sab se QAREEB zone. Ye zyada munsifana hai — agar do zone
//     ek saath chhu rahe hon to SL qareeb wale ke paar hona chahiye, door
//     wale ke nahi. Magar is se SL badal jata hai, yani trade ka nateeja bhi.
//     Is liye default band hai; on karein to dobara test karein.
f_zoneEdge(bool _wantSup) =>
    float best   = na
    float bestD  = na
    if array.size(zBox) > 0
        for i = 0 to array.size(zBox) - 1
            if array.get(zSup, i) == _wantSup
                box b = array.get(zBox, i)
                if low <= box.get_top(b) and high >= box.get_bottom(b)
                    float edge = _wantSup ? box.get_bottom(b) : box.get_top(b)
                    if not useNearZone
                        best := edge
                        break
                    float d = math.abs(close - edge)
                    if na(bestD) or d < bestD
                        bestD := d
                        best  := edge
    best

float supHit = f_zoneEdge(true)
float resHit = f_zoneEdge(false)

// ============================================================================
//  2 · FVG — teen candle ka khali gap, bharne par khud mit jata hai
// ============================================================================
var box[]  fBox  = array.new_box()
var bool[] fBull = array.new_bool()

bool fvgUp = bar_index > 2 and low  > high[2]
bool fvgDn = bar_index > 2 and high < low[2]

// barstate.isconfirmed: chalti candle par FVG banate the, to wo candle ke
// andar aata jata rehta tha. Ab band hui candle par hi banta hai.
if showFVG and fvgUp and barstate.isconfirmed
    box nb = box.new(bar_index - 2, low, bar_index + 5, high[2], xloc = xloc.bar_index, bgcolor = cFvgU, border_color = color.new(color.blue, 40), text = "FVG", text_size = size.tiny, text_color = color.new(color.blue, 0), text_halign = text.align_left, text_valign = text.align_center)
    array.push(fBox, nb)
    array.push(fBull, true)

if showFVG and fvgDn and barstate.isconfirmed
    box nb = box.new(bar_index - 2, low[2], bar_index + 5, high, xloc = xloc.bar_index, bgcolor = cFvgD, border_color = color.new(color.orange, 40), text = "FVG", text_size = size.tiny, text_color = color.new(color.orange, 0), text_halign = text.align_left, text_valign = text.align_center)
    array.push(fBox, nb)
    array.push(fBull, false)

if array.size(fBox) > 0
    for i = array.size(fBox) - 1 to 0
        box  b  = array.get(fBox, i)
        bool bu = array.get(fBull, i)
        box.set_right(b, bar_index + 5)
        bool filled = bu ? (low <= box.get_bottom(b)) : (high >= box.get_top(b))
        if filled
            box.delete(b)
            array.remove(fBox, i)
            array.remove(fBull, i)

while array.size(fBox) > fvgMax
    box.delete(array.shift(fBox))
    array.shift(fBull)

// ============================================================================
//  3 · LIQUIDITY GRAB — pichli choti/talwa tor kar wapas andar aa jana
// ============================================================================
var float lastPH = na
var float lastPL = na
if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl

bool grabUp = not na(lastPH) and high > lastPH and close < lastPH   // upar ka jhoota break -> bearish
bool grabDn = not na(lastPL) and low  < lastPL and close > lastPL   // neeche ka jhoota break -> bullish

var label[] lgLbls = array.new_label()
var box[]   lgBoxs = array.new_box()

// Grab ka shaded hissa = jo level tora gaya us se le kar wick ke sire tak.
// Yehi wo jagah hai jahan se stops uthaye gaye.
if showLGB and grabUp and barstate.isconfirmed
    array.push(lgBoxs, box.new(bar_index - 1, high, bar_index + 3, lastPH, xloc = xloc.bar_index, bgcolor = cLgUp, border_color = color.new(color.red, 40)))
    array.push(lgLbls, label.new(bar_index, high, "LG", xloc = xloc.bar_index, yloc = yloc.abovebar, style = label.style_label_down, color = color.new(color.red, 25), textcolor = color.white, size = size.tiny, tooltip = "Liquidity grab: upar stops liye, wapas neeche band hui"))

if showLGB and grabDn and barstate.isconfirmed
    array.push(lgBoxs, box.new(bar_index - 1, lastPL, bar_index + 3, low, xloc = xloc.bar_index, bgcolor = cLgDn, border_color = color.new(color.teal, 40)))
    array.push(lgLbls, label.new(bar_index, low, "LG", xloc = xloc.bar_index, yloc = yloc.belowbar, style = label.style_label_up, color = color.new(color.teal, 25), textcolor = color.white, size = size.tiny, tooltip = "Liquidity grab: neeche stops liye, wapas upar band hui"))

while array.size(lgLbls) > lgMax
    label.delete(array.shift(lgLbls))
while array.size(lgBoxs) > lgMax
    box.delete(array.shift(lgBoxs))

// ============================================================================
//  4 · BUY / SELL SIGNAL
// ============================================================================
float rng  = high - low
float body = math.abs(close - open)
bool  bodyOK = rng > 0 and (body / rng * 100.0) >= minBodyPc

bool bullBar = close > open and bodyOK
bool bearBar = close < open and bodyOK

bool trendOKb = not useTrend or close > ema
bool trendOKs = not useTrend or close < ema

var int lastSigBar = na
bool coolOK = na(lastSigBar) or (bar_index - lastSigBar) >= coolBars

// Session filter — default band. Sust ghanton (jaise Asia ki raat) mein
// spread chaura aur harkat kam hoti hai, to wahan ke signal mehngay parte
// hain. Magar ye dawa test kiye baghair nahi maanna chahiye.
bool sessOK = not useSession or not na(time(timeframe.period, sessStr))

// --- Continuation 1: pichli swing high/low tootna (breakout)
bool brkUp = useBreak and not na(lastPH) and close > lastPH + brkBufAtr * atr
bool brkDn = useBreak and not na(lastPL) and close < lastPL - brkBufAtr * atr

// --- Continuation 2: trend mein price MA20 tak wapas aaya aur wahan se palta
bool retUp = useRetest and close > ma1 and math.abs(low  - ma1) <= retestAtr * atr
bool retDn = useRetest and close < ma1 and math.abs(high - ma1) <= retestAtr * atr

// Chaar rasty: support/resistance zone, liquidity grab, breakout, MA20 retest.
bool trigBuy  = not na(supHit) or grabDn or brkUp or retUp
bool trigSell = not na(resHit) or grabUp or brkDn or retDn

bool rawBuy  = trigBuy  and bullBar and trendOKb and htfOKb
bool rawSell = trigSell and bearBar and trendOKs and htfOKs

// SL kitna door banega — signal banane se PEHLE naap lete hain, taake bara
// SL wala signal rad kiya ja sake. Chhota account bare SL wali trade utha hi
// nahi sakta: minimum lot par bhi risk had se barh jata hai.
float preAnchorB = na(supHit) ? math.min(low, low[1]) : math.min(low, supHit)
float preAnchorS = na(resHit) ? math.max(high, high[1]) : math.max(high, resHit)
float preSlB = preAnchorB - slBuf * atr
float preSlS = preAnchorS + slBuf * atr
bool stopOKb = not useMaxStop or (atr > 0 and math.abs(close - preSlB) <= maxStopAtr * atr)
bool stopOKs = not useMaxStop or (atr > 0 and math.abs(close - preSlS) <= maxStopAtr * atr)

bool sigBuy  = rawBuy  and not rawSell and coolOK and sessOK and stopOKb and barstate.isconfirmed
bool sigSell = rawSell and not rawBuy  and coolOK and sessOK and stopOKs and barstate.isconfirmed

var string  sideTx  = ""
var float   sEntry  = na
var float   sSL     = na
var float   sTP1    = na
var float   sTP2    = na
var line[]  planLn  = array.new_line()
var label[] planLb  = array.new_label()
var label   sigLbl  = na
var int     sDir    = 0        // 1 = buy, -1 = sell, 0 = koi nahi
var int     sBar    = na       // signal kis bar par bana
var bool    sLive   = false    // abhi chal raha hai?
var bool    sTp1Hit = false
var string  sStat   = ""       // halat ka matn

// Live scorecard — is chart par ab tak kya hua. Ye forward test ka chhota
// version hai: bina strategy chalaye, seedha chart par.
var int   nWin  = 0
var int   nLoss = 0
var int   nBE   = 0            // TP1 ke baad breakeven — na jeet na haar
var float grossW = 0.0
var float grossL = 0.0
var bool  sCount = false       // ye signal scorecard mein ginna hai ya nahi

if sigBuy or sigSell
    lastSigBar := bar_index

    while array.size(planLn) > 0
        line.delete(array.shift(planLn))
    while array.size(planLb) > 0
        label.delete(array.shift(planLb))

    color sc = sigBuy ? cBuy : cSell
    sideTx  := sigBuy ? "BUY" : "SELL"
    sDir    := sigBuy ? 1 : -1
    sBar    := bar_index
    sLive   := true
    sTp1Hit := false
    sCount  := not statsUseDt or time >= statsFrom
    sStat   := "CHAL RAHA HAI"
    sEntry  := close
    sSL     := sigBuy ? preSlB : preSlS
    float r = math.abs(sEntry - sSL)
    sTP1 := sigBuy ? (sEntry + r * tp1R) : (sEntry - r * tp1R)
    sTP2 := sigBuy ? (sEntry + r * tp2R) : (sEntry - r * tp2R)

    string why = sigBuy ? (not na(supHit) ? "support zone" : grabDn ? "liquidity grab" : brkUp ? "breakout" : "MA20 retest") : (not na(resHit) ? "resistance zone" : grabUp ? "liquidity grab" : brkDn ? "breakdown" : "MA20 retest")
    if onlyLast and not na(sigLbl)
        label.delete(sigLbl)
    sigLbl := label.new(bar_index, close, sideTx + "  (" + why + ")\nEntry " + f_px(sEntry) + "\nSL " + f_px(sSL) + "\nTP1 " + f_px(sTP1) + "\nTP2 " + f_px(sTP2), xloc = xloc.bar_index, yloc = sigBuy ? yloc.belowbar : yloc.abovebar, style = sigBuy ? label.style_label_up : label.style_label_down, color = sc, textcolor = color.white, size = size.normal)

    if showPlan
        line l1 = line.new(bar_index, sEntry, bar_index + 30, sEntry, xloc = xloc.bar_index, color = color.new(color.blue, 0), width = 2)
        line l2 = line.new(bar_index, sSL,    bar_index + 30, sSL,    xloc = xloc.bar_index, color = cSell, width = 2, style = line.style_dashed)
        line l3 = line.new(bar_index, sTP1,   bar_index + 30, sTP1,   xloc = xloc.bar_index, color = cBuy,  width = 1, style = line.style_dashed)
        line l4 = line.new(bar_index, sTP2,   bar_index + 30, sTP2,   xloc = xloc.bar_index, color = cBuy,  width = 1, style = line.style_dotted)
        array.push(planLn, l1)
        array.push(planLn, l2)
        array.push(planLn, l3)
        array.push(planLn, l4)
        array.push(planLb, label.new(bar_index + 30, sEntry, "ENTRY " + f_px(sEntry), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(color.blue, 25), textcolor = color.white, size = size.small))
        array.push(planLb, label.new(bar_index + 30, sSL, "SL " + f_px(sSL), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(cSell, 25), textcolor = color.white, size = size.small))
        array.push(planLb, label.new(bar_index + 30, sTP1, "TP1 " + f_px(sTP1), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(cBuy, 25), textcolor = color.white, size = size.small))
        array.push(planLb, label.new(bar_index + 30, sTP2, "TP2 " + f_px(sTP2), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(cBuy, 45), textcolor = color.white, size = size.small))

    alert(sideTx + " — " + syminfo.ticker + " " + timeframe.period + " | Entry " + f_px(sEntry) + " | SL " + f_px(sSL) + " | TP1 " + f_px(sTP1) + " | TP2 " + f_px(sTP2), alert.freq_once_per_bar_close)

// --- signal ke baad har bar: dekho SL laga, TP laga, ya abhi chal raha hai.
//     SL pehle check hota hai: agar ek hi candle mein dono chhue gaye to hum
//     maan lete hain ke SL laga. Ye jaan boojh kar sakht rakha hai — chart se
//     ye nahi pata chalta ke pehle kaun chhua, aur khud ko fayda de kar ginna
//     record ko jhoota bana deta hai.
if sLive and not (sigBuy or sigSell)
    // Chalta hua stop: TP1 lag chukne ke baad wo entry par aa jata hai, bilkul
    // waise jaise strategy karti hai. sTp1Hit is bar se PEHLE ki halat hai —
    // ek hi candle mein TP1 aur wapasi ho jaye to hum khud ko riayat nahi dete.
    bool wasBE  = sTp1Hit and beAfterTp1
    float effSL = wasBE ? sEntry : sSL
    bool slHit  = sDir > 0 ? (low  <= effSL) : (high >= effSL)
    bool tp2Hit = sDir > 0 ? (high >= sTP2)  : (low  <= sTP2)
    bool tp1Hit = sDir > 0 ? (high >= sTP1)  : (low  <= sTP1)
    if tp1Hit
        sTp1Hit := true
    if slHit
        sLive := false
        sStat := wasBE ? "KHATAM — breakeven (TP1 ke baad)" : "KHATAM — SL laga"
        if sCount
            if wasBE
                nBE += 1
            else
                nLoss += 1
                grossL += 1.0
    else if tp2Hit
        sLive := false
        sStat := "KHATAM — TP2 mil gaya"
        if sCount
            nWin += 1
            grossW += tp2R
    else
        sStat := sTp1Hit ? "CHAL RAHA HAI (TP1 mil chuka)" : "CHAL RAHA HAI"
    // khatam hone par plan ki lines hata do, chart saaf rahe
    if not sLive
        while array.size(planLn) > 0
            line.delete(array.shift(planLn))
        while array.size(planLb) > 0
            label.delete(array.shift(planLb))

plotshape(showArrow and sigBuy,  title = "BUY",  style = shape.triangleup,   location = location.belowbar, color = cBuy,  size = size.tiny)
plotshape(showArrow and sigSell, title = "SELL", style = shape.triangledown, location = location.abovebar, color = cSell, size = size.tiny)

// ============================================================================
//  LOT SIZE — har signal ke saath, kyunke yehi wo hisaab hai jo log nahi karte
//
//  Usool: risk ($) = SL ka faasla × units. Ise ulta karein to units nikal
//  aati hain:  units = risk ÷ SL ka faasla,  lot = units ÷ contract size.
//
//  Aur ek check jo is se bhi ahem hai: broker ka sab se chhota lot bhi kabhi
//  kabhi zyada hota hai. $180 SL wale daily signal par 0.01 lot ka matlab
//  $180 risk hai — $500 account par 36%. Us waqt sahi jawab "chhota lot lo"
//  nahi, "ye trade mat lo" hai. Panel wahan saaf mana kar deta hai.
// ============================================================================
float riskAmt   = acctSize * riskPct / 100.0
float stopDist  = na(sEntry) or na(sSL) ? na : math.abs(sEntry - sSL)
float wantUnits = na(stopDist) or stopDist <= 0 ? na : riskAmt / stopDist
float wantLots  = na(wantUnits) ? na : wantUnits / contrSize
float minLotRsk = na(stopDist) ? na : stopDist * contrSize * minLot
float minLotPct = na(minLotRsk) ? na : minLotRsk / acctSize * 100.0
bool  tooBig    = not na(minLotRsk) and minLotRsk > riskAmt

// ============================================================================
//  PANEL — signal ki halat, lot ka hisaab, aur ab tak ka scorecard
// ============================================================================
var table t = na
if showPanel and barstate.islast
    if na(t)
        t := table.new(position.bottom_right, 1, 10, border_width = 1)
    else
        table.clear(t, 0, 0, 0, 9)

    string ageTx = na(sBar) ? "" : (str.tostring(bar_index - sBar) + " candle purana")
    string r1 = sideTx == "" ? "Abhi koi signal nahi" : ("Aakhri signal: " + sideTx + "   (" + ageTx + ")")
    string r2 = sideTx == "" ? "Zone / grab ka intezaar" : sStat
    string r3 = sideTx == "" ? "" : ("Entry " + f_px(sEntry) + "   SL " + f_px(sSL) + "   TP1 " + f_px(sTP1) + "   TP2 " + f_px(sTP2))
    string r4 = not useHtf ? "HTF filter band (har taraf ke signal aayenge)" : (htfTF + " trend: " + (htfDir == 1 ? "UP — sirf BUY milenge" : htfDir == -1 ? "DOWN — sirf SELL milenge" : "saaf nahi — koi signal nahi"))

    table.cell(t, 0, 0, r1, bgcolor = panelBg, text_color = sideTx == "BUY" ? cBuy : sideTx == "SELL" ? cSell : panelDim, text_size = size.normal)
    table.cell(t, 0, 1, r2, bgcolor = panelBg, text_color = sLive ? (sDir > 0 ? cBuy : cSell) : panelDim, text_size = size.normal)
    table.cell(t, 0, 2, r3, bgcolor = panelBg, text_color = panelTx, text_size = size.small)
    table.cell(t, 0, 3, r4, bgcolor = panelBg, text_color = not useHtf ? panelDim : (htfDir == 1 ? cBuy : htfDir == -1 ? cSell : panelDim), text_size = size.small)

    int row = 4
    if showRisk
        string q1 = "Account $" + str.tostring(acctSize, "#") + "   risk " + str.tostring(riskPct, "#.##") + "%  =  $" + str.tostring(riskAmt, "#.##")
        string q2 = na(stopDist) ? "SL ka faasla: —" : ("SL ka faasla " + str.tostring(stopDist, format.mintick) + "   →   lot " + str.tostring(wantLots, "#.###"))
        string q3 = na(minLotRsk) ? "" : (tooBig ? ("XX  " + str.tostring(minLot, "#.###") + " lot par bhi risk $" + str.tostring(minLotRsk, "#.##") + " (" + str.tostring(minLotPct, "#.#") + "%) — YE TRADE MAT LEIN") : ("OK  " + str.tostring(minLot, "#.###") + " lot par risk $" + str.tostring(minLotRsk, "#.##") + " (" + str.tostring(minLotPct, "#.#") + "%)"))
        table.cell(t, 0, row, q1, bgcolor = panelBg, text_color = panelDim, text_size = size.small)
        table.cell(t, 0, row + 1, q2, bgcolor = panelBg, text_color = panelTx, text_size = size.small)
        table.cell(t, 0, row + 2, q3, bgcolor = panelBg, text_color = tooBig ? cSell : panelDim, text_size = size.small)
        row += 3

    if showStats
        int    done = nWin + nLoss + nBE
        float  pf   = grossL > 0 ? grossW / grossL : na
        float  wr   = done > 0 ? nWin * 100.0 / done : na
        string sc1 = done == 0 ? "Scorecard: abhi koi trade khatam nahi hui" : ("Scorecard " + timeframe.period + ": " + str.tostring(nWin) + " jeet / " + str.tostring(nLoss) + " haar / " + str.tostring(nBE) + " breakeven   (" + str.tostring(wr, "#") + "%)   PF " + (na(pf) ? "—" : str.tostring(pf, "#.##")))
        string sc2 = statsUseDt ? "Scorecard shuru: " + str.format("{0,date,dd MMM yyyy}", statsFrom) : "Scorecard: poore chart ka (forward nahi)"
        table.cell(t, 0, row, sc1, bgcolor = panelBg, text_color = na(pf) ? panelDim : (pf >= 1.0 ? cBuy : cSell), text_size = size.small)
        table.cell(t, 0, row + 1, sc2, bgcolor = panelBg, text_color = panelDim, text_size = size.small)

// ============================================================================
//  VOLUME / DABAO PANEL — sirf mushahide ke liye, signal is se nahi banta
//
//  1. VOLUME — pichli MUKAMMAL candle ka volume, us se pehli vpLen candles ke
//     ausat se kitna guna. Chalti hui candle ka volume istemal NAHI karte: wo
//     din bhar barhta rehta hai, is liye subah "kam" aur shaam "zyada" dikhta.
//
//  2. DABAO — candle apni range mein kahan band hui. Upar band = kharidaron ka
//     zor. Ye ratio hai, cumulative nahi, is liye chalti candle par bhi dekha
//     ja sakta hai — magar wo abhi badal sakta hai ("live" likha hai).
//
//  XAUUSD ka volume asli exchange volume NAHI hai — ye tick count hai. Asli
//  gold volume COMEX futures (GC1!) mein hai. Ise ishara samjhen, saboot nahi.
// ============================================================================
f_vpStats() =>
    float _pos   = (high - low) > 0 ? (close - low) / (high - low) : 0.5
    float _avgS  = ta.sma(volume, vpLen)
    float _numS  = math.sum(volume * _pos, vpLen)
    float _denS  = math.sum(volume, vpLen)
    float _vPrev = volume[1]
    float _vAvg  = _avgS[1]
    float _num   = _numS[1]
    float _den   = _denS[1]
    float _ratio = (na(_vAvg) or _vAvg <= 0) ? na : _vPrev / _vAvg
    float _avgP  = (na(_den)  or _den  <= 0) ? na : _num / _den * 100.0
    float _live  = _pos * 100.0
    [_ratio, _live, _avgP]

[v1r, v1l, v1a] = request.security(syminfo.tickerid, vpTf1, f_vpStats(), lookahead = barmerge.lookahead_off)
[v2r, v2l, v2a] = request.security(syminfo.tickerid, vpTf2, f_vpStats(), lookahead = barmerge.lookahead_off)

f_volTx(_r) => na(_r) ? "—" : str.tostring(_r, "#.0#") + "x " + (_r >= 1.5 ? "(bohot zyada)" : _r >= 1.0 ? "(zyada)" : _r >= 0.6 ? "(mamooli)" : "(sust)")
f_prsTx(_p) => na(_p) ? "—" : str.tostring(_p, "#") + "%  " + (_p >= 65 ? "kharidar" : _p <= 35 ? "bechne wale" : "barabar")
f_prsCol(_p) => na(_p) ? panelDim : _p >= 65 ? cBuy : _p <= 35 ? cSell : panelDim

var table vt = na
if showVP and barstate.islast
    if na(vt)
        vt := table.new(position.top_right, 4, 3, border_width = 1)
    table.cell(vt, 0, 0, "TF",           bgcolor = panelHdBg, text_color = panelTx, text_size = size.small)
    table.cell(vt, 1, 0, "Volume",       bgcolor = panelHdBg, text_color = panelTx, text_size = size.small)
    table.cell(vt, 2, 0, "Dabao (live)", bgcolor = panelHdBg, text_color = panelTx, text_size = size.small)
    table.cell(vt, 3, 0, str.tostring(vpLen) + " ka dabao", bgcolor = panelHdBg, text_color = panelTx, text_size = size.small)

    table.cell(vt, 0, 1, vpTf1, bgcolor = panelBg, text_color = panelTx, text_size = size.small)
    table.cell(vt, 1, 1, f_volTx(v1r), bgcolor = panelBg, text_color = panelTx, text_size = size.small)
    table.cell(vt, 2, 1, f_prsTx(v1l), bgcolor = panelBg, text_color = f_prsCol(v1l), text_size = size.small)
    table.cell(vt, 3, 1, f_prsTx(v1a), bgcolor = panelBg, text_color = f_prsCol(v1a), text_size = size.small)

    table.cell(vt, 0, 2, vpTf2, bgcolor = panelBg, text_color = panelTx, text_size = size.small)
    table.cell(vt, 1, 2, f_volTx(v2r), bgcolor = panelBg, text_color = panelTx, text_size = size.small)
    table.cell(vt, 2, 2, f_prsTx(v2l), bgcolor = panelBg, text_color = f_prsCol(v2l), text_size = size.small)
    table.cell(vt, 3, 2, f_prsTx(v2a), bgcolor = panelBg, text_color = f_prsCol(v2a), text_size = size.small)

// ============================================================================
//  ALERTS
// ============================================================================
alertcondition(sigBuy,  "BUY signal",            "SMC Simple: BUY signal")
alertcondition(sigSell, "SELL signal",           "SMC Simple: SELL signal")
alertcondition(grabUp,  "Liquidity grab upar",   "SMC Simple: upar liquidity grab")
alertcondition(grabDn,  "Liquidity grab neeche", "SMC Simple: neeche liquidity grab")
