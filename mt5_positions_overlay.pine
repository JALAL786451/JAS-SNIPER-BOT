//@version=6
// ══════════════════════════════════════════════════════════════════════════
//  MT5 POSITIONS OVERLAY  —  apni MT5 positions TradingView chart par
// ══════════════════════════════════════════════════════════════════════════
//
//  MT5 ke Trade tab se apni positions copy karein aur settings ke text box
//  mein paste kar dein. Har position ek line mein:
//
//      buy  0.01  4355.759
//      buy  0.04  4470.677
//      sell 0.01  4573.640
//
//  Comma bhi chalega:  buy,0.01,4355.759
//
//  CHART PAR KYA BANEGA:
//      Har position ki apni horizontal line (BUY = green, SELL = red)
//      Har line par lot aur us ka live profit/loss
//      Ek YELLOW line = poore basket ka BREAKEVEN (ye MT5 nahi batata)
//      Corner mein table = kul lots, average entry, aur kul profit/loss
//
// ══════════════════════════════════════════════════════════════════════════

indicator("MT5 Positions Overlay", overlay = true,
     max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────────────  INPUTS  ───────────────────────────────

posText = input.text_area(
     "buy 0.01 4355.759\nbuy 0.01 4344.050\nbuy 0.01 4339.930\nsell 0.01 4573.640",
     "MT5 positions — har line mein: type  lot  price",
     tooltip = "MT5 ke Trade tab se dekh kar likhein. Misal:\nbuy 0.01 4355.759\nsell 0.04 4573.640")

grpAcc     = "Account"
lotSize    = input.float(100.0, "1 lot = kitni units (Gold = 100)", minval = 0.0001, group = grpAcc,
     tooltip = "XAUUSD par 1 lot = 100 ounce. Doosre symbols par alag hota hai.")
centAcc    = input.bool(true, "Cent account (profit cents mein dikhayein)", group = grpAcc,
     tooltip = "Exness USC / cent account ke liye tick lagayein. Standard account ke liye hata dein.")

grpView    = "Dikhawa"
showLines  = input.bool(true,  "Position lines", group = grpView)
showLabels = input.bool(true,  "Har line par label", group = grpView)
showBE     = input.bool(true,  "Breakeven line", group = grpView)
showTable  = input.bool(true,  "Summary table", group = grpView)
tblPos     = input.string("Top Right", "Table kahan", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grpView)
labelOff   = input.int(20, "Label kitna dayein", minval = 1, maxval = 100, group = grpView)

// ──────────────────────────────  HELPERS  ────────────────────────────────

f_tablePos(string s) =>
    switch s
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.top_right

// Ek line ko saaf kar ke tokens nikalta hai
f_tokens(string ln) =>
    s = str.replace_all(ln, ",", " ")
    s := str.replace_all(s, "\t", " ")
    s := str.replace_all(s, "\r", "")
    raw = str.split(s, " ")
    out = array.new<string>()
    if array.size(raw) > 0
        for i = 0 to array.size(raw) - 1
            t = array.get(raw, i)
            if str.length(t) > 0
                array.push(out, t)
    out

money(float usd) =>
    centAcc ? usd * 100.0 : usd

unit() =>
    centAcc ? " ¢" : " $"

// ═══════════════════════════════  DRAWING  ════════════════════════════════

var array<line>  drawnLines  = array.new<line>()
var array<label> drawnLabels = array.new<label>()
var line         beLine      = na
var label        beLabel     = na
var table        sumTbl      = na

if barstate.islast

    // ---- purani drawing hatao ----
    if array.size(drawnLines) > 0
        for i = 0 to array.size(drawnLines) - 1
            line.delete(array.get(drawnLines, i))
        array.clear(drawnLines)
    if array.size(drawnLabels) > 0
        for i = 0 to array.size(drawnLabels) - 1
            label.delete(array.get(drawnLabels, i))
        array.clear(drawnLabels)
    line.delete(beLine)
    label.delete(beLabel)

    // ---- totals ----
    float buyLots   = 0.0
    float sellLots  = 0.0
    float buyNotion = 0.0     // Σ (lot × entry)  buys
    float selNotion = 0.0     // Σ (lot × entry)  sells
    float buyPL     = 0.0
    float selPL     = 0.0
    int   nBuy      = 0
    int   nSell     = 0
    int   nBad      = 0

    lines = str.split(posText, "\n")

    if array.size(lines) > 0
        for i = 0 to array.size(lines) - 1
            tk = f_tokens(array.get(lines, i))

            if array.size(tk) >= 3
                side  = str.lower(array.get(tk, 0))
                lot   = str.tonumber(array.get(tk, 1))
                entry = str.tonumber(array.get(tk, 2))

                isBuy  = str.contains(side, "buy")
                isSell = str.contains(side, "sell")

                if (isBuy or isSell) and not na(lot) and not na(entry) and lot > 0 and entry > 0

                    units = lot * lotSize
                    pl    = isBuy ? (close - entry) * units : (entry - close) * units

                    if isBuy
                        buyLots   += lot
                        buyNotion += lot * entry
                        buyPL     += pl
                        nBuy      += 1
                    else
                        sellLots  += lot
                        selNotion += lot * entry
                        selPL     += pl
                        nSell     += 1

                    col = isBuy ? color.new(color.lime, 25) : color.new(color.red, 25)

                    if showLines
                        ln = line.new(bar_index - 1, entry, bar_index, entry,
                             extend = extend.both, color = col, width = 1, style = line.style_dotted)
                        array.push(drawnLines, ln)

                    if showLabels
                        txt = (isBuy ? "BUY " : "SELL ") + str.tostring(lot) +
                              "  @ " + str.tostring(entry, format.mintick) +
                              "   " + str.tostring(money(pl), "#.##") + unit()
                        lb = label.new(bar_index + labelOff, entry, txt,
                             xloc = xloc.bar_index, yloc = yloc.price,
                             style = label.style_label_left, size = size.tiny,
                             color = color.new(color.black, 100),
                             textcolor = pl >= 0 ? color.new(color.lime, 0) : color.new(color.red, 0))
                        array.push(drawnLabels, lb)
                else
                    nBad += 1
            else if str.length(str.replace_all(array.get(lines, i), " ", "")) > 0
                nBad += 1

    // ---- breakeven: wo price jahan poora basket sifar par aata hai ----
    netLots = buyLots - sellLots
    float be = na
    if math.abs(netLots) > 1e-9
        be := (buyNotion - selNotion) / netLots

    if showBE and not na(be) and be > 0
        beLine := line.new(bar_index - 1, be, bar_index, be,
             extend = extend.both, color = color.new(color.yellow, 0), width = 2)
        beLabel := label.new(bar_index + labelOff, be,
             "BREAKEVEN  " + str.tostring(be, format.mintick),
             xloc = xloc.bar_index, yloc = yloc.price,
             style = label.style_label_left, size = size.small,
             color = color.new(color.yellow, 0), textcolor = color.black)

    // ---- summary table ----
    if showTable
        totalPL = buyPL + selPL
        avgBuy  = buyLots  > 0 ? buyNotion / buyLots  : na
        avgSell = sellLots > 0 ? selNotion / sellLots : na

        if na(sumTbl)
            sumTbl := table.new(f_tablePos(tblPos), 5, 5, border_width = 1)
        table.clear(sumTbl, 0, 0, 4, 4)

        hdBg = color.new(color.gray, 20)
        bg   = color.new(color.black, 20)
        fg   = color.new(color.white, 0)

        table.cell(sumTbl, 0, 0, "",         bgcolor = hdBg, text_color = fg, text_size = size.small)
        table.cell(sumTbl, 1, 0, "Count",    bgcolor = hdBg, text_color = fg, text_size = size.small)
        table.cell(sumTbl, 2, 0, "Lots",     bgcolor = hdBg, text_color = fg, text_size = size.small)
        table.cell(sumTbl, 3, 0, "Avg entry",bgcolor = hdBg, text_color = fg, text_size = size.small)
        table.cell(sumTbl, 4, 0, "P/L",      bgcolor = hdBg, text_color = fg, text_size = size.small)

        table.cell(sumTbl, 0, 1, "BUY",  bgcolor = bg, text_color = color.new(color.lime, 0), text_size = size.small)
        table.cell(sumTbl, 1, 1, str.tostring(nBuy),            bgcolor = bg, text_color = fg, text_size = size.small)
        table.cell(sumTbl, 2, 1, str.tostring(buyLots, "#.##"), bgcolor = bg, text_color = fg, text_size = size.small)
        table.cell(sumTbl, 3, 1, na(avgBuy) ? "—" : str.tostring(avgBuy, format.mintick), bgcolor = bg, text_color = fg, text_size = size.small)
        table.cell(sumTbl, 4, 1, str.tostring(money(buyPL), "#.##") + unit(), bgcolor = bg,
             text_color = buyPL >= 0 ? color.new(color.lime, 0) : color.new(color.red, 0), text_size = size.small)

        table.cell(sumTbl, 0, 2, "SELL", bgcolor = bg, text_color = color.new(color.red, 0), text_size = size.small)
        table.cell(sumTbl, 1, 2, str.tostring(nSell),            bgcolor = bg, text_color = fg, text_size = size.small)
        table.cell(sumTbl, 2, 2, str.tostring(sellLots, "#.##"), bgcolor = bg, text_color = fg, text_size = size.small)
        table.cell(sumTbl, 3, 2, na(avgSell) ? "—" : str.tostring(avgSell, format.mintick), bgcolor = bg, text_color = fg, text_size = size.small)
        table.cell(sumTbl, 4, 2, str.tostring(money(selPL), "#.##") + unit(), bgcolor = bg,
             text_color = selPL >= 0 ? color.new(color.lime, 0) : color.new(color.red, 0), text_size = size.small)

        table.cell(sumTbl, 0, 3, "NET",  bgcolor = hdBg, text_color = fg, text_size = size.small)
        table.cell(sumTbl, 1, 3, str.tostring(nBuy + nSell),    bgcolor = hdBg, text_color = fg, text_size = size.small)
        table.cell(sumTbl, 2, 3, str.tostring(netLots, "#.##"), bgcolor = hdBg, text_color = fg, text_size = size.small)
        table.cell(sumTbl, 3, 3, na(be) ? "—" : str.tostring(be, format.mintick) + "  (BE)", bgcolor = hdBg,
             text_color = color.new(color.yellow, 0), text_size = size.small)
        table.cell(sumTbl, 4, 3, str.tostring(money(totalPL), "#.##") + unit(), bgcolor = hdBg,
             text_color = totalPL >= 0 ? color.new(color.lime, 0) : color.new(color.red, 0), text_size = size.small)

        note = nBad > 0 ? "⚠ " + str.tostring(nBad) + " line parh nahi saka — format check karein" :
               "Price " + str.tostring(close, format.mintick) + " par hisaab"
        table.cell(sumTbl, 0, 4, note, bgcolor = bg,
             text_color = nBad > 0 ? color.new(color.orange, 0) : color.new(color.silver, 0),
             text_size = size.tiny)
        table.merge_cells(sumTbl, 0, 4, 4, 4)
