//@version=6
// ══════════════════════════════════════════════════════════════════════════
//  XAUUSD MTF Wick / FVG Scalper  v2  —  SELF-ADJUSTING        [ INDICATOR ]
// ══════════════════════════════════════════════════════════════════════════
//
//  Sirf 3 settings. Baaqi sab ATR (volatility) ke hisaab se khud adjust
//  hota hai — Asian session ki sust chaal ho ya NY news ki tezi, thresholds
//  khud badal jate hain.
//
//  Chart 1M par rakhein.
//
//  LOGIC (aapka apna method):
//      15M ki pichli candle ke wick / FVG   ->  zone     (YELLOW box)
//      Price zone mein wapas aaye           ->  retest
//      15M + 5M dono MA20/MA50 se confirm   ->  trend
//      1M ka unfilled wick touch + rejection close  ->  ENTRY
//
//  CHART PAR KYA KYA BANTA HAI:
//      Light YELLOW box  = bullish zone (15M wick ya FVG) — yahan BUY dhoondte hain
//      Light BLUE  box   = bearish zone (15M wick ya FVG) — yahan SELL dhoondte hain
//      Green box         = TP zone  (entry se target tak)
//      Red box           = SL zone  (entry se stop tak)
//      Har box par uska naam likha hota hai, to guess karne ki zaroorat nahi.
//
// ══════════════════════════════════════════════════════════════════════════

indicator("XAUUSD Scalper v2 [auto]", overlay = true,
     max_boxes_count = 50, max_lines_count = 100, max_labels_count = 100,
     max_bars_back = 300)

// ─────────────────────────────  SIRF 3 SETTINGS  ──────────────────────────

sens = input.string("Balanced", "1. Sensitivity",
     options  = ["Conservative", "Balanced", "Aggressive"],
     tooltip  = "Conservative = kam magar saaf signals. Aggressive = zyada signals magar shor bhi zyada.")

rr = input.float(2.0, "2. Risk : Reward", minval = 0.5, maxval = 5.0, step = 0.1,
     tooltip  = "TP = SL ka itna guna. 2.0 ka matlab: 1 haar ke muqable 2 jeet.")

sessMode = input.string("London + NY", "3. Session filter",
     options  = ["Off", "London only", "NY only", "London + NY"],
     tooltip  = "Sirf in sessions mein signal lein. Asian session ki sust chaal se bachne ke liye.")

// ─────────────────────  SENSITIVITY -> KHUD KE THRESHOLDS  ────────────────
// Ye teen numbers Sensitivity se badalte hain. Baaqi sab ATR se scale hota hai.

wickFactor = sens == "Conservative" ? 0.80 : sens == "Aggressive" ? 0.30 : 0.50  // wick kitna bara ho (ATR ka guna)
rejFactor  = sens == "Conservative" ? 1.20 : sens == "Aggressive" ? 0.50 : 0.80  // rejection wick vs body
maxAge     = sens == "Conservative" ? 60   : sens == "Aggressive" ? 120  : 90    // zone kitni 1M bars tak zinda rahe

// ──────────────────────────  TIMEFRAME GUARD  ─────────────────────────────

var bool warned = false
if not warned and timeframe.in_seconds() > 300
    label.new(bar_index, high, "⚠ Ye script 1M chart ke liye hai.\nChart ko 1 minute par rakhein.",
         color = color.orange, textcolor = color.white, style = label.style_label_down, size = size.normal)
    warned := true

// ─────────────────────────────  HTF DATA (15M)  ───────────────────────────
// [1] lagaya hai taake sirf CONFIRMED 15M candle use ho -> repaint nahi hota.

[h15, l15, o15, c15, h15old, l15old, atr15, ma20_15, ma50_15] = request.security(
     syminfo.tickerid, "15",
     [high[1], low[1], open[1], close[1], high[3], low[3], ta.atr(14)[1], ta.sma(close, 20)[1], ta.sma(close, 50)[1]],
     lookahead = barmerge.lookahead_off)

// ─────────────────────────────  HTF DATA (5M)  ────────────────────────────

[ma20_5, ma50_5] = request.security(
     syminfo.tickerid, "5",
     [ta.sma(close, 20)[1], ta.sma(close, 50)[1]],
     lookahead = barmerge.lookahead_off)

atrC = ta.atr(14)   // chart (1M) ATR — SL buffer ke liye

// ──────────────────────────────  TREND FILTER  ────────────────────────────
// 15M aur 5M dono ka MA20 > MA50 hona zaroori hai.

bullTrend = ma20_15 > ma50_15 and ma20_5 > ma50_5
bearTrend = ma20_15 < ma50_15 and ma20_5 < ma50_5

// ──────────────────────────────  SESSION FILTER  ──────────────────────────

inLondon = not na(time(timeframe.period, "0800-1700", "Europe/London"))
inNY     = not na(time(timeframe.period, "0800-1700", "America/New_York"))

sessOk = switch sessMode
    "Off"          => true
    "London only"  => inLondon
    "NY only"      => inNY
    => inLondon or inNY

// ═══════════════════════════════  ZONE ENGINE  ════════════════════════════

type Zone
    float top
    float bot
    bool  isBull
    int   born
    box   bx
    bool  dead

var array<Zone> zones = array.new<Zone>()

drawZone(float top, float bot, bool isBull, string kind) =>
    bg  = isBull ? color.new(color.yellow, 88) : color.new(color.blue, 88)
    brd = isBull ? color.new(color.orange, 35) : color.new(color.blue, 35)
    bx  = box.new(bar_index, top, bar_index + 1, bot,
         border_color = brd, border_width = 1, bgcolor = bg,
         text = kind + (isBull ? " ▲ BUY zone" : " ▼ SELL zone"),
         text_size = size.tiny, text_color = color.new(color.gray, 20),
         text_halign = text.align_left, text_valign = text.align_top)
    array.push(zones, Zone.new(top, bot, isBull, bar_index, bx, false))

// ── Naya 15M candle band hote hi zones banao ──────────────────────────────

newBar15 = timeframe.change("15")

if newBar15 and not na(atr15) and atr15 > 0

    // ---- 1) WICK ZONES (pichli 15M candle ka wick) ----
    bodyTop  = math.max(o15, c15)
    bodyBot  = math.min(o15, c15)
    lowWick  = bodyBot - l15          // neeche ka wick -> demand
    highWick = h15 - bodyTop          // upar ka wick   -> supply

    if lowWick >= atr15 * wickFactor
        drawZone(bodyBot, l15, true, "15M WICK")

    if highWick >= atr15 * wickFactor
        drawZone(h15, bodyTop, false, "15M WICK")

    // ---- 2) FVG ZONES (3-candle gap on 15M) ----
    // Bullish FVG: candle[1] ka low, candle[3] ke high se upar hai
    if l15 > h15old and (l15 - h15old) >= atr15 * wickFactor * 0.5
        drawZone(l15, h15old, true, "15M FVG")

    // Bearish FVG: candle[1] ka high, candle[3] ke low se neeche hai
    if h15 < l15old and (l15old - h15) >= atr15 * wickFactor * 0.5
        drawZone(l15old, h15, false, "15M FVG")

// ── Zones ko right taraf extend karo + purane / toote hue hatao ───────────

if array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        z = array.get(zones, i)

        // zone invalid ho gaya? (price uske aar paar band ho gaya)
        broke = z.isBull ? close < z.bot - atrC * 0.10 : close > z.top + atrC * 0.10
        old   = bar_index - z.born > maxAge

        if z.dead or broke or old
            box.delete(z.bx)
            array.remove(zones, i)
        else
            box.set_right(z.bx, bar_index + 1)

// ═════════════════════════════  ENTRY ENGINE  ═════════════════════════════
// 1M ka wick zone ko touch kare, phir rejection close ke sath bahar nikle.

body      = math.abs(close - open)
lowerWick = math.min(open, close) - low
upperWick = high - math.max(open, close)

var float pendEntry = na
var float pendSL    = na
var float pendTP    = na
var bool  pendBull  = false

longSig  = false
shortSig = false

if array.size(zones) > 0 and sessOk and barstate.isconfirmed
    for i = 0 to array.size(zones) - 1
        z = array.get(zones, i)

        if z.isBull and bullTrend and not longSig
            touched = low <= z.top and low >= z.bot - atrC * 0.30      // wick zone ke andar gaya
            closeOk = close > z.top and close > open                    // rejection ke sath bahar band
            rejOk   = lowerWick >= body * rejFactor and lowerWick > 0
            if touched and closeOk and rejOk
                longSig   := true
                pendBull  := true
                pendEntry := close
                pendSL    := z.bot - atrC * 0.25
                pendTP    := close + (close - (z.bot - atrC * 0.25)) * rr
                z.dead    := true                                       // zone use ho gaya

        if not z.isBull and bearTrend and not shortSig
            touched = high >= z.bot and high <= z.top + atrC * 0.30
            closeOk = close < z.bot and close < open
            rejOk   = upperWick >= body * rejFactor and upperWick > 0
            if touched and closeOk and rejOk
                shortSig  := true
                pendBull  := false
                pendEntry := close
                pendSL    := z.top + atrC * 0.25
                pendTP    := close - ((z.top + atrC * 0.25) - close) * rr
                z.dead    := true

// ══════════════════════════════  DRAWING  ═════════════════════════════════

// ---- BUY / SELL labels ----
plotshape(longSig,  title = "BUY",  style = shape.labelup,   location = location.belowbar,
     color = color.new(color.green, 0), textcolor = color.white, text = "BUY",  size = size.small)
plotshape(shortSig, title = "SELL", style = shape.labeldown, location = location.abovebar,
     color = color.new(color.red, 0),   textcolor = color.white, text = "SELL", size = size.small)

// ---- TP / SL boxes (taake dikhe ke trade kahan ja raha hai) ----
if longSig or shortSig
    tpBox = box.new(bar_index, math.max(pendEntry, pendTP), bar_index + 40, math.min(pendEntry, pendTP),
         border_color = color.new(color.green, 40), bgcolor = color.new(color.green, 90),
         text = "TP  " + str.tostring(pendTP, format.mintick), text_size = size.tiny,
         text_color = color.new(color.green, 20), text_halign = text.align_right, text_valign = text.align_top)
    slBox = box.new(bar_index, math.max(pendEntry, pendSL), bar_index + 40, math.min(pendEntry, pendSL),
         border_color = color.new(color.red, 40), bgcolor = color.new(color.red, 90),
         text = "SL  " + str.tostring(pendSL, format.mintick), text_size = size.tiny,
         text_color = color.new(color.red, 20), text_halign = text.align_right, text_valign = text.align_bottom)

// ---- MA lines (trend confirm dikhane ke liye) ----
plot(ma20_15, "15M MA20", color = color.new(color.teal, 30),  linewidth = 2)
plot(ma50_15, "15M MA50", color = color.new(color.teal, 60),  linewidth = 2)
plot(ma20_5,  "5M MA20",  color = color.new(color.aqua, 55),  linewidth = 1)
plot(ma50_5,  "5M MA50",  color = color.new(color.aqua, 75),  linewidth = 1)

// ---- Trend background (halka sa) ----
bgcolor(bullTrend and sessOk ? color.new(color.green, 96) : bearTrend and sessOk ? color.new(color.red, 96) : na,
     title = "Trend tint")

// ══════════════════════════════  ALERTS  ══════════════════════════════════

alertcondition(longSig,  "Scalper BUY",  "XAUUSD Scalper v2: BUY signal")
alertcondition(shortSig, "Scalper SELL", "XAUUSD Scalper v2: SELL signal")

if longSig
    alert("BUY  " + syminfo.ticker + " @ " + str.tostring(pendEntry, format.mintick) +
          "  SL " + str.tostring(pendSL, format.mintick) +
          "  TP " + str.tostring(pendTP, format.mintick), alert.freq_once_per_bar_close)
if shortSig
    alert("SELL " + syminfo.ticker + " @ " + str.tostring(pendEntry, format.mintick) +
          "  SL " + str.tostring(pendSL, format.mintick) +
          "  TP " + str.tostring(pendTP, format.mintick), alert.freq_once_per_bar_close)
